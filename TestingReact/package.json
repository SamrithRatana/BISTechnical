{
  "name": "testing-react",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --webpack",
    "dev:turbo": "next dev -H 0.0.0.0 --turbo",
    "dev:webpack": "next dev -H 0.0.0.0 --webpack",
    "dev:https": "next dev -H 0.0.0.0 --experimental-https --experimental-https-key ./certificates/localhost-key.pem --experimental-https-cert ./certificates/localhost.pem",
    "build": "node scripts/sync-report-layout.mjs --check && node scripts/build-report-templates.mjs && next build --webpack",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "node scripts/sync-report-layout.mjs --check && tsc --noEmit",
    "build:templates": "node scripts/build-report-templates.mjs",
    "sync:shared": "node scripts/sync-report-layout.mjs",
    "check:shared": "node scripts/sync-report-layout.mjs --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1112.0",
    "@fortune-sheet/react": "^1.0.4",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/qrcode": "^1.5.6",
    "@vladmandic/face-api": "^1.7.15",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^13.1.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.31.0",
    "next": "^16.3.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5.7.3"
  }
}
