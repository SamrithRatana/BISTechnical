# ==============================================================================
# CAMPROTEC SERVICE MAINTENANCE SYSTEM - NEXT.JS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and never committed.

# API Base Endpoints
#
# >>> THIS IS THE ONLY PLACE A DEVELOPER NEEDS TO CHANGE A BACKEND URL. <<<
# Every backend call goes through the Next.js proxy routes under
# src/app/api/proxy/*, and those routes read these three variables.
# Restart `npm run dev` after editing.
#
# For local backend testing, point a variable at the API's localhost port,
# e.g. TechnicalService.API (src/APIs/TechnicalService.API) -> http://localhost:8000
NEXT_PUBLIC_JWT_API_URL=https://your-user-api.example.com
NEXT_PUBLIC_TECHNICAL_API_URL=https://your-technical-api.example.com
NEXT_PUBLIC_CUSTOMER_API_URL=https://your-customer-api.example.com
NEXT_PUBLIC_API_VERSION=1.0

# ------------------------------------------------------------------------------
# Sentry — error and performance monitoring (browser + Next.js server)
#
# Leave NEXT_PUBLIC_SENTRY_DSN empty to turn monitoring off entirely; the SDK
# is never initialised and the app behaves exactly as it did before.
#
# The DSN is a write-only key and is safe to ship in the browser bundle (that
# is why it is NEXT_PUBLIC_). Copy it from
#   Sentry -> Settings -> Projects -> <project> -> Client Keys (DSN)
# It looks like: https://<hash>@o<org-id>.ingest.de.sentry.io/<project-id>
NEXT_PUBLIC_SENTRY_DSN=

# Build-time only, and optional. Without it the build still succeeds — you just
# get minified stack traces in Sentry instead of real file/line numbers.
# Create at Sentry -> Settings -> Auth Tokens, scope: project:releases.
# This one is a SECRET: never prefix it with NEXT_PUBLIC_.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=cam-gg
SENTRY_PROJECT=javascript-nextjs

# Upstash Redis Cache Connection
REDIS_URL=rediss://default:your_redis_password@your-redis-host.upstash.io:6379

# Telegram Bot Notification Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Telegram Topic Identifiers
TELEGRAM_TOPIC_ITEM_RECEIVED=0
TELEGRAM_TOPIC_INSPECTING=0
TELEGRAM_TOPIC_INSPECTION=0
TELEGRAM_TOPIC_AWAITING_SPAREPART=0
TELEGRAM_TOPIC_AWAITING_CUSTOMER_CONFIRM=0
TELEGRAM_TOPIC_SALE_CONFIRMED=0
TELEGRAM_TOPIC_CUSTOMER_REJECTED=0
TELEGRAM_TOPIC_UNREPAIRABLE=0
TELEGRAM_TOPIC_SENT_SPAREPARTS=0
TELEGRAM_TOPIC_FINISHED=0

# JWT Token Validation Parameters
JWT_SECRET=YourStrongAndSecureJwtSecretKeyGoesHereMinimum32Chars!
JWT_ISSUER=https://your-issuer.example.com
JWT_AUDIENCE=https://your-audience.example.com
JWT_TOKEN_VALIDITY_HOURS=8
JWT_REFRESH_TOKEN_VALIDITY_DAYS=30

# ------------------------------------------------------------------------------
# AI Search (optional)
#
# Powers the "Ask AI" toggle in the header search. The assistant answers a
# plain-language question (English or Khmer) by actually querying the system —
# tickets, spare-part stock, customers, machines and user accounts — and then
# answering from the rows it read. It also handles general questions and
# greetings conversationally.
#
# Examples: "តើថ្ងៃនេះមានម៉ាស៊ីនចូលប៉ុន្មាន?", "Y Sophy បាន Sale Confirmed ថ្ងៃនេះ",
# "how many Roller parts are left in stock", "what can you do?"
#
# GEMINI_API_KEY is the primary provider. Get a key from
# https://aistudio.google.com/apikey — the free tier is enough for this
# feature. GOOGLE_API_KEY is accepted as an alias.
#
# MULTIPLE KEYS: separate them with commas and the route rotates through them.
#
#   GEMINI_API_KEY=first_key,second_key,third_key
#
# IMPORTANT: the free tier meters 20 requests per day, per model, PER PROJECT
# — verified from a live 429 (quotaId
# "GenerateRequestsPerDayPerProjectPerModel-FreeTier", quotaValue 20). Extra
# keys only add allowance when each one comes from a DIFFERENT Google Cloud
# project. Several keys minted in the same project share one 20-a-day bucket
# and add nothing.
#
# Budget it per REQUEST, not per question: every round of the assistant's tool
# loop is one request, so a question that looks something up costs 2-3 of the
# 20, and a greeting costs 1 (~6,600 input tokens, since the system prompt and
# all nine tool schemas go up every time). The dev log prints the running cost
# of each round.
#
# Free-tier quota is metered per model PER PROJECT (currently 20 requests/day
# each) and projects cannot be pooled, so a second key is the only way to raise
# the ceiling. The route tries every key on the strongest model before stepping
# down to a weaker one, and remembers which (key, model) pairs are spent so it
# does not re-probe them. One key still works exactly as before — a single key
# is just a list of one.
#
# Note that keys from separate Google accounts have their own quotas by design;
# check Google's terms before relying on that to multiply a free allowance.
#
# IMAGE GENERATION ("generate an image of…", "ជួយបង្កើតរូបភាព…") runs on Google's
# Nano Banana models and uses this SAME GEMINI_API_KEY — there is no separate
# key to set. It is Gemini-only: an Anthropic-only setup answers questions but
# cannot draw.
#
# It does, however, need BILLING ENABLED on the Google Cloud project behind the
# key. Unlike the text models, the image models have no free allowance at all —
# verified 2026-08-14, every one of them (Nano Banana 2 Lite included) reports:
#
#   Quota exceeded for metric: ...generate_content_free_tier_requests,
#   limit: 0, model: gemini-3.1-flash-lite-image
#
# "limit: 0" is no allowance, not a spent daily one, so on an unbilled project
# every image request is refused immediately and the assistant says so in plain
# language rather than telling the user to wait. Enable billing at
# https://console.cloud.google.com/billing and it starts working with no code
# change. Text answers are unaffected either way — they run on a separate
# free-tier allowance that is not zero.
#
# Cheapest model first, so a picture costs as little as possible:
#   gemini-3.1-flash-lite-image  Nano Banana 2 Lite  ~$0.0336/image
#   gemini-3.1-flash-image       Nano Banana 2       ~$0.0672/image
#   gemini-2.5-flash-image       Nano Banana
#   gemini-3-pro-image           Nano Banana Pro     ~$0.134/image
#
# FALLBACK — POLLINATIONS. Because Nano Banana needs billing, image generation
# falls back to Pollinations, which is what makes the feature work out of the
# box. It has two endpoints and the app uses whichever is reachable:
#
#   1. gen.pollinations.ai/image/{prompt}  — the current documented API
#      (https://gen.pollinations.ai/docs#tag/image). Needs POLLINATIONS_API_KEY
#      from https://enter.pollinations.ai/keys AND a prepaid "pollen" balance;
#      with a zero balance it answers 402 to every request. Free (not
#      paid_only) models include zimage, flux, gptimage and klein.
#   2. image.pollinations.ai/prompt/{prompt} — the older endpoint, still serves
#      anonymously. No key, no signup, no balance. This is the one that answers
#      today.
#
# The app tries (1) when a key is set and falls straight through to (2) on 401
# or 402, remembering that for 30 minutes so it costs one probe rather than a
# wasted round-trip per picture. Leaving POLLINATIONS_API_KEY blank is fine and
# simply uses (2).
#
# NOTE: (2) is the fragile half — if Pollinations retires it, keyless generation
# stops and a funded key becomes required.
#
# PRIVACY: Pollinations is an anonymous public endpoint. The prompt leaves your
# system to a third party with no account or contract behind it. Only the words
# the user typed after "draw me" are sent — never ticket, customer or parts data
# — but set AI_IMAGE_POLLINATIONS=off to disable the fallback entirely and keep
# image generation on Gemini alone.
#
# ANTHROPIC_API_KEY is used instead when no Gemini key is set. Anthropic has no
# free tier — new accounts get a one-time trial credit, then it is pay-as-you-go.
#
# Leave BOTH blank to keep the feature switched off — the toggle is hidden and
# ordinary search is completely unaffected.
#
# Server-side only: read in src/app/api/ai-search/route.ts and never exposed to
# the browser. Do NOT rename either to NEXT_PUBLIC_* — that would ship your key
# to every visitor.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional — leave blank to use the free keyless Pollinations endpoint.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=zimage
# Set to "off" to disable the Pollinations fallback entirely.
AI_IMAGE_POLLINATIONS=
