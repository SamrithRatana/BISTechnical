# ==============================================================================
# CAMPROTEC SERVICE MAINTENANCE SYSTEM - NEXT.JS ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env.local and fill in real values. .env.local is
# gitignored and never committed.

# API Base Endpoints
NEXT_PUBLIC_JWT_API_URL=https://your-user-api.example.com
NEXT_PUBLIC_TECHNICAL_API_URL=https://your-technical-api.example.com
NEXT_PUBLIC_CUSTOMER_API_URL=https://your-customer-api.example.com
NEXT_PUBLIC_API_VERSION=1.0

# Upstash Redis Cache Connection
REDIS_URL=rediss://default:your_redis_password@your-redis-host.upstash.io:6379

# Telegram Bot Notification Integration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Telegram Topic Identifiers
TELEGRAM_TOPIC_ITEM_RECEIVED=0
TELEGRAM_TOPIC_INSPECTING=0
TELEGRAM_TOPIC_INSPECTION=0
TELEGRAM_TOPIC_AWAITING_SPAREPART=0
TELEGRAM_TOPIC_AWAITING_CUSTOMER_CONFIRM=0
TELEGRAM_TOPIC_SALE_CONFIRMED=0
TELEGRAM_TOPIC_CUSTOMER_REJECTED=0
TELEGRAM_TOPIC_UNREPAIRABLE=0
TELEGRAM_TOPIC_SENT_SPAREPARTS=0
TELEGRAM_TOPIC_FINISHED=0

# JWT Token Validation Parameters
JWT_SECRET=YourStrongAndSecureJwtSecretKeyGoesHereMinimum32Chars!
JWT_ISSUER=https://your-issuer.example.com
JWT_AUDIENCE=https://your-audience.example.com
JWT_TOKEN_VALIDITY_HOURS=8
JWT_REFRESH_TOKEN_VALIDITY_DAYS=30
