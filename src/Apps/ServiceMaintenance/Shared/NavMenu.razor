@using System.Security.Claims
@using ServiceMaintenance.Models
@inject MenuService MenuService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<App> Loc
@inject IJSRuntime JSRuntime
<div class="app-sidebar-container @(IsOpen ? "is-open" : "is-closed") @(IsCollapsed ? "is-collapsed" : "")">
    <!-- ===== Sidebar Header ===== -->
    <div class="sidebar-header">
        <div class="sidebar-brand">
            <img src="images/Cam-Logo.png" alt="Cam" class="sidebar-brand-logo" />
            <span class="sidebar-brand-text">Repair & Maintenance</span>
        </div>
        <div class="sidebar-header-actions">
            <button class="sidebar-header-icon-btn collapse-toggle-btn" title="@(IsCollapsed ? "Expand" : "Collapse")" @onclick="ToggleCollapsed">
                <i class="fas @(IsCollapsed ? "fa-angle-double-right" : "fa-angle-double-left")"></i>
            </button>
            <button class="sidebar-header-icon-btn" title="Refresh" @onclick="RefreshPage" disabled="@isRefreshing">
                <i class="fas fa-sync-alt @(isRefreshing ? "fa-spin" : "")"></i>
            </button>
        </div>
    </div>
    <div class="app-sidebar" id="appSidebarScrollArea">
        <AuthorizeView>
            <Authorized Context="authorizedContext">
                @foreach (var menuSection in Sections)
                {
                    @if (!string.IsNullOrEmpty(menuSection.Title))
                    {
                        <div class="nav-section-label">@menuSection.Title</div>
                    }
                    @foreach (var item in menuSection.Items)
                    {
                        <NavLink class="nav-item" href="@item.NavigateUrl" Match="NavLinkMatch.All" ActiveClass="nav-item-active" title="@(IsCollapsed? item.Text: null)">
                            <i class="@item.IconCssClass nav-item-icon"></i>
                            <span class="nav-item-text">@item.Text</span>
                            @if (!string.IsNullOrEmpty(item.BadgeText))
                            {
                                <span class="nav-item-badge">@item.BadgeText</span>
                            }
                        </NavLink>
                    }
                }
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-item" href="/identity/account/login" Match="NavLinkMatch.All" ActiveClass="nav-item-active">
                    <i class="oi oi-lock-locked nav-item-icon"></i>
                    <span class="nav-item-text">@Loc["Login"]</span>
                </NavLink>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
@if (IsOpen)
{
    <div class="app-sidebar-backdrop" @onclick="Close"></div>
}
@code {
    [Parameter]
    public bool IsOpen { get; set; } = true;
    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }
    private bool IsCollapsed { get; set; } = false;
    private bool isRefreshing = false;
    private List<MenuSection> Sections = new();

    // ✅ REVERTED to plain OnInitializedAsync — no longer needs to be delayed
    // to OnAfterRenderAsync, since culture is now correct from the very first
    // line of the very first render (set by app.UseRequestLocalization in
    // Program.cs, before this component even starts executing).
    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var userRoles = authState.User.Claims
            .Where(c => c.Type == ClaimTypes.Role)
            .Select(c => c.Value);
        Sections = MenuService.GetMenuSections(userRoles);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initSidebarScrollFade", "#appSidebarScrollArea");
        }
    }

    private async Task Close()
    {
        IsOpen = false;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
    public async Task ToggleAsync()
    {
        IsOpen = !IsOpen;
        await IsOpenChanged.InvokeAsync(IsOpen);
    }
    private void ToggleCollapsed()
    {
        IsCollapsed = !IsCollapsed;
    }

    private void RefreshPage()
    {
        isRefreshing = true;
        StateHasChanged();
        NavigationManager.Refresh(forceReload: true);
    }
}