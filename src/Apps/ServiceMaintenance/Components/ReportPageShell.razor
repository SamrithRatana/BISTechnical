@*
    ReportPageShell.razor

    The reusable "no outer page scrollbar" wrapper extracted from the
    monthly report page. Any report page drops its own toolbar,
    filter sidebar, and body content into the three slots below and
    gets the same pinned-to-viewport behavior for free.

    Usage:

    <ReportPageShell WrapperId="dailyReportPageWrapper">
        <Toolbar>
            <DxToolbar>...</DxToolbar>
        </Toolbar>
        <FilterPanel>
            <SfSidebar ...>...</SfSidebar>
        </FilterPanel>
        <Body>
            ... quick date row, loading/empty states, ReportGroupedDocument ...
        </Body>
    </ReportPageShell>
*@
@using ServiceMaintenance.Components
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="report-page-wrapper" id="@WrapperId">

    @if (Toolbar is not null)
    {
        <div class="card-body report-shrink">
            @Toolbar
        </div>
    }

    @if (FilterPanel is not null)
    {
        @FilterPanel
    }

    <hr class="report-shrink" />

    <div class="report-frame">
        @Body
    </div>
</div>

@code {
    /// <summary>Unique DOM id for this page's wrapper (needed so JS can
    /// measure the right element if multiple report pages share a
    /// SPA session). Give each page its own value.</summary>
    [Parameter, EditorRequired]
    public string WrapperId { get; set; } = "reportPageWrapper";

    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public RenderFragment? FilterPanel { get; set; }
    [Parameter, EditorRequired] public RenderFragment Body { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("reportPageFit.init", WrapperId);
        }
    }

    /// <summary>Call after data loads / filters change if layout height
    /// might need re-measuring (mirrors the old mrPageFit.adjust call).</summary>
    public async Task ReadjustAsync()
    {
        await JSRuntime.InvokeVoidAsync("reportPageFit.adjust", WrapperId);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("reportPageFit.dispose", WrapperId);
        }
        catch (JSDisconnectedException)
        {
            // Circuit already gone (page navigation) — nothing to clean up.
        }
    }
}
