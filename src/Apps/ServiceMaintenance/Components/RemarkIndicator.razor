@using Microsoft.AspNetCore.Components.Web
@inject IJSRuntime JSRuntime

<div style="display:inline-flex; align-items:center; position:relative;">
    @if (AllowEdit)
    {
        <span class="remark-icon-wrapper"
              @onmouseenter="ShowTooltip"
              @onmouseleave="HideTooltip">
            <i class="@(HasRemark ? "fas fa-comment-dots" : "far fa-comment")"
               style="cursor:pointer; font-size:0.85rem; color:@(HasRemark ? "#007bff" : "#adb5bd");"
               title="@(HasRemark ? string.Empty : "Add remark")"
               @onclick="ToggleEdit">
            </i>
        </span>

        @if (_isEditing)
        {
            <div class="remarks-popup-overlay" @onclick="CancelEdit"></div>

            <div class="remarks-popup" style="@PopupStyle" @onclick:stopPropagation="true">
                @if (!_showCustomInput)
                {
                    <div class="remarks-preset-list">
                        @foreach (var preset in PresetRemarks)
                        {
                            <button type="button"
                                    class="remarks-preset-btn"
                                    @onclick="() => SelectPreset(preset)">
                                @preset
                            </button>
                        }
                        <button type="button"
                                class="remarks-preset-btn remarks-preset-custom"
                                @onclick="ShowCustomInputPanel">
                            <i class="fas fa-pen"></i> Custom Remarks
                        </button>
                    </div>
                }
                else
                {
                    <textarea @bind="_editValue"
                              rows="2"
                              placeholder="Add remark..."
                              autofocus></textarea>
                    <div class="remarks-popup-actions">
                        <button type="button" class="e-btn e-small e-outline"
                                @onclick="BackToPresetList" title="Back to list">
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <button type="button" class="e-btn e-small e-primary"
                                @onclick="ConfirmSave">
                            <i class="fas fa-check"></i>
                        </button>
                        <button type="button" class="e-btn e-small e-outline"
                                @onclick="CancelEdit">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                }
            </div>
        }
    }
    else if (HasRemark)
    {
        <span class="remark-icon-wrapper"
              @onmouseenter="ShowTooltip"
              @onmouseleave="HideTooltip">
            <i class="fas fa-comment-dots" style="cursor:default; font-size:0.85rem; color:#007bff;"></i>
        </span>
    }

    @if (HasRemark && _isHovered)
    {
        <div class="remarks-tooltip-fixed" style="@TooltipStyle">
            @if (RemarksUpdatedAt.HasValue)
            {
                <span class="remarks-tooltip-time">@RemarksUpdatedAt.Value.ToString("yyyy-MM-dd HH:mm")</span>
            }
            <span class="remarks-tooltip-text">@Remarks</span>
        </div>
    }
</div>

@code {
    [Parameter] public Guid SparePartId { get; set; }
    [Parameter] public string? Remarks { get; set; }
    [Parameter] public DateTime? RemarksUpdatedAt { get; set; }
    [Parameter] public bool AllowEdit { get; set; } = false;
    [Parameter] public string[] PresetRemarks { get; set; } = Array.Empty<string>();

    /// <summary>
    /// Fired when the user confirms a new remark value (preset click or custom-save).
    /// The component does NOT persist anything itself — the parent owns the actual
    /// save call, cache invalidation, SignalR broadcast, and toast, since those are
    /// page-specific concerns.
    /// </summary>
    [Parameter] public EventCallback<string> OnSave { get; set; }

    private bool HasRemark => !string.IsNullOrWhiteSpace(Remarks);

    // Tooltip state (hover-anchored, fixed to viewport)
    private bool _isHovered = false;
    private double _tooltipTop = 0;
    private double _tooltipLeft = 0;

    // Edit popup state (click-anchored, fixed to viewport)
    private bool _isEditing = false;
    private bool _showCustomInput = false;
    private string _editValue = string.Empty;
    private double _popupTop = 0;
    private double _popupLeft = 0;

    private string TooltipStyle =>
        $"top:{_tooltipTop.ToString(System.Globalization.CultureInfo.InvariantCulture)}px; " +
        $"left:{_tooltipLeft.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";

    private string PopupStyle =>
        $"top:{_popupTop.ToString(System.Globalization.CultureInfo.InvariantCulture)}px; " +
        $"left:{_popupLeft.ToString(System.Globalization.CultureInfo.InvariantCulture)}px;";

    private void ShowTooltip(MouseEventArgs e)
    {
        _tooltipLeft = e.ClientX;
        _tooltipTop = e.ClientY - 10;
        _isHovered = true;
    }

    private void HideTooltip()
    {
        _isHovered = false;
    }

    private async Task ToggleEdit(MouseEventArgs e)
    {
        if (_isEditing)
            CancelEdit();
        else
            await StartEdit(e);
    }

    private async Task StartEdit(MouseEventArgs e)
    {
        _isEditing = true;
        _editValue = Remarks ?? string.Empty;
        _showCustomInput = false;

        const double popupWidth = 190;
        const double popupHeightEstimate = 190; // 4 presets + custom button + padding

        double viewportWidth = 1200;
        double viewportHeight = 800;

        try
        {
            viewportWidth = await JSRuntime.InvokeAsync<double>("eval", "window.innerWidth");
            viewportHeight = await JSRuntime.InvokeAsync<double>("eval", "window.innerHeight");
        }
        catch
        {
            // fall back to defaults above if JS eval isn't available
        }

        _popupLeft = e.ClientX - 160;
        if (_popupLeft < 8) _popupLeft = 8;
        if (_popupLeft + popupWidth > viewportWidth - 8)
            _popupLeft = viewportWidth - popupWidth - 8;

        if (e.ClientY + 8 + popupHeightEstimate > viewportHeight)
            _popupTop = e.ClientY - popupHeightEstimate - 8;
        else
            _popupTop = e.ClientY + 8;

        if (_popupTop < 8) _popupTop = 8;
    }

    private void CancelEdit()
    {
        _isEditing = false;
        _editValue = string.Empty;
        _showCustomInput = false;
    }

    private async Task SelectPreset(string preset)
    {
        _editValue = preset;
        await ConfirmSave();
    }

    private void ShowCustomInputPanel()
    {
        _showCustomInput = true;
        _editValue = Remarks ?? string.Empty;
    }

    private void BackToPresetList()
    {
        _showCustomInput = false;
    }

    private async Task ConfirmSave()
    {
        var newValue = _editValue?.Trim() ?? string.Empty;
        _isEditing = false;
        _showCustomInput = false;

        if (newValue == (Remarks ?? string.Empty))
            return;

        if (OnSave.HasDelegate)
            await OnSave.InvokeAsync(newValue);
    }
}