@using ServiceMaintenance.Models
@using Syncfusion.Blazor.Popups

<SfDialog @ref="_dialog" Target="#target" Width="600px" IsModal="true" ShowCloseIcon="true" @bind-Visible="IsVisible">
    <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
    <DialogTemplates>
        <Header>@HeaderText</Header>
        <Content>
            <div class="report-container">
                <div class="report-body">
                    <table class="report-table">

                        @* Reference No *@
                        @if (!string.IsNullOrEmpty(Service?.reportNo))
                        {
                            <tr>
                                <td class="report-label"><strong>Ref No:</strong></td>
                                <td class="report-value">@Service.reportNo</td>
                            </tr>
                        }

                        @* Service Date + Created By *@
                        @if (Service?.ServiceDate != default(DateTime))
                        {
                            <tr>
                                <td class="report-label"><strong>Receive Date:</strong></td>
                                <td class="report-value">
                                    @Service.ServiceDate.ToString("yyyy-MM-dd HH:mm tt")
                                    @{
                                        var createdByUser = GetUserName(Service?.createby == Guid.Empty ? (Guid?)null : Service?.createby);
                                    }
                                    @if (IsRealName(createdByUser))
                                    {
                                        <span style="color: var(--text-secondary); margin-left: 8px;">| @createdByUser</span>
                                    }
                                </td>
                            </tr>
                        }

                        @* Inspect Date + Inspect By *@
                        @if (Service?.inspectDate.HasValue == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Inspection:</strong></td>
                                <td class="report-value">
                                    @Service.inspectDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                    @{
                                        var inspectByUser = GetUserName(Service?.inspectBy);
                                    }
                                    @if (IsRealName(inspectByUser))
                                    {
                                        <span style="color: var(--text-secondary); margin-left: 8px;">| @inspectByUser</span>
                                    }
                                </td>
                            </tr>
                        }

                        @* Repair Date *@
                        @if (Service?.repairDate.HasValue == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Repair Date:</strong></td>
                                <td class="report-value">@Service.repairDate.Value.ToString("yyyy-MM-dd HH:mm tt")</td>
                            </tr>
                        }

                        @* Awaiting Sparepart Date + By *@
                        @if (Service?.awaitingSparepartDate.HasValue == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Awaiting Sparepart:</strong></td>
                                <td class="report-value">
                                    @Service.awaitingSparepartDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                    @{
                                        var setByUser = GetUserName(Service?.setAwaitingSparepartBy);
                                    }
                                    @if (IsRealName(setByUser))
                                    {
                                        <span style="color: var(--text-secondary); margin-left: 8px;">| @setByUser</span>
                                    }
                                </td>
                            </tr>
                        }

                        @* Awaiting Customer Confirm Date + By *@
                        @if (Service?.awaitingCustomerConfirmDate.HasValue == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Awaiting Customer Confirm:</strong></td>
                                <td class="report-value">
                                    @Service.awaitingCustomerConfirmDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                    @{
                                        var confirmByUser = GetUserName(Service?.setAwaitingCustomerConfirmBy);
                                    }
                                    @if (IsRealName(confirmByUser))
                                    {
                                        <span style="color: var(--text-secondary); margin-left: 8px;">| @confirmByUser</span>
                                    }
                                </td>
                            </tr>
                        }

                        @* Sale Confirmed Date + By *@
                        @if (Service?.saleConfirmedDate.HasValue == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Sale Confirmed:</strong></td>
                                <td class="report-value">
                                    @Service.saleConfirmedDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                    @{
                                        var saleConfirmedByUser = GetUserName(Service?.setSaleConfirmedBy);
                                    }
                                    @if (IsRealName(saleConfirmedByUser))
                                    {
                                        <span style="color: var(--text-secondary); margin-left: 8px;">| @saleConfirmedByUser</span>
                                    }
                                </td>
                            </tr>
                        }

                        @* Customer Rejected Date + By *@
                        @if (Service?.customerRejectedDate.HasValue == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Customer Rejected:</strong></td>
                                <td class="report-value">
                                    @Service.customerRejectedDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                    @{
                                        var rejectedByUser = GetUserName(Service?.setCustomerRejectedBy);
                                    }
                                    @if (IsRealName(rejectedByUser))
                                    {
                                        <span style="color: var(--text-secondary); margin-left: 8px;">| @rejectedByUser</span>
                                    }
                                </td>
                            </tr>
                        }

                        @* Unrepairable Date + By *@
                        @if (Service?.unrepairableDate.HasValue == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Unrepairable:</strong></td>
                                <td class="report-value">
                                    @Service.unrepairableDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                    @{
                                        var unrepairableByUser = GetUserName(Service?.setUnrepairableBy);
                                    }
                                    @if (IsRealName(unrepairableByUser))
                                    {
                                        <span style="color: var(--text-secondary); margin-left: 8px;">| @unrepairableByUser</span>
                                    }
                                </td>
                            </tr>
                        }

                        @* Finish Date *@
                        @if (Service?.finishedDate.HasValue == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Finish Date:</strong></td>
                                <td class="report-value">@Service.finishedDate.Value.ToString("yyyy-MM-dd HH:mm tt")</td>
                            </tr>
                        }

                        @* Days Taken *@
                        @if (Service?.DaysTaken.HasValue == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Days Taken:</strong></td>
                                <td class="report-value">@Service.DaysTaken.Value days</td>
                            </tr>
                        }

                        <!-- ព័ត៍មានអតិថិជន -->
                        <tr class="report-section-header">
                            <td colspan="2" style="background: #f1f5f9; padding: 9px 14px; font-weight: 700; color: #0f172a; font-size: 13.5px; border-top: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1;">
                                <i class="fas fa-building text-primary me-1"></i> ព័ត៍មានអតិថិជន
                            </td>
                        </tr>

                        @if (!string.IsNullOrEmpty(Service?.CompanyName))
                        {
                            <tr>
                                <td class="report-label"><strong>Company Name:</strong></td>
                                <td class="report-value">@Service.CompanyName</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.Address))
                        {
                            <tr>
                                <td class="report-label"><strong>Address:</strong></td>
                                <td class="report-value">@Service.Address</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.ContactName))
                        {
                            <tr>
                                <td class="report-label"><strong>Contact Name:</strong></td>
                                <td class="report-value">@Service.ContactName</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.PhoneNumber))
                        {
                            <tr>
                                <td class="report-label"><strong>Phone Number:</strong></td>
                                <td class="report-value">@Service.PhoneNumber</td>
                            </tr>
                        }

                        <!-- ពត័មានម៉ាស៊ីន -->
                        <tr class="report-section-header">
                            <td colspan="2" style="background: #f1f5f9; padding: 9px 14px; font-weight: 700; color: #0f172a; font-size: 13.5px; border-top: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1;">
                                <i class="fas fa-print text-primary me-1"></i> ពត័មានម៉ាស៊ីន
                            </td>
                        </tr>

                        @if (!string.IsNullOrEmpty(Service?.itemName))
                        {
                            <tr>
                                <td class="report-label"><strong>Item Name:</strong></td>
                                <td class="report-value">@Service.itemName</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.serialNumber))
                        {
                            <tr>
                                <td class="report-label"><strong>Serial Number:</strong></td>
                                <td class="report-value">@Service.serialNumber</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.CustomerRequest))
                        {
                            <tr>
                                <td class="report-label"><strong>Customer Request:</strong></td>
                                <td class="report-value">@Service.CustomerRequest</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.Inspection))
                        {
                            <tr>
                                <td class="report-label"><strong>Inspection:</strong></td>
                                <td class="report-value">@Service.Inspection</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.Solution))
                        {
                            <tr>
                                <td class="report-label"><strong>Solution:</strong></td>
                                <td class="report-value">@Service.Solution</td>
                            </tr>
                        }

                        <!-- ពត័មានស្ថានភាពជួសជុល -->
                        <tr class="report-section-header">
                            <td colspan="2" style="background: #f1f5f9; padding: 9px 14px; font-weight: 700; color: #0f172a; font-size: 13.5px; border-top: 1px solid #cbd5e1; border-bottom: 1px solid #cbd5e1;">
                                <i class="fas fa-tools text-primary me-1"></i> ពត័មានស្ថានភាពជួសជុល
                            </td>
                        </tr>

                        @if (!string.IsNullOrEmpty(Service?.ServiceLocation))
                        {
                            <tr>
                                <td class="report-label"><strong>Service Location:</strong></td>
                                <td class="report-value">@Service.ServiceLocation</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.ServiceType))
                        {
                            <tr>
                                <td class="report-label"><strong>Service Type:</strong></td>
                                <td class="report-value">@Service.ServiceType</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.ServicePriority))
                        {
                            <tr>
                                <td class="report-label"><strong>Priority:</strong></td>
                                <td class="report-value">@Service.ServicePriority</td>
                            </tr>
                        }
                        @if (!string.IsNullOrEmpty(Service?.Status))
                        {
                            <tr>
                                <td class="report-label"><strong>Status:</strong></td>
                                <td class="report-value">@Service.Status</td>
                            </tr>
                        }

                        <tr>
                            <td class="report-label"><strong>Contract:</strong></td>
                            <td class="report-value">@(Service?.hasContract == true ? "Yes" : "No")</td>
                        </tr>

                        @if (Service?.isThirdPartyRepair == true)
                        {
                            <tr>
                                <td class="report-label"><strong>Third-Party Repair:</strong></td>
                                <td class="report-value">Yes</td>
                            </tr>
                        }

                        @if (Service?.repairBy.HasValue == true && Service.repairBy.Value != Guid.Empty)
                        {
                            <tr>
                                <td class="report-label"><strong>Repair By:</strong></td>
                                <td class="report-value">@GetUserName(Service.repairBy)</td>
                            </tr>
                        }

                    </table>

                    @* Spare Parts Table *@
                    @if (Service?.SparePartItems != null && Service.SparePartItems.Count > 0)
                    {
                        <hr />
                        <h4 style="font-size:0.95rem; font-weight:700; margin-bottom:8px;">
                            <i class="fas fa-tools" style="color:#007bff;"></i> SparePart Details
                        </h4>
                        <div style="overflow-x:auto; overflow-y:visible; width:100%;">
                            <table style="width:100%; border-collapse:collapse; font-size:0.78rem; table-layout:fixed;">
                                <colgroup>
                                    <col style="width:52px;" />
                                    <col style="width:22%;" />
                                    <col style="width:22%;" />
                                    <col style="width:36px;" />
                                    <col style="width:70px;" />
                                    @if (ShowPricing)
                                    {
                                        <col style="width:75px;" />
                                    }
                                    <col style="width:110px;" />
                                </colgroup>
                                <thead>
                                    <tr style="background:#007bff; color:#fff;">
                                        <th style="padding:6px 4px; text-align:center;">Img</th>
                                        <th style="padding:6px 6px; text-align:left;">Item Name</th>
                                        <th style="padding:6px 6px; text-align:left;">Use For</th>
                                        <th style="padding:6px 4px; text-align:center;">Qty</th>
                                        <th style="padding:6px 4px; text-align:center;">Condition</th>
                                        @if (ShowPricing)
                                        {
                                            <th style="padding:6px 4px; text-align:right;">Price</th>
                                        }
                                        <th style="padding:6px 4px; text-align:center;">Stock Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var sparePart in Service.SparePartItems)
                                    {
                                        var sparePartObject = SpareParts?.FirstOrDefault(x => x.Id == sparePart.SparePartId);
                                        var stockQty = sparePartObject?.Quantity ?? 0;

                                        string stockLabel, stockBg, stockFg;
                                        if (sparePart.Condition == "Fix")
                                        {
                                            stockLabel = "ជួសជុលមិនកាត់ស្តុក";
                                            stockBg = "#6f42c1"; stockFg = "#fff";
                                        }
                                        else if (stockQty <= 0)
                                        {
                                            stockLabel = "OUT OF STOCK";
                                            stockBg = "#dc3545"; stockFg = "#fff";
                                        }
                                        else
                                        {
                                            stockLabel = "IN STOCK";
                                            stockBg = "#28a745"; stockFg = "#fff";
                                        }

                                        <tr style="border-bottom:1px solid #f0f0f0;">
                                            <td style="padding:5px 4px; text-align:center; vertical-align:middle;">
                                                @if (sparePartObject != null && !string.IsNullOrEmpty(sparePartObject.PictureUrl))
                                                {
                                                    <img src="@sparePartObject.PictureUrl" alt="img"
                                                         style="width:40px; height:40px; object-fit:cover; border-radius:5px; border:1px solid #ddd;" />
                                                }
                                                else
                                                {
                                                    <div style="width:40px; height:40px; background:#f5f5f5; border-radius:5px;
                                                                            border:1px solid #ddd; display:flex; align-items:center;
                                                                            justify-content:center; margin:auto;">
                                                        <i class="fas fa-image" style="color:#ccc;"></i>
                                                    </div>
                                                }
                                            </td>
                                            <td style="padding:5px 6px; vertical-align:middle; font-weight:500;
                                                               overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                                title="@(sparePartObject?.ItemName ?? sparePart.ItemName)">
                                                @(sparePartObject?.ItemName ?? sparePart.ItemName ?? "—")
                                            </td>
                                            <td style="padding:5px 6px; vertical-align:middle; color:#555;
                                                               overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                                title="@(sparePartObject?.UseFor ?? sparePart.UseFor)">
                                                @(sparePartObject?.UseFor ?? sparePart.UseFor ?? "—")
                                            </td>
                                            <td style="padding:5px 4px; text-align:center; vertical-align:middle; font-weight:700;">
                                                @sparePart.Quantity
                                            </td>
                                            <td style="padding:5px 4px; text-align:center; vertical-align:middle;">
                                                @if (!string.IsNullOrEmpty(sparePart.Condition))
                                                {
                                                    <span style="background:#e9ecef; padding:2px 6px; border-radius:8px;
                                                                             font-size:0.72rem; color:#495057;">
                                                        @sparePart.Condition
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span style="color:#aaa;">—</span>
                                                }
                                            </td>
                                            @if (ShowPricing)
                                            {
                                                <td style="padding:5px 4px; text-align:right; vertical-align:middle;
                                                                       font-weight:600; color:#28a745; white-space:nowrap;">
                                                    @if (sparePartObject != null)
                                                    {
                                                        <span>$@sparePartObject.DefaultPrice.ToString("N2")</span>
                                                    }
                                                    else
                                                    {
                                                        <span style="color:#aaa;">—</span>
                                                    }
                                                </td>
                                            }
                                            <td style="padding:5px 4px; text-align:center; vertical-align:middle; position:relative;">
                                                <div style="display:inline-flex; align-items:center; gap:3px; position:relative;">
                                                    <span class="stock-status-badge"
                                                          style="background:@stockBg; color:@stockFg;
                                                                  padding:2px 8px; border-radius:8px; font-size:0.7rem;
                                                                  font-weight:700; white-space:nowrap; display:inline-block;
                                                                  position:relative; cursor:default;">
                                                        @stockLabel
                                                        <span class="stock-qty-tooltip">@stockQty in stock</span>
                                                    </span>

                                                    @if (ShowRemarks)
                                                    {
                                                        <RemarkIndicator SparePartId="@sparePart.Id"
                                                                         Remarks="@sparePart.Remarks"
                                                                         RemarksUpdatedAt="@sparePart.RemarksUpdatedAt"
                                                                         AllowEdit="false" />
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr style="background:#f8f9fa; font-weight:700; border-top:2px solid #dee2e6;">
                                        <td colspan="3" style="padding:6px 8px; text-align:right; color:#555; font-size:0.8rem;">Total:</td>
                                        <td style="padding:6px 4px; text-align:center;">
                                            @Service.SparePartItems.Sum(x => x.Quantity)
                                        </td>
                                        <td></td>
                                        @if (ShowPricing)
                                        {
                                            <td style="padding:6px 4px; text-align:right; color:#28a745; white-space:nowrap;">
                                                @{
                                                    var grandTotal = Service.SparePartItems.Sum(sp =>
                                                    {
                                                        var obj = SpareParts?.FirstOrDefault(x => x.Id == sp.SparePartId);
                                                        return (obj?.DefaultPrice ?? 0) * sp.Quantity;
                                                    });
                                                }
                                                $@grandTotal.ToString("N2")
                                            </td>
                                        }
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Close" IsPrimary="true" OnClick="@Close" />
    </DialogButtons>
</SfDialog>

<style>
    .stock-status-badge {
        position: relative;
    }

    .stock-qty-tooltip {
        visibility: hidden;
        opacity: 0;
        background-color: rgba(0, 0, 0, 0.75);
        color: #fff;
        text-align: center;
        border-radius: 5px;
        padding: 3px 7px;
        font-size: 0.68rem;
        font-weight: 500;
        white-space: nowrap;
        position: absolute;
        bottom: 130%;
        left: 50%;
        transform: translateX(-50%);
        transition: opacity 0.2s ease;
        z-index: 100;
        pointer-events: none;
    }

        .stock-qty-tooltip::after {
            content: "";
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 4px solid transparent;
            border-top-color: rgba(0, 0, 0, 0.75);
        }

    .stock-status-badge:hover .stock-qty-tooltip {
        visibility: visible;
        opacity: 1;
    }
</style>

@code {
    private SfDialog _dialog;

    /// <summary>The record to display. Every row is conditional on the field
    /// being present, so pages that populate fewer fields (e.g. monthly-report)
    /// simply render fewer rows — no per-page markup branching needed.</summary>
    [Parameter] public RepairServices Service { get; set; }

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter] public IEnumerable<SparePartObject> SpareParts { get; set; } = Enumerable.Empty<SparePartObject>();

    /// <summary>Resolves a user id to a display name. Pass the page's existing
    /// GetUserNameById method group directly.</summary>
    [Parameter] public Func<Guid?, string> GetUserName { get; set; } = _ => "Unknown";

    [Parameter] public string HeaderText { get; set; } = "View Info";

    /// <summary>Show the Price column / grand total in the spare-parts table.</summary>
    [Parameter] public bool ShowPricing { get; set; } = true;

    /// <summary>Show the RemarkIndicator next to each stock badge.</summary>
    [Parameter] public bool ShowRemarks { get; set; } = false;

    [Parameter] public EventCallback OnClose { get; set; }

    private static bool IsRealName(string name) =>
        !string.IsNullOrEmpty(name) && name != "Unknown" && name != "Unknown User" && name != "Loading...";

    private async Task Close()
    {
        IsVisible = false;
        await IsVisibleChanged.InvokeAsync(false);
        if (OnClose.HasDelegate) await OnClose.InvokeAsync();
    }

    private async Task OverlayClick(OverlayModalClickEventArgs args) => await Close();
}