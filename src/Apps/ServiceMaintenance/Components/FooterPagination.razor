@* 
   Reusable pagination bar that renders itself inside the shared app footer.
   Drop this on any page with a paged grid — no markup duplication needed.
*@
<FooterPortal>
    <div class="footer-pagination-bar">
        <div class="footer-pagination-controls">
            <button class="footer-page-btn" @onclick="HandleFirst" disabled="@(CurrentPage <= 1)" title="First page">
                <i class="fas fa-angle-double-left"></i>
            </button>
            <button class="footer-page-btn" @onclick="HandlePrevious" disabled="@(CurrentPage <= 1)" title="Previous page">
                <i class="fas fa-angle-left"></i>
            </button>

            <span class="footer-page-info">Page @CurrentPage of @(TotalPages == 0 ? 1 : TotalPages)</span>

            <button class="footer-page-btn" @onclick="HandleNext" disabled="@(CurrentPage >= TotalPages)" title="Next page">
                <i class="fas fa-angle-right"></i>
            </button>
            <button class="footer-page-btn" @onclick="HandleLast" disabled="@(CurrentPage >= TotalPages)" title="Last page">
                <i class="fas fa-angle-double-right"></i>
            </button>

            @if (PageSizeOptions is { Length: > 0 })
            {
                <select class="footer-page-size-select" value="@PageSize" @onchange="HandlePageSizeChanged">
                    @foreach (var size in PageSizeOptions)
                    {
                        <option value="@size">@size / page</option>
                    }
                </select>
            }
        </div>

        <div class="footer-pagination-summary">
            Showing @StartItem - @EndItem of @TotalItems items
        </div>
    </div>
</FooterPortal>

@code {
    [Parameter, EditorRequired] public int CurrentPage { get; set; }
    [Parameter, EditorRequired] public int TotalPages { get; set; }
    [Parameter, EditorRequired] public int TotalItems { get; set; }
    [Parameter, EditorRequired] public int PageSize { get; set; }

    [Parameter, EditorRequired] public EventCallback OnFirstPage { get; set; }
    [Parameter, EditorRequired] public EventCallback OnPreviousPage { get; set; }
    [Parameter, EditorRequired] public EventCallback OnNextPage { get; set; }
    [Parameter, EditorRequired] public EventCallback OnLastPage { get; set; }

    // Optional — only pages that support changing page size need to pass these
    [Parameter] public int[] PageSizeOptions { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }

    private int StartItem => TotalItems == 0 ? 0 : Math.Min((CurrentPage - 1) * PageSize + 1, TotalItems);
    private int EndItem => Math.Min(CurrentPage * PageSize, TotalItems);

    private Task HandleFirst() => OnFirstPage.InvokeAsync();
    private Task HandlePrevious() => OnPreviousPage.InvokeAsync();
    private Task HandleNext() => OnNextPage.InvokeAsync();
    private Task HandleLast() => OnLastPage.InvokeAsync();

    private Task HandlePageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
            return OnPageSizeChanged.InvokeAsync(size);
        return Task.CompletedTask;
    }
}