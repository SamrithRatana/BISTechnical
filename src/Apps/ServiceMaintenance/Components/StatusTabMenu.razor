@* Shared/StatusTabMenu.razor *@
@* Styles moved to: wwwroot/css/components-repair-service.css (.tab-menu, .tab-item, .tab-count) *@
<div class="tab-menu">
    @foreach (var tab in Tabs)
    {
        <button type="button"
                class="tab-item @(ActiveTabKey == tab.Key ? "active" : "")"
                @onclick="() => HandleTabClick(tab.Key)">
            @tab.Label <span class="tab-count">(@tab.Count)</span>
        </button>
    }
</div>
@code {
    [Parameter] public List<TabItem> Tabs { get; set; } = new();
    [Parameter] public string ActiveTabKey { get; set; }
    [Parameter] public EventCallback<string> ActiveTabKeyChanged { get; set; }
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }
    private async Task HandleTabClick(string key)
    {
        if (ActiveTabKey == key) return;
        ActiveTabKey = key;
        await ActiveTabKeyChanged.InvokeAsync(key);
        await OnTabChanged.InvokeAsync(key);
    }
    public class TabItem
    {
        public string Key { get; set; }
        public string Label { get; set; }
        public int Count { get; set; }
    }
}
