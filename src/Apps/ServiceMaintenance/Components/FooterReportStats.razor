@*
    Reusable stats/grand-total bar that renders itself inside the shared
    app footer — same pattern as FooterPagination. Drop this on any report
    page that builds a List<ReportSummaryStat>, and pass a grand total
    label/value if you want one pinned on the right as a highlighted pill.
*@
@using ServiceMaintenance.Components

<FooterPortal>
    <div class="footer-stats-bar">
        @foreach (var stat in Stats)
        {
            <span class="footer-stat-pill">@stat.Label: @stat.Value</span>
        }
        @if (!string.IsNullOrWhiteSpace(GrandTotalLabel))
        {
            <span class="footer-stat-pill is-grand-total">@GrandTotalLabel @GrandTotalValue</span>
        }
    </div>
</FooterPortal>

@code {
    [Parameter, EditorRequired] public List<ReportSummaryStat> Stats { get; set; } = new();

    // Optional — only pages that want a highlighted grand-total pill need to pass these
    [Parameter] public string GrandTotalLabel { get; set; }
    [Parameter] public int GrandTotalValue { get; set; }

}
