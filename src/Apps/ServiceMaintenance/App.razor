<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    @if (Navigation != null)
                    {
                       // Navigation.NavigateTo("https://technicalsystemservices.koompi.cloud/identity/account/login", true);
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@* ✅ REMOVED — the @using System.Globalization, @inject ILocalStorageService,
   and the @code block with OnAfterRenderAsync/_hasInitializedCulture.
   Culture is now set by app.UseRequestLocalization(...) in Program.cs, which
   reads the ".AspNetCore.Culture" cookie and sets CultureInfo.CurrentCulture/
   CurrentUICulture BEFORE this component (or any component, including NavMenu)
   ever renders. Setting culture again here, after the fact, was both redundant
   and the actual source of the sidebar-vs-content race: this code ran in
   OnAfterRenderAsync, which is strictly LATER than NavMenu's OnInitializedAsync,
   so NavMenu had already built its Sections list with the wrong culture by the
   time this ran. *@