@page "/admin/theme-settings"
@using ServiceMaintenance.Services
@attribute [Authorize(Roles = "Admin, SuperAdmin")]
@inject AppThemeService ThemeService
@inject IJSRuntime JSRuntime
@implements IDisposable

<PageTitle>Theme Playground — ServiceMaintenance</PageTitle>

<!-- Page Header -->
<div class="ts-page-header">
    <div class="ts-page-header-content">
        <div class="ts-page-header-left">
            <div class="ts-page-header-icon"><i class="fas fa-palette"></i></div>
            <div>
                <h3 class="ts-page-title">Theme Playground</h3>
                <p class="ts-page-subtitle">Customize every visual aspect of your ServiceMaintenance system in real time.</p>
            </div>
        </div>
        <div class="ts-page-header-actions">
            <!-- Quick Mode Toggle -->
            <button class="ts-btn ts-btn-ghost" @onclick="ToggleQuickMode">
                <i class="fas @(IsDarkMode ? "fa-moon" : "fa-sun") me-2"></i>
                <span>@(IsDarkMode ? "DARK MODE" : "LIGHT MODE")</span>
            </button>
            <button class="ts-btn ts-btn-ghost" @onclick="ResetToDefaults" title="Reset theme to light default">
                <i class="fas fa-undo me-2"></i> Reset
            </button>
            <button class="ts-btn ts-btn-primary" @onclick="SaveAllSettings">
                <i class="fas fa-check me-2"></i> Save Changes
            </button>
        </div>
    </div>
</div>

<!-- Main Playground Grid Layout (Side by Side) -->
<div class="ts-main-layout">

    <!-- LEFT: Controls Panel -->
    <div class="ts-controls-panel">

        <!-- Navigation Tabs -->
        <div class="ts-tabs-wrapper mb-3" style="padding: 0;">
            <div class="ts-tabs">
                <button class="ts-tab @(ActiveTab == "themes" ? "active" : "")" @onclick='() => ActiveTab = "themes"'>
                    <i class="fas fa-layer-group me-1"></i> Preset Themes
                </button>
                <button class="ts-tab @(ActiveTab == "colors" ? "active" : "")" @onclick='() => ActiveTab = "colors"'>
                    <i class="fas fa-paint-brush me-1"></i> Colors
                </button>
                <button class="ts-tab @(ActiveTab == "components" ? "active" : "")" @onclick='() => ActiveTab = "components"'>
                    <i class="fas fa-shapes me-1"></i> Components
                </button>
            </div>
        </div>

        <!-- === PRESETS TAB === -->
        @if (ActiveTab == "themes")
        {
            <div class="ts-section">
                <div class="ts-section-header">
                    <i class="fas fa-swatchbook"></i>
                    <div>
                        <h5 class="ts-section-title">Choose a Preset Theme</h5>
                        <p class="ts-section-desc">Select a built-in color palette as your base theme. You can fine-tune afterwards.</p>
                    </div>
                </div>
                <div class="ts-preset-grid">
                    @foreach (var preset in Presets)
                    {
                        <div class="ts-preset-tile @(ThemeService.CurrentTheme.Mode == preset.Mode ? "active" : "")"
                             @onclick="() => SelectPresetMode(preset.Mode)">
                            <div class="ts-preset-swatch" style="background: @preset.Gradient;"></div>
                            <div class="ts-preset-label">
                                <span class="ts-preset-name">@preset.Name</span>
                                <span class="ts-preset-tag @(preset.IsDark ? "ts-tag-dark" : "ts-tag-light")">
                                    @(preset.IsDark ? "DARK" : "LIGHT")
                                </span>
                            </div>
                            @if (ThemeService.CurrentTheme.Mode == preset.Mode)
                            {
                                <div class="ts-preset-check"><i class="fas fa-check"></i></div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <!-- === COLORS TAB === -->
        @if (ActiveTab == "colors")
        {
            <div class="ts-section">
                <div class="ts-section-header">
                    <i class="fas fa-eye-dropper"></i>
                    <div>
                        <h5 class="ts-section-title">Brand & Accent Colors</h5>
                        <p class="ts-section-desc">Pick from curated swatches or use a custom hex color for your organization's branding.</p>
                    </div>
                </div>

                <!-- Quick Swatches -->
                <div class="ts-control-group">
                    <label class="ts-label">Quick Color Swatches</label>
                    <div class="ts-swatches">
                        @foreach (var color in ColorSwatches)
                        {
                            <button class="ts-swatch @(ThemeService.CurrentTheme.PrimaryColor.Equals(color, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                    style="background-color: @color;"
                                    title="@color"
                                    @onclick="() => SetPrimaryColor(color)">
                                @if (ThemeService.CurrentTheme.PrimaryColor.Equals(color, StringComparison.OrdinalIgnoreCase))
                                {
                                    <i class="fas fa-check"></i>
                                }
                            </button>
                        }
                    </div>
                </div>

                <!-- Color Pickers -->
                <div class="ts-color-pickers">
                    <div class="ts-color-pick-item">
                        <label class="ts-label">Primary Accent Color</label>
                        <div class="ts-color-input-row">
                            <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.PrimaryColor" @bind:after="ApplyCustomColors" />
                            <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.PrimaryColor" @bind:after="ApplyCustomColors" placeholder="#1FA9D3" />
                            <div class="ts-color-dot" style="background-color: @ThemeService.CurrentTheme.PrimaryColor;"></div>
                        </div>
                    </div>

                    <div class="ts-color-pick-item">
                        <label class="ts-label">Secondary / Hover Color</label>
                        <div class="ts-color-input-row">
                            <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.SecondaryColor" @bind:after="ApplyCustomColors" />
                            <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.SecondaryColor" @bind:after="ApplyCustomColors" placeholder="#007bff" />
                            <div class="ts-color-dot" style="background-color: @ThemeService.CurrentTheme.SecondaryColor;"></div>
                        </div>
                    </div>

                    <div class="ts-color-pick-item">
                        <label class="ts-label">Table / Grid Header Background</label>
                        <div class="ts-color-input-row">
                            <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.HeaderBg" @bind:after="ApplyCustomColors" />
                            <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.HeaderBg" @bind:after="ApplyCustomColors" placeholder="#1FA9D3" />
                            <div class="ts-color-dot" style="background-color: @ThemeService.CurrentTheme.HeaderBg;"></div>
                        </div>
                    </div>

                    <div class="ts-color-pick-item">
                        <label class="ts-label">Accent / Highlight Color</label>
                        <div class="ts-color-input-row">
                            <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.AccentColor" @bind:after="ApplyCustomColors" />
                            <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.AccentColor" @bind:after="ApplyCustomColors" placeholder="#20c997" />
                            <div class="ts-color-dot" style="background-color: @ThemeService.CurrentTheme.AccentColor;"></div>
                        </div>
                    </div>

                    <div class="ts-color-pick-item">
                        <label class="ts-label">Main Text / Font Color</label>
                        <div class="ts-color-input-row">
                            <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.TextPrimary" @bind:after="ApplyCustomColors" />
                            <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.TextPrimary" @bind:after="ApplyCustomColors" placeholder="#f1f5f9" />
                            <div class="ts-color-dot" style="background-color: @ThemeService.CurrentTheme.TextPrimary;"></div>
                        </div>
                    </div>

                    <div class="ts-color-pick-item">
                        <label class="ts-label">Secondary / Muted Text Color</label>
                        <div class="ts-color-input-row">
                            <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.TextSecondary" @bind:after="ApplyCustomColors" />
                            <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.TextSecondary" @bind:after="ApplyCustomColors" placeholder="#94a3b8" />
                            <div class="ts-color-dot" style="background-color: @ThemeService.CurrentTheme.TextSecondary;"></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- === COMPONENTS TAB === -->
        @if (ActiveTab == "components")
        {
            <div class="ts-section">
                <div class="ts-section-header">
                    <i class="fas fa-ruler-combined"></i>
                    <div>
                        <h5 class="ts-section-title">Component Shape & Density</h5>
                        <p class="ts-section-desc">Control button corners, table row padding, card radius, and base font size across all UI components.</p>
                    </div>
                </div>

                <!-- Button Radius -->
                <div class="ts-control-group">
                    <div class="ts-control-label-row">
                        <label class="ts-label">Button Corner Radius</label>
                        <span class="ts-value-badge">@(ThemeService.CurrentTheme.ButtonRadiusPx)px</span>
                    </div>
                    <div class="ts-chip-row">
                        @foreach (var (label, val) in new[] { ("Sharp", 0), ("Slight", 4), ("Standard", 6), ("Soft", 12), ("Pill", 20) })
                        {
                            <button class="ts-chip @(ThemeService.CurrentTheme.ButtonRadiusPx == val ? "active" : "")"
                                    @onclick="() => SetButtonRadius(val)">@label</button>
                        }
                    </div>
                    <input type="range" class="ts-range" min="0" max="24" step="1"
                           @bind="ThemeService.CurrentTheme.ButtonRadiusPx" @bind:after="ApplyCustomColors" />
                    <div class="ts-range-labels"><span>0px</span><span>24px</span></div>
                </div>

                <!-- Card Radius -->
                <div class="ts-control-group">
                    <div class="ts-control-label-row">
                        <label class="ts-label">Card / Panel Corner Radius</label>
                        <span class="ts-value-badge">@(ThemeService.CurrentTheme.BorderRadiusPx)px</span>
                    </div>
                    <input type="range" class="ts-range" min="0" max="24" step="2"
                           @bind="ThemeService.CurrentTheme.BorderRadiusPx" @bind:after="ApplyCustomColors" />
                    <div class="ts-range-labels"><span>0px (Square)</span><span>24px (Round)</span></div>
                </div>

                <!-- Table Density -->
                <div class="ts-control-group">
                    <div class="ts-control-label-row">
                        <label class="ts-label">Table Row Density</label>
                        <span class="ts-value-badge">@(ThemeService.CurrentTheme.TablePaddingPx)px padding</span>
                    </div>
                    <div class="ts-density-cards">
                        <div class="ts-density-card @(ThemeService.CurrentTheme.TablePaddingPx == 4 ? "active" : "")" @onclick="() => SetTablePadding(4)">
                            <div class="ts-density-lines ts-density-compact">
                                <span></span><span></span><span></span>
                            </div>
                            <div class="ts-density-label">Compact</div>
                            <div class="ts-density-px">4px</div>
                        </div>
                        <div class="ts-density-card @(ThemeService.CurrentTheme.TablePaddingPx == 8 ? "active" : "")" @onclick="() => SetTablePadding(8)">
                            <div class="ts-density-lines ts-density-standard">
                                <span></span><span></span><span></span>
                            </div>
                            <div class="ts-density-label">Standard</div>
                            <div class="ts-density-px">8px</div>
                        </div>
                        <div class="ts-density-card @(ThemeService.CurrentTheme.TablePaddingPx == 14 ? "active" : "")" @onclick="() => SetTablePadding(14)">
                            <div class="ts-density-lines ts-density-spacious">
                                <span></span><span></span><span></span>
                            </div>
                            <div class="ts-density-label">Spacious</div>
                            <div class="ts-density-px">14px</div>
                        </div>
                    </div>
                </div>

                <!-- Table Radius -->
                <div class="ts-control-group">
                    <div class="ts-control-label-row">
                        <label class="ts-label">Table Corner Radius</label>
                        <span class="ts-value-badge">@(ThemeService.CurrentTheme.TableRadiusPx)px</span>
                    </div>
                    <input type="range" class="ts-range" min="0" max="16" step="1"
                           @bind="ThemeService.CurrentTheme.TableRadiusPx" @bind:after="ApplyCustomColors" />
                    <div class="ts-range-labels"><span>0px</span><span>16px</span></div>
                </div>

                <!-- Font Size -->
                <div class="ts-control-group">
                    <div class="ts-control-label-row">
                        <label class="ts-label">Base Font Size</label>
                        <span class="ts-value-badge">@(ThemeService.CurrentTheme.BaseFontSizePx)px</span>
                    </div>
                    <div class="ts-chip-row">
                        @foreach (var (label, val) in new[] { ("12px Small", 12), ("14px Default", 14), ("16px Large", 16) })
                        {
                            <button class="ts-chip @(ThemeService.CurrentTheme.BaseFontSizePx == val ? "active" : "")"
                                    @onclick="() => SetFontSize(val)">@label</button>
                        }
                    </div>
                    <input type="range" class="ts-range" min="12" max="18" step="1"
                           @bind="ThemeService.CurrentTheme.BaseFontSizePx" @bind:after="ApplyCustomColors" />
                    <div class="ts-range-labels"><span>12px</span><span>18px</span></div>
                </div>
            </div>
        }
    </div>

    <!-- RIGHT: Live Preview Panel with Interactive Component Click-to-Edit -->
    <div class="ts-preview-panel">
        <div class="ts-preview-sticky">
            <div class="ts-preview-header">
                <div class="ts-preview-header-left">
                    <div class="ts-live-dot"></div>
                    <span class="ts-preview-title">Live Preview</span>
                    <small class="text-muted ms-2">(Click any component below to edit directly)</small>
                </div>
                <span class="ts-preview-mode-chip">@ThemeService.CurrentTheme.Mode</span>
            </div>

            <!-- DYNAMIC COMPONENT INSPECTOR POPOVER CARD -->
            @if (!string.IsNullOrEmpty(SelectedElement))
            {
                <div class="ts-inspector-card">
                    <div class="ts-inspector-header">
                        <div class="ts-inspector-title">
                            <i class="fas fa-sliders-h text-info"></i>
                            @GetInspectorTitle(SelectedElement)
                        </div>
                        <button class="ts-inspector-save-btn" @onclick="DeselectElement" title="Save changes">
                            <i class="fas fa-check me-1"></i> Save
                        </button>
                    </div>

                    <!-- BUTTONS INSPECTOR -->
                    @if (SelectedElement == "buttons")
                    {
                        <div class="ts-inspector-grid">
                            <div class="ts-color-pick-item">
                                <label class="ts-label">Primary Button Color</label>
                                <div class="ts-color-input-row">
                                    <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.PrimaryColor" @bind:after="ApplyCustomColors" />
                                    <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.PrimaryColor" @bind:after="ApplyCustomColors" />
                                </div>
                            </div>
                            <div class="ts-color-pick-item">
                                <label class="ts-label">Secondary / Hover Color</label>
                                <div class="ts-color-input-row">
                                    <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.SecondaryColor" @bind:after="ApplyCustomColors" />
                                    <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.SecondaryColor" @bind:after="ApplyCustomColors" />
                                </div>
                            </div>
                            <div class="ts-control-group">
                                <label class="ts-label">Button Corner Radius (@(ThemeService.CurrentTheme.ButtonRadiusPx)px)</label>
                                <div class="ts-chip-row mb-2">
                                    @foreach (var (label, val) in new[] { ("Sharp", 0), ("Slight", 4), ("Standard", 6), ("Soft", 12), ("Pill", 20) })
                                    {
                                        <button class="ts-chip @(ThemeService.CurrentTheme.ButtonRadiusPx == val ? "active" : "")"
                                                @onclick="() => SetButtonRadius(val)">@label</button>
                                    }
                                </div>
                                <input type="range" class="ts-range" min="0" max="24" step="1"
                                       @bind="ThemeService.CurrentTheme.ButtonRadiusPx" @bind:after="ApplyCustomColors" />
                            </div>
                        </div>
                    }

                    <!-- HEADER INSPECTOR -->
                    @if (SelectedElement == "header")
                    {
                        <div class="ts-inspector-grid">
                            <div class="ts-color-pick-item">
                                <label class="ts-label">Primary Header Color</label>
                                <div class="ts-color-input-row">
                                    <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.PrimaryColor" @bind:after="ApplyCustomColors" />
                                    <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.PrimaryColor" @bind:after="ApplyCustomColors" />
                                </div>
                            </div>
                            <div class="ts-color-pick-item">
                                <label class="ts-label">Header Background Color</label>
                                <div class="ts-color-input-row">
                                    <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.HeaderBg" @bind:after="ApplyCustomColors" />
                                    <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.HeaderBg" @bind:after="ApplyCustomColors" />
                                </div>
                            </div>
                        </div>
                    }

                    <!-- TABLE INSPECTOR -->
                    @if (SelectedElement == "table")
                    {
                        <div class="ts-inspector-grid">
                            <div class="ts-color-pick-item">
                                <label class="ts-label">Table Header Background</label>
                                <div class="ts-color-input-row">
                                    <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.HeaderBg" @bind:after="ApplyCustomColors" />
                                    <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.HeaderBg" @bind:after="ApplyCustomColors" />
                                </div>
                            </div>
                            <div class="ts-control-group">
                                <label class="ts-label">Row Padding Density (@(ThemeService.CurrentTheme.TablePaddingPx)px)</label>
                                <div class="ts-chip-row">
                                    <button class="ts-chip @(ThemeService.CurrentTheme.TablePaddingPx == 4 ? "active" : "")" @onclick="() => SetTablePadding(4)">Compact (4px)</button>
                                    <button class="ts-chip @(ThemeService.CurrentTheme.TablePaddingPx == 8 ? "active" : "")" @onclick="() => SetTablePadding(8)">Standard (8px)</button>
                                    <button class="ts-chip @(ThemeService.CurrentTheme.TablePaddingPx == 14 ? "active" : "")" @onclick="() => SetTablePadding(14)">Spacious (14px)</button>
                                </div>
                            </div>
                            <div class="ts-control-group">
                                <label class="ts-label">Table Corner Radius (@(ThemeService.CurrentTheme.TableRadiusPx)px)</label>
                                <input type="range" class="ts-range" min="0" max="16" step="1"
                                       @bind="ThemeService.CurrentTheme.TableRadiusPx" @bind:after="ApplyCustomColors" />
                            </div>
                        </div>
                    }

                    <!-- BADGES & ACCENT INSPECTOR -->
                    @if (SelectedElement == "badges")
                    {
                        <div class="ts-inspector-grid">
                            <div class="ts-color-pick-item">
                                <label class="ts-label">Accent Color</label>
                                <div class="ts-color-input-row">
                                    <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.AccentColor" @bind:after="ApplyCustomColors" />
                                    <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.AccentColor" @bind:after="ApplyCustomColors" />
                                </div>
                            </div>
                            <div class="ts-color-pick-item">
                                <label class="ts-label">Secondary Color</label>
                                <div class="ts-color-input-row">
                                    <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.SecondaryColor" @bind:after="ApplyCustomColors" />
                                    <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.SecondaryColor" @bind:after="ApplyCustomColors" />
                                </div>
                            </div>
                        </div>
                    }

                    <!-- FORM INPUTS INSPECTOR -->
                    @if (SelectedElement == "inputs")
                    {
                        <div class="ts-inspector-grid">
                            <div class="ts-control-group">
                                <label class="ts-label">Input Corner Radius (@(ThemeService.CurrentTheme.ButtonRadiusPx)px)</label>
                                <input type="range" class="ts-range" min="0" max="24" step="1"
                                       @bind="ThemeService.CurrentTheme.ButtonRadiusPx" @bind:after="ApplyCustomColors" />
                            </div>
                            <div class="ts-control-group">
                                <label class="ts-label">Base Font Size (@(ThemeService.CurrentTheme.BaseFontSizePx)px)</label>
                                <div class="ts-chip-row">
                                    <button class="ts-chip @(ThemeService.CurrentTheme.BaseFontSizePx == 12 ? "active" : "")" @onclick="() => SetFontSize(12)">12px Small</button>
                                    <button class="ts-chip @(ThemeService.CurrentTheme.BaseFontSizePx == 14 ? "active" : "")" @onclick="() => SetFontSize(14)">14px Default</button>
                                    <button class="ts-chip @(ThemeService.CurrentTheme.BaseFontSizePx == 16 ? "active" : "")" @onclick="() => SetFontSize(16)">16px Large</button>
                                </div>
                            </div>
                        </div>
                    }

                    <!-- ALERT INSPECTOR -->
                    @if (SelectedElement == "alert")
                    {
                        <div class="ts-inspector-grid">
                            <div class="ts-color-pick-item">
                                <label class="ts-label">Alert Border & Accent Color</label>
                                <div class="ts-color-input-row">
                                    <input type="color" class="ts-color-picker" @bind="ThemeService.CurrentTheme.AccentColor" @bind:after="ApplyCustomColors" />
                                    <input type="text" class="ts-text-input" @bind="ThemeService.CurrentTheme.AccentColor" @bind:after="ApplyCustomColors" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Simulated Card Component with Click-to-Edit Sections -->
            <div class="ts-demo-card" style="border-radius: @(ThemeService.CurrentTheme.BorderRadiusPx)px;">
                
                <!-- 1. Header Bar -->
                <div class="ts-demo-card-header ts-interactive-item @(SelectedElement == "header" ? "active-selected" : "")"
                     data-hover-label="Click to edit Header ✏️"
                     data-selected-label="Editing Header ✏️"
                     style="background-color: @ThemeService.CurrentTheme.PrimaryColor;"
                     @onclick='() => SelectElement("header")'>
                    <i class="fas fa-tools me-2"></i> Service Dashboard
                    <span class="ms-auto ts-demo-badge-live">LIVE</span>
                </div>

                <div class="ts-demo-card-body">
                    
                    <!-- 2. Buttons Row -->
                    <div class="ts-interactive-item @(SelectedElement == "buttons" ? "active-selected" : "")"
                         data-hover-label="Click to edit Buttons ✏️"
                         data-selected-label="Editing Buttons ✏️"
                         @onclick='() => SelectElement("buttons")'>
                        <div class="ts-demo-section-label">BUTTONS</div>
                        <div class="ts-demo-buttons">
                            <button class="ts-demo-btn ts-demo-btn-primary"
                                    style="background-color: @ThemeService.CurrentTheme.PrimaryColor; border-radius: @(ThemeService.CurrentTheme.ButtonRadiusPx)px;">
                                <i class="fas fa-plus me-1"></i>Create
                            </button>
                            <button class="ts-demo-btn ts-demo-btn-success"
                                    style="border-radius: @(ThemeService.CurrentTheme.ButtonRadiusPx)px;">
                                <i class="fas fa-check me-1"></i>Approve
                            </button>
                            <button class="ts-demo-btn ts-demo-btn-danger"
                                    style="border-radius: @(ThemeService.CurrentTheme.ButtonRadiusPx)px;">
                                <i class="fas fa-trash me-1"></i>Delete
                            </button>
                            <button class="ts-demo-btn ts-demo-btn-outline"
                                    style="border-radius: @(ThemeService.CurrentTheme.ButtonRadiusPx)px;">
                                Cancel
                            </button>
                        </div>
                    </div>

                    <!-- 3. Badges Row -->
                    <div class="ts-interactive-item @(SelectedElement == "badges" ? "active-selected" : "")"
                         data-hover-label="Click to edit Badges ✏️"
                         data-selected-label="Editing Badges ✏️"
                         @onclick='() => SelectElement("badges")'>
                        <div class="ts-demo-section-label">STATUS BADGES</div>
                        <div class="ts-demo-badges">
                            <span class="ts-demo-status ts-demo-status-active">Active</span>
                            <span class="ts-demo-status ts-demo-status-pending">Pending</span>
                            <span class="ts-demo-status ts-demo-status-done">Finished</span>
                            <span class="ts-demo-status ts-demo-status-danger">Rejected</span>
                        </div>
                    </div>

                    <!-- 4. Data Table Preview -->
                    <div class="ts-interactive-item @(SelectedElement == "table" ? "active-selected" : "")"
                         data-hover-label="Click to edit Table ✏️"
                         data-selected-label="Editing Table ✏️"
                         @onclick='() => SelectElement("table")'>
                        <div class="ts-demo-section-label">DATA TABLE</div>
                        <div class="ts-demo-table-wrapper" style="border-radius: @(ThemeService.CurrentTheme.TableRadiusPx)px;">
                            <table class="ts-demo-table">
                                <thead>
                                    <tr style="background-color: @ThemeService.CurrentTheme.HeaderBg;">
                                        <th style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">Service No</th>
                                        <th style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">Model</th>
                                        <th style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">Tech</th>
                                        <th style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">SR-2026-081</td>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">CANON MF4350</td>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">Ratana S.</td>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;"><span class="ts-demo-status ts-demo-status-pending">Inspecting</span></td>
                                    </tr>
                                    <tr class="ts-demo-row-alt">
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">SR-2026-082</td>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">HP LaserJet Pro</td>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">Chhunlay Y.</td>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;"><span class="ts-demo-status ts-demo-status-done">Finished</span></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">SR-2026-083</td>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">EPSON L3150</td>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;">Sovann T.</td>
                                        <td style="padding: @(ThemeService.CurrentTheme.TablePaddingPx)px 12px;"><span class="ts-demo-status ts-demo-status-active">Active</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- 5. Form Inputs -->
                    <div class="ts-interactive-item @(SelectedElement == "inputs" ? "active-selected" : "")"
                         data-hover-label="Click to edit Inputs ✏️"
                         data-selected-label="Editing Inputs ✏️"
                         @onclick='() => SelectElement("inputs")'>
                        <div class="ts-demo-section-label">FORM INPUTS</div>
                        <div class="ts-demo-form">
                            <input type="text" class="ts-demo-input"
                                   style="border-radius: @(ThemeService.CurrentTheme.ButtonRadiusPx)px; font-size: @(ThemeService.CurrentTheme.BaseFontSizePx)px;"
                                   placeholder="Search service tickets..." readonly />
                            <select class="ts-demo-input"
                                    style="border-radius: @(ThemeService.CurrentTheme.ButtonRadiusPx)px; font-size: @(ThemeService.CurrentTheme.BaseFontSizePx)px;">
                                <option>All Technicians</option>
                                <option>Ratana S.</option>
                                <option>Chhunlay Y.</option>
                            </select>
                        </div>
                    </div>

                    <!-- 6. Alert Banner -->
                    <div class="ts-interactive-item @(SelectedElement == "alert" ? "active-selected" : "")"
                         data-hover-label="Click to edit Alert ✏️"
                         data-selected-label="Editing Alert ✏️"
                         @onclick='() => SelectElement("alert")'>
                        <div class="ts-demo-alert" style="border-left-color: @ThemeService.CurrentTheme.AccentColor;">
                            <i class="fas fa-info-circle me-2" style="color: @ThemeService.CurrentTheme.AccentColor;"></i>
                            <span style="font-size: @(ThemeService.CurrentTheme.BaseFontSizePx)px;">All theme changes are saved to your browser and applied instantly.</span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Current Config Summary -->
            <div class="ts-config-summary">
                <div class="ts-config-row">
                    <span class="ts-config-key">Mode</span>
                    <span class="ts-config-val">@ThemeService.CurrentTheme.Mode</span>
                </div>
                <div class="ts-config-row">
                    <span class="ts-config-key">Primary</span>
                    <span class="ts-config-val">
                        <span class="ts-config-dot" style="background: @ThemeService.CurrentTheme.PrimaryColor;"></span>
                        @ThemeService.CurrentTheme.PrimaryColor
                    </span>
                </div>
                <div class="ts-config-row">
                    <span class="ts-config-key">Header</span>
                    <span class="ts-config-val">
                        <span class="ts-config-dot" style="background: @ThemeService.CurrentTheme.HeaderBg;"></span>
                        @ThemeService.CurrentTheme.HeaderBg
                    </span>
                </div>
                <div class="ts-config-row">
                    <span class="ts-config-key">Button Radius</span>
                    <span class="ts-config-val">@(ThemeService.CurrentTheme.ButtonRadiusPx)px</span>
                </div>
                <div class="ts-config-row">
                    <span class="ts-config-key">Table Padding</span>
                    <span class="ts-config-val">@(ThemeService.CurrentTheme.TablePaddingPx)px</span>
                </div>
                <div class="ts-config-row">
                    <span class="ts-config-key">Font Size</span>
                    <span class="ts-config-val">@(ThemeService.CurrentTheme.BaseFontSizePx)px</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string ActiveTab = "themes";
    private string? SelectedElement = null;

    private bool IsDarkMode => ThemeService.CurrentTheme.Mode != "light";

    private async Task ToggleQuickMode() =>
        await SelectPresetMode(IsDarkMode ? "light" : "dark");

    private record PresetDef(string Mode, string Name, string Gradient, bool IsDark);

    private readonly List<PresetDef> Presets = new()
    {
        new("light",     "Light Clean",    "linear-gradient(135deg,#f8fafc,#1FA9D3)",    false),
        new("dark",      "Dark Slate",     "linear-gradient(135deg,#0f172a,#6366f1)",    true),
        new("midnight",  "Midnight Blue",  "linear-gradient(135deg,#0b132b,#3b82f6)",    true),
        new("rose",      "Rose Velvet",    "linear-gradient(135deg,#180914,#e11d48)",    true),
        new("cyberpunk", "Cyberpunk Neon", "linear-gradient(135deg,#05050d,#00ffcc)",    true),
        new("luxury",    "Luxury Gold",    "linear-gradient(135deg,#111111,#d4af37)",    true),
        new("emerald",   "Emerald Forest", "linear-gradient(135deg,#064e3b,#10b981)",    true),
        new("ocean",     "Ocean Breeze",   "linear-gradient(135deg,#0c4a6e,#06b6d4)",    true),
        new("glass",     "Frosted Glass",  "linear-gradient(135deg,#0f172a,#0284c7)",    true),
        new("cyberglass","Cyber Glass",    "linear-gradient(135deg,#09090b,#7e22ce)",    true),
        new("material",    "Material You M3", "linear-gradient(135deg,#FEF7FF,#6750A4)", false),
        new("materialdark","Material Dark M3","linear-gradient(135deg,#141218,#D0BCFF)", true),
    };

    private readonly string[] ColorSwatches = new[]
    {
        "#1FA9D3", "#6366f1", "#a855f7", "#ec4899",
        "#10b981", "#0284c7", "#f59e0b", "#ef4444"
    };

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += StateHasChanged;
        await ThemeService.InitializeThemeAsync();
    }

    private void SelectElement(string elementId)
    {
        SelectedElement = elementId;

        if (elementId == "buttons" || elementId == "inputs")
            ActiveTab = "components";
        else if (elementId == "header" || elementId == "table" || elementId == "badges")
            ActiveTab = "colors";
    }

    private void DeselectElement()
    {
        SelectedElement = null;
    }

    private string GetInspectorTitle(string elementId) => elementId switch
    {
        "buttons" => "Editing Buttons Component",
        "header"  => "Editing Card & Page Header",
        "table"   => "Editing Data Table & Grid",
        "badges"  => "Editing Status Badges & Accents",
        "inputs"  => "Editing Form Controls & Inputs",
        "alert"   => "Editing Alert Banners",
        _         => "Editing Component"
    };

    private async Task SelectPresetMode(string mode) =>
        await ThemeService.SetModeAsync(mode);

    private async Task SetPrimaryColor(string color) =>
        await ThemeService.SetPrimaryColorAsync(color);

    private async Task SetButtonRadius(int px)
    {
        ThemeService.CurrentTheme.ButtonRadiusPx = px;
        await ApplyCustomColors();
    }

    private async Task SetTablePadding(int px)
    {
        ThemeService.CurrentTheme.TablePaddingPx = px;
        await ApplyCustomColors();
    }

    private async Task SetFontSize(int px)
    {
        ThemeService.CurrentTheme.BaseFontSizePx = px;
        await ApplyCustomColors();
    }

    private async Task ApplyCustomColors() =>
        await ThemeService.SetThemeConfigAsync(ThemeService.CurrentTheme);

    private async Task SaveAllSettings() =>
        await ThemeService.SetThemeConfigAsync(ThemeService.CurrentTheme);

    private async Task ResetToDefaults()
    {
        await ThemeService.ResetToDefaultsAsync();
        SelectedElement = null;
        ActiveTab = "themes";
    }

    public void Dispose() =>
        ThemeService.OnThemeChanged -= StateHasChanged;
}
