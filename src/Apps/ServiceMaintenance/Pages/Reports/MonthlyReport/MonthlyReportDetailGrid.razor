@* ══════════════════════════════════════════════════════════════════
   MonthlyReportDetailGrid.razor
   Each expanded row gets its own instance of this component, which
   loads ONLY its own page of data from the server — never the full
   dataset.

   ✅ FIXED: now filters by EVENT DATE (useProcessDateFiltering +
   statusesForProcessFiltering) instead of CURRENT status. This
   matches the logic in GetMonthlyReportCompanySummaryAsync: a
   service counts as "Finished" for this period if FinishedDate
   falls in range, even if its current status later changed (e.g.
   moved back to Inspecting via MoveBackToInspectingAsync). The old
   status:"Finished,Customer Rejected,Unrepairable" filter required
   Status.Name to STILL match today, which silently dropped rows the
   summary grid counts — causing the detail grid total to be lower
   than the summary grid total (e.g. Post Bank showing 1 instead of
   the 2 the summary reports).
   ══════════════════════════════════════════════════════════════════ *@
@inject RepairItemService RepairService

<div class="detail-grid-container p-3">
    @if (_loading)
    {
        <div class="text-center p-3">
            <div class="spinner-border spinner-border-sm text-primary"></div>
            <span class="ms-2">Loading @CustomerType records...</span>
        </div>
    }
    else
    {
        <SfGrid DataSource="@_pageItems"
                AllowSorting="true"
                Height="300"
                SelectionMode="GridSelectionMode.Single"
                AllowResizing="true"
                AllowSelection="true">
            <GridColumns>
                <GridColumn Field="CompanyName" HeaderText="Company Name" Width="300"></GridColumn>
                <GridColumn Field="itemName" HeaderText="Item Name" Width="250"></GridColumn>
                <GridColumn Field="serialNumber" HeaderText="Serial Number" Width="150"></GridColumn>
                <GridColumn Field="CustomerType" HeaderText="Customer Type" Width="120"></GridColumn>
                <GridColumn HeaderText="Action" IsFrozen="true" Freeze="FreezeDirection.Right" Width="150">
                    <Template Context="columnContext">
                        <DxButton IconCssClass="fas fa-eye"
                                  CssClass="icon-button info"
                                  RenderStyle="ButtonRenderStyle.Info"
                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                  Text="View"
                                  Click="() => OnViewDetails.InvokeAsync(columnContext as RepairServices)" />
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                <strong>Showing @((_currentPage - 1) * _pageSize + 1) to @Math.Min(_currentPage * _pageSize, _totalRecords) of @_totalRecords records</strong>
            </div>
            <div class="d-flex align-items-center gap-2">
                <label class="me-2">Page Size:</label>
                <select class="form-select form-select-sm" style="width: 80px;"
                        value="@_pageSize" @onchange="OnPageSizeChanged">
                    <option value="10">10</option>
                    <option value="25">25</option>
                    <option value="50">50</option>
                </select>
                <div class="btn-group ms-3" role="group">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => GoToPage(1)" disabled="@(_currentPage <= 1)">
                        <i class="fas fa-angle-double-left"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => GoToPage(_currentPage - 1)" disabled="@(_currentPage <= 1)">
                        <i class="fas fa-angle-left"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" disabled>@_currentPage / @_totalPages</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => GoToPage(_currentPage + 1)" disabled="@(_currentPage >= _totalPages)">
                        <i class="fas fa-angle-right"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => GoToPage(_totalPages)" disabled="@(_currentPage >= _totalPages)">
                        <i class="fas fa-angle-double-right"></i>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string CustomerType { get; set; } = "Unknown";
    [Parameter] public List<string> CompanyNames { get; set; } = new();
    [Parameter] public DateTime FromDate { get; set; }
    [Parameter] public DateTime ToDate { get; set; }
    [Parameter] public string ServiceLocation { get; set; } = "All";
    [Parameter] public EventCallback<RepairServices> OnViewDetails { get; set; }

    // ✅ Same three statuses the summary grid aggregates on. Kept as a
    // single static array so the "what counts as a detail row" list
    // only has to be edited in one place if it ever changes.
    private static readonly string[] _relevantStatuses =
        { "Finished", "Customer Rejected", "Unrepairable" };

    private List<RepairServices> _pageItems = new();
    private int _currentPage = 1;
    private int _pageSize = 10;
    private int _totalRecords = 0;
    private int _totalPages => _totalRecords > 0 ? (int)Math.Ceiling(_totalRecords / (double)_pageSize) : 1;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadPage(1);
    }

    private async Task LoadPage(int page)
    {
        if (CompanyNames == null || CompanyNames.Count == 0)
        {
            _pageItems = new();
            _totalRecords = 0;
            _loading = false;
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            // ✅ FIXED — event-date filtering (useProcessDateFiltering),
            // NOT current-status filtering (status:"..."). A service
            // Finished within [FromDate, ToDate] must count here even
            // if it was later moved back to Inspecting, exactly like
            // GetMonthlyReportCompanySummaryAsync counts it. Passing
            // status: "Finished,Customer Rejected,Unrepairable" instead
            // hits SearchServicesAsync's isStatusFiltering branch, which
            // additionally requires Status.Name to STILL equal that
            // value today — silently dropping rows the summary counts.
            var result = await RepairService.SearchRepairServicesAsync(
                pageNumber: page,
                pageSize: _pageSize,
                fromDate: FromDate,
                toDate: ToDate,
                useProcessDateFiltering: true,
                statusesForProcessFiltering: _relevantStatuses,
                serviceLocation: ServiceLocation != "All" ? ServiceLocation : null,
                sortBy: "reportNo",
                sortDescending: true,
                companyNames: CompanyNames.ToArray());

            _pageItems = result?.Items?.ToList() ?? new();
            _totalRecords = result?.TotalCount ?? 0;
            _currentPage = page;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading detail page for {CustomerType}: {ex.Message}");
            _pageItems = new();
            _totalRecords = 0;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private Task GoToPage(int page)
    {
        if (page < 1 || page > _totalPages) return Task.CompletedTask;
        return LoadPage(page);
    }

    private Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            _pageSize = newSize;
            return LoadPage(1);
        }
        return Task.CompletedTask;
    }
}
