@page "/monthly-report"
@using System.Linq.Expressions
@using DXApplication1
@using ServiceMaintenance.Models
@using ServiceMaintenance.Pages.Reports
@using ServiceMaintenance.Services
@using ServiceMaintenance.Infrastructure.Shared.Caching
@using ServiceMaintenance.Components
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Buttons
@inject RepairItemService RepairService
@inject UserService UserService
@inject IJSRuntime JSRuntime
@inject ServiceSparePart SparePartService
@inject CustomerService CustomerService
@inject CacheHelper Cache
@inherits PermissionBase

@if (CanAccess)
{
    <DxToastProvider Name="Customization"
                     MaxToastCount="5"
                     HorizontalAlignment="HorizontalAlignment.Right"
                     VerticalAlignment="VerticalEdge.Top"
                     AnimationType="@Animation" />
    <DxToastProvider Name="Error"
                     MaxToastCount="5"
                     HorizontalAlignment="HorizontalAlignment.Right"
                     VerticalAlignment="VerticalEdge.Top"
                     AnimationType="@Animation" />

    @* ══════════════════════════════════════════════════════════════
       Page shell now handles the "no outer scrollbar" behavior —
       this page only supplies its toolbar, filter sidebar, and body.
       ══════════════════════════════════════════════════════════════ *@
    <ReportPageShell @ref="_shell" WrapperId="monthlyReportPageWrapper">
        <Toolbar>
            <DxToolbar ItemRenderStyleMode="ToolbarRenderStyleMode.Plain">
                <DxToolbarItem Text="Filters" IconCssClass="fas fa-filter" Click="OpenFilterDialog" />
                <DxToolbarItem Text="@Loc[nameof(ResourceStrings.TextExport)]" IconCssClass="fas fa-download">
                    <Items>
                        <DxToolbarItem Text="@Loc[nameof(ResourceStrings.TextToExcel)]" Click="ExportToExcel" IconCssClass="fas fa-file-excel" />
                        <DxToolbarItem Text="@Loc[nameof(ResourceStrings.TextToPdf)]" Click="ShowReportPreview2" IconCssClass="fas fa-file-pdf" />
                    </Items>
                </DxToolbarItem>
                <DxToolbarItem Text="Print Report" Click="ShowReportPreview" CssClass="toolbar-item" IconCssClass="fas fa-print" />
            </DxToolbar>
        </Toolbar>

        <FilterPanel>
            <SfSidebar @ref="FilterSidebar"
                       Width="380px"
                       Position="SidebarPosition.Right"
                       Type="SidebarType.Over"
                       IsOpen="@IsFilterDialogVisible"
                       IsOpenChanged="OnFilterSidebarOpenChanged"
                       CloseOnDocumentClick="true"
                       ShowBackdrop="true">
                <ChildContent>
                    <div style="display:flex; flex-direction:column; height:100vh; overflow:hidden;">
                        <div style="display:flex; justify-content:space-between; align-items:center;
                                    padding:12px 20px; border-bottom:1px solid #dee2e6; flex-shrink:0; background:#fff;">
                            <div>
                                <h5 style="margin:0; font-weight:600;">
                                    <i class="fas fa-filter" style="margin-right:8px; color:#007bff;"></i>
                                    Report Filters
                                </h5>
                                <div style="font-size:0.85rem; color:#777; margin-top:2px;">
                                    Set a date range and narrow the report, then fetch.
                                </div>
                            </div>
                            <button @onclick="CloseFilterDialog" style="background:none; border:none; cursor:pointer; font-size:18px; color:#666;">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>

                        <div style="flex:1; overflow-y:auto; padding:20px; display:flex; flex-direction:column; gap:16px;">
                            <div>
                                <label for="serviceLocationFilter" class="font-weight-bold">Service Location:</label>
                                <InputSelect @bind-Value="SelectedServiceLocation" id="serviceLocationFilter" class="form-control">
                                    @foreach (var location in ServiceLocationOptions)
                                    {
                                        <option value="@location">@location</option>
                                    }
                                </InputSelect>
                            </div>
                            <div>
                                <label for="customerTypeFilter" class="font-weight-bold">Customer Type:</label>
                                <SfComboBox TValue="string"
                                            TItem="CustomerService.CustomerTypeDto"
                                            @bind-Value="SelectedCustomerType"
                                            DataSource="@CustomerTypes"
                                            Placeholder="Select or search..."
                                            AllowFiltering="true"
                                            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                            PopupHeight="300px"
                                            id="customerTypeFilter"
                                            CssClass="form-control">
                                    <ComboBoxFieldSettings Text="Type" Value="Type"></ComboBoxFieldSettings>
                                    <ComboBoxEvents TValue="string" TItem="CustomerService.CustomerTypeDto" Filtering="OnCustomerTypeFiltering"></ComboBoxEvents>
                                </SfComboBox>
                            </div>
                        </div>

                        <div style="padding:12px 20px; border-top:1px solid #dee2e6; flex-shrink:0; display:flex; flex-direction:column; gap:8px; background:#fff;">
                            <SfButton Content="@(IsLoading ? "Loading..." : "Fetch Report")" IsPrimary="true" Disabled="@IsLoading" @onclick="FetchReportFromDialog" />
                            <SfButton Content="Cancel" @onclick="CloseFilterDialog" />
                        </div>
                    </div>
                </ChildContent>
            </SfSidebar>
        </FilterPanel>

        <Body>
            <div class="report-quick-date-range report-shrink">
                <div class="report-quick-date-field">
                    <label for="quickFromDate" class="font-weight-bold">@Loc[nameof(ResourceStrings.Textfrom)]:</label>
                    <SfDatePicker TValue="DateTime" @ref="@DateObj1" @bind-Value="StartDate" id="quickFromDate" class="form-control" Format="dd/MM/yyyy">
                        <DatePickerEvents TValue="DateTime" Focus="FocusHandler1"></DatePickerEvents>
                    </SfDatePicker>
                </div>
                <div class="report-quick-date-field">
                    <label for="quickToDate" class="font-weight-bold">@Loc[nameof(ResourceStrings.TextTo)]:</label>
                    <SfDatePicker TValue="DateTime" @ref="@DateObj2" @bind-Value="EndDate" id="quickToDate" class="form-control" Format="dd/MM/yyyy">
                        <DatePickerEvents TValue="DateTime" Focus="FocusHandler2"></DatePickerEvents>
                    </SfDatePicker>
                </div>
                <button class="btn btn-primary report-quick-date-fetch" @onclick="FetchReport" disabled="@IsLoading">
                    @if (IsLoading)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    else
                    {
                        <i class="fas fa-sync-alt me-2"></i>
                    }
                    Refresh
                </button>
            </div>

            @if (IsLoading)
            {
                <div class="text-center p-4 report-shrink">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2">@LoadingMessage</p>
                </div>
            }
            else if (!HasSearched)
            {
                <div class="alert alert-secondary report-shrink">
                    <i class="fas fa-info-circle me-2"></i>
                    Choose a date range and click "@Loc[nameof(ResourceStrings.TextFetchReport)]" to load the report.
                </div>
            }
            else if (DocumentGroups.Count == 0)
            {
                <div class="alert alert-info report-shrink">
                    <i class="fas fa-info-circle me-2"></i>
                    No data available for the selected criteria. Please adjust your filters and try again.
                </div>
            }
            else
            {
                <ReportGroupedDocument TItem="RepairServices"
                                       Title="Monthly Repair Report"
                                       SubHeader="@BuildSubHeader()"
                                       Columns="@_columns"
                                       Groups="@DocumentGroups"
                                       SummaryStats="@BuildSummaryStats()"
                                       GrandTotalLabel="Grand Total —" />
            }
        </Body>
    </ReportPageShell>

    <!-- View Details Dialog -->
    <SfDialog @ref="DialogEdit" Target="#target" Width="600px" IsModal="true" ShowCloseIcon="true" @bind-Visible="@isViewDialogVisible">
        <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
        <DialogTemplates>
            <Header>@Loc[nameof(ResourceStrings.TextViewInfo)]</Header>
            <Content>
                <div class="report-container">
                    <div class="report-header"><span>Repair Service Report</span></div>
                    <div class="report-body">
                        <table class="report-table">
                            @if (_selectedRepairService?.reportNo != null)
                            {
                                <tr>
                                    <td class="report-label"><strong>@Loc[nameof(ResourceStrings.Textref)]:</strong></td>
                                    <td class="report-value">@_selectedRepairService?.reportNo</td>
                                </tr>
                            }
                            @if (_selectedRepairService?.ServiceDate != null)
                            {
                                <tr>
                                    <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextReceiveDate)]:</strong></td>
                                    <td class="report-value">@_selectedRepairService?.ServiceDate.ToString("yyyy-MM-dd HH:mm tt")</td>
                                </tr>
                            }
                            @if (_selectedRepairService?.repairDate.HasValue == true)
                            {
                                <tr>
                                    <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextRepairDate)]:</strong></td>
                                    <td class="report-value">@_selectedRepairService.repairDate.Value.ToString("yyyy-MM-dd HH:mm tt")</td>
                                </tr>
                            }
                            @if (_selectedRepairService?.finishedDate.HasValue == true)
                            {
                                <tr>
                                    <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextFinishDate)]:</strong></td>
                                    <td class="report-value">@_selectedRepairService.finishedDate.Value.ToString("yyyy-MM-dd HH:mm tt")</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>
            </Content>
        </DialogTemplates>
        <DialogButtons>
            <DialogButton Content="Close" IsPrimary="true" OnClick="@CloseDialog" />
        </DialogButtons>
    </SfDialog>
}

@code {
    private ReportPageShell? _shell;

    private DateTime StartDate = DateTime.Today;
    private DateTime EndDate = DateTime.Today;

    private RepairServices _selectedRepairService;
    private Dictionary<string, string> UserMap = new();
    private Dictionary<string, string> _userCache = new();
    private bool _usersLoaded = false;
    private IEnumerable<SparePartObject> _spareParts = Enumerable.Empty<SparePartObject>();
    private bool isViewDialogVisible = false;
    private SfDialog DialogEdit;
    private string CurrentUserName;
    private bool IsFilterDialogVisible = false;
    private SfSidebar FilterSidebar;

    private Task OnFilterSidebarOpenChanged(bool isOpen)
    {
        IsFilterDialogVisible = isOpen;
        return Task.CompletedTask;
    }
    SfDatePicker<DateTime> DateObj1;
    SfDatePicker<DateTime> DateObj2;
    private string SelectedCustomerType = "All";
    private bool IsLoading = false;
    private string LoadingMessage = "Loading report data...";
    ToastAnimationType Animation { get; set; } = ToastAnimationType.Slide;
    private string SelectedServiceLocation = "All";
    private List<string> ServiceLocationOptions = new() { "All", "OnSite", "CompanyService" };
    private bool HasSearched = false;
    private DateTime _lastStartDate;
    private DateTime _lastEndDate;
    private string _lastServiceLocation = "All";
    private string _lastCustomerType = "All";
    private List<CustomerService.CustomerTypeDto> CustomerTypes = new();
    private int CustomerTypeCurrentPage = 1;
    private const int CustomerTypePageSize = 10;
    private bool HasMoreCustomerTypes = true;
    private Dictionary<Guid, SparePartObject> _sparePartsCache = new();

    private static readonly Dictionary<string, string> _companyTypeCache = new();
    private static readonly SemaphoreSlim _companyTypeCacheLock = new(1, 1);

    private static readonly string[] _relevantStatuses =
        { "Finished", "Customer Rejected", "Unrepairable" };

    // ── Column definitions: this list is the only thing that differs
    //    from what a page like daily-report would declare. ──
    private List<ReportColumn<RepairServices>> _columns = new();

    private List<ReportGroup<RepairServices>> DocumentGroups = new();
    private List<RepairServices> _fullReportCache = new();
    private bool _fullReportCacheValid = false;

    protected override void OnInitialized()
    {
        _columns = new List<ReportColumn<RepairServices>>
        {
            ReportColumn<RepairServices>.Text("Date", s => s.ServiceDate.ToString("dd/MM/yyyy"), "12%"),
            ReportColumn<RepairServices>.Text("Report #", s => s.reportNo, "12%"),
            ReportColumn<RepairServices>.Text("Item Name", s => s.itemName, "26%", subTextSelector: s => s.CompanyName),
            ReportColumn<RepairServices>.Text("Serial Number", s => s.serialNumber, "16%"),
            ReportColumn<RepairServices>.Text("Status", s => string.IsNullOrWhiteSpace(s.Status) ? "-" : s.Status, "16%"),
            new ReportColumn<RepairServices>
            {
                Header = "Action",
                Width = "18%",
                Align = "right",
                CellTemplate = item => builder =>
                {
                    builder.OpenComponent<DxButton>(0);
                    builder.AddAttribute(1, "IconCssClass", "fas fa-eye");
                    builder.AddAttribute(2, "CssClass", "report-icon-button info");
                    builder.AddAttribute(3, "RenderStyle", ButtonRenderStyle.Info);
                    builder.AddAttribute(4, "RenderStyleMode", ButtonRenderStyleMode.Text);
                    builder.AddAttribute(5, "Text", "View");
                    builder.AddAttribute(6, "Click", EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => ShowRepairServiceDetails(item)));
                    builder.CloseComponent();
                }
            }
        };
    }

    private string BuildSubHeader()
    {
        var text = $"From {_lastStartDate:dd/MM/yyyy} To {_lastEndDate:dd/MM/yyyy}";
        if (_lastServiceLocation != "All")
        {
            text += $"  •  Service Location: {_lastServiceLocation}";
        }
        return text;
    }

    private List<ReportSummaryStat> BuildSummaryStats() => new()
    {
        new ReportSummaryStat { Label = "Fixed", Value = DocumentGroups.Sum(g => g.Items.Count(i => i.Status == "Finished")) },
        new ReportSummaryStat { Label = "Customer Rejected", Value = DocumentGroups.Sum(g => g.Items.Count(i => i.Status == "Customer Rejected")) },
        new ReportSummaryStat { Label = "Unrepairable", Value = DocumentGroups.Sum(g => g.Items.Count(i => i.Status == "Unrepairable")) },
    };

    public async void FocusHandler1(Syncfusion.Blazor.Calendars.FocusEventArgs args) => await this.DateObj1.ShowPopupAsync();
    public async void FocusHandler2(Syncfusion.Blazor.Calendars.FocusEventArgs args) => await this.DateObj2.ShowPopupAsync();

    private void OpenFilterDialog() => IsFilterDialogVisible = true;
    private void CloseFilterDialog() => IsFilterDialogVisible = false;

    private async Task FetchReportFromDialog()
    {
        await FetchReport();
        IsFilterDialogVisible = false;
    }

    protected override async Task OnPermissionsLoadedAsync()
    {
        if (!CanAccess)
        {
            ShowError("You don't have permission to access this page");
            return;
        }
        await InitializePageData();
    }

    private async Task InitializePageData()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;
        if (user.Identity.IsAuthenticated) CurrentUserName = user.Identity.Name;

        StartDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        EndDate = StartDate.AddMonths(1).AddDays(-1);
        await LoadAllUsersAsync();
        await LoadCustomerTypes();
        await FetchReport();
        if (_shell is not null) await _shell.ReadjustAsync();
    }

    private async Task LoadAllUsersAsync()
    {
        if (_usersLoaded) return;
        try
        {
            var users = await UserService.GetUsersAsync();
            _userCache = users.ToDictionary(u => u.Id, u => $"{u.LastName}");
            UserMap = _userCache;
            _usersLoaded = true;
        }
        catch
        {
            _userCache = new Dictionary<string, string>();
            UserMap = new Dictionary<string, string>();
        }
    }

    private async Task LoadCustomerTypes()
    {
        try
        {
            CustomerTypes = new List<CustomerService.CustomerTypeDto>
            {
                new() { Type = "All", Description = "All Types", IsActive = true }
            };

            var pagedResponse = await CustomerService.GetCustomerTypesPaginatedAsync(
                pageNumber: 1, pageSize: CustomerTypePageSize, isActive: true);

            if (pagedResponse?.Data != null && pagedResponse.Data.Any())
            {
                CustomerTypes.AddRange(pagedResponse.Data.OrderBy(ct => ct.Type));
                HasMoreCustomerTypes = pagedResponse.HasNext;
                CustomerTypeCurrentPage = 1;
            }
            SelectedCustomerType = "All";
        }
        catch
        {
            CustomerTypes = new List<CustomerService.CustomerTypeDto>
            {
                new() { Type = "All", Description = "All Types", IsActive = true }
            };
        }
    }

    private void OnCustomerTypeFiltering(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        _ = Task.Run(async () =>
        {
            try
            {
                if (string.IsNullOrEmpty(args.Text))
                {
                    await InvokeAsync(async () => { await LoadCustomerTypes(); StateHasChanged(); });
                }
                else
                {
                    var searchResults = await CustomerService.GetCustomerTypesPaginatedAsync(
                        pageNumber: 1, pageSize: 20, searchTerm: args.Text, isActive: true);

                    await InvokeAsync(() =>
                    {
                        CustomerTypes = new List<CustomerService.CustomerTypeDto>
                        {
                            new() { Type = "All", Description = "All Types", IsActive = true }
                        };
                        if (searchResults?.Data != null)
                            CustomerTypes.AddRange(searchResults.Data.OrderBy(ct => ct.Type));
                        StateHasChanged();
                    });
                }
            }
            catch
            {
                await InvokeAsync(() =>
                {
                    CustomerTypes = new List<CustomerService.CustomerTypeDto>
                    {
                        new() { Type = "All", Description = "All Types", IsActive = true }
                    };
                    StateHasChanged();
                });
            }
        });
    }

    private async Task FetchReport()
    {
        try
        {
            IsLoading = true;
            HasSearched = true;
            LoadingMessage = "Loading report...";
            DocumentGroups.Clear();
            _fullReportCacheValid = false;
            _fullReportCache.Clear();
            StateHasChanged();

            _lastStartDate = StartDate.Date;
            _lastEndDate = EndDate.Date;
            _lastServiceLocation = SelectedServiceLocation;
            _lastCustomerType = SelectedCustomerType;

            var allItems = await EnsureFullReportDataAsync();

            var grouped = allItems
                .GroupBy(i => string.IsNullOrWhiteSpace(i.CustomerType) ? "Unknown" : i.CustomerType)
                .Select(g => new ReportGroup<RepairServices>
                {
                    GroupName = g.Key,
                    Items = g.OrderByDescending(x => x.reportNo).ToList()
                });

            if (_lastCustomerType != "All")
                grouped = grouped.Where(g => g.GroupName == _lastCustomerType);

            DocumentGroups = grouped.OrderBy(g => g.GroupName).ToList();
        }
        catch (Exception)
        {
            DocumentGroups.Clear();
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task<List<RepairServices>> EnsureFullReportDataAsync()
    {
        if (_fullReportCacheValid) return _fullReportCache;

        var cacheKey = CacheKeys.MonthlyReport(_lastStartDate, _lastEndDate, _lastServiceLocation, "All");

        var lean = await Cache.GetOrSetAsync(
            cacheKey,
            async () =>
            {
                var full = await FetchAndEnrichFullReportDataAsync(loadSpareParts: false);
                return full.Select(TrimForDocumentCache).ToList();
            },
            TimeSpan.FromMinutes(15)
        );

        _fullReportCache = lean ?? new List<RepairServices>();
        _fullReportCacheValid = true;
        return _fullReportCache;
    }

    private async Task<List<RepairServices>> EnsureFullExportDataAsync()
        => await FetchAndEnrichFullReportDataAsync(loadSpareParts: true);

    private static RepairServices TrimForDocumentCache(RepairServices s) => new RepairServices
    {
        Id = s.Id,
        ServiceDate = s.ServiceDate,
        reportNo = s.reportNo,
        itemName = s.itemName,
        serialNumber = s.serialNumber,
        Status = s.Status,
        CompanyName = s.CompanyName,
        CustomerType = s.CustomerType,
        repairDate = s.repairDate,
        finishedDate = s.finishedDate,
    };

    private async Task<List<RepairServices>> FetchAndEnrichFullReportDataAsync(bool loadSpareParts)
    {
        var all = new List<RepairServices>();
        const int pageSize = 200;

        var firstPage = await RepairService.SearchRepairServicesAsync(
            pageNumber: 1, pageSize: pageSize,
            fromDate: _lastStartDate, toDate: _lastEndDate,
            useProcessDateFiltering: true,
            statusesForProcessFiltering: _relevantStatuses,
            serviceLocation: _lastServiceLocation != "All" ? _lastServiceLocation : null,
            sortBy: "reportNo", sortDescending: true,
            companyNames: null);

        all.AddRange(firstPage?.Items ?? Enumerable.Empty<RepairServices>());
        var totalPages = (int)Math.Ceiling((firstPage?.TotalCount ?? 0) / (double)pageSize);

        if (totalPages > 1)
        {
            using var throttler = new SemaphoreSlim(8);
            var tasks = Enumerable.Range(2, totalPages - 1).Select(async page =>
            {
                await throttler.WaitAsync();
                try
                {
                    return await RepairService.SearchRepairServicesAsync(
                        pageNumber: page, pageSize: pageSize,
                        fromDate: _lastStartDate, toDate: _lastEndDate,
                        useProcessDateFiltering: true,
                        statusesForProcessFiltering: _relevantStatuses,
                        serviceLocation: _lastServiceLocation != "All" ? _lastServiceLocation : null,
                        sortBy: "reportNo", sortDescending: true,
                        companyNames: null);
                }
                catch (Exception)
                {
                    return null;
                }
                finally { throttler.Release(); }
            });

            var results = await Task.WhenAll(tasks);
            foreach (var r in results)
                if (r?.Items != null) all.AddRange(r.Items);
        }

        LoadingMessage = "Looking up customer types...";
        StateHasChanged();
        await EnrichWithCustomerTypesFor(all);

        if (loadSpareParts)
        {
            LoadingMessage = "Loading spare part details...";
            StateHasChanged();
            await LoadSparePartsForRecordsAsync(all);
        }

        return all;
    }

    private async Task<Dictionary<string, string>> ResolveCompanyTypesAsync(List<string> companyNames)
    {
        var uncached = new List<string>();
        await _companyTypeCacheLock.WaitAsync();
        try
        {
            foreach (var name in companyNames)
                if (!_companyTypeCache.ContainsKey(name))
                    uncached.Add(name);
        }
        finally { _companyTypeCacheLock.Release(); }

        if (uncached.Any())
        {
            var lookupTasks = uncached.Select(async companyName =>
            {
                try
                {
                    var type = await CustomerService.GetCustomerTypeByCompanyName(companyName);
                    return (companyName, type: string.IsNullOrEmpty(type) ? "Unknown" : type);
                }
                catch
                {
                    return (companyName, type: "Unknown");
                }
            });

            var results = await Task.WhenAll(lookupTasks);
            await _companyTypeCacheLock.WaitAsync();
            try { foreach (var r in results) _companyTypeCache[r.companyName] = r.type; }
            finally { _companyTypeCacheLock.Release(); }
        }

        await _companyTypeCacheLock.WaitAsync();
        try { return companyNames.ToDictionary(n => n, n => _companyTypeCache.GetValueOrDefault(n, "Unknown")); }
        finally { _companyTypeCacheLock.Release(); }
    }

    private async Task EnrichWithCustomerTypesFor(List<RepairServices> services)
    {
        try
        {
            var companyNames = services
                .Select(s => s.CompanyName)
                .Distinct()
                .Where(cn => !string.IsNullOrWhiteSpace(cn))
                .ToList();

            if (!companyNames.Any()) return;

            var companyToType = await ResolveCompanyTypesAsync(companyNames);
            foreach (var service in services)
            {
                service.CustomerType = !string.IsNullOrWhiteSpace(service.CompanyName)
                    ? companyToType.GetValueOrDefault(service.CompanyName, "Unknown")
                    : "Unknown";
            }
        }
        catch (Exception)
        {
        }
    }

    private async Task LoadSparePartsForRecordsAsync(List<RepairServices> records)
    {
        var sparePartIds = records
            .SelectMany(s => s.SparePartItems ?? Enumerable.Empty<SparePartItem>())
            .Where(item => item.SparePartId.HasValue)
            .Select(item => item.SparePartId.Value)
            .Distinct()
            .ToList();

        if (!sparePartIds.Any()) return;

        var batchSize = 10;
        var batches = sparePartIds
            .Select((id, index) => new { id, index })
            .GroupBy(x => x.index / batchSize)
            .Select(g => g.Select(x => x.id).ToList())
            .ToList();

        foreach (var batch in batches)
        {
            var tasks = batch.Select(async sparePartId =>
            {
                if (!_sparePartsCache.ContainsKey(sparePartId))
                {
                    try
                    {
                        var sparePart = await SparePartService.GetSparePartByIdAsync(sparePartId);
                        if (sparePart != null) _sparePartsCache[sparePartId] = sparePart;
                    }
                    catch (Exception)
                    {
                    }
                }
            });
            await Task.WhenAll(tasks);
        }

        _spareParts = _sparePartsCache.Values;
    }

    private async Task ShowRepairServiceDetails(RepairServices repairService)
    {
        if (repairService == null) return;
        await LoadSparePartsForRecordsAsync(new List<RepairServices> { repairService });
        _selectedRepairService = repairService;
        isViewDialogVisible = true;
        await DialogEdit.ShowAsync();
    }

    private void OverlayClick(OverlayModalClickEventArgs args) => isViewDialogVisible = false;
    private void CloseDialog() => isViewDialogVisible = false;

    private async Task ShowReportPreview()
    {
        try
        {
            var exportData = await EnsureFullExportDataAsync();
            bool isSameDate = (StartDate.Date == EndDate.Date);
            var report = new MonthlyReportShow();
            report.SetCustomers(new List<Customer>());
            report.SetDataSource(exportData, isSameDate);
            report.Parameters["FromDate"].Value = StartDate.Date;
            if (!isSameDate) report.Parameters["ToDate"].Value = EndDate.Date;

            var toDateParam = report.Parameters["ToDate"] as DevExpress.XtraReports.Parameters.Parameter;
            if (toDateParam != null) toDateParam.Visible = !isSameDate;
            report.Parameters["ServiceLocation"].Value = SelectedServiceLocation;

            byte[] reportData;
            using (var ms = new MemoryStream())
            {
                report.ExportToPdf(ms);
                reportData = ms.ToArray();
            }

            string base64Report = Convert.ToBase64String(reportData);
            await JSRuntime.InvokeVoidAsync("blazorReportsPrint.previewReportInNewTab", base64Report, "ServiceReport.pdf");
        }
        catch (Exception)
        {
        }
    }

    private async Task ShowReportPreview2()
    {
        try
        {
            var exportData = await EnsureFullExportDataAsync();
            var report = new DailyReport();
            var repairByUsers = new List<string>();
            var verifiedByUsers = new List<string>();

            foreach (var service in exportData)
            {
                var repairByName = GetUserNameById(service.repairBy);
                var verifiedByName = GetUserNameById(service.verifiedBy);
                repairByUsers.Add(repairByName);
                verifiedByUsers.Add(verifiedByName);
                service.RepairByName = repairByName;
                service.VerifiedByName = verifiedByName;
            }

            report.Parameters["FromDate"].Value = StartDate;
            report.Parameters["ToDate"].Value = EndDate;
            report.SetDataSource(exportData, repairByUsers, verifiedByUsers, CurrentUserName);

            byte[] reportData;
            using (var ms = new MemoryStream())
            {
                report.ExportToPdf(ms);
                reportData = ms.ToArray();
            }

            await JSRuntime.InvokeVoidAsync("downloadReportPdf", reportData);
        }
        catch (Exception)
        {
        }
    }

    public async Task ExportToExcel()
    {
        var exportData = await EnsureFullExportDataAsync();
        foreach (var service in exportData)
        {
            foreach (var item in service.SparePartItems ?? Enumerable.Empty<SparePartItem>())
            {
                var sparePart = _spareParts.FirstOrDefault(sp => sp.Id == item.SparePartId);
                if (sparePart != null) item.ItemName = sparePart.ItemName;
            }
        }

        using var workbook = new ClosedXML.Excel.XLWorkbook();
        var ws = workbook.Worksheets.Add("Monthly Report");
        var row = 1;
        ws.Cell(row, 1).Value = "Monthly Repair Report";
        ws.Cell(row, 1).Style.Font.Bold = true;
        row++;
        ws.Cell(row, 1).Value = $"From {_lastStartDate:dd/MM/yyyy} To {_lastEndDate:dd/MM/yyyy}";
        row += 2;

        int overallDataStart = row;
        int overallDataEnd = row;

        foreach (var group in DocumentGroups)
        {
            ws.Cell(row, 1).Value = group.GroupName;
            ws.Cell(row, 1).Style.Font.Bold = true;
            row++;

            ws.Cell(row, 1).Value = "Date";
            ws.Cell(row, 2).Value = "Report #";
            ws.Cell(row, 3).Value = "Item Name";
            ws.Cell(row, 4).Value = "Serial Number";
            ws.Cell(row, 5).Value = "Status";
            ws.Range(row, 1, row, 5).Style.Font.Bold = true;
            row++;

            int itemStart = row;
            foreach (var item in group.Items)
            {
                ws.Cell(row, 1).Value = item.ServiceDate.ToString("dd/MM/yyyy");
                ws.Cell(row, 2).Value = item.reportNo;
                ws.Cell(row, 3).Value = item.itemName;
                ws.Cell(row, 4).Value = item.serialNumber;
                ws.Cell(row, 5).Value = string.IsNullOrWhiteSpace(item.Status) ? "-" : item.Status;
                ws.Cell(row, 7).Value = 1;
                row++;
            }
            int itemEnd = row - 1;

            ws.Cell(row, 4).Value = "Total";
            if (itemEnd >= itemStart)
                ws.Cell(row, 5).FormulaA1 = $"=SUBTOTAL(109,G{itemStart}:G{itemEnd})";
            else
                ws.Cell(row, 5).Value = 0;
            ws.Range(row, 4, row, 5).Style.Font.Bold = true;

            overallDataEnd = itemEnd >= itemStart ? itemEnd : overallDataEnd;
            row += 2;
        }

        string ItemCountRange = $"G{overallDataStart}:G{overallDataEnd}";
        string StatusRange = $"E{overallDataStart}:E{overallDataEnd}";
        string StatusFirstCell = $"E{overallDataStart}";

        string VisibleStatusCount(string statusText) =>
            $"=SUMPRODUCT(SUBTOTAL(103,OFFSET({StatusFirstCell},ROW({StatusRange})-ROW({StatusFirstCell}),0,1)),--({StatusRange}=\"{statusText}\"))";

        ws.Cell(row, 4).Value = "Grand Total";
        ws.Cell(row, 5).FormulaA1 = $"=SUBTOTAL(109,{ItemCountRange})";
        ws.Range(row, 4, row, 5).Style.Font.Bold = true;
        row++;

        ws.Cell(row, 1).Value = "Fixed:";
        ws.Cell(row, 2).FormulaA1 = VisibleStatusCount("Finished");
        ws.Cell(row, 3).Value = "Customer Rejected:";
        ws.Cell(row, 4).FormulaA1 = VisibleStatusCount("Customer Rejected");
        ws.Cell(row, 5).Value = "Unrepairable:";
        ws.Cell(row, 6).FormulaA1 = VisibleStatusCount("Unrepairable");

        ws.Column(7).Hide();
        ws.Columns().AdjustToContents();

        using var ms = new MemoryStream();
        workbook.SaveAs(ms);
        await JSRuntime.InvokeVoidAsync("downloadExcelFile", ms.ToArray(), "MonthlyReport.xlsx");
    }

    public string GetUserNameById(Guid? userId)
    {
        if (!userId.HasValue || userId.Value == Guid.Empty) return "None";
        string userIdString = userId.Value.ToString();
        if (!_usersLoaded) return "Loading...";
        if (_userCache.TryGetValue(userIdString, out string username)) return username;
        return "Unknown User";
    }
}
