    public async Task ExportToExcel()
    {
        IsExporting = true;
        StateHasChanged();

        try
        {
            bool isAlwaysCreated = ReportMode == "alwayscreated";
            bool forceServiceDate = isAlwaysCreated || _lastFilterMode == 2;

            var allRecordsResult = await RepairService.SearchRepairServicesAsync(
                pageNumber: 1,
                pageSize: int.MaxValue,
                searchTerm: _lastCompanyName,
                serialNumber: null,
                status: (isAlwaysCreated || _lastFilterMode == 2) && _lastSelectedStatuses?.Any() == true
                    ? string.Join(",", _lastSelectedStatuses)
                    : null,
                serviceType: _lastServiceType != "All" ? _lastServiceType : null,
                serviceLocation: _lastServiceLocation != "All" ? _lastServiceLocation : null,
                fromDate: _lastFromDate,
                toDate: _lastToDate,
                hasContract: null,
                dateFilter: null,
                statusFilter: null,
                sortBy: "ServiceDate",
                sortDescending: true,
                useProcessDateFiltering: !isAlwaysCreated && _lastFilterMode == 1,
                statusesForProcessFiltering: !isAlwaysCreated && _lastFilterMode == 1 && _lastSelectedStatuses?.Any() == true
                    ? _lastSelectedStatuses
                    : null,
                forceServiceDateOnly: forceServiceDate
            );

            var allServices = allRecordsResult.Items.ToList();

            if (!string.IsNullOrEmpty(_lastSelectedCustomerType))
            {
                allServices = await ApplyCustomerTypeFilter(allServices);
                Console.WriteLine($"ExportExcel: CustomerType '{_lastSelectedCustomerType}' → {allServices.Count} records");
            }

            await LoadSparePartsForServices(allServices);

            foreach (var service in allServices)
            {
                service.RepairByName = service.repairBy.HasValue && service.repairBy.Value != Guid.Empty
                    ? GetUserNameById(service.repairBy)
                    : service.setAwaitingCustomerConfirmBy.HasValue && service.setAwaitingCustomerConfirmBy.Value != Guid.Empty
                    ? GetUserNameById(service.setAwaitingCustomerConfirmBy)
                    : service.setAwaitingSparepartBy.HasValue && service.setAwaitingSparepartBy.Value != Guid.Empty
                    ? GetUserNameById(service.setAwaitingSparepartBy)
                    : service.thirdPartyRepairBy.HasValue && service.thirdPartyRepairBy.Value != Guid.Empty
                    ? GetUserNameById(service.thirdPartyRepairBy)
                    : "None";

                service.VerifiedByName = GetUserNameById(service.verifiedBy);

                foreach (var item in service.SparePartItems ?? Enumerable.Empty<SparePartItem>())
                {
                    var sparePart = _spareParts.FirstOrDefault(sp => sp.Id == item.SparePartId);
                    if (sparePart != null)
                        item.ItemName = sparePart.ItemName;
                }
            }

            var exportGroups = allServices
                .GroupBy(s => string.IsNullOrWhiteSpace(s.Status) ? "Unknown" : GetKhmerStatus(s.Status))
                .Select(g => new { GroupName = g.Key, Items = g.OrderByDescending(x => x.ServiceDate).ToList() })
                .OrderBy(g => g.GroupName)
                .ToList();

            using var workbook = new ClosedXML.Excel.XLWorkbook();
            var ws = workbook.Worksheets.Add("Daily Report");
            var row = 1;
            ws.Cell(row, 1).Value = "Daily Repair Report";
            ws.Cell(row, 1).Style.Font.Bold = true;
            row++;
            ws.Cell(row, 1).Value = BuildSubHeader();
            row += 2;

            int overallDataStart = row;
            int overallDataEnd = row;

            foreach (var group in exportGroups)
            {
                ws.Cell(row, 1).Value = group.GroupName;
                ws.Cell(row, 1).Style.Font.Bold = true;
                row++;

                ws.Cell(row, 1).Value = "Date";
                ws.Cell(row, 2).Value = "Report #";
                ws.Cell(row, 3).Value = "Company";
                ws.Cell(row, 4).Value = "Item Name";
                ws.Cell(row, 5).Value = "Serial Number";
                ws.Cell(row, 6).Value = "Service Type";
                ws.Cell(row, 7).Value = "Status";
                ws.Range(row, 1, row, 7).Style.Font.Bold = true;
                row++;

                int itemStart = row;
                foreach (var item in group.Items)
                {
                    ws.Cell(row, 1).Value = item.ServiceDate.ToString("dd/MM/yyyy HH:mm");
                    ws.Cell(row, 2).Value = item.reportNo;
                    ws.Cell(row, 3).Value = item.CompanyName;
                    ws.Cell(row, 4).Value = item.itemName;
                    ws.Cell(row, 5).Value = item.serialNumber;
                    ws.Cell(row, 6).Value = item.ServiceType;
                    ws.Cell(row, 7).Value = string.IsNullOrWhiteSpace(item.Status) ? "-" : item.Status;
                    ws.Cell(row, 9).Value = 1;
                    row++;
                }
                int itemEnd = row - 1;

                ws.Cell(row, 6).Value = "Total";
                if (itemEnd >= itemStart)
                    ws.Cell(row, 7).FormulaA1 = $"=SUBTOTAL(109,I{itemStart}:I{itemEnd})";
                else
                    ws.Cell(row, 7).Value = 0;
                ws.Range(row, 6, row, 7).Style.Font.Bold = true;

                overallDataEnd = itemEnd >= itemStart ? itemEnd : overallDataEnd;
                row += 2;
            }

            ws.Cell(row, 6).Value = "Grand Total";
            ws.Cell(row, 7).FormulaA1 = $"=SUBTOTAL(109,I{overallDataStart}:I{overallDataEnd})";
            ws.Range(row, 6, row, 7).Style.Font.Bold = true;

            ws.Column(9).Hide();
            ws.Columns().AdjustToContents();

            using var ms = new MemoryStream();
            workbook.SaveAs(ms);
            await JSRuntime.InvokeVoidAsync("downloadExcelFile", ms.ToArray(), $"DailyReport_{DateTime.Now:yyyyMMdd_HHmm}.xlsx");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error exporting to Excel: {ex.Message}");
        }
        finally
        {
            IsExporting = false;
            StateHasChanged();
        }
    }

    public string GetUserNameById(Guid? userId)
    {
        if (!userId.HasValue || userId.Value == Guid.Empty)
            return "None";

        string userIdString = userId.Value.ToString();

        if (!_usersLoaded)
            return "Loading...";

        if (_userCache.TryGetValue(userIdString, out string username))
            return username;

        return "Unknown User";
    }
