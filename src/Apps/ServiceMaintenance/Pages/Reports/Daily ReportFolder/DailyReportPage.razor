    private async Task InitializePageData()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authenticationState.User;

        if (user.Identity.IsAuthenticated)
        {
            CurrentUserName = user.Identity.Name;
        }

        // Load statuses
        var statuses = await RepairService.GetServiceStatusesAsync();
        StatusList = statuses.Select(s => new ServiceStatusViewModel
        {
            DisplayName = StatusTranslations.ContainsKey(s.Name)
                ? $"{s.Name} - {StatusTranslations[s.Name]}"
                : s.Name,
            Value = s.Name
        }).ToList();

        // Load service types
        var serviceTypes = await RepairService.GetServiceTypesAsync();
        ServiceTypeOptions = serviceTypes.ToList();

        // Load spare parts (first page only)
        var sparePartsResult = await SparePartService.GetSparePartsPagedAsync(pageNumber: 1, pageSize: 10);
        _spareParts = sparePartsResult.Items.ToList();

        // Load customers (first page only)
        var customersResult = await CustomerService.GetCustomersPaginatedAsync(pageNumber: 1, pageSize: 10);
        _customers = customersResult.Data.ToList();
        _customerTypes = await CustomerService.GetAllCustomerTypesAsync();

        await LoadAllUsersAsync();
    }

    private async Task LoadAllUsersAsync()
    {
        if (_usersLoaded)
            return;

        try
        {
            Console.WriteLine("📥 Loading all users from API...");
            _userCache = await GlobalUserCache.GetUsersAsync();
            _usersLoaded = true;
            Console.WriteLine($"✅ Loaded {_userCache.Count} users into cache");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading users: {ex.Message}");
            _userCache = new Dictionary<string, string>();
        }
    }

    private string BuildReportCacheKey(int page, int size)
    {
        bool isAlwaysCreated = ReportMode == "alwayscreated";

        var statusPart = (isAlwaysCreated || _lastFilterMode == 2) && _lastSelectedStatuses?.Any() == true
            ? string.Join("-", _lastSelectedStatuses.OrderBy(s => s))
            : "none";

        var keyParts = new[]
        {
        $"page{page}",
        $"size{size}",
        $"company{_lastCompanyName ?? "all"}",
        $"loc{_lastServiceLocation}",
        $"type{_lastServiceType}",
        $"from{_lastFromDate:yyyyMMdd}",
        $"to{_lastToDate:yyyyMMdd}",
        $"mode{_lastFilterMode}",
        $"report{ReportMode}",
        $"custtype{_lastSelectedCustomerType}",
        $"status{statusPart}"
    };

        return $"{CacheKeys.PrefixRepairItem}dailyreport:{string.Join(":", keyParts)}";
    }

    private async Task<List<RepairServices>> ApplyCustomerTypeFilter(List<RepairServices> services)
    {
        try
        {
            var matchingCompanyNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            int page = 1;
            bool hasMore = true;

            while (hasMore)
            {
                var pagedResponse = await CustomerService.GetCustomersPaginatedAsync(
                    pageNumber: page,
                    pageSize: 100,
                    isActive: true
                );

                if (pagedResponse?.Data != null && pagedResponse.Data.Any())
                {
                    foreach (var c in pagedResponse.Data)
                    {
                        if (!string.IsNullOrWhiteSpace(c.CompanyName) &&
                            c.CustomerType == SelectedCustomerType)
                        {
                            matchingCompanyNames.Add(c.CompanyName.Trim());
                        }
                    }
                    hasMore = pagedResponse.HasNext;
                    page++;
                }
                else
                {
                    hasMore = false;
                }
            }

            return services
                .Where(r => !string.IsNullOrWhiteSpace(r.CompanyName) &&
                            matchingCompanyNames.Contains(r.CompanyName.Trim()))
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ApplyCustomerTypeFilter: {ex.Message}");
            return services;
        }
    }

