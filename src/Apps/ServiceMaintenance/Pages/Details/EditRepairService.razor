@implements IDisposable
@using ServiceMaintenance.Models
@inject RepairItemService RepairItemService
@inject ItemService ItemService
@inject CustomerService CustomerService
@inject ServiceSparePart SparePartService
@inject InspectItemService InspectItemService
@inject StateManagementAction StateManagementAction
@inject IJSRuntime JSRuntime
@inject AwaitingCustomerConfirmService AwaitingCustomerConfirmService
@inject CustomerRejectedService CustomerRejectedService
@inject AwaitingSparePartService AwaitingSparePartService
@inject ThirdPartyRepairService ThirdPartyRepairService
@inject UnrepairableService UnrepairableService

<div class="edit-modal">
    <div class="edit-modal-content">
        <div class="edit-modal-header">
            <h2 class="edit-modal-title">Edit Repair Service - @EditModel?.ReportNo</h2>
            <button class="close-btn" @onclick="CloseModal">&times;</button>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="success-message">
                <i class="fas fa-check-circle"></i> @successMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert-danger">
                <i class="fas fa-exclamation-circle"></i> @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(warningMessage))
        {
            <div class="alert-warning">
                <i class="fas fa-exclamation-triangle"></i> @warningMessage
            </div>
        }

        @if (EditModel != null)
        {
            <EditForm Model="EditModel" OnValidSubmit="HandleSubmit">
                <DataAnnotationsValidator />


                <div class="form-section">

                    <h3 class="section-title">Customer Information</h3>

                    <div class="form-row">

                        <div class="form-group">

                            <label class="form-label">Company Name *</label>

                            <input type="text"
                                   class="form-control"
                                   @bind="customerSearchTerm"
                                   @oninput="OnCustomerSearchInput"
                                   @onclick="OnCustomerInputClick"
                                   @onblur="OnCustomerInputBlur"
                                   placeholder="Type to search company (min 2 characters)..."
                                   style="font-family: 'Khmer OS'" />

                            @if (IsCustomerDropdownVisible && FilteredCustomers.Any())

                            {

                                <div class="customer-dropdown" @onmousedown:preventDefault>

                                    <div class="dropdown-header">

                                        <span style="font-size: 12px; color: #6c757d;">

                                            <strong>Select a company (showing @FilteredCustomers.Count() results)</strong>

                                        </span>

                                        <button class="dropdown-close-btn"
                                                @onclick="CloseCustomerDropdown"
                                                type="button">

                                            �

                                        </button>

                                    </div>

                                    @foreach (var customer in FilteredCustomers)

                                    {

                                        <div class="dropdown-item" @onclick="() => OnCustomerSelect(customer)">

                                            <div style="font-weight: 500;">@customer.CompanyName</div>

                                            <div style="font-size: 12px; color: #6c757d;">@customer.ContactName</div>

                                        </div>

                                    }

                                </div>

                            }

                            else if (!string.IsNullOrWhiteSpace(customerSearchTerm) &&

                            customerSearchTerm.Length >= 2 &&

                            !FilteredCustomers.Any())

                            {

                                <div style="position: absolute; width: 100%; margin-top: 5px; top: 100%;">

                                    <div class="no-results">

                                        <i class="fas fa-exclamation-triangle"></i>

                                        No customers found matching "@customerSearchTerm"

                                    </div>

                                </div>

                            }

                            <ValidationMessage For="@(() => EditModel.CompanyName)" />

                        </div>

                        <div class="form-group">

                            <label class="form-label">Contact Name</label>

                            <InputText class="form-control" @bind-Value="EditModel.ContactName" readonly />

                        </div>

                    </div>

                    <div class="form-row">

                        <div class="form-group">

                            <label class="form-label">Address *</label>

                            <InputText class="form-control" @bind-Value="EditModel.Address" readonly />

                            <ValidationMessage For="@(() => EditModel.Address)" />

                        </div>

                        <div class="form-group">

                            <label class="form-label">Phone Number *</label>

                            <InputText class="form-control" @bind-Value="EditModel.PhoneNumber" readonly />

                            <ValidationMessage For="@(() => EditModel.PhoneNumber)" />

                        </div>

                    </div>

                </div>

                <div class="form-section">
                    <h3 class="section-title">Service Details</h3>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Report No</label>
                            <InputText class="form-control" @bind-Value="EditModel.ReportNo" disabled />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Service Date *</label>
                            <InputDate class="form-control" @bind-Value="EditModel.ServiceDate" />
                            <ValidationMessage For="@(() => EditModel.ServiceDate)" />
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Service Location</label>
                            <InputText class="form-control" @bind-Value="EditModel.ServiceLocation" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">Service Type</label>
                            <InputSelect class="form-control" @bind-Value="EditModel.ServiceTypeId">
                                <option value="0">Select Type</option>
                                @foreach (var type in serviceTypes)
                                {
                                    <option value="@type.Id">@type.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">Service Priority</label>
                            <InputSelect class="form-control" @bind-Value="EditModel.ServicePriorityId">
                                <option value="0">Select Priority</option>
                                @foreach (var priority in servicePriorities)
                                {
                                    <option value="@priority.Id">@priority.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Status</label>
                            <InputSelect class="form-control" @bind-Value="EditModel.StatusId">
                                <option value="0">Select Status</option>
                                @foreach (var status in serviceStatuses)
                                {
                                    <option value="@status.Id">@status.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">
                                <InputCheckbox @bind-Value="EditModel.HasContract" /> Has Contract
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="section-title">Service Description</h3>
                    <div class="form-group">
                        <label class="form-label">Customer Request</label>
                        <InputTextArea class="form-control textarea-control" @bind-Value="EditModel.CustomerRequest" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Inspection</label>
                        <InputTextArea class="form-control textarea-control" @bind-Value="EditModel.Inspection" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Solution</label>
                        <InputTextArea class="form-control textarea-control" @bind-Value="EditModel.Solution" />
                    </div>
                </div>

               <div class="form-section">
                    <h3 class="section-title">Spare Parts</h3>
                    
                    <div class="spare-parts-container">
                        <!-- Desktop Table View -->
                        <div class="table-responsive d-none d-lg-block">
                            <table class="modern-table">
                                <thead>
                                    <tr>
                                        <th>Spare Part</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-center">Condition</th>
                                        <th class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (EditModel.SparePartItems != null && EditModel.SparePartItems.Any())
                                    {
                                        @for (int index = 0; index < EditModel.SparePartItems.Count; index++)
                                        {
                                            var sparePart = EditModel.SparePartItems[index];
                                            var currentIndex = index;

                                            <tr class="table-row">
                                                <td class="spare-part-cell">
                                                    <SfComboBox TValue="Guid?" TItem="SparePartObject"
                                                                Placeholder="Select Spare Part"
                                                                @bind-Value="sparePart.SparePartId"
                                                                DataSource="@filteredSpareParts"
                                                                AllowFiltering="true"
                                                                AllowCustom="false"
                                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                PopupWidth="400px"
                                                                Enabled="@(!isSubmitting)"
                                                                CssClass="modern-combo">
                                                        <ComboBoxEvents Filtering="OnFilteringSparePart" TValue="Guid?" TItem="SparePartObject"></ComboBoxEvents>
                                                        <ComboBoxFieldSettings Value="Id" Text="ItemName"></ComboBoxFieldSettings>
                                                        <ComboBoxTemplates TItem="SparePartObject">
                                                            <ItemTemplate Context="sparePartItem">
                                                                <div class="combo-item">
                                                                    <img src="@sparePartItem.PictureUrl"
                                                                         alt="@sparePartItem.ItemName"
                                                                         class="combo-item-image" />
                                                                    <div class="combo-item-details">
                                                                        <div class="combo-item-header">
                                                                            <strong class="item-name">@sparePartItem.ItemName</strong>
                                                                            <span class="serial-number">@sparePartItem.SerialNumber</span>
                                                                        </div>
                                                                        <div class="combo-item-info">
                                                                            <span>@sparePartItem.Description</span>
                                                                            <span class="divider">|</span>
                                                                            <span>Use: @sparePartItem.UseFor</span>
                                                                        </div>
                                                                        <!-- ? ADD STOCK INDICATOR -->
                                                                        <div class="stock-indicator-row">
                                                                            @{
                                                                                var stockLevel = sparePartItem.Quantity;
                                                                                var stockColor = GetStockColorForCombo(stockLevel);
                                                                                var stockIcon = GetStockIconForCombo(stockLevel);
                                                                                var stockText = GetStockTextForCombo(stockLevel);
                                                                            }
                                                                            <span class="stock-badge" style="background-color: @stockColor; color: white; padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; font-weight: 600;">
                                                                                <i class="@stockIcon"></i> @stockText (@stockLevel available)
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                    <button type="button"
                                                                            class="btn-view-details"
                                                                            @onclick="() => ShowFullDetails(sparePartItem)"
                                                                            @onclick:stopPropagation="true">
                                                                        <i class="fa fa-eye"></i>
                                                                    </button>
                                                                </div>
                                                            </ItemTemplate>
                                                            <NoRecordsTemplate>
                                                                @if (isSparePartLoading)
                                                                {
                                                                    <div class="loading-state">
                                                                        <span class="spinner-border spinner-border-sm"></span>
                                                                        <span>Searching spare parts...</span>
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="no-records">
                                                                        <i class="fas fa-search"></i>
                                                                        <span>No matching spare parts found</span>
                                                                    </div>
                                                                }
                                                            </NoRecordsTemplate>
                                                        </ComboBoxTemplates>
                                                    </SfComboBox>
                                                </td>

                                                <td class="quantity-cell">
                                                    <InputNumber @bind-Value="sparePart.Quantity"
                                                                 class="form-control modern-input"
                                                                 disabled="@isSubmitting"
                                                                 min="0" />
                                                </td>

                                                <td class="condition-cell">
                                                    <SfComboBox TValue="string" TItem="string"
                                                                Placeholder="Select Condition"
                                                                @bind-Value="sparePart.Condition"
                                                                DataSource="@_repairConditions"
                                                                AllowFiltering="true"
                                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                Enabled="@(!isSubmitting)"
                                                                CssClass="modern-combo">
                                                    </SfComboBox>
                                                </td>

                                                <td class="action-cell">
                                                    <button type="button"
                                                            class="btn-remove"
                                                            @onclick="() => RemoveSparePart(sparePart)"
                                                            disabled="@isSubmitting"
                                                            title="Remove spare part">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" class="empty-state">
                                                <i class="fas fa-inbox"></i>
                                                <p>No spare parts added yet</p>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- Mobile Card View -->
                        <div class="d-block d-lg-none">
                            @if (EditModel.SparePartItems != null && EditModel.SparePartItems.Any())
                            {
                                @for (int index = 0; index < EditModel.SparePartItems.Count; index++)
                                {
                                    var sparePart = EditModel.SparePartItems[index];
                                    var currentIndex = index;

                                    <div class="spare-part-card">
                                        <div class="card-header-mobile">
                                            <h6>Spare Part #@(index + 1)</h6>
                                            <button type="button"
                                                    class="btn-remove-mobile"
                                                    @onclick="() => RemoveSparePart(sparePart)"
                                                    disabled="@isSubmitting">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>

                                        <div class="card-body-mobile">
                                            <div class="mobile-field">
                                                <label>Spare Part</label>
                                                <SfComboBox TValue="Guid?" TItem="SparePartObject"
                                                            Placeholder="Select Spare Part"
                                                            @bind-Value="sparePart.SparePartId"
                                                            DataSource="@filteredSpareParts"
                                                            AllowFiltering="true"
                                                            AllowCustom="false"
                                                            FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                            PopupWidth="90%"
                                                            Enabled="@(!isSubmitting)"
                                                            CssClass="modern-combo">
                                                    <ComboBoxEvents Filtering="OnFilteringSparePart" TValue="Guid?" TItem="SparePartObject"></ComboBoxEvents>
                                                    <ComboBoxFieldSettings Value="Id" Text="ItemName"></ComboBoxFieldSettings>
                                                    <ComboBoxTemplates TItem="SparePartObject">
                                                        <ItemTemplate Context="sparePartItem">
                                                            <div class="combo-item-mobile">
                                                                <img src="@sparePartItem.PictureUrl"
                                                                     alt="@sparePartItem.ItemName"
                                                                     class="combo-item-image-mobile" />
                                                                <div class="combo-item-details-mobile">
                                                                    <strong>@sparePartItem.ItemName</strong>
                                                                    <small>@sparePartItem.SerialNumber</small>
                                                                    <!-- ? ADD MOBILE STOCK INDICATOR -->
                                                                    <div class="stock-indicator-row" style="margin-top: 0.25rem;">
                                                                        @{
                                                                            var stockLevel = sparePartItem.Quantity;
                                                                            var stockColor = GetStockColorForCombo(stockLevel);
                                                                            var stockIcon = GetStockIconForCombo(stockLevel);
                                                                            var stockText = GetStockTextForCombo(stockLevel);
                                                                        }
                                                                        <span class="stock-badge" style="background-color: @stockColor; color: white; padding: 2px 6px; border-radius: 4px; font-size: 0.65rem; font-weight: 600;">
                                                                            <i class="@stockIcon"></i> @stockLevel
                                                                        </span>
                                                                    </div>
                                                                </div>
                                                                <button type="button"
                                                                        class="btn-view-details-mobile"
                                                                        @onclick="() => ShowFullDetails(sparePartItem)"
                                                                        @onclick:stopPropagation="true">
                                                                    <i class="fa fa-eye"></i>
                                                                </button>
                                                            </div>
                                                        </ItemTemplate>
                                                        <NoRecordsTemplate>
                                                            @if (isSparePartLoading)
                                                            {
                                                                <div class="loading-state">
                                                                    <span class="spinner-border spinner-border-sm"></span>
                                                                    <span>Searching...</span>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="no-records">
                                                                    <span>No results</span>
                                                                </div>
                                                            }
                                                        </NoRecordsTemplate>
                                                    </ComboBoxTemplates>
                                                </SfComboBox>
                                            </div>

                                            <div class="mobile-row">
                                                <div class="mobile-field">
                                                    <label>Quantity</label>
                                                    <InputNumber @bind-Value="sparePart.Quantity"
                                                                 class="form-control modern-input"
                                                                 disabled="@isSubmitting"
                                                                 min="0" />
                                                </div>

                                                <div class="mobile-field">
                                                    <label>Condition</label>
                                                    <SfComboBox TValue="string" TItem="string"
                                                                Placeholder="Select"
                                                                @bind-Value="sparePart.Condition"
                                                                DataSource="@_repairConditions"
                                                                AllowFiltering="true"
                                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                                Enabled="@(!isSubmitting)"
                                                                CssClass="modern-combo">
                                                    </SfComboBox>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="empty-state-mobile">
                                    <i class="fas fa-inbox"></i>
                                    <p>No spare parts added yet</p>
                                </div>
                            }
                        </div>

                        <!-- Add Button -->
                        <button type="button"
                                class="btn-add-spare"
                                @onclick="AddSparePart"
                                disabled="@isSubmitting">
                            <i class="fas fa-plus"></i>
                            <span>Add Spare Part</span>
                        </button>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        @if (isSubmitting)
                        {
                            <span>Saving...</span>
                        }
                        else
                        {
                            <span><i class="fas fa-save"></i> Save Changes</span>
                        }
                    </button>
                </div>
            </EditForm>
        }
    </div>
</div>
<SfDialog IsModal="true" @bind-Visible="isSparePartDialogVisible" Width="600px" Header="Spare Part Details" ShowCloseIcon="true">
    <div class="modal-content" style="padding: 20px;">
        <div class="row">
            <div class="col-md-4">
                <img src="@selectedSparePartForView?.PictureUrl" alt="@selectedSparePartForView?.ItemName" 
                     style="width: 100%; height: auto; border-radius: 8px; object-fit: cover;" />
            </div>
            <div class="col-md-8">
                <div style="margin-top: 10px;">
                    <p><strong>Item Name:</strong> @selectedSparePartForView?.ItemName</p>
                    <p><strong>Serial Number:</strong> @selectedSparePartForView?.SerialNumber</p>
                    <p><strong>Description:</strong></p>
                    <p class="description-text">@selectedSparePartForView?.Description</p>
                    <p><strong>Use For:</strong> @selectedSparePartForView?.UseFor</p>
                </div>
                <div style="margin-top: 20px;">
                    <button type="button" class="btn btn-primary" @onclick="CloseSparePartDialog">Close</button>
                </div>
            </div>
        </div>
    </div>
</SfDialog>

@code {
    [Parameter] public bool ShowModal { get; set; }
    [Parameter] public EventCallback<bool> ShowModalChanged { get; set; }
    [Parameter] public RepairServices ServiceToEdit { get; set; }
    [Parameter] public EventCallback OnServiceUpdated { get; set; }

    private RepairServiceEditModel EditModel { get; set; }
    private List<ServiceType> serviceTypes = new();
    private List<ServicePriority> servicePriorities = new();
    private List<ServiceStatus> serviceStatuses = new();
    private bool isSubmitting = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;
    private string warningMessage = string.Empty;

    private List<SparePartObject> filteredSpareParts = new();
    private bool isSparePartLoading = false;
    private System.Threading.Timer _sparePartSearchDebounceTimer;
    private List<string> _repairConditions = new List<string> { "Fix", "Replace", "Free" };
    private bool isSparePartDialogVisible = false;
    private SparePartObject selectedSparePartForView;
    
    // Customer search variables
    private string customerSearchTerm = string.Empty;
    private bool IsCustomerDropdownVisible { get; set; } = false;
    private IEnumerable<Customer> _customers = new List<Customer>();
    private System.Threading.Timer _customerSearchDebounceTimer;

    private IEnumerable<Customer> FilteredCustomers => _customers;

    protected override async Task OnParametersSetAsync()
    {
        if (ShowModal)
        {
            if (ServiceToEdit == null)
            {
                errorMessage = "No service selected for editing.";
                return;
            }

            await LoadDropdownData();
            await LoadInitialCustomers();
            // ? DON'T load spare parts here - only load when needed
            await LoadEditModel();
        }
    }

    private async Task LoadDropdownData()
    {
        try
        {
            serviceTypes = (await RepairItemService.GetServiceTypesAsync())?.ToList() ?? new();
            servicePriorities = (await RepairItemService.GetServicePrioritiesAsync())?.ToList() ?? new();
            serviceStatuses = (await RepairItemService.GetServiceStatusesAsync())?.ToList() ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dropdown data: {ex.Message}");
            errorMessage = "Failed to load form options. Please try again.";
        }
    }

    private async Task LoadInitialCustomers()
    {
        try
        {
            var customerResult = await CustomerService.GetCustomersPaginatedAsync(pageNumber: 1, pageSize: 10);
            _customers = customerResult.Data;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading initial customers: {ex.Message}");
        }
    }

    private async Task LoadEditModel()
    {
        try
        {
            errorMessage = string.Empty;
            warningMessage = string.Empty;

            if (ServiceToEdit == null)
            {
                errorMessage = "Service data is missing.";
                Console.WriteLine("? ServiceToEdit is null in LoadEditModel");
                return;
            }

            Console.WriteLine($"?? Loading service: {ServiceToEdit.Id}");

            var fullService = await RepairItemService.GetRepairServiceByIdAsync(ServiceToEdit.Id);

            if (fullService == null)
            {
                errorMessage = "Service not found in database.";
                Console.WriteLine($"? GetRepairServiceByIdAsync returned null for ID: {ServiceToEdit.Id}");
                return;
            }

            Console.WriteLine($"? Service loaded: {fullService.reportNo}");

            var customerId = fullService.CustomerId;
            var itemId = fullService.itemId;

            if (customerId == Guid.Empty && !string.IsNullOrWhiteSpace(fullService.CompanyName))
            {
                customerId = await ResolveCustomerId(fullService.CompanyName.Trim());
            }

            if (itemId == Guid.Empty && !string.IsNullOrWhiteSpace(fullService.serialNumber))
            {
                itemId = await ResolveItemId(fullService.serialNumber.Trim());
            }

            var warnings = new List<string>();
            if (customerId == Guid.Empty)
            {
                warnings.Add($"Customer '{fullService.CompanyName}' not found");
            }
            if (itemId == Guid.Empty)
            {
                warnings.Add($"Item '{fullService.serialNumber}' not found");
            }

            if (warnings.Any())
            {
                warningMessage = $"{string.Join(". ", warnings)}. The update may fail if these IDs are required.";
            }

            EditModel = new RepairServiceEditModel
            {
                Id = fullService.Id,
                CustomerId = customerId,
                CompanyName = fullService.CompanyName,
                Address = fullService.Address,
                ContactName = fullService.ContactName,
                PhoneNumber = fullService.PhoneNumber,
                ItemId = itemId,
                ReportNo = fullService.reportNo,
                ServiceDate = fullService.ServiceDate,
                CustomerRequest = fullService.CustomerRequest,
                Inspection = fullService.Inspection,
                Solution = fullService.Solution,
                ServiceLocation = fullService.ServiceLocation,
                HasContract = fullService.hasContract,
                ServiceTypeId = serviceTypes.FirstOrDefault(t => t.Name == fullService.ServiceType)?.Id ?? 0,
                ServicePriorityId = servicePriorities.FirstOrDefault(p => p.Name == fullService.ServicePriority)?.Id ?? 0,
                StatusId = serviceStatuses.FirstOrDefault(s => s.Name == fullService.Status)?.Id ?? 0,
                SparePartItems = fullService.SparePartItems?.Select(sp => new SparePartEditModel
                {
                    Id = sp.Id, // ? ADD THIS LINE
                    SparePartId = sp.SparePartId,
                    Description = sp.Description ?? string.Empty,
                    Quantity = sp.Quantity,
                    Condition = sp.Condition ?? string.Empty
                }).ToList() ?? new()
            };

            // ? OPTIMIZED: Only load spare parts that are already selected
            await LoadSelectedSparePartsOnly(EditModel.SparePartItems);

            customerSearchTerm = fullService.CompanyName ?? string.Empty;

            Console.WriteLine($"? EditModel ready - CustomerId: {EditModel.CustomerId}, ItemId: {EditModel.ItemId}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"? Error: {ex.Message}");
            errorMessage = $"Failed to load service: {ex.Message}";
        }
    }

    // ? NEW: Only load selected spare parts by their IDs
    private async Task LoadSelectedSparePartsOnly(List<SparePartEditModel> spareParts)
    {
        try
        {
            filteredSpareParts.Clear();

            if (spareParts == null || !spareParts.Any())
            {
                Console.WriteLine("?? No spare parts to load");
                return;
            }

            var sparePartIds = spareParts
                .Where(sp => sp.SparePartId.HasValue && sp.SparePartId.Value != Guid.Empty)
                .Select(sp => sp.SparePartId.Value)
                .Distinct()
                .ToList();

            if (!sparePartIds.Any())
            {
                Console.WriteLine("?? No valid spare part IDs found");
                return;
            }

            Console.WriteLine($"?? Loading {sparePartIds.Count} spare parts by ID...");

            // ? Load only the specific spare parts by ID
            foreach (var sparePartId in sparePartIds)
            {
                try
                {
                    var sparePart = await SparePartService.GetSparePartByIdAsync(sparePartId);
                    if (sparePart != null)
                    {
                        filteredSpareParts.Add(sparePart);
                        Console.WriteLine($"? Loaded spare part: {sparePart.ItemName} (ID: {sparePartId})");
                    }
                    else
                    {
                        Console.WriteLine($"?? Spare part not found: {sparePartId}");
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"? Error loading spare part {sparePartId}: {ex.Message}");
                }
            }

            Console.WriteLine($"? Total spare parts loaded: {filteredSpareParts.Count}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"? Error in LoadSelectedSparePartsOnly: {ex.Message}");
            filteredSpareParts.Clear();
        }
    }

