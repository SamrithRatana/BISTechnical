@page "/users-management/roles/{UserId}"
@using ServiceMaintenance.Services
@inject JwtUserManagementService UserManagementService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "SuperAdmin")]

<div class="manage-roles-container">
    <div class="page-header">
        <div>
            <h2 class="page-title">Manage User Roles</h2>
            <p class="page-subtitle">Assign and manage roles for user access control</p>
        </div>
        <button class="btn btn-secondary" @onclick="GoBack">
            ? Back to Users
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Loading user roles...</p>
        </div>
    }
    else if (userRoles == null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> Unable to load user roles
        </div>
        <button class="btn btn-secondary" @onclick="GoBack">Go Back</button>
    }
    else
    {
        @if (!string.IsNullOrEmpty(messageText))
        {
            <div class="alert @(messageType == "success" ? "alert-success" : "alert-danger")">
                @messageText
                <button class="btn-close-alert" @onclick="@(() => messageText = null)">×</button>
            </div>
        }

        <!-- User Info Card -->
        <div class="user-info-card">
            <div class="user-info-header">
                <div class="user-avatar">
                    <span>@GetInitials(userRoles.UserName)</span>
                </div>
                <div class="user-details">
                    <h3>@userRoles.UserName</h3>
                    <p class="user-id">User ID: @userRoles.UserId</p>
                </div>
            </div>
        </div>

        <!-- Roles Management Card -->
        <div class="roles-card">
            <div class="card-header">
                <h4>Available Roles</h4>
                <p>Select the roles you want to assign to this user</p>
            </div>

            <div class="roles-grid">
                @foreach (var role in userRoles.Roles)
                {
                    <div class="role-item @(role.IsAssigned ? "role-assigned" : "")">
                        <div class="role-checkbox-container">
                            <input type="checkbox"
                                   id="role-@role.Id"
                                   checked="@role.IsAssigned"
                                   @onchange="@(e => ToggleRole(role, (bool)e.Value))" />
                            <label for="role-@role.Id">
                                <span class="role-icon">@GetRoleIcon(role.Name)</span>
                                <div class="role-info">
                                    <span class="role-name">@role.Name</span>
                                    <span class="role-description">@GetRoleDescription(role.Name)</span>
                                </div>
                            </label>
                        </div>
                        @if (role.IsAssigned)
                        {
                            <span class="assigned-badge">? Assigned</span>
                        }
                    </div>
                }
            </div>

            <!-- Summary -->
            <div class="roles-summary">
                <div class="summary-item">
                    <span class="summary-label">Total Roles:</span>
                    <span class="summary-value">@userRoles.Roles.Count</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Assigned:</span>
                    <span class="summary-value assigned">@selectedRoles.Count</span>
                </div>
                <div class="summary-item">
                    <span class="summary-label">Unassigned:</span>
                    <span class="summary-value">@(userRoles.Roles.Count - selectedRoles.Count)</span>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="SaveRoles" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-small"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>?? Save Changes</span>
                    }
                </button>
                <button class="btn btn-secondary" @onclick="ResetChanges" disabled="@isSubmitting">
                    Reset
                </button>
                <button class="btn btn-outline" @onclick="GoBack" disabled="@isSubmitting">
                    Cancel
                </button>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="quick-actions-card">
            <h4>Quick Actions</h4>
            <div class="quick-actions-grid">
                <button class="quick-action-btn" @onclick="SelectAllRoles" disabled="@isSubmitting">
                    <span class="action-icon">?</span>
                    <span>Select All</span>
                </button>
                <button class="quick-action-btn" @onclick="DeselectAllRoles" disabled="@isSubmitting">
                    <span class="action-icon">?</span>
                    <span>Deselect All</span>
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public string UserId { get; set; }

    private UserRolesDto userRoles;
    private List<string> selectedRoles = new();
    private List<string> originalRoles = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string messageText;
    private string messageType;

    protected override async Task OnInitializedAsync()
    {
        await LoadUserRoles();
    }

    private async Task LoadUserRoles()
    {
        isLoading = true;

        var response = await UserManagementService.GetUserRolesAsync(UserId);

        if (response.Status == "Success" && response.Data != null)
        {
            userRoles = response.Data;

            // Initialize selected roles
            selectedRoles = userRoles.Roles
                .Where(r => r.IsAssigned)
                .Select(r => r.Name)
                .ToList();

            originalRoles = new List<string>(selectedRoles);
        }
        else
        {
            ShowMessage(response.Message ?? "Failed to load user roles", "error");
        }

        isLoading = false;
    }

    private void ToggleRole(RoleAssignmentDto role, bool isChecked)
    {
        role.IsAssigned = isChecked;

        if (isChecked && !selectedRoles.Contains(role.Name))
        {
            selectedRoles.Add(role.Name);
        }
        else if (!isChecked && selectedRoles.Contains(role.Name))
        {
            selectedRoles.Remove(role.Name);
        }

        StateHasChanged();
    }

    private async Task SaveRoles()
    {
        isSubmitting = true;
        messageText = null;

        try
        {
            var response = await UserManagementService.UpdateUserRolesAsync(UserId, selectedRoles);

            if (response.Status == "Success")
            {
                ShowMessage("Roles updated successfully", "success");
                originalRoles = new List<string>(selectedRoles);
            }
            else
            {
                ShowMessage(response.Message, "error");
            }
        }
        catch (Exception ex)
        {
            ShowMessage($"Error: {ex.Message}", "error");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void ResetChanges()
    {
        selectedRoles = new List<string>(originalRoles);

        foreach (var role in userRoles.Roles)
        {
            role.IsAssigned = originalRoles.Contains(role.Name);
        }

        messageText = null;
        StateHasChanged();
    }

    private void SelectAllRoles()
    {
        foreach (var role in userRoles.Roles)
        {
            role.IsAssigned = true;
        }
        selectedRoles = userRoles.Roles.Select(r => r.Name).ToList();
        StateHasChanged();
    }

    private void DeselectAllRoles()
    {
        foreach (var role in userRoles.Roles)
        {
            role.IsAssigned = false;
        }
        selectedRoles.Clear();
        StateHasChanged();
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/users");
    }

    private void ShowMessage(string message, string type)
    {
        messageText = message;
        messageType = type;
        StateHasChanged();
    }

    private string GetInitials(string userName)
    {
        if (string.IsNullOrWhiteSpace(userName))
            return "U";

        var parts = userName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();

        return userName.Length >= 2
            ? userName.Substring(0, 2).ToUpper()
            : userName[0].ToString().ToUpper();
    }

    private string GetRoleIcon(string roleName)
    {
        return roleName?.ToLower() switch
        {
            "admin" => "??",
            "manager" => "??",
            "user" => "??",
            _ => "??"
        };
    }

    private string GetRoleDescription(string roleName)
    {
        return roleName?.ToLower() switch
        {
            "admin" => "Full system access and user management",
            "manager" => "Team management and reporting access",
            "user" => "Standard user access to the system",
            _ => "Custom role with specific permissions"
        };
    }
}