@page "/users-management/create"
@using ServiceMaintenance.Services
@using static ServiceMaintenance.Services.JWT.JwtUserManagementService
@inject JwtUserManagementService UserManagementService
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "SuperAdmin")]

<div class="create-user-container">
    <div class="page-header">
        <h2 class="page-title">Create New User</h2>
        <p class="page-subtitle">Add a new user to the system with roles and permissions</p>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @errorMessage
            <button class="btn-close-alert" @onclick="@(() => errorMessage = null)">×</button>
        </div>
    }

    <div class="form-card">
        <EditForm Model="newUser" OnValidSubmit="CreateUser">
            <DataAnnotationsValidator />

            <!-- Personal Information -->
            <div class="form-section">
                <h5 class="section-title">Personal Information</h5>
                <div class="form-row">
                    <div class="form-group">
                        <label>First Name</label>
                        <InputText @bind-Value="newUser.FirstName" class="form-input" placeholder="Enter first name" />
                        <ValidationMessage For="@(() => newUser.FirstName)" />
                    </div>
                    <div class="form-group">
                        <label>Last Name</label>
                        <InputText @bind-Value="newUser.LastName" class="form-input" placeholder="Enter last name" />
                        <ValidationMessage For="@(() => newUser.LastName)" />
                    </div>
                </div>
            </div>

            <!-- Account Details -->
            <div class="form-section">
                <h5 class="section-title">Account Details</h5>
                <div class="form-row">
                    <div class="form-group">
                        <label>Username *</label>
                        <InputText @bind-Value="newUser.UserName" class="form-input" placeholder="Enter username" />
                        <ValidationMessage For="@(() => newUser.UserName)" />
                    </div>
                    <div class="form-group">
                        <label>Email *</label>
                        <InputText @bind-Value="newUser.Email" type="email" class="form-input" placeholder="user@example.com" />
                        <ValidationMessage For="@(() => newUser.Email)" />
                    </div>
                </div>
                <div class="form-group">
                    <label>Phone Number</label>
                    <InputText @bind-Value="newUser.PhoneNumber" class="form-input" placeholder="+1 (555) 000-0000" />
                </div>
            </div>

            <!-- Security -->
            <div class="form-section">
                <h5 class="section-title">Security</h5>
                <div class="form-row">
                    <div class="form-group">
                        <label>Password *</label>
                        <InputText @bind-Value="newUser.Password" type="password" class="form-input" placeholder="Enter password" />
                        <small class="form-text">Minimum 6 characters, at least one uppercase, lowercase, and digit</small>
                        <ValidationMessage For="@(() => newUser.Password)" />
                    </div>
                    <div class="form-group">
                        <label>Confirm Password *</label>
                        <InputText @bind-Value="confirmPassword" type="password" class="form-input" placeholder="Confirm password" />
                    </div>
                </div>
            </div>

            <!-- Roles -->
            <div class="form-section">
                <h5 class="section-title">User Roles</h5>
                <div class="roles-grid">
                    @foreach (var role in availableRoles)
                    {
                        <div class="role-checkbox">
                            <input type="checkbox"
                                   id="role-@role"
                                   checked="@newUser.Roles.Contains(role)"
                                   @onchange="@(e => ToggleRole(role, (bool)e.Value))" />
                            <label for="role-@role">@role</label>
                        </div>
                    }
                </div>
            </div>

            <!-- Actions -->
            <div class="form-actions">
                <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-small"></span>
                        <span>Creating...</span>
                    }
                    else
                    {
                        <span>Create User</span>
                    }
                </button>
                <button type="button" @onclick="Cancel" class="btn btn-secondary" disabled="@isSubmitting">
                    Cancel
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private CreateUserDto newUser = new();
    private string confirmPassword = "";
    private List<string> availableRoles = new List<string> { "Admin", "User", "Manager" };
    private string errorMessage;
    private bool isSubmitting = false;

    private void ToggleRole(string role, bool isChecked)
    {
        if (isChecked && !newUser.Roles.Contains(role))
        {
            newUser.Roles.Add(role);
        }
        else if (!isChecked && newUser.Roles.Contains(role))
        {
            newUser.Roles.Remove(role);
        }
    }

    private async Task CreateUser()
    {
        errorMessage = null;

        // Validate passwords match
        if (newUser.Password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        // Validate required fields
        if (string.IsNullOrWhiteSpace(newUser.UserName) || string.IsNullOrWhiteSpace(newUser.Email))
        {
            errorMessage = "Username and Email are required.";
            return;
        }

        isSubmitting = true;

        try
        {
            var response = await UserManagementService.CreateUserAsync(newUser);

            if (response.Status == "Success")
            {
                NavigationManager.NavigateTo("/users-management");
            }
            else
            {
                errorMessage = response.Message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/users");
    }
}