    // ✅ OPTIMIZED ConfirmCustomerConfirm Method — now sends PNG IMAGE to Telegram instead of PDF
    // ✅ UPDATED — Telegram photo is now only sent when ServiceLocation == "CompanyService".
    // "OnSite" items skip both the image generation and the Telegram send entirely.
    private async Task ConfirmCustomerConfirm()
    {
        if (isSaving)
        {
            return; // Prevent double-click
        }

        try
        {
            isSaving = true;
            StateHasChanged();


            // ==========================================
            // STEP 1: SET USER ID
            // ==========================================
            // ==========================================
            // STEP 1: SET USER ID
            // ==========================================
            Guid userGuid = Guid.Empty;
            if (Guid.TryParse(CurrentUserId, out userGuid))
            {
                FinishItemBy.verifiedBy = userGuid;
                Console.WriteLine($"✅ Setting verifiedBy to: {userGuid}");
            }
            else
            {
                Console.WriteLine("⚠️ Could not parse user ID to Guid");
                FinishItemBy.verifiedBy = Guid.Empty;
            }

            // ✅ NEW — only OnSite items allow a custom Finished Date.
            // CompanyService (and anything else) keeps using server-side "now".
            bool isOnSite = string.Equals(_selectedRepairService?.ServiceLocation, "OnSite", StringComparison.OrdinalIgnoreCase);

            if (isOnSite)
            {
                if (!customFinishedDate.HasValue)
                {
                    isSaving = false;
                    StateHasChanged();

                    ToastNotificationService.ShowToast(new ToastOptions
                    {
                        ProviderName = "Error",
                        Title = "Missing Date",
                        Text = "សូមជ្រើសរើសកាលបរិច្ឆេទបញ្ចប់ការងារសម្រាប់ OnSite",
                        ThemeMode = ToastThemeMode.Pastel,
                        RenderStyle = ToastRenderStyle.Warning
                    });
                    return; // ❗ stop — don't proceed without a date
                }

                FinishItemBy.FinishedDate = customFinishedDate.Value;
            }
            else
            {
                FinishItemBy.FinishedDate = null; // server will use current date
            }

            // ==========================================
            // STEP 2: CRITICAL PATH - API CALL
            // ==========================================
            await FinishItemService.FinishItemAsync(FinishItemBy);
            Console.WriteLine("✅ Item finished in database");

            // ✅ Invalidate Redis cache — Repairing list loses the item, Finished list gains it
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixRepairItem);
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixFinishRepair);
            await Cache.InvalidateAsync(CacheKeys.DashboardStats);

            // ==========================================
            // STEP 3: OPTIMISTIC UI UPDATE (Immediate feedback)
            // ==========================================
            Guid finishedItemId = Guid.Empty;
            string reportNo = string.Empty;

            // ✅ Captured BEFORE any background/async work, and used to
            // generate the PDF synchronously (on this request thread) below,
            // rather than inside Task.Run — DevExpress's reporting engine is not
            // guaranteed safe to call outside the normal request/render context.
            RepairServices capturedService = _selectedRepairService;

            if (_selectedRepairService != null)
            {
                finishedItemId = _selectedRepairService.Id;
                reportNo = _selectedRepairService.reportNo;

                // Remove from main grid immediately
                filteredRepairServices = filteredRepairServices
                    .Where(x => x.Id != finishedItemId)
                    .ToList();

                totalItems--;
                totalPages = totalItems > 0
                    ? (int)Math.Ceiling(totalItems / (double)pageSize)
                    : 0;

                // Adjust current page if needed
                if (currentPage > totalPages && totalPages > 0)
                {
                    currentPage = totalPages;
                }

                // Mark as visible in finished section
                if (!temporarilyVisibleFinishedItems.Contains(finishedItemId))
                {
                    temporarilyVisibleFinishedItems.Add(finishedItemId);
                }

                // Update item's status locally for immediate card display
                _selectedRepairService.finishedDate = DateTime.UtcNow.AddHours(7);
                _selectedRepairService.Status = "Finished";
                _selectedRepairService.verifiedBy = userGuid;

                // Add to finished list at the beginning
                finishedRepairServices = new List<RepairServices> { _selectedRepairService }
                    .Concat(finishedRepairServices)
                    .ToList();

                UpdateFinishedPagination();

                Console.WriteLine($"✅ Optimistic UI update - {totalItems} items remaining");
            }

            // ==========================================
            // STEP 3.5: GENERATE PDF THEN CONVERT TO IMAGE (before backgrounding)
            // ==========================================
            // ✅ Only generated for "CompanyService" items — "OnSite" items don't
            // get sent to Telegram, so skip the (costly) PDF export + PDF→PNG
            // conversion entirely for them.
            // ✅ PDF is generated synchronously on the request thread (DevExpress
            // reporting engine requirement), then IMMEDIATELY converted to a PNG
            // image. Only the image bytes are kept/handed to the background task —
            // the PDF bytes are local and get GC'd right after this block; the
            // PDF itself is never sent anywhere.
            byte[] finishedImageBytes = null;
            string finishedReportFileName = null;

            bool isCompanyService = capturedService != null &&
                string.Equals(capturedService.ServiceLocation, "CompanyService", StringComparison.OrdinalIgnoreCase);

            if (capturedService != null && isCompanyService)
            {
                try
                {
                    // ✅ `Report2` inherits DevExpress.XtraReports.UI.XtraReport
                    // → System.ComponentModel.Component, which implements
                    // IDisposable. It owns child controls (tables, labels,
                    // the ObjectDataSource) that hold onto fonts/layout
                    // resources — without `using`, these leak until the
                    // finalizer thread eventually collects them.
                    using var report = new Report2();

                    string repairByUser = GetUserNameById(capturedService.repairBy);
                    string verifiedByUser = GetUserNameById(userGuid);

                    var phoneNumbers = await Task.WhenAll(
                        GetUserPhoneNumberById(capturedService.repairBy),
                        GetUserPhoneNumberById(userGuid)
                    );

                    if (capturedService.SparePartItems != null && capturedService.SparePartItems.Any())
                    {
                        var validSpareParts = capturedService.SparePartItems
                            .Where(item => item.SparePartId.HasValue && item.SparePartId.Value != Guid.Empty)
                            .ToList();

                        if (validSpareParts.Any())
                        {
                            var fetchTasks = validSpareParts.Select(async item =>
                            {
                                try
                                {
                                    var sparePartDetails = await SparePartService.GetSparePartByIdAsync(item.SparePartId.Value);
                                    if (sparePartDetails != null)
                                    {
                                        item.ItemName = sparePartDetails.ItemName;
                                        item.Description = sparePartDetails.ItemName;
                                        item.SerialNumber = sparePartDetails.SerialNumber;
                                        item.UseFor = sparePartDetails.UseFor;
                                    }
                                }
                                catch (Exception ex)
                                {
                                    Console.WriteLine($"❌ Error fetching spare part {item.SparePartId}: {ex.Message}");
                                }
                            }).ToList();

                            await Task.WhenAll(fetchTasks);
                        }
                    }

                    report.SetParameters(
                        capturedService,
                        capturedService.ServiceLocation,
                        capturedService.SparePartItems,
                        capturedService.hasContract,
                        repairByUser,
                        verifiedByUser,
                        phoneNumbers[0],
                        phoneNumbers[1]
                    );

                    HideReportParameters(report);

                    // Export to PDF in-memory (intermediate step only — never sent as-is)
                    byte[] pdfBytes;
                    using (var pdfMs = new MemoryStream())
                    {
                        report.ExportToPdf(pdfMs);
                        pdfBytes = pdfMs.ToArray();
                    }

                    // Convert first page of the PDF to a PNG image.
                    // ✅ IMPORTANT: SKBitmap wraps unmanaged (native) memory and
                    // MUST be disposed explicitly — the .NET GC does not track
                    // or reclaim native heap allocations on its own schedule.
                    // Without this `using`, each finish-item call would leak a
                    // native bitmap buffer that only gets freed whenever the
                    // finalizer thread happens to run (unpredictable, delayed).
                    using (var pdfStream = new MemoryStream(pdfBytes))
                    using (var bitmap = PDFtoImage.Conversion.ToImage(
                        pdfStream,
                        page: 0,
                        options: new PDFtoImage.RenderOptions(Dpi: 150)))
                    {
                        using var imgMs = new MemoryStream();
                        bitmap.Encode(imgMs, SkiaSharp.SKEncodedImageFormat.Png, 100);
                        finishedImageBytes = imgMs.ToArray();
                    }

                    string sanitizedReportNo = reportNo?.Replace("/", "-").Replace("\\", "-") ?? "Report";
                    finishedReportFileName = $"ServiceReport_{sanitizedReportNo}.png";

                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Failed to generate image for Telegram: {ex.Message}");
                    finishedImageBytes = null;
                }
            }
            else if (capturedService != null)
            {
                Console.WriteLine($"ℹ️ Skipping Telegram image generation — ServiceLocation is '{capturedService.ServiceLocation}', not 'CompanyService'");
            }

            // ==========================================
            // STEP 4: CLOSE DIALOG IMMEDIATELY
            // ==========================================
            isConfirmationDialogVisible = false;
            isSaving = false; // ✅ Reset immediately so user can continue
            StateHasChanged();

            Console.WriteLine("✅ Dialog closed - user can continue working");

            // ==========================================
            // STEP 5: SHOW SUCCESS MESSAGE IMMEDIATELY
            // ==========================================
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Customization",
                Title = "Success",
                Text = $"Item {reportNo} marked as finished",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Success
            });

            // ==========================================
            // STEP 6: BACKGROUND TASKS (Non-blocking, parallel)
            // ==========================================
            _ = Task.Run(async () =>
            {
                var backgroundTasks = new List<Task>();

                // ✅ 1. SignalR broadcast (parallel)
                if (hubConnection?.State == HubConnectionState.Connected)
                {
                    backgroundTasks.Add(
                        hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                        {
                            AffectedStatuses = new[] { "Repairing", "Finished" }
                        })
                            .ContinueWith(t =>
                            {
                                if (t.IsCompletedSuccessfully)
                                    Console.WriteLine("✅ SignalR broadcast sent");
                                else
                                    Console.WriteLine($"⚠️ SignalR failed: {t.Exception?.Message}");
                            })
                    );
                }

                // ✅ 2. Telegram — send the finished report IMAGE to topic "Finished" (48)
                // Only for "CompanyService" items; "OnSite" items are skipped
                // (finishedImageBytes will already be null for them, but the
                // ServiceLocation check is kept here too as a belt-and-braces guard).
                if (finishedImageBytes != null && capturedService != null && isCompanyService)
                {
                    backgroundTasks.Add(Task.Run(async () =>
                    {
                        try
                        {
                            await TelegramQueue.EnqueueAsync(new TelegramMessage
                            {
                                Action = TelegramAction.SendPhoto,   // ✅ ប្តូរពី SendDocument
                                ItemId = finishedItemId,
                                TopicKey = "Finished",
                                FileBytes = finishedImageBytes,
                                FileName = finishedReportFileName,
                                Caption = $"✅ <b>ជួសជុលរួចរាល់</b>\n" +
                               $"លេខ Report: <b>{reportNo}</b>\n" +
                               $"ស្ថាប័ន: {capturedService.CompanyName}\n" +
                               $"ម៉ាស៊ីន: {capturedService.itemName}\n" +
                               $"SerialNumber: {capturedService.serialNumber}"
                            });
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"⚠️ Telegram image enqueue failed: {ex.Message}");
                        }
                    }));
                }
                else if (capturedService != null && !isCompanyService)
                {
                    Console.WriteLine($"ℹ️ Skipping Telegram send — ServiceLocation is '{capturedService.ServiceLocation}', not 'CompanyService'");
                }

                // ✅ Wait for all parallel tasks to complete
                try
                {
                    await Task.WhenAll(backgroundTasks);
                    Console.WriteLine("✅ All notifications sent");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Some notifications failed: {ex.Message}");
                }

                // ✅ 3. Smart background refresh (only if UI might be stale)
                await Task.Delay(2000);

                try
                {
                    var stillExists = filteredRepairServices.Any(x => x.Id == finishedItemId);

                    if (stillExists)
                    {
                        Console.WriteLine("⚠️ Item still in grid - optimistic update may have failed, refreshing...");
                    }

                    await InvokeAsync(async () =>
                    {
                        await LoadPageData();
                        StateHasChanged();
                    });

                    Console.WriteLine("✅ Background grid refresh completed");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Background refresh failed: {ex.Message}");
                }

                Console.WriteLine("ℹ️ Skipping user cache refresh - not needed for finish updates");
            });

            Console.WriteLine("✅ Finish operation completed successfully");
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("timed out"))
        {
            Console.WriteLine($"⏱️ Finish operation timed out: {ex.Message}");

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Timeout",
                Text = "Operation is taking longer than expected. Refreshing data...",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Warning
            });

            await LoadPageData();
            isConfirmationDialogVisible = false;
            isSaving = false;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"❌ Failed to finish item: {ex.Message}");
            Console.Error.WriteLine($"Stack trace: {ex.StackTrace}");

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Error",
                Text = $"Failed to finish item: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });

            await LoadPageData();
            isConfirmationDialogVisible = false;
            isSaving = false;
        }
        finally
        {
            if (isSaving)
            {
                isSaving = false;
                StateHasChanged();
            }

            Console.WriteLine("🏁 Finish operation finalized");
        }
    }


    private async Task LoadFinishedData(string searchTerm = null, string sortOrder = null)
    {
        try
        {
            PaginatedResult<RepairServices> finishedResult;

            if (!string.IsNullOrWhiteSpace(searchTerm) || !string.IsNullOrWhiteSpace(sortOrder))
            {
                // Active search/sort bypasses cache
                finishedResult = await RepairItemService.SearchRepairServicesAsync(
                    pageNumber: currentFinishedPage,
                    pageSize: pageSizeFinished,
                    status: "Finished",
                    searchTerm: searchTerm,
                    sortBy: "reportNo",
                    sortDescending: sortOrder == "Descending"
                );
            }
            else
            {
                finishedResult = await Cache.GetOrSetAsync(
                    CacheKeys.FinishRepair(currentFinishedPage, pageSizeFinished),
                    () => RepairItemService.SearchRepairServicesAsync(
                        pageNumber: currentFinishedPage,
                        pageSize: pageSizeFinished,
                        status: "Finished",
                        sortBy: "reportNo",
                        sortDescending: true),
                    TimeSpan.FromMinutes(3)
                );
            }

            var finishedList = (finishedResult?.Items ?? new List<RepairServices>()).ToList();

            if (temporarilyVisibleFinishedItems.Any())
            {
                finishedRepairServices = finishedList
                    .Where(x => temporarilyVisibleFinishedItems.Contains(x.Id))
                    .ToList();
            }
            else
            {
                finishedRepairServices = finishedList;
            }

            // ✅ Use server-side total count
            totalFinishedPages = finishedResult?.TotalPages ?? 0;

            UpdateFinishedPagination();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading finished data: {ex.Message}");
        }
    }

