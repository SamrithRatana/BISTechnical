    private async Task ToggleGridView()
    {
        isLoading = true;
        StateHasChanged(); // Update the UI to show the spinner

        await Task.Delay(300); // Optional delay to show spinner smoothly (you can remove it if unnecessary)

        showFinishedGrid = !showFinishedGrid;

        isLoading = false;
        StateHasChanged(); // Update the UI to hide the spinner and show grid
    }


    private void UpdateFinishedPagination()
    {
        if (finishedRepairServices == null || !finishedRepairServices.Any())
        {
            totalFinishedPages = 0;
            PaginatedFinishedRepairServices = new List<RepairServices>();
            return;
        }

        totalFinishedPages = (int)Math.Ceiling((double)finishedRepairServices.Count / pageSizeFinished);

        PaginatedFinishedRepairServices = finishedRepairServices
            .Skip((currentFinishedPage - 1) * pageSizeFinished)
            .Take(pageSizeFinished)
            .ToList();
    }
    private async Task GoToFirstFinishedPage()
    {
        if (currentFinishedPage != 1)
        {
            currentFinishedPage = 1;
            await LoadFinishedData(FinishedSearchValue, FinishedSortingValue);
            StateHasChanged();
        }
    }

    private async Task GoToPreviousFinishedPage()
    {
        if (currentFinishedPage > 1)
        {
            currentFinishedPage--;
            await LoadFinishedData(FinishedSearchValue, FinishedSortingValue);
            StateHasChanged();
        }
    }

    private async Task GoToNextFinishedPage()
    {
        if (currentFinishedPage < totalFinishedPages)
        {
            currentFinishedPage++;
            await LoadFinishedData(FinishedSearchValue, FinishedSortingValue);
            StateHasChanged();
        }
    }

    private async Task GoToLastFinishedPage()
    {
        if (currentFinishedPage != totalFinishedPages)
        {
            currentFinishedPage = totalFinishedPages;
            await LoadFinishedData(FinishedSearchValue, FinishedSortingValue);
            StateHasChanged();
        }
    }

    private bool IsFirstFinishedPage => currentFinishedPage == 1;
    private bool IsLastFinishedPage => currentFinishedPage == totalFinishedPages;




