    private string GetUserNameById(Guid? userId)
    {
        if (!userId.HasValue || userId.Value == Guid.Empty)
            return "Unknown";

        string userIdString = userId.Value.ToString();

        if (!_usersLoaded)
            return "Loading...";

        if (_allUsers.TryGetValue(userIdString, out string username))
            return username;

        return "Unknown User";
    }

    private async Task ShowRepairServiceDetails(RepairServices repairService)
    {
        _selectedRepairService = repairService;

        // ✅ CHANGED — was a sequential foreach + await, meaning each spare
        // part detail was fetched one-at-a-time (N round-trips in series).
        // A report with 8-10 spare parts could take several seconds just to
        // open the view dialog. Now all missing spare parts are fetched
        // concurrently with Task.WhenAll — total time ≈ the slowest single
        // call instead of the sum of all calls.
        if (_selectedRepairService?.SparePartItems != null && _selectedRepairService.SparePartItems.Any())
        {
            var missingIds = _selectedRepairService.SparePartItems
                .Where(item => item.SparePartId.HasValue && item.SparePartId.Value != Guid.Empty)
                .Select(item => item.SparePartId.Value)
                .Where(id => !_spareParts.Any(x => x.Id == id))
                .Distinct()
                .ToList();

            if (missingIds.Count > 0)
            {
                var fetchTasks = missingIds.Select(async id =>
                {
                    try
                    {
                        return await SparePartService.GetSparePartByIdAsync(id);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"❌ Error fetching spare part {id}: {ex.Message}");
                        return null;
                    }
                });

                var fetchedResults = await Task.WhenAll(fetchTasks);

                var newlyFetched = fetchedResults.Where(x => x != null);
                _spareParts = _spareParts.Concat(newlyFetched).ToList();
            }
        }

        // ✅ CHANGED — DialogEdit/SfDialog.ShowAsync() no longer exists here
        // (replaced by RepairServiceViewDialog), so just flip the bound
        // Visible flag; the component's own Visible parameter drives it.
        isViewDialogVisible = true;
        StateHasChanged();
    }

    // ✅ CHANGED — RepairServiceViewDialog's OnSaveRemarks callback hands back
    // a (SparePartItem Part, string NewValue) tuple; this wrapper unpacks it
    // and forwards to the existing SaveRemarks logic (persistence/cache/
    // broadcast/toast), which is unchanged.
    private async Task HandleSaveRemarks((SparePartItem Part, string NewValue) args)
    {
        await SaveRemarks(args.Part, args.NewValue);
    }

    private async Task SaveRemarks(SparePartItem sparePart, string newValue)
    {
        try
        {
            var success = await SparePartService.UpdateSparepartItemRemarksAsync(sparePart.Id, newValue);

            if (success)
            {
                var savedAt = DateTime.Now;

                sparePart.Remarks = newValue;
                sparePart.RemarksUpdatedAt = savedAt;

                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixAwaitSparePart);

                if (hubConnection?.State == HubConnectionState.Connected)
                    await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                    {
                        AffectedStatuses = new[] { "Awaiting SparePart" }
                    });

                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Customization",
                    Title = "Saved",
                    Text = "Remark updated",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Success
                });

                // ✅ CHANGED — instead of sending a brand-new "remark updated" message,
                // rebuild the SAME "📦 បានបញ្ជូនទៅផ្នែកស្តុក" notification (all fields +
                // EVERY spare part's own Remarks line, not just the one just edited)
                // and push it as an Edit onto the message already sitting in the
                // "AwaitingSparepart" topic. This keeps one message per item that
                // stays up to date, instead of a new "updated" message per save.
                var service = _selectedRepairService;
                var capturedItemId = service?.Id;
                var capturedReportNo = service?.reportNo;
                var capturedCompanyName = service?.CompanyName;
                var capturedServiceLocation = service?.ServiceLocation;
                var capturedMachineItemName = service?.itemName;
                var capturedMachineSerialNumber = service?.serialNumber;
                var capturedCustomerRequest = service?.CustomerRequest;
                var capturedInspection = service?.Inspection;
                var capturedSolution = service?.Solution;
                var capturedInspectorName = GetUserNameById(service?.inspectBy);
                var capturedSenderName = GetUserNameById(service?.setAwaitingSparepartBy);

                // Snapshot every spare part row on this service (not just the row
                // just edited) so the rebuilt message reflects ALL current remarks.
                // ItemName is resolved via _spareParts (the catalog already loaded
                // for this dialog session by ShowRepairServiceDetails), same lookup
                // pattern used everywhere else in this file.
                var capturedSpareParts = (service?.SparePartItems ?? new List<SparePartItem>())
                    .Where(sp => sp.SparePartId.HasValue && sp.SparePartId.Value != Guid.Empty)
                    .Select(sp =>
                    {
                        var catalogItem = _spareParts.FirstOrDefault(fp => fp.Id == sp.SparePartId.Value);
                        return new
                        {
                            ItemName = catalogItem?.ItemName ?? "Unknown Item",
                            sp.Quantity,
                            sp.Condition,
                            // Reflect the value just saved for the edited row; every
                            // other row keeps whatever remark is already on it.
                            Remarks = sp.Id == sparePart.Id ? newValue : sp.Remarks
                        };
                    })
                    .ToList();

                _ = Task.Run(async () =>
                {
                    try
                    {
                        string sparePartsSection = TelegramMessageHelper.BuildSparePartsSectionWithRemarks(
                              capturedSpareParts.Select(sp => (sp.ItemName, sp.Quantity, sp.Condition, sp.Remarks)));

                        await TelegramQueue.EnqueueAsync(new TelegramMessage
                        {
                            Action = TelegramAction.Edit,
                            ItemId = capturedItemId ?? Guid.Empty,
                            TopicKey = "AwaitingSparepart",
                            ResolveMessageIdFromTopic = true,
                            Text = $"📦 <b>បានបញ្ជូនទៅផ្នែកស្តុក</b>\n\n" +
                                   $"លេខ Report: <b>{capturedReportNo}</b>\n\n" +
                                   $"ស្ថាប័ន: {capturedCompanyName}\n\n" +
                                   $"ទីតាំងជួសជុល: {capturedServiceLocation}\n\n" +
                                   $"ម៉ាស៊ីន: {capturedMachineItemName}\n\n" +
                                   $"SerialNumber: {capturedMachineSerialNumber}\n\n" +
                                   $"សំណើពីអតិថិជន: {capturedCustomerRequest}\n\n" +
                                   $"វិនិច្ឆ័យ: {capturedInspection}\n\n" +
                                   $"ដំណោះស្រាយ: {capturedSolution}\n\n" +
                                   $"ឈ្មោះអ្នកវិនិច្ឆ័យ: {capturedInspectorName}\n\n" +
                                   $"ឈ្មោះអ្នកបញ្ជូន: {capturedSenderName}" +
                                   $"{sparePartsSection}"
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"⚠️ Telegram remark notify failed: {ex.Message}");
                    }
                });
            }
            else
            {
                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Error",
                    Title = "Error",
                    Text = "Failed to save remark",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Danger
                });
            }
        }
        catch (Exception ex)
        {
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Error",
                Text = $"Failed: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }

        StateHasChanged();
    }

