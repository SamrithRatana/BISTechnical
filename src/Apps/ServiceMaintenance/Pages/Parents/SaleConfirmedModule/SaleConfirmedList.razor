@page "/sale-confirmed"
@page "/sale-confirmed/{ReportNo}"
@implements IAsyncDisposable

@using ServiceMaintenance.Components
@using ServiceMaintenance.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Authorization
@using ServiceMaintenance.Services
@using ServiceMaintenance.Services.BISServices
@using Syncfusion.Blazor.Navigations
@using ServiceMaintenance.Infrastructure.Shared.Caching
@inject RepairItemService RepairItemService
@inject SentSparepartsService SentSparepartsService
@inject NavigationManager NavigationManager
@inject ServiceSparePart SparePartService
@inject GlobalUserService GlobalUserCache
@inject PrintPreviewService PrintPreviewService
@inject TelegramNotificationQueue TelegramQueue
@inject CacheHelper Cache

<DxToastProvider Name="Customization"
                 MaxToastCount="5"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 VerticalAlignment="VerticalEdge.Top"
                 AnimationType="@Animation" />
<DxToastProvider Name="Error"
                 MaxToastCount="5"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 VerticalAlignment="VerticalEdge.Top"
                 AnimationType="@Animation" />

<ActionToolbox CanCreate="false"
               CanEdit="false"
               CanDelete="false"
               CanExport="CanExport"
               IsRowSelected="@(_selectedRepairService != null)"
               OnExportExcel="ExportToExcel"
               OnExportPdf="ExportToPdf">
    <CustomActions>
        @if (CanPrint)
        {
            <button type="button" class="soft-btn soft-btn-secondary compact-btn" @onclick="() => ShowReportPreview(_selectedRepairService)" disabled="@(_selectedRepairService == null)">
                <i class="fas fa-print me-1"></i> Print Report
            </button>
        }
    </CustomActions>
</ActionToolbox>
<SfMediaQuery @bind-ActiveBreakPoint="activeBreakpoint"></SfMediaQuery>
@{
    bool enableAdaptiveUIMode = false;
    RowDirection renderingMode = RowDirection.Vertical;

    if (activeBreakpoint == "Small")
    {
        enableAdaptiveUIMode = true;
        renderingMode = RowDirection.Vertical;
    }
    else if (activeBreakpoint == "Medium")
    {
        enableAdaptiveUIMode = true;
        renderingMode = RowDirection.Horizontal;
    }
    else
    {
        enableAdaptiveUIMode = false;
    }
}
@if (CanAccess)
{
    @if (CanView)
    {
        <StatusTabMenu Tabs="Tabs"
                       ActiveTabKey="@ActiveTabKey"
                       OnTabChanged="HandleTabChanged" />

        <div style="margin-bottom: 15px; padding: 15px; background-color: #f9f9f9; border-radius: 4px;">
            <div style="display: flex; gap: 10px; align-items: center;">
                <SfTextBox Placeholder="Search by Report No, Company, Serial Number..."
                           ShowClearButton="true"
                           Width="400px"
                           @bind-Value="GridSearchValue"
                           Input="OnGridSearchInput">
                </SfTextBox>

                <SfButton Content="Search"
                          CssClass="e-btn e-primary"
                          IconCss="fas fa-search"
                          OnClick="PerformGridSearch" />

                <SfButton Content="Clear"
                          CssClass="e-btn e-outline"
                          IconCss="fas fa-times"
                          OnClick="ClearGridSearch" />
            </div>

            @if (!string.IsNullOrEmpty(GridSearchValue))
            {
                <div style="margin-top: 10px; color: #666; font-size: 14px;">
                    <i class="fas fa-info-circle"></i> Searching for: <strong>@GridSearchValue</strong>
                </div>
            }
        </div>

        <SfGrid @ref="MyGrid"
                DataSource="@filteredSaleConfirmed"
                AllowPaging="false"
                AllowSorting="true"
                ShowColumnChooser="true"
                AllowExcelExport="true"
                AllowPdfExport="true"
                SelectionMode="GridSelectionMode.Single"
                Toolbar="@ToolbarItems"
                EnableAdaptiveUI="@enableAdaptiveUIMode"
                RowRenderingMode="@renderingMode"
                AllowResizing="true"
                AllowFiltering="true"
                AllowSelection="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridEvents RowSelected="RowSelectHandler" TValue="RepairServices"></GridEvents>
            <GridColumns>
                <GridColumn Field="Id" HeaderText="Id" Width="150" Format="d" Visible="false" />
                <GridColumn Field="reportNo" HeaderText="@Loc[nameof(ResourceStrings.Textref)]" Width="150" />

                @* ✅ Date column now switches source field depending on the active tab *@
                @if (ActiveTabKey == "Sent Spareparts")
                {
                    <GridColumn Field="sentSparepartsDate" HeaderText="Sent Spareparts Date" Width="150" Format="dd/MM/yyyy HH:mm tt" />
                }
                else
                {
                    <GridColumn Field="saleConfirmedDate" HeaderText="Sale Confirmed Date" Width="150" Format="dd/MM/yyyy HH:mm tt" />
                }

                <GridColumn Field="CompanyName" HeaderText="@Loc[nameof(ResourceStrings.TextCompanyName)]" Width="200" />
                <GridColumn Field="itemName" HeaderText="@Loc[nameof(ResourceStrings.TextItemName)]" Width="200" />
                <GridColumn Field="serialNumber" HeaderText="@Loc[nameof(ResourceStrings.TextSerialNumber)]" Width="200" />
                <GridColumn Field="ServiceLocation" HeaderText="@Loc[nameof(ResourceStrings.TextServiceLocation)]" Width="200" />
                <GridColumn Field="Status" HeaderText="@Loc[nameof(ResourceStrings.TextStatus)]" Width="220">
                    <Template>
                        @{
                            var item = context as RepairServices;
                            var currentStatus = item?.Status ?? "Sale Confirmed";

                            string bgColor, textColor, borderColor;
                            switch (currentStatus)
                            {
                                case "Sent Spareparts":
                                    bgColor = "#fff3cd"; textColor = "#856404"; borderColor = "#ffeeba";
                                    break;
                                case "Inspecting":
                                    bgColor = "#d4edda"; textColor = "#155724"; borderColor = "#c3e6cb";
                                    break;
                                case "Awaiting Customer Confirm":
                                    bgColor = "#5bc8c8"; textColor = "#003d3d"; borderColor = "#3aa8a8";
                                    break;
                                default: // Sale Confirmed
                                    bgColor = "#cce5ff"; textColor = "#004085"; borderColor = "#b8daff";
                                    break;
                            }
                        }
                        @if (ActiveTabKey == "Sale Confirmed")
                        {
                            <select style="background-color: @bgColor;
                                           color: @textColor;
                                           border: 1px solid @borderColor;
                                           border-radius: 20px;
                                           padding: 4px 10px;
                                           font-size: 12px;
                                           font-weight: 600;
                                           cursor: pointer;
                                           outline: none;
                                           min-width: 180px;
                                           font-family: 'Khmer OS', sans-serif;"
                                    @key="@($"{item?.Id}_{currentStatus}")"
                                    @onchange="async (e) => await OnSaleConfirmedStatusChanged(item, e.Value?.ToString())">
                                <option value="Sale Confirmed" hidden
                                        selected="@(currentStatus == "Sale Confirmed")"
                                        disabled
                                        style="background-color:#ffffff; color:#212529; font-size:12px;">
                                    អាចជួសជុលបាន
                                </option>
                                <option value="Sent Spareparts"
                                        selected="@(currentStatus == "Sent Spareparts")"
                                        style="background-color:#ffffff; color:#212529; font-size:12px;">
                                    បញ្ជូនគ្រឿងបន្លាស់ទៅជាង
                                </option>
                            </select>
                        }
                        else
                        {
                            <span class="status-badge-select @GetSaleConfirmedStatusBadgeClass(currentStatus)">
                                @GetStatusLabel(currentStatus)
                            </span>
                        }
                    </Template>
                </GridColumn>

                @* ✅ "By" column now switches source field depending on the active tab *@
                <GridColumn HeaderText="@(ActiveTabKey == "Sent Spareparts" ? "Sent By" : "Confirmed By")" Width="150">
                    <Template>
                        @{
                            var item = context as RepairServices;
                            var userId = ActiveTabKey == "Sent Spareparts" ? item.setSentSparepartsBy : item.setSaleConfirmedBy;
                            var username = GetUserNameById(userId);
                        }
                        @username
                    </Template>
                </GridColumn>

                <GridColumn HeaderText="Actions" Width="120">
                    <Template>
                        @{
                            var item = context as RepairServices;
                        }
                        <DxButton IconCssClass="fas fa-eye"
                                  CssClass="icon-button info"
                                  RenderStyle="ButtonRenderStyle.Info"
                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                  Text="@Loc[nameof(ResourceStrings.TextView)]"
                                  @onclick="() => ShowRepairServiceDetails(item)" />
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>

        <FooterPagination CurrentPage="currentGridPage"
                          TotalPages="totalGridPages"
                          TotalItems="totalGridItems"
                          PageSize="gridPageSize"
                          OnFirstPage="GridFirstPage"
                          OnPreviousPage="GridPreviousPage"
                          OnNextPage="GridNextPage"
                          OnLastPage="GridLastPage" />
    }
}

@* ✅ CHANGED — replaced the page's own hand-rolled SfDialog + report markup
     with the shared RepairServiceViewDialog component (same as
     await-sparepart.razor / await-customer.razor). AllowEditRemarks stays
     true — this page still supports inline remark editing via RemarkIndicator. *@
<RepairServiceViewDialog Service="_selectedRepairService"
                         @bind-Visible="isViewDialogVisible"
                         SpareParts="_spareParts"
                         GetUserNameById="GetUserNameById"
                         StatusLabelResolver="GetStatusLabel"
                         AllowEditRemarks="true"
                         PresetRemarks="_presetRemarks"
                         OnSaveRemarks="HandleSaveRemarks" />

<PrintPreviewSidebar @bind-IsOpen="isPrintSidebarOpen"
                     Base64Pdf="@_printPreviewBase64"
                     ReportNo="@(_selectedRepairService?.reportNo)" />

@code {
    [Parameter] public string ReportNo { get; set; }
    private SfGrid<RepairServices> MyGrid;
    ToastAnimationType Animation { get; set; } = ToastAnimationType.Slide;
    private string activeBreakpoint { get; set; }
    public string[] ToolbarItems = new string[] { "ColumnChooser" };
    private IEnumerable<RepairServices> filteredSaleConfirmed = new List<RepairServices>();

    // ✅ CHANGED — RepairServiceViewDialog expects List<SparePartObject>, so this
    // is now a List instead of IEnumerable to avoid a .ToList() at every binding site.
    private List<SparePartObject> _spareParts = new();
    private string GridSearchValue { get; set; }
    private System.Threading.Timer _gridSearchDebounceTimer;
    private HubConnection hubConnection;
    private bool isViewDialogVisible = false;
    private int currentGridPage = 1;
    private int gridPageSize = 10;
    private int totalGridPages = 0;
    private int totalGridItems = 0;

    private bool _isPrintSidebarOpen = false;
    private bool isPrintSidebarOpen
    {
        get => _isPrintSidebarOpen;
        set
        {
            _isPrintSidebarOpen = value;
            if (!value) _printPreviewBase64 = string.Empty;
        }
    }
    private string _printPreviewBase64 = string.Empty;

    private Dictionary<string, string> _allUsers = new Dictionary<string, string>();
    private bool _usersLoaded = false;
    private RepairServices _selectedRepairService;
    private static readonly string[] _presetRemarks = new[]
{
    "មានស្តុក",
    "ដោះពីម៉ាស៊ីន",
    "ស្តុកក្នុងស្រុក",
    "រង់ចាំ ៦ ទៅ៨អាទិត្យ"
};

    // ✅ Added "Sent Spareparts" tab — moved here from await-sparepart.razor
    private List<StatusTabMenu.TabItem> Tabs = new()
{
    new StatusTabMenu.TabItem { Key = "Awaiting Customer Confirm", Label = "រង់ចាំយល់ព្រមពីភ្ញៀវ" },
    new StatusTabMenu.TabItem { Key = "Sale Confirmed", Label = "អាចជួសជុលបាន" },
    new StatusTabMenu.TabItem { Key = "Sent Spareparts", Label = "បញ្ជូនគ្រឿងបន្លាស់ទៅជាង" },
};

    // ✅ default = "Sale Confirmed" សម្រាប់ page នេះ
    private string ActiveTabKey = "Sale Confirmed";

    private async Task HandleTabChanged(string tabKey)
    {
        ActiveTabKey = tabKey;
        currentGridPage = 1;
        GridSearchValue = string.Empty;

        await LoadGridData();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        try
        {
            await LoadAllUsersAsync();
            await LoadTabCountsAsync();
            await LoadGridData();

            var sparePartsResult = await SparePartService.GetSparePartsPagedAsync(pageNumber: 1, pageSize: 10);
            _spareParts = sparePartsResult.Items?.ToList() ?? new List<SparePartObject>();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading data: {ex.Message}");
            filteredSaleConfirmed = new List<RepairServices>();
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/itemHub"))
            .Build();

        hubConnection.On<ItemUpdateMessage>("ReceiveItemUpdate", async (msg) =>
  {
      var affected = msg?.AffectedStatuses ?? Array.Empty<string>();

      foreach (var status in affected)
          await Cache.InvalidateByPrefixAsync(GetPrefixForTab(status));

      await Cache.InvalidateAsync(CacheKeys.DashboardStats);

      // Tab counts always need refreshing — any affected status could be
      // one of this page's own tabs (Awaiting Customer Confirm / Sale
      // Confirmed / Sent Spareparts).
      await LoadTabCountsAsync();

      // ✅ Only reload the grid if the CURRENTLY OPEN tab is one of the
      // affected statuses.
      if (affected.Contains(ActiveTabKey))
          await LoadGridData();

      await InvokeAsync(StateHasChanged);
  });

        hubConnection.On<Guid>("BroadcastItemDelete", async (deletedItemId) =>
        {
            await Cache.InvalidateByPrefixAsync(GetPrefixForTab(ActiveTabKey));
            await Cache.InvalidateAsync(CacheKeys.DashboardStats);
            await LoadTabCountsAsync();
            await LoadGridData();
            await InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();

        hubConnection.Closed += async (error) =>
        {
            await Task.Delay(new Random().Next(0, 5) * 1000);
            try { await hubConnection.StartAsync(); }
            catch (Exception ex) { Console.WriteLine($"Reconnection failed: {ex.Message}"); }
        };
    }

    // ✅ Added "Sent Spareparts" case — previously fell through to SaleConfirmed key
    private static string GetCacheKeyForTab(string status, int page, int size) => status switch
    {
        "Awaiting Customer Confirm" => CacheKeys.AwaitCustomer(page, size),
        "Sale Confirmed" => CacheKeys.SaleConfirmed(page, size),
        "Sent Spareparts" => CacheKeys.SentSpareparts(page, size),
        _ => CacheKeys.SaleConfirmed(page, size),
    };

    // ✅ Added "Sent Spareparts" case — previously fell through to SaleConfirmed prefix
    private static string GetPrefixForTab(string status) => status switch
    {
        "Awaiting Customer Confirm" => CacheKeys.PrefixAwaitCustomer,
        "Sale Confirmed" => CacheKeys.PrefixSaleConfirmed,
        "Sent Spareparts" => CacheKeys.PrefixSentSpareparts,
        _ => CacheKeys.PrefixSaleConfirmed,
    };

    private string GetStatusLabel(string status) => status switch
    {
        "Awaiting Customer Confirm" => "រង់ចាំយល់ព្រមពីភ្ញៀវ",
        "Sale Confirmed" => "អាចជួសជុលបាន",
        "Sent Spareparts" => "បញ្ជូនគ្រឿងបន្លាស់ទៅជាង",
        "Inspecting" => "កែតម្រូវគ្រឿងបន្លាស់ម្ដងទៀត",
        _ => status
    };

    private string GetSaleConfirmedStatusBadgeClass(string status) => status switch
    {
        "Awaiting Customer Confirm" => "badge-awaiting-customer",
        "Sale Confirmed" => "badge-sale-confirmed",
        "Sent Spareparts" => "badge-sent-spareparts",
        "Inspecting" => "badge-inspecting",
        _ => "badge-default"
    };

    private async Task LoadTabCountsAsync()
    {
        try
        {
            // ✅ CHANGED — cached per-tab, same pattern as await-customer.razor.
            // Previously 3 uncached SearchRepairServicesAsync calls fired on
            // every page load AND every SignalR broadcast received by every
            // connected client — a major contributor to intermittent slowness.
            var tasks = Tabs.Select(async t =>
            {
                var cacheKey = $"{GetPrefixForTab(t.Key)}count";

                var result = await Cache.GetOrSetAsync(
                    cacheKey,
                    () => RepairItemService.SearchRepairServicesAsync(
                        pageNumber: 1,
                        pageSize: 1,
                        status: t.Key,
                        sortBy: "reportNo",
                        sortDescending: true),
                    TimeSpan.FromMinutes(3)
                );

                return result;
            }).ToList();

            var results = await Task.WhenAll(tasks);

            for (int i = 0; i < Tabs.Count; i++)
            {
                Tabs[i].Count = results[i]?.TotalCount ?? 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading tab counts: {ex.Message}");
        }
    }
    private string ParseFriendlyErrorMessage(string rawError)
    {
        try
        {
            if (rawError.Contains("Insufficient stock") || rawError.Contains("Insufficient stock when releasing hold"))
            {
                var itemMatch = System.Text.RegularExpressions.Regex.Match(
                    rawError, @"Item:\s*(.+?)\s*\|");
                var availableMatch = System.Text.RegularExpressions.Regex.Match(
                    rawError, @"Available:\s*(\d+)");
                var requiredMatch = System.Text.RegularExpressions.Regex.Match(
                    rawError, @"Required:\s*(\d+)");
                var barcodeMatch = System.Text.RegularExpressions.Regex.Match(
                    rawError, @"(?:Barcode|Serial|SKU|Code):\s*([A-Za-z0-9\-]+)",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase);

                string itemName = itemMatch.Success ? itemMatch.Groups[1].Value.Trim() : "គ្រឿងបន្លាស់";
                string available = availableMatch.Success ? availableMatch.Groups[1].Value : "0";
                string required = requiredMatch.Success ? requiredMatch.Groups[1].Value : "?";

                string barcode = barcodeMatch.Success
                    ? barcodeMatch.Groups[1].Value.Trim()
                    : GetBarcodeFromCurrentService(itemName);

                string barcodeInfo = !string.IsNullOrEmpty(barcode) ? $"Id: {barcode} | " : "";

                return $"ស្តុកគ្រឿងបន្លាស់មិនគ្រប់គ្រាន់ សូមពិនិត្យឡើងវិញ! " +
                       $"ឈ្មោះ: {itemName} | " +
                       $"{barcodeInfo}" +
                       $"មានក្នុងស្តុក: {available} | " +
                       $"ត្រូវការ: {required}. " +
                       $"សូមបញ្ចូលស្តុកជាមុនសិន។";
            }

            if (rawError.Contains("DbUpdateException") || rawError.Contains("SqlException"))
                return "មានបញ្ហាក្នុងការរក្សាទុកទិន្នន័យ។ សូមព្យាយាមម្តងទៀត។";

            if (rawError.Contains("timed out") || rawError.Contains("timeout"))
                return "ការតភ្ជាប់យឺតពេក។ សូមព្យាយាមម្តងទៀត។";

            if (rawError.Contains("InternalServerError") || rawError.Contains("500"))
                return "មានបញ្ហានៅម៉ាស៊ីនមេ។ សូមទាក់ទងអ្នកគ្រប់គ្រង។";

            return "មិនអាចធ្វើប្រតិបត្តិការនេះបានទេ។ សូមពិនិត្យម្តងទៀត ឬទាក់ទងអ្នកគ្រប់គ្រង។";
        }
        catch
        {
            return "មិនអាចធ្វើប្រតិបត្តិការនេះបានទេ។ សូមទាក់ទងអ្នកគ្រប់គ្រង។";
        }
    }

    private string GetBarcodeFromCurrentService(string itemName)
    {
        try
        {
            if (_selectedRepairService?.SparePartItems == null)
                return string.Empty;

            foreach (var sp in _selectedRepairService.SparePartItems)
            {
                var sparePartObj = _spareParts.FirstOrDefault(x =>
                    x.Id == sp.SparePartId &&
                    (x.ItemName?.Equals(itemName, StringComparison.OrdinalIgnoreCase) == true ||
                     itemName.Contains(x.ItemName ?? "", StringComparison.OrdinalIgnoreCase)));

                if (sparePartObj != null)
                    return sparePartObj.Id.ToString();
            }

            var firstSparePart = _selectedRepairService?.SparePartItems?.FirstOrDefault();
            return firstSparePart?.SparePartId != null ? firstSparePart.SparePartId.ToString() : string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }
    private async Task LoadAllUsersAsync()
    {
        if (_usersLoaded)
            return;

        try
        {
            _allUsers = await GlobalUserCache.GetUsersAsync();
            _usersLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading users: {ex.Message}");
            _allUsers = new Dictionary<string, string>();
        }
    }

    // ✅ CHANGED — RepairServiceViewDialog's OnSaveRemarks callback hands back
    // a (SparePartItem Part, string NewValue) tuple; this wrapper unpacks it
    // and forwards to the existing SaveRemarks logic (persistence/cache/
    // broadcast/toast), which is unchanged.
    private async Task HandleSaveRemarks((SparePartItem Part, string NewValue) args)
    {
        await SaveRemarks(args.Part, args.NewValue);
    }

    // Called by RepairServiceViewDialog (via HandleSaveRemarks) — the dialog only
    // decides WHAT the new value is; actual persistence/cache/broadcast/toast stays here.
    private async Task SaveRemarks(SparePartItem sparePart, string newValue)
    {
        try
        {
            var success = await SparePartService.UpdateSparepartItemRemarksAsync(sparePart.Id, newValue);

            if (success)
            {
                var savedAt = DateTime.Now;

                sparePart.Remarks = newValue;
                sparePart.RemarksUpdatedAt = savedAt;

                await Cache.InvalidateByPrefixAsync(GetPrefixForTab(ActiveTabKey));

                if (hubConnection?.State == HubConnectionState.Connected)
                    // ✅ CHANGED — remark edits never change status, so the only
                    // affected status is the tab currently open on this page.
                    await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                    {
                        AffectedStatuses = new[] { ActiveTabKey }
                    });

                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Customization",
                    Title = "Saved",
                    Text = "Remark updated",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Success
                });
            }
            else
            {
                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Error",
                    Title = "Error",
                    Text = "Failed to save remark",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Danger
                });
            }
        }
        catch (Exception ex)
        {
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Error",
                Text = $"Failed: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }

        StateHasChanged();
    }
    // ✅ Redis-cached load, mirrors the AwaitCustomer page's LoadGridData pattern.
    private async Task LoadGridData()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(GridSearchValue))
            {
                var result = await RepairItemService.SearchRepairServicesAsync(
                    pageNumber: currentGridPage,
                    pageSize: gridPageSize,
                    status: ActiveTabKey,
                    searchTerm: GridSearchValue.Trim(),
                    sortBy: "saleConfirmedDate",
                    sortDescending: true
                );

                filteredSaleConfirmed = result.Items;
                totalGridPages = result.TotalPages;
                totalGridItems = result.TotalCount;
            }
            else
            {
                var result = await Cache.GetOrSetAsync(
                    GetCacheKeyForTab(ActiveTabKey, currentGridPage, gridPageSize),
                    () => RepairItemService.SearchRepairServicesAsync(
                        pageNumber: currentGridPage,
                        pageSize: gridPageSize,
                        status: ActiveTabKey,
                        sortBy: "saleConfirmedDate",
                        sortDescending: true),
                    TimeSpan.FromMinutes(3)
                );

                filteredSaleConfirmed = result?.Items ?? new List<RepairServices>();
                totalGridPages = result?.TotalPages ?? 0;
                totalGridItems = result?.TotalCount ?? 0;
            }

            var activeTab = Tabs.FirstOrDefault(t => t.Key == ActiveTabKey);
            if (activeTab != null) activeTab.Count = totalGridItems;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading Sale Confirmed grid data: {ex.Message}");
        }
    }


    // and invalidating the correct Redis prefixes for both the source list
    // (this page) and the destination list.
    private async Task OnSaleConfirmedStatusChanged(RepairServices item, string newStatus)
    {
        if (string.IsNullOrEmpty(newStatus) || newStatus == item.Status)
            return;

        string previousStatus = item.Status;

        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            Guid performedBy = Guid.Empty;
            if (user.Identity.IsAuthenticated)
            {
                var claim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                Guid.TryParse(claim, out performedBy);
            }

            string[] affectedStatuses;

            if (newStatus == "Inspecting")
            {
                await RepairItemService.MoveBackToInspectingAsync(item.Id);

                // ✅ CHANGED — only "Sale Confirmed" (leaving) + "Inspecting"
                // (entering, served by inspect-item.razor) need clearing.
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixInspectItem);
                affectedStatuses = new[] { "Sale Confirmed", "Inspecting" };
            }
            else if (newStatus == "Sent Spareparts")
            {
                await SentSparepartsService.SetSentSparepartsAsync(item.Id, performedBy);

                // ✅ CHANGED — only "Sale Confirmed" (leaving) + "Sent Spareparts"
                // (entering — also a tab ON this same page) need clearing.
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixSentSpareparts);
                affectedStatuses = new[] { "Sale Confirmed", "Sent Spareparts" };
            }
            else
            {
                affectedStatuses = new[] { "Sale Confirmed" };
            }

            // ✅ this item is leaving Sale Confirmed, so invalidate the
            // Sale Confirmed prefix specifically.
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixSaleConfirmed);
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixSparePart);
            await Cache.InvalidateAsync(CacheKeys.DashboardStats);

            if (hubConnection?.State == HubConnectionState.Connected)
                await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                {
                    AffectedStatuses = affectedStatuses
                });

            // ✅ FIX — _spareParts only ever holds the first page-of-10 catalog rows
            // loaded in OnInitializedAsync, unless ShowRepairServiceDetails (view
            // dialog) patched it with this item's actual spare parts first. Changing
            // status straight from the grid dropdown skips that patch, so the
            // ItemName lookup below would miss and TelegramMessageHelper would
            // faithfully render "Unknown Item" for every part (the helper only
            // formats whatever name it's given — it doesn't fetch anything itself).
            // Must be awaited here in the main method body, not inside the Task.Run
            // below, since it mutates the shared _spareParts field.
            if (item.SparePartItems != null && item.SparePartItems.Any())
            {
                var missingIds = item.SparePartItems
                    .Where(sp => sp.SparePartId.HasValue && sp.SparePartId.Value != Guid.Empty)
                    .Select(sp => sp.SparePartId.Value)
                    .Distinct()
                    .Where(id => !_spareParts.Any(x => x.Id == id))
                    .ToList();

                if (missingIds.Count > 0)
                {
                    var fetchTasks = missingIds.Select(async id =>
                    {
                        try
                        {
                            return await SparePartService.GetSparePartByIdAsync(id);
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"❌ Error fetching spare part {id}: {ex.Message}");
                            return null;
                        }
                    });

                    var fetched = await Task.WhenAll(fetchTasks);
                    _spareParts = _spareParts.Concat(fetched.Where(x => x != null)).ToList();
                }
            }

            // ✅ Telegram: close out "SaleConfirmed" topic (53), open the destination topic
            _ = Task.Run(async () =>
            {
                try
                {
                    await TelegramQueue.EnqueueAsync(new TelegramMessage
                    {
                        Action = TelegramAction.Delete,
                        ItemId = item.Id,
                        TopicKey = "SaleConfirmed",
                        ResolveMessageIdFromTopic = true
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Telegram delete enqueue failed: {ex.Message}");
                }

                string destinationTopicKey;
                string emoji;
                string label;

                if (newStatus == "Sent Spareparts")
                {
                    destinationTopicKey = "SentSpareparts";
                    emoji = "✅";
                    label = "បានបញ្ជូនគ្រឿងបន្លាស់ទៅជាង";
                }
                else if (newStatus == "Inspecting")
                {
                    destinationTopicKey = "Inspecting";
                    emoji = "🔁";
                    label = "កែតម្រូវគ្រឿងបន្លាស់ម្ដងទៀត";
                }
                else
                {
                    return;
                }

                try
                {
                    string text;

                    if (newStatus == "Sent Spareparts")
                    {
                        // ✅ CHANGED — was the short 5-line form. Now matches the full
                        // field set + spare parts with remarks used by
                        // await-customer.razor's "Sale Confirmed" message and
                        // await-sparepart.razor's "Awaiting Customer Confirm" message,
                        // so the same information travels with the item all the way
                        // to the repair shop.
                        string sparePartsSection = string.Empty;

                        if (item.SparePartItems != null && item.SparePartItems.Any())
                        {
                            var partsWithRemarks = item.SparePartItems
                                .Where(sp => sp.SparePartId.HasValue && sp.SparePartId.Value != Guid.Empty)
                                .Select(sp =>
                                {
                                    var catalogItem = _spareParts.FirstOrDefault(fp => fp.Id == sp.SparePartId.Value);
                                    return (
                                        ItemName: catalogItem?.ItemName ?? "Unknown Item",
                                        sp.Quantity,
                                        sp.Condition,
                                        sp.Remarks
                                    );
                                });

                            sparePartsSection = TelegramMessageHelper.BuildSparePartsSectionWithRemarks(partsWithRemarks);
                        }

                        text = $"{emoji} <b>{label}</b>\n\n" +
                               $"លេខ Report: <b>{item.reportNo}</b>\n\n" +
                               $"ស្ថាប័ន: {item.CompanyName}\n\n" +
                               $"ទីតាំងជួសជុល: {item.ServiceLocation}\n\n" +
                               $"ម៉ាស៊ីន: {item.itemName}\n\n" +
                               $"SerialNumber: {item.serialNumber}\n\n" +
                               $"ប្រភេទសេវាកម្មជួសជុល: {item.ServiceType}\n\n" +
                               $"សំណើពីអតិថិជន: {item.CustomerRequest}\n\n" +
                               $"វិនិច្ឆ័យ: {item.Inspection}\n\n" +
                               $"ដំណោះស្រាយ: {item.Solution}\n\n" +
                               $"ឈ្មោះអ្នកវិនិច្ឆ័យ: {GetUserNameById(item.inspectBy)}\n\n" +
                               $"ឈ្មោះអ្នកបញ្ជូន: {GetUserNameById(performedBy)}" +
                               $"{sparePartsSection}";
                    }
                    else
                    {
                        // "Inspecting" keeps the short form — this is a correction
                        // path back to re-inspection, not a forward handoff.
                        text = $"{emoji} <b>{label}</b>\n" +
                               $"លេខ Report: <b>{item.reportNo}</b>\n" +
                               $"ក្រុមហ៊ុន: {item.CompanyName}\n" +
                               $"ម៉ាស៊ីន: {item.itemName}\n" +
                               $"លេខស៊េរី: {item.serialNumber}";
                    }

                    await TelegramQueue.EnqueueAsync(new TelegramMessage
                    {
                        Action = TelegramAction.Send,
                        ItemId = item.Id,
                        TopicKey = destinationTopicKey,
                        Text = text
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Telegram send enqueue failed: {ex.Message}");
                }
            });

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Customization",
                Title = "សម្រេច",
                Text = $"{item.reportNo} → {newStatus}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Success
            });

            // Optimistic removal — item no longer belongs on this page
            filteredSaleConfirmed = filteredSaleConfirmed.Where(x => x.Id != item.Id).ToList();
            totalGridItems = Math.Max(0, totalGridItems - 1);
            totalGridPages = totalGridItems > 0 ? (int)Math.Ceiling(totalGridItems / (double)gridPageSize) : 0;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            item.Status = previousStatus;
            StateHasChanged();

            string userMessage = ParseFriendlyErrorMessage(ex.Message);

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "មិនអាចធ្វើប្រតិបត្តិការបាន",
                Text = userMessage,
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }
    }

    private async Task GridNextPage()
    {
        if (currentGridPage < totalGridPages)
        {
            currentGridPage++;
            await LoadGridData();
            StateHasChanged();
        }
    }

    private async Task GridPreviousPage()
    {
        if (currentGridPage > 1)
        {
            currentGridPage--;
            await LoadGridData();
            StateHasChanged();
        }
    }

    private async Task GridFirstPage()
    {
        if (currentGridPage != 1)
        {
            currentGridPage = 1;
            await LoadGridData();
            StateHasChanged();
        }
    }

    private async Task GridLastPage()
    {
        if (currentGridPage != totalGridPages)
        {
            currentGridPage = totalGridPages;
            await LoadGridData();
            StateHasChanged();
        }
    }

    private string GetUserNameById(Guid? userId)
    {
        if (!userId.HasValue || userId.Value == Guid.Empty)
            return "Unknown";

        string userIdString = userId.Value.ToString();

        if (!_usersLoaded)
            return "Loading...";

        if (_allUsers.TryGetValue(userIdString, out string username))
            return username;

        return "Unknown User";
    }
    private async Task ShowRepairServiceDetails(RepairServices repairService)
    {
        _selectedRepairService = repairService;

        // ✅ Parallelized spare part fetches (see await-sparepart.razor for full rationale).
        if (_selectedRepairService?.SparePartItems != null && _selectedRepairService.SparePartItems.Any())
        {
            var missingIds = _selectedRepairService.SparePartItems
                .Where(item => item.SparePartId.HasValue && item.SparePartId.Value != Guid.Empty)
                .Select(item => item.SparePartId.Value)
                .Where(id => !_spareParts.Any(x => x.Id == id))
                .Distinct()
                .ToList();

            if (missingIds.Count > 0)
            {
                var fetchTasks = missingIds.Select(async id =>
                {
                    try
                    {
                        return await SparePartService.GetSparePartByIdAsync(id);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"❌ Error fetching spare part {id}: {ex.Message}");
                        return null;
                    }
                });

                var fetchedResults = await Task.WhenAll(fetchTasks);

                var newlyFetched = fetchedResults.Where(x => x != null);
                _spareParts = _spareParts.Concat(newlyFetched).ToList();
            }
        }

        // ✅ CHANGED — DialogEdit/SfDialog.ShowAsync() no longer exists here
        // (replaced by RepairServiceViewDialog), so just flip the bound
        // Visible flag; the component's own Visible parameter drives it.
        isViewDialogVisible = true;
        StateHasChanged();
    }

