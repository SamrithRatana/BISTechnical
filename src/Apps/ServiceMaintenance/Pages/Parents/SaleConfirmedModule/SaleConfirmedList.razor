    private async Task PerformGridSearch()
    {
        if (string.IsNullOrWhiteSpace(GridSearchValue))
        {
            await LoadGridData();
            return;
        }

        currentGridPage = 1;
        await LoadGridData();
        StateHasChanged();
    }

    private void OnGridSearchInput(InputEventArgs args)
    {
        _gridSearchDebounceTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(args.Value))
        {
            _ = Task.Run(async () =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadGridData();
                    StateHasChanged();
                });
            });
            return;
        }

        _gridSearchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    currentGridPage = 1;
                    await LoadGridData();
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Grid search error: {ex.Message}");
            }
        }, null, 500, Timeout.Infinite);
    }

    private async Task ClearGridSearch()
    {
        GridSearchValue = string.Empty;
        currentGridPage = 1;
        await LoadGridData();
        StateHasChanged();
    }

    private async Task ShowReportPreview(RepairServices selectedRepairService)
    {
        try
        {
            _selectedRepairService = selectedRepairService;
            _printPreviewBase64 = string.Empty;
            isPrintSidebarOpen = true;
            StateHasChanged();

            _printPreviewBase64 = await PrintPreviewService.GenerateReportBase64Async(
                selectedRepairService,
                GetUserNameById
            );

            StateHasChanged();
        }
        catch (Exception ex)
        {
            isPrintSidebarOpen = false;
            _printPreviewBase64 = string.Empty;

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Report Error",
                Text = $"Failed to generate report: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }
    }

    public async ValueTask DisposeAsync()
    {
        _gridSearchDebounceTimer?.Dispose();
        if (hubConnection != null) await hubConnection.DisposeAsync();
    }
