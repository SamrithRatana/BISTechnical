    private async Task LoadSparePartsForCurrentPageAsync()
    {
        try
        {
            if (filteredRepairServices2 == null || !filteredRepairServices2.Any())
            {
                _spareParts = new List<SparePartObject>();
                return;
            }

            var distinctIds = filteredRepairServices2
                .Where(r => r.SparePartItems != null)
                .SelectMany(r => r.SparePartItems)
                .Where(sp => sp.SparePartId.HasValue && sp.SparePartId.Value != Guid.Empty)
                .Select(sp => sp.SparePartId.Value)
                .Distinct()
                .ToList();

            if (!distinctIds.Any())
            {
                _spareParts = new List<SparePartObject>();
                return;
            }

            // ✅ FIX — ហៅ parallel ជំនួស sequential loop, ចៀសវាង round-trip
            // ម្ដងម្ដងៗតាមចំនួន spare part ដែលធ្វើឲ្យ tab/page change យឺត
            var tasks = distinctIds.Select(async id =>
            {
                try
                {
                    return await SparePartService.GetSparePartByIdAsync(id);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"❌ Error loading spare part {id}: {ex.Message}");
                    return null;
                }
            });

            var results = await Task.WhenAll(tasks);
            _spareParts = results.Where(sp => sp != null).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in LoadSparePartsForCurrentPageAsync: {ex.Message}");
            _spareParts = new List<SparePartObject>();
        }
    }

