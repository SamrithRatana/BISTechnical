    private async Task NextPage2() { if (currentPage2 < totalPages2) { currentPage2++; await LoadPageData2(); await LoadSparePartsForCurrentPageAsync(); StateHasChanged(); } }
    private async Task PreviousPage2() { if (currentPage2 > 1) { currentPage2--; await LoadPageData2(); await LoadSparePartsForCurrentPageAsync(); StateHasChanged(); } }
    private async Task FirstPage2() { currentPage2 = 1; await LoadPageData2(); await LoadSparePartsForCurrentPageAsync(); StateHasChanged(); }
    private async Task LastPage2() { currentPage2 = totalPages2; await LoadPageData2(); await LoadSparePartsForCurrentPageAsync(); StateHasChanged(); }

