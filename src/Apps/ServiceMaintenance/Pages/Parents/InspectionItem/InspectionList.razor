@page "/inspection-list"
@implements IAsyncDisposable

@using ServiceMaintenance.Models
@using Microsoft.AspNetCore.SignalR.Client
@using ServiceMaintenance.Services.Filters.GlobalSecurity
@using ServiceMaintenance.Pages.Reports
@using ServiceMaintenance.Services
@inject RepairItemService RepairItemService
@inject ServiceSparePart SparePartService
@inject InspectItemService InspectItemService
@inject JwtSessionService JwtSessionService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject StateManagementAction StateManagementAction
@inject GlobalUserService GlobalUserCache
@inject CacheHelper Cache
@inject AwaitingSparePartService AwaitingSparePartService
@inject AwaitingCustomerConfirmService AwaitingCustomerConfirmService
@inject InspectingService InspectingService
@inject TelegramNotificationQueue TelegramQueue
<DxToastProvider Name="Customization"
                 MaxToastCount="5"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 VerticalAlignment="VerticalEdge.Top"
                 AnimationType="@Animation" />
<DxToastProvider Name="Error"
                 MaxToastCount="5"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 VerticalAlignment="VerticalEdge.Top"
                 AnimationType="@Animation" />

<!-- Loading Overlay -->
@if (isSaving)
{
    <div class="loading-overlay">
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <div class="loading-text">
                <h4>Processing...</h4>
                <p>Please wait</p>
            </div>
        </div>
    </div>
}

<ActionToolbox CanCreate="false"
               CanEdit="false"
               CanDelete="false"
               CanExport="CanExport"
               IsRowSelected="isRowSelected"
               OnExportExcel="ExportToExcel"
               OnExportPdf="ExportToPdf">
    <CustomActions>
        @if (CanPrint)
        {
            <button class="btn btn-sm btn-outline-secondary compact-btn" @onclick="() => ShowReportPreview(_selectedRepairService)" disabled="@(!isRowSelected)">
                <i class="fas fa-print me-1"></i> Print Report
            </button>
        }
    </CustomActions>
</ActionToolbox>

<br />

<SfMediaQuery @bind-ActiveBreakPoint="activeBreakpoint"></SfMediaQuery>
@{
    bool enableAdaptiveUIMode = false;
    RowDirection renderingMode = RowDirection.Vertical;

    if (activeBreakpoint == "Small")
    {
        enableAdaptiveUIMode = true;
        renderingMode = RowDirection.Vertical;
    }
    else if (activeBreakpoint == "Medium")
    {
        enableAdaptiveUIMode = true;
        renderingMode = RowDirection.Horizontal;
    }
    else
    {
        enableAdaptiveUIMode = false;
    }
}

@if (CanAccess)
{
    @if (CanView)
    {
        <h2>@Loc[nameof(ResourceStrings.TextInspectItemList)]</h2>
        <StatusTabMenu Tabs="Tabs"
                       ActiveTabKey="@ActiveTabKey"
                       OnTabChanged="HandleTabChanged" />
        <div style="margin-bottom: 15px; padding: 15px; background-color: #f9f9f9; border-radius: 4px;">
            <div style="display: flex; gap: 10px; align-items: center;">
                <SfTextBox @ref="InspectionSearchBox"
                           Placeholder="Search by Report No, Company, Serial Number..."
                           ShowClearButton="true"
                           Width="400px"
                           @bind-Value="InspectionSearchValue"
                           Input="OnInspectionSearchInput">
                </SfTextBox>
                <SfButton Content="Search"
                          CssClass="e-btn e-primary"
                          IconCss="fas fa-search"
                          OnClick="PerformInspectionSearch" />
                <SfButton Content="Clear"
                          CssClass="e-btn e-outline"
                          IconCss="fas fa-times"
                          OnClick="ClearInspectionSearch" />
            </div>
            @if (!string.IsNullOrEmpty(InspectionSearchValue))
            {
                <div style="margin-top: 10px; color: #666; font-size: 14px;">
                    <i class="fas fa-info-circle"></i>
                    Searching for: <strong>@InspectionSearchValue</strong>
                </div>
            }
        </div>

        <SfGrid @ref="MyGrid"
                DataSource="@filteredRepairServices2"
                AllowPaging="true"
                AllowSorting="true"
                ShowColumnChooser="true"
                AllowExcelExport="true"
                AllowPdfExport="true"
                AllowResizing="true"
                AllowFiltering="true"
                Height="400"
                SelectionMode="GridSelectionMode.Single"
                Toolbar=@ToolbarItems
                EnableAdaptiveUI="@enableAdaptiveUIMode"
                RowRenderingMode="@renderingMode"
                AllowSelection="true">
            <GridEvents TValue="RepairServices" RowSelected="RowSelectHandler"></GridEvents>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridPageSettings PageSize="10"></GridPageSettings>

            <GridTemplates>
                <DetailTemplate>
                    @{
                        var repairService = (context as RepairServices);
                    }
                    @if (repairService.SparePartItems == null || !repairService.SparePartItems.Any())
                    {
                        <div class="text-center">
                            <h5>The spare part is unavailable.</h5>
                        </div>
                    }
                    else
                    {
                        <div class="d-none d-md-block">
                            <table class="table table-bordered">
                                <thead class="thead-dark">
                                    <tr>
                                        <th class="text-center">Image</th>
                                        <th class="text-center">Item Name</th>
                                        <th class="text-center">UseFor</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-center">Condition</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var part in repairService.SparePartItems)
                                    {
                                        var sparePart = GetSparePartById(part.SparePartId);
                                        if (sparePart == null) { continue; }
                                        <tr style="background-color: white;">
                                            <td class="text-center" style="vertical-align: middle;">
                                                <img src="@sparePart?.PictureUrl" alt="@sparePart?.ItemName" class="img-fluid sparePartImage" style="max-width: 50px;" />
                                            </td>
                                            <td class="text-start" style="vertical-align: middle;">@sparePart?.ItemName</td>
                                            <td class="text-start" style="vertical-align: middle;"><strong>UseFor:</strong> @sparePart?.UseFor</td>
                                            <td class="text-center" style="vertical-align: middle;">@part.Quantity</td>
                                            <td class="text-center" style="vertical-align: middle;">@part.Condition</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-block d-md-none">
                            <div class="container">
                                <div class="row">
                                    @foreach (var part in repairService.SparePartItems)
                                    {
                                        var sparePart = GetSparePartById(part.SparePartId);
                                        if (sparePart == null) { continue; }
                                        <div class="col-12 mb-4">
                                            <div class="card">
                                                <div class="row g-0">
                                                    <div class="col-4 d-flex align-items-center justify-content-center">
                                                        <img src="@sparePart?.PictureUrl" alt="@sparePart?.ItemName" class="img-fluid sparePartImage" />
                                                    </div>
                                                    <div class="col-8">
                                                        <div class="card-body">
                                                            <h5 class="card-title">@sparePart?.ItemName</h5>
                                                            <p class="card-text"><strong>UseFor:</strong> @sparePart?.UseFor</p>
                                                            <p class="card-text"><strong>Description:</strong> @part.Description</p>
                                                            <p class="card-text"><strong>Quantity:</strong> @part.Quantity</p>
                                                            <p class="card-text"><strong>Condition:</strong> @part.Condition</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </DetailTemplate>
            </GridTemplates>

            <GridColumns>
                <GridColumn Field="Id" HeaderText="Id" Width="150" Format="d" Visible="false" />
                <GridColumn Field="reportNo" HeaderText="@Loc[nameof(ResourceStrings.Textref)]" Width="150" />

                <!-- ✅ NEW — Company / Item / Serial, added so all 5 tabs on this page show them -->
                <GridColumn Field="CompanyName" HeaderText="@Loc[nameof(ResourceStrings.TextCompanyName)]" Width="180" />
                <GridColumn Field="itemName" HeaderText="@Loc[nameof(ResourceStrings.TextItemName)]" Width="180" />
                <GridColumn Field="serialNumber" HeaderText="@Loc[nameof(ResourceStrings.TextSerialNumber)]" Width="180" />
                <GridColumn Field="Inspection" HeaderText="@Loc[nameof(ResourceStrings.TextInspection)]" CustomAttributes="@(new Dictionary<string, object>() { { "class", "e-attr" } })" Width="200" />
                <GridColumn Field="Solution" HeaderText="@Loc[nameof(ResourceStrings.Textsolution)]" CustomAttributes="@(new Dictionary<string, object>() { { "class", "e-attr" } })" Width="200" />
                <GridColumn Field="Status" HeaderText="@Loc[nameof(ResourceStrings.TextStatus)]" Width="180">
                    <Template>
                        @{
                            var item = context as RepairServices;
                        }
                        @if (ActiveTabKey == "Inspection")
                        {
                            <select @key="@($"{item.Id}_{item.Status}")"
                                    class="status-badge-select @GetInspectionStatusBadgeClass(item.Status)"
                                    value="@item.Status"
                                    @onchange="async (e) => await OnInspectionStatusChanged(item, e.Value?.ToString())">
                                <option value="Inspection" hidden>វិនិច្ឆ័យរួចរាល់</option>
                                <option value="Inspecting">វិនិច្ឆ័យម្ដងទៀត</option>
                                <option value="Awaiting Sparepart">បញ្ជូនទៅផ្នែកស្តុក</option>
                                <option value="Awaiting Customer Confirm">បញ្ជូនទៅផ្នែកទីផ្សារ</option>
                            </select>
                        }
                        else
                        {
                            <span class="status-badge-select @GetInspectionStatusBadgeClass(item.Status)">
                                @GetStatusLabel(item.Status)
                            </span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="Actions" Width="120">
                    <Template>
                        @{
                            var item = context as RepairServices;
                        }
                        <DxButton IconCssClass="fas fa-eye"
                                  CssClass="icon-button info"
                                  RenderStyle="ButtonRenderStyle.Info"
                                  RenderStyleMode="ButtonRenderStyleMode.Text"
                                  Text="@Loc[nameof(ResourceStrings.TextView)]"
                                  Enabled="@(!isSaving)"
                                  @onclick="() => ShowRepairServiceDetails(item)" />
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>

        <!-- ✅ FIX — replaced the hand-rolled First/Prev/Next/Last button block with
             the shared FooterPagination component, matching inspect-item.razor and
             receive-item.razor so all three list pages share one pagination UI/behavior. -->
        <FooterPagination CurrentPage="currentPage2"
                          TotalPages="totalPages2"
                          TotalItems="totalItems2"
                          PageSize="pageSize2"
                          OnFirstPage="FirstPage2"
                          OnPreviousPage="PreviousPage2"
                          OnNextPage="NextPage2"
                          OnLastPage="LastPage2" />
    }
}
<RepairServiceViewDialog Service="_selectedRepairService"
                         @bind-Visible="isViewDialogVisible"
                         SpareParts="_spareParts"
                         GetUserNameById="GetUserNameById"
                         StatusLabelResolver="GetStatusLabel"
                         AllowEditRemarks="true"
                         PresetRemarks="_presetRemarks"
                         OnSaveRemarks="HandleRemarkSave" />

@code {

    // ── Grid ──
    private SfGrid<RepairServices> MyGrid;
    ToastAnimationType Animation { get; set; } = ToastAnimationType.Slide;
    private string activeBreakpoint { get; set; }
    private IEnumerable<RepairServices> filteredRepairServices2;
    private HubConnection hubConnection;
    public string[] ToolbarItems = new string[] { "ColumnChooser"};

    // ── Dialogs ──
    private bool isViewDialogVisible = false;

    // ── Row selection ──
    private bool isRowSelected = false;
    private RepairServices _selectedRepairService;

    // ── Spare parts (for detail template only) ──
    private List<SparePartObject> _spareParts = new();

    // ── Status change saving flag ──
    private bool isSaving = false;

    // ── Pagination ──
    private int currentPage2 = 1;
    private int pageSize2 = 10;
    private int totalPages2 = 0;
    private int totalItems2 = 0;

    // ── Search ──
    private SfTextBox InspectionSearchBox;
    private string InspectionSearchValue { get; set; }
    private System.Threading.Timer _inspectionSearchDebounceTimer;

    // ── Users ──
    private Dictionary<string, string> _allUsers = new Dictionary<string, string>();
    private bool _usersLoaded = false;
    private List<StatusTabMenu.TabItem> Tabs = new()
{
    new StatusTabMenu.TabItem { Key = "Inspection", Label = "វិនិច្ឆ័យរួចរាល់" },
    new StatusTabMenu.TabItem { Key = "Awaiting Sparepart", Label = "ផ្នែកជាងស្នើរគ្រឿងបន្លាស់" },
    new StatusTabMenu.TabItem { Key = "Awaiting Customer Confirm", Label = "រង់ចាំ Confirm ពីអតិថិជន" },
    new StatusTabMenu.TabItem { Key = "Sale Confirmed", Label = "រង់ចាំ Confirm ពីផ្នែកSale" },
    new StatusTabMenu.TabItem { Key = "Sent Spareparts", Label = "បានបញ្ជូនគ្រឿងបន្លាស់" },
};

    private string ActiveTabKey = "Inspection";

    private async Task HandleTabChanged(string tabKey)
    {
        ActiveTabKey = tabKey;
        currentPage2 = 1;
        InspectionSearchValue = string.Empty;

        await LoadPageData2();
        await LoadSparePartsForCurrentPageAsync();
        StateHasChanged();
    }
    private static readonly Guid DefaultVerifiedById = Guid.Parse("94b0772a-0588-4b37-b31d-51b1e0ea22e5");
    private const string DefaultVerifiedByName = "Seng KimNeang";

    // ✅ NEW — resolves the "Verified By" name for the printed report.
    // Status "Inspection" always attributes to the fixed reviewer above;
    // every other status falls back to the real verifiedBy field.
    private string GetVerifiedByNameForReport(RepairServices service)
    {
        return DefaultVerifiedByName;
    }

    // ✅ NEW — resolves the "Repair By" name for the printed report based on
    // the service's CURRENT status, since RepairBy itself is only populated
    // once the item actually reaches the Repairing stage. For earlier
    // statuses we show whoever performed THAT stage's action instead.
    private string GetRepairByNameForReport(RepairServices service)
    {
        if (service == null) return GetUserNameById(null);

        return service.Status switch
        {
            "Inspection" => GetUserNameById(service.inspectBy),
            "Inspecting" => GetUserNameById(service.inspectingBy),
            "Awaiting Sparepart" => GetUserNameById(service.setAwaitingSparepartBy),
            "Awaiting Customer Confirm" => GetUserNameById(service.setAwaitingCustomerConfirmBy),
            "Sale Confirmed" => GetUserNameById(service.setSaleConfirmedBy),
            "Sent Spareparts" => GetUserNameById(service.setSentSparepartsBy),
            "Customer Rejected" => GetUserNameById(service.setCustomerRejectedBy),
            "Unrepairable" => GetUserNameById(service.setUnrepairableBy),
            "Repair by Third-Party" => GetUserNameById(service.thirdPartyRepairBy),
            _ => GetUserNameById(service.repairBy) // "Repairing" / "Finished" / default
        };
    }
    // ─────────────────────────────────────────────────────
    // LIFECYCLE
    // ─────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            await LoadAllUsersAsync();
            await LoadTabCountsAsync();
            await LoadPageData2();
            await LoadSparePartsForCurrentPageAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading data: {ex.Message}");
        }

        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/itemHub"))
            .WithAutomaticReconnect(new[]
            {
        TimeSpan.Zero,
        TimeSpan.FromSeconds(2),
        TimeSpan.FromSeconds(5),
        TimeSpan.FromSeconds(10),
        TimeSpan.FromSeconds(30)
            })
            .Build();

        // ✅ CHANGED — was On<string>. Now receives ItemUpdateMessage carrying
        // exactly which statuses were affected by the update, so we only
        // invalidate/reload the prefixes and tab that actually changed instead
        // of nuking all 5 caches + always reloading the current grid.
        hubConnection.On<ItemUpdateMessage>("ReceiveItemUpdate", async (msg) =>
        {
            var affected = msg?.AffectedStatuses ?? Array.Empty<string>();

            // ✅ invalidate only the cache prefixes actually touched by this update
            foreach (var status in affected)
            {
                await Cache.InvalidateByPrefixAsync(GetPrefixForTab(status));
            }
            await Cache.InvalidateAsync(CacheKeys.DashboardStats);

            // Tab counts still need refreshing since ANY affected status could
            // change a badge number, even if it's not the tab currently open.
            await LoadTabCountsAsync();

            // ✅ Only reload the grid rows if the currently-open tab is one of
            // the affected statuses — otherwise the visible grid didn't change.
            if (affected.Contains(ActiveTabKey))
            {
                await LoadPageData2();
                await LoadSparePartsForCurrentPageAsync();
            }

            await InvokeAsync(StateHasChanged);
        });

        hubConnection.On<Guid>("BroadcastItemDelete", async (deletedItemId) =>
        {
            // ✅ FIX — មិន mutate local list ទៀតទេ, invalidate cache + reload ពី server
            // ដើម្បីឲ្យ totalItems2/totalPages2 (pagination) ស្របនឹង grid ជានិច្ច
            await Cache.InvalidateByPrefixAsync(GetPrefixForTab(ActiveTabKey));
            await Cache.InvalidateAsync(CacheKeys.DashboardStats);
            await LoadTabCountsAsync();
            await LoadPageData2();
            await LoadSparePartsForCurrentPageAsync();
            await InvokeAsync(StateHasChanged);
        });

        // ✅ FIX — signal ដល់ user ថា connection ដាច់/កំពុងព្យាយាមភ្ជាប់ឡើងវិញ
        hubConnection.Reconnecting += (error) =>
        {
            Console.WriteLine($"⚠️ SignalR reconnecting: {error?.Message}");
            return Task.CompletedTask;
        };

        // ✅ FIX — resync ទិន្នន័យបន្ទាប់ពី reconnect ជោគជ័យ ព្រោះ update ណាមួយ
        // ដែលកើតឡើងកំឡុងពេលដាច់ អាចនឹងខកខាន (missed events)។ Full invalidation
        // នៅតែសមហេតុផលត្រង់នេះ ព្រោះមិនដឹងច្បាស់ថា status មួយណាខ្លះបានផ្លាស់ប្តូរ
        // កំឡុងពេលដាច់ connection។
        hubConnection.Reconnected += async (connectionId) =>
        {
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixInspectionItem);
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixAwaitSparePart);
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixAwaitCustomer);
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixSaleConfirmed);
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixSentSpareparts);
            await Cache.InvalidateAsync(CacheKeys.DashboardStats);

            await LoadTabCountsAsync();
            await LoadPageData2();
            await LoadSparePartsForCurrentPageAsync();
            await InvokeAsync(StateHasChanged);
        };

        // ✅ FIX — `WithAutomaticReconnect` ធ្វើឲ្យ event នេះកើតឡើងតែពេលព្យាយាម
        // reconnect អស់លទ្ធភាពទាំងអស់ (ឧ. server down យូរ)។ Log ច្បាស់ជាងមុន។
        hubConnection.Closed += (error) =>
        {
            Console.WriteLine($"❌ SignalR connection closed permanently: {error?.Message}");
            return Task.CompletedTask;
        };

        await hubConnection.StartAsync();
    }
    // ─────────────────────────────────────────────────────
    // DATA LOADING
    // ─────────────────────────────────────────────────────
    private async Task LoadAllUsersAsync()
    {
        if (_usersLoaded) return;
        try
        {
            _allUsers = await GlobalUserCache.GetUsersAsync();
            _usersLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading users: {ex.Message}");
            _allUsers = new Dictionary<string, string>();
        }
    }
    private async Task LoadTabCountsAsync()
    {
        try
        {
            // ✅ CHANGED — cached per-tab under the same Redis prefix used by
            // that tab's list data (GetPrefixForTab). Every status-change
            // handler on this page already calls
            // Cache.InvalidateByPrefixAsync(GetPrefixForTab(status)) whenever
            // an item enters/leaves a status, so this count cache is
            // invalidated for free. Previously this fired 5 uncached
            // SearchRepairServicesAsync calls every time OnInitializedAsync
            // ran AND every time ANY connected client's status change
            // triggered a SignalR broadcast — a major source of load spikes
            // against the backend API that could make the app feel slow for
            // everyone.
            var tasks = Tabs.Select(async t =>
            {
                var cacheKey = $"{GetPrefixForTab(t.Key)}count";

                var result = await Cache.GetOrSetAsync(
                    cacheKey,
                    () => RepairItemService.SearchRepairServicesAsync(
                        pageNumber: 1,
                        pageSize: 1,
                        status: t.Key,
                        sortBy: "InspectDate",
                        sortDescending: true),
                    TimeSpan.FromMinutes(3)
                );

                return result;
            }).ToList();

            var results = await Task.WhenAll(tasks);

            for (int i = 0; i < Tabs.Count; i++)
            {
                Tabs[i].Count = results[i]?.TotalCount ?? 0;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading tab counts: {ex.Message}");
        }
    }
    private async Task LoadPageData2()
    {
        try
        {
            var result = await Cache.GetOrSetAsync(
                GetCacheKeyForTab(ActiveTabKey, currentPage2, pageSize2),   // ✅ ប្តូរ
                () => RepairItemService.SearchRepairServicesAsync(
                    pageNumber: currentPage2,
                    pageSize: pageSize2,
                    status: ActiveTabKey,                                   // ✅ ប្តូរ
                    sortBy: "InspectDate",
                    sortDescending: true),
                TimeSpan.FromMinutes(3)
            );

            filteredRepairServices2 = result?.Items ?? new List<RepairServices>();
            totalPages2 = result?.TotalPages ?? 0;
            totalItems2 = result?.TotalCount ?? 0;

            // ✅ ធ្វើឲ្យ count លើ tab ដែលកំពុងសកម្មទាន់សម័យភ្លាមៗ
            var activeTab = Tabs.FirstOrDefault(t => t.Key == ActiveTabKey);
            if (activeTab != null) activeTab.Count = totalItems2;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading page data 2: {ex.Message}");
        }
    }
    private static readonly string[] _presetRemarks = new[]
    {
        "មានស្តុក",
        "ដោះពីម៉ាស៊ីន",
        "ស្តុកក្នុងស្រុក",
        "រង់ចាំ ៦ ទៅ៨អាទិត្យ"
    };
    private async Task HandleRemarkSave((SparePartItem Part, string NewValue) e)
    {
        await SaveRemarks(e.Part, e.NewValue);
    }
    private static string GetPrefixForTab(string status) => status switch
    {
        "Inspection" => CacheKeys.PrefixInspectionItem,
        "Awaiting Sparepart" => CacheKeys.PrefixAwaitSparePart,
        "Awaiting Customer Confirm" => CacheKeys.PrefixAwaitCustomer,
        "Sale Confirmed" => CacheKeys.PrefixSaleConfirmed,
        "Sent Spareparts" => CacheKeys.PrefixSentSpareparts,
        _ => CacheKeys.PrefixInspectionItem,
    };

    private async Task SaveRemarks(SparePartItem sparePart, string newValue)
    {
        try
        {
            var success = await SparePartService.UpdateSparepartItemRemarksAsync(sparePart.Id, newValue);

            if (success)
            {
                var savedAt = DateTime.Now;

                sparePart.Remarks = newValue;
                sparePart.RemarksUpdatedAt = savedAt;

                await Cache.InvalidateByPrefixAsync(GetPrefixForTab(ActiveTabKey));

                if (hubConnection?.State == HubConnectionState.Connected)
                    // ✅ CHANGED — remark edit, status doesn't change.
                    await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                    {
                        AffectedStatuses = new[] { ActiveTabKey }
                    });

                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Customization",
                    Title = "Saved",
                    Text = "Remark updated",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Success
                });

                // ✅ NEW — Telegram notification for the remark update. Uses Edit
                // (not Send) so this updates the SAME message already sitting in
                // the status topic (e.g. the "📦 បញ្ជូនទៅផ្នែកស្តុក" message),
                // instead of posting a new one — this avoids a repeat push alert
                // on every remark save, and avoids duplicate messages piling up
                // in the topic if a remark gets edited more than once.
                var capturedReportNo = _selectedRepairService?.reportNo;
                var capturedCompanyName = _selectedRepairService?.CompanyName;
                var capturedAddress = _selectedRepairService?.Address;
                var capturedContactName = _selectedRepairService?.ContactName;
                var capturedPhoneNumber = _selectedRepairService?.PhoneNumber;
                var capturedServiceDate = _selectedRepairService?.ServiceDate;
                var capturedServiceLocation = _selectedRepairService?.ServiceLocation;
                var capturedMachineItemName = _selectedRepairService?.itemName;
                var capturedMachineSerialNumber = _selectedRepairService?.serialNumber;
                var capturedCustomerRequest = _selectedRepairService?.CustomerRequest;
                var capturedItemId = _selectedRepairService?.Id;
                var capturedActiveTabKey = ActiveTabKey;

                // Spare part's own detail (the row this remark belongs to)
                var capturedSparePartItemName = sparePart.ItemName;
                var capturedSparePartSerialNumber = sparePart.SerialNumber;
                var capturedSparePartUseFor = sparePart.UseFor;
                var capturedSparePartQuantity = sparePart.Quantity;
                var capturedSparePartCondition = sparePart.Condition;
                var capturedRemark = newValue;
                var capturedSavedAt = savedAt;

                _ = Task.Run(async () =>
                {
                    try
                    {
                        // ✅ Topic routed by which tab was active when the remark was
                        // saved — matches the TopicKey convention used by every
                        // status-change handler on this page.
                        string topicKey = capturedActiveTabKey switch
                        {
                            "Inspection" => "Inspection",
                            "Awaiting Sparepart" => "AwaitingSparepart",
                            "Awaiting Customer Confirm" => "AwaitingCustomerConfirm",
                            "Sale Confirmed" => "SaleConfirmed",
                            "Sent Spareparts" => "SentSpareparts",
                            _ => "Inspection"
                        };

                        await TelegramQueue.EnqueueAsync(new TelegramMessage
                        {
                            Action = TelegramAction.Edit,           // ✅ Edit, not Send
                            ItemId = capturedItemId ?? Guid.Empty,
                            TopicKey = topicKey,
                            ResolveMessageIdFromTopic = true,       // ✅ finds the live message to edit
                            Text = $"💬 <b>បានធ្វើបច្ចុប្បន្នភាពកំណត់ចំណាំ</b>\n\n" +
                                   $"លេខ Report: <b>{capturedReportNo}</b>\n\n" +
                                   $"ស្ថាប័ន: {capturedCompanyName}\n\n" +
                                   $"អាសយដ្ឋាន: {capturedAddress}\n\n" +
                                   $"ឈ្មោះទំនាក់ទំនង: {capturedContactName}\n\n" +
                                   $"លេខទូរស័ព្ទ: {capturedPhoneNumber}\n\n" +
                                   $"កាលបរិច្ឆេទទទួល: {capturedServiceDate:dd/MM/yyyy HH:mm}\n\n" +
                                   $"ទីតាំងជួសជុល: {capturedServiceLocation}\n\n" +
                                   $"ម៉ាស៊ីន: {capturedMachineItemName}\n\n" +
                                   $"លេខស៊េរីម៉ាស៊ីន: {capturedMachineSerialNumber}\n\n" +
                                   $"សំណើពីអតិថិជន: {capturedCustomerRequest}\n\n" +
                                   $"<b>--- គ្រឿងបន្លាស់ ---</b>\n\n" +
                                   $"ឈ្មោះគ្រឿងបន្លាស់: {capturedSparePartItemName}\n\n" +
                                   $"លេខស៊េរីគ្រឿងបន្លាស់: {capturedSparePartSerialNumber}\n\n" +
                                   $"ប្រើសម្រាប់: {capturedSparePartUseFor}\n\n" +
                                   $"ចំនួន: {capturedSparePartQuantity}\n\n" +
                                   $"ស្ថានភាព: {capturedSparePartCondition}\n\n" +
                                   $"ចំណាំ: {capturedRemark}\n\n" +
                                   $"កាលបរិច្ឆេទកែប្រែ: {capturedSavedAt:dd/MM/yyyy HH:mm}"
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"⚠️ Telegram remark notify failed: {ex.Message}");
                    }
                });
            }
            else
            {
                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Error",
                    Title = "Error",
                    Text = "Failed to save remark",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Danger
                });
            }
        }
        catch (Exception ex)
        {
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Error",
                Text = $"Failed: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }

        StateHasChanged();
    }
