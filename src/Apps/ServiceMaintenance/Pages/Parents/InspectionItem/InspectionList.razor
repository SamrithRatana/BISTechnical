    // ─────────────────────────────────────────────────────
    // STATUS CHANGE (inline dropdown)
    // ─────────────────────────────────────────────────────
    // ✅ SIMPLIFIED — "Awaiting Sparepart" and "Awaiting Customer Confirm" branches
    // moved to reapairItem.razor's OnRepairStatusChanged. This page now only
    // handles "Inspecting" (send back for re-inspection).
    //
    // ✅ PAGINATION FIX — previously this handler removed the affected row from the
    // in-memory list and only decremented totalItems2 locally, WITHOUT reloading
    // from the server. That meant:
    //   1) the current page never got refilled from the next page's worth of data
    //      (a page could silently show fewer than pageSize2 rows), and
    //   2) if the last row on the last page was removed, currentPage2 was never
    //      walked back, leaving the grid stuck on an empty page.
    // Fix mirrors receive-item.razor's ConfirmDelete / inspect-item.razor's
    // HandleSetInspecting: recompute totals/paging, clamp currentPage2, then
    // re-fetch the page (and its spare parts) from the server so the grid, count,
    // and page controls all stay consistent with what's actually in the database.
    // ─────────────────────────────────────────────────────
    // STATUS CHANGE (inline dropdown)
    // ─────────────────────────────────────────────────────
   
    private async Task OnInspectionStatusChanged(RepairServices item, string newStatus)
    {
        if (string.IsNullOrEmpty(newStatus) || newStatus == item.Status) return;

        if (newStatus == "Inspecting")
        {
            try
            {
                var currentUserId = JwtSessionService.GetCurrentUserId();
                if (!currentUserId.HasValue)
                {
                    ToastNotificationService.ShowToast(new ToastOptions
                    {
                        ProviderName = "Error",
                        Title = "Authentication Error",
                        Text = "Session expired. Please login.",
                        ThemeMode = ToastThemeMode.Pastel,
                        RenderStyle = ToastRenderStyle.Danger
                    });
                    return;
                }

                isSaving = true;
                StateHasChanged();

                var reInspectRequest = new InspectItemRequest
                {
                    Id = item.Id,
                    Inspection = item.Inspection ?? string.Empty,
                    Solution = item.Solution ?? string.Empty,
                    InspectBy = currentUserId.Value,
                    ServiceTypeId = item.ServiceTypeId ?? 1,
                    SpareParts = item.SparePartItems?
                        .Where(sp => sp.SparePartId.HasValue && sp.SparePartId.Value != Guid.Empty)
                        .Select(sp => new SparePart
                        {
                            Id = sp.Id,
                            SparePartId = sp.SparePartId.Value,
                            Description = sp.Description ?? string.Empty,
                            Quantity = sp.Quantity,
                            Condition = sp.Condition ?? string.Empty,
                            ServiceId = item.Id,
                            IsHoldStatus = false
                        }).ToList() ?? new List<SparePart>()
                };

                await InspectItemService.UpdateInspectItemAsync(item.Id, reInspectRequest);

                await InspectingService.SetInspectingAsync(new SetInspectingRequest
                {
                    Id = item.Id,
                    InspectingBy = currentUserId.Value
                });

                // ✅ CHANGED — invalidate only the 2 prefixes actually touched by
                // this transition: "Inspection" (item is leaving it) and
                // "Inspecting" (item is entering it — served by inspect-item.razor).
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixInspectionItem);
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixInspectItem);
                await Cache.InvalidateAsync(CacheKeys.DashboardStats);

                // ✅ CHANGED — broadcast now carries exactly which statuses changed,
                // so every page listening only reacts if it actually cares.
                if (hubConnection?.State == HubConnectionState.Connected)
                    await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                    {
                        AffectedStatuses = new[] { "Inspection", "Inspecting" }
                    });

                // ✅ Telegram: close out "Inspection" topic (59), re-open "Inspecting" topic (61)
                // (No spare-part section on this branch, so no race here.)
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await TelegramQueue.EnqueueAsync(new TelegramMessage
                        {
                            Action = TelegramAction.Delete,
                            ItemId = item.Id,
                            TopicKey = "Inspection",
                            ResolveMessageIdFromTopic = true
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"⚠️ Telegram delete enqueue failed: {ex.Message}");
                    }

                    try
                    {
                        await TelegramQueue.EnqueueAsync(new TelegramMessage
                        {
                            Action = TelegramAction.Send,
                            ItemId = item.Id,
                            TopicKey = "Inspecting",
                            Text = $"🔁 <b>វិនិច្ឆ័យម្ដងទៀត</b>\n" +
                                   $"លេខ Report: <b>{item.reportNo}</b>\n" +
                                   $"ក្រុមហ៊ុន: {item.CompanyName}\n" +
                                   $"ម៉ាស៊ីន: {item.itemName}\n" +
                                   $"លេខស៊េរី: {item.serialNumber}"
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"⚠️ Telegram send enqueue failed: {ex.Message}");
                    }
                });

                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Customization",
                    Title = "Success",
                    Text = "វិនិច្ឆ័យម្ដងទៀត",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Success
                });

                await LoadTabCountsAsync();
                await LoadPageData2();
                await LoadSparePartsForCurrentPageAsync();

                isSaving = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                item.Status = "Inspection";
                isSaving = false;
                StateHasChanged();
                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Error",
                    Title = "Error",
                    Text = $"Failed: {ex.Message}",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Danger
                });
            }
        }
        else if (newStatus == "Awaiting Sparepart")
        {
            try
            {
                var currentUserId = JwtSessionService.GetCurrentUserId();
                if (!currentUserId.HasValue)
                {
                    ToastNotificationService.ShowToast(new ToastOptions
                    {
                        ProviderName = "Error",
                        Title = "Authentication Error",
                        Text = "Session expired. Please login.",
                        ThemeMode = ToastThemeMode.Pastel,
                        RenderStyle = ToastRenderStyle.Danger
                    });
                    return;
                }

                isSaving = true;
                StateHasChanged();

                if (item.SparePartItems != null && item.SparePartItems.Any())
                {
                    var holdRequest = new InspectItemRequest
                    {
                        Id = item.Id,
                        Inspection = item.Inspection ?? string.Empty,
                        Solution = item.Solution ?? string.Empty,
                        InspectBy = item.inspectBy ?? Guid.Empty,
                        ServiceTypeId = item.ServiceTypeId ?? 1,
                        SpareParts = item.SparePartItems
                            .Where(sp => sp.SparePartId.HasValue && sp.SparePartId.Value != Guid.Empty)
                            .Select(sp => new SparePart
                            {
                                Id = sp.Id,
                                SparePartId = sp.SparePartId.Value,
                                Description = sp.Description ?? string.Empty,
                                Quantity = sp.Quantity,
                                Condition = sp.Condition ?? string.Empty,
                                ServiceId = item.Id,
                                IsHoldStatus = true
                            }).ToList()
                    };
                    await InspectItemService.UpdateInspectItemAsync(item.Id, holdRequest);
                }

                // ✅ FIX — resolve/capture the spare-parts section as a plain string
                // NOW, while item.SparePartItems / GetSparePartById(_spareParts) still
                // reflect the CURRENT page's data. If this were built later inside the
                // Task.Run below, it would race against LoadSparePartsForCurrentPageAsync()
                // further down — which reassigns _spareParts to the NEXT page's data —
                // and GetSparePartById could then miss the lookup and fall back to
                // "Unknown Item" intermittently depending on thread-pool timing.
                string sparePartsSectionCaptured = TelegramMessageHelper.BuildSparePartsSection(
                    item.SparePartItems, GetSparePartById);

                await AwaitingSparePartService.SetAwaitingSparePartAsync(
                    new AwaitingSparePartRequest
                    {
                        Id = item.Id,
                        SetAwaitingSparepartBy = currentUserId.Value
                    });

                // ✅ CHANGED — only "Inspection" (leaving) and "Awaiting Sparepart"
                // (entering, served by await-sparepart.razor) prefixes need clearing.
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixInspectionItem);
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixAwaitSparePart);
                await Cache.InvalidateAsync(CacheKeys.DashboardStats);

                if (hubConnection?.State == HubConnectionState.Connected)
                    await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                    {
                        AffectedStatuses = new[] { "Inspection", "Awaiting Sparepart" }
                    });

                // ✅ Telegram: close out "Inspection" topic (59), open "Awaiting Sparepart" topic (57)
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await TelegramQueue.EnqueueAsync(new TelegramMessage
                        {
                            Action = TelegramAction.Delete,
                            ItemId = item.Id,
                            TopicKey = "Inspection",
                            ResolveMessageIdFromTopic = true
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"⚠️ Telegram delete enqueue failed: {ex.Message}");
                    }

                    try
                    {
                        // ✅ FIX — uses the value captured BEFORE _spareParts could be
                        // reassigned by LoadSparePartsForCurrentPageAsync(), instead of
                        // resolving the catalog lookup here inside the background task.
                        string sparePartsSection = sparePartsSectionCaptured;
                        await TelegramQueue.EnqueueAsync(new TelegramMessage
                        {
                            Action = TelegramAction.Send,
                            ItemId = item.Id,
                            TopicKey = "AwaitingSparepart",
                            Text = $"📦 <b>បានបញ្ជូនមកផ្នែកស្តុក</b>\n\n" +
                                   $"លេខ Report: <b>{item.reportNo}</b>\n\n" +
                                   $"ស្ថាប័ន: {item.CompanyName}\n\n" +
                                   $"ទីតាំងជួសជុល: {item.ServiceLocation}\n\n" +
                                   $"ម៉ាស៊ីន: {item.itemName}\n\n" +
                                   $"ប្រភេទសេវាកម្ម: {item.ServiceType}\n\n" +
                                   $"SerialNumber: {item.serialNumber}\n\n" +
                                   $"សំណើពីអតិថិជន: {item.CustomerRequest}\n\n" +
                                   $"វិនិច្ឆ័យ: {item.Inspection}\n\n" +
                                   $"ដំណោះស្រាយ: {item.Solution}\n\n" +
                                   $"ឈ្មោះអ្នកវិនិច្ឆ័យ: {GetUserNameById(item.inspectBy)}\n\n" +
                                   $"ឈ្មោះអ្នកបញ្ជូន: {GetUserNameById(currentUserId)}" +
                                   $"{sparePartsSection}"
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"⚠️ Telegram send enqueue failed: {ex.Message}");
                    }
                });

                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Customization",
                    Title = "Success",
                    Text = "បញ្ជូនទៅផ្នែកស្តុក",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Success
                });

                totalItems2 = Math.Max(0, totalItems2 - 1);
                totalPages2 = totalItems2 > 0 ? (int)Math.Ceiling(totalItems2 / (double)pageSize2) : 0;

                if (currentPage2 > totalPages2 && totalPages2 > 0)
                    currentPage2 = totalPages2;
                else if (totalPages2 == 0)
                    currentPage2 = 1;

                await LoadPageData2();
                await LoadSparePartsForCurrentPageAsync();

                isSaving = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                item.Status = "Inspection";
                isSaving = false;
                StateHasChanged();
                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Error",
                    Title = "Error",
                    Text = $"Failed: {ex.Message}",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Danger
                });
            }
        }
        else if (newStatus == "Awaiting Customer Confirm")
        {
            try
            {
                var currentUserId = JwtSessionService.GetCurrentUserId();
                if (!currentUserId.HasValue)
                {
                    ToastNotificationService.ShowToast(new ToastOptions
                    {
                        ProviderName = "Error",
                        Title = "Authentication Error",
                        Text = "Session expired. Please login.",
                        ThemeMode = ToastThemeMode.Pastel,
                        RenderStyle = ToastRenderStyle.Danger
                    });
                    return;
                }

                isSaving = true;
                StateHasChanged();

                if (item.SparePartItems != null && item.SparePartItems.Any())
                {
                    var holdRequest = new InspectItemRequest
                    {
                        Id = item.Id,
                        Inspection = item.Inspection ?? string.Empty,
                        Solution = item.Solution ?? string.Empty,
                        InspectBy = item.inspectBy ?? Guid.Empty,
                        ServiceTypeId = item.ServiceTypeId ?? 1,
                        SpareParts = item.SparePartItems
                            .Where(sp => sp.SparePartId.HasValue && sp.SparePartId.Value != Guid.Empty)
                            .Select(sp => new SparePart
                            {
                                Id = sp.Id,
                                SparePartId = sp.SparePartId.Value,
                                Description = sp.Description ?? string.Empty,
                                Quantity = sp.Quantity,
                                Condition = sp.Condition ?? string.Empty,
                                ServiceId = item.Id,
                                IsHoldStatus = true
                            }).ToList()
                    };
                    await InspectItemService.UpdateInspectItemAsync(item.Id, holdRequest);
                }

                // ✅ FIX — same reasoning as the "Awaiting Sparepart" branch above:
                // capture the resolved spare-parts string now, before
                // LoadSparePartsForCurrentPageAsync() can reassign _spareParts
                // underneath GetSparePartById and cause an intermittent
                // "Unknown Item" fallback in the background Task.Run.
                string sparePartsSectionCaptured = TelegramMessageHelper.BuildSparePartsSection(
                    item.SparePartItems, GetSparePartById);

                await AwaitingCustomerConfirmService.SetAwaitingCustomerConfirmAsync(
                    new AwaitingCustomerConfirmRequest
                    {
                        Id = item.Id,
                        SetAwaitingCustomerConfirmBy = currentUserId.Value
                    });

                // ✅ CHANGED — only "Inspection" (leaving) and "Awaiting Customer
                // Confirm" (entering, served by await-customer.razor) prefixes
                // need clearing.
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixInspectionItem);
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixAwaitCustomer);
                await Cache.InvalidateAsync(CacheKeys.DashboardStats);

                if (hubConnection?.State == HubConnectionState.Connected)
                    await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                    {
                        AffectedStatuses = new[] { "Inspection", "Awaiting Customer Confirm" }
                    });

                // ✅ Telegram: close out "Inspection" topic (59), open "Awaiting Customer Confirm" topic (55)
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await TelegramQueue.EnqueueAsync(new TelegramMessage
                        {
                            Action = TelegramAction.Delete,
                            ItemId = item.Id,
                            TopicKey = "Inspection",
                            ResolveMessageIdFromTopic = true
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"⚠️ Telegram delete enqueue failed: {ex.Message}");
                    }

                    try
                    {
                        // ✅ FIX — uses the value captured BEFORE _spareParts could be
                        // reassigned by LoadSparePartsForCurrentPageAsync(), same fix as
                        // the "Awaiting Sparepart" branch. (Previously this referenced an
                        // undeclared `sparePartsSection` here — out-of-scope bug — now
                        // fixed to also close that compile-time issue.)
                        string sparePartsSection = sparePartsSectionCaptured;
                        await TelegramQueue.EnqueueAsync(new TelegramMessage
                        {
                            Action = TelegramAction.Send,
                            ItemId = item.Id,
                            TopicKey = "AwaitingCustomerConfirm",
                            Text = $"📞 <b>បានបញ្ជូនមកផ្នែកទីផ្សារ</b>\n\n" +
                                   $"លេខ Report: <b>{item.reportNo}</b>\n\n" +
                                   $"ស្ថាប័ន: {item.CompanyName}\n\n" +
                                   $"ទីតាំងជួសជុល: {item.ServiceLocation}\n\n" +
                                   $"ម៉ាស៊ីន: {item.itemName}\n\n" +
                                   $"SerialNumber: {item.serialNumber}\n\n" +
                                   $"ប្រភេទសេវាកម្ម: {item.ServiceType}\n\n" +
                                   $"សំណើពីអតិថិជន: {item.CustomerRequest}\n\n" +
                                   $"វិនិច្ឆ័យ: {item.Inspection}\n\n" +
                                   $"ដំណោះស្រាយ: {item.Solution}\n\n" +
                                   $"ឈ្មោះអ្នកវិនិច្ឆ័យ: {GetUserNameById(item.inspectBy)}\n\n" +
                                   $"ឈ្មោះអ្នកបញ្ជូន: {GetUserNameById(currentUserId)}" +
                                   $"{sparePartsSection}"
                        });
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"⚠️ Telegram send enqueue failed: {ex.Message}");
                    }
                });

                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Customization",
                    Title = "Success",
                    Text = "បញ្ជូនទៅផ្នែកទីផ្សារ",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Success
                });

                totalItems2 = Math.Max(0, totalItems2 - 1);
                totalPages2 = totalItems2 > 0 ? (int)Math.Ceiling(totalItems2 / (double)pageSize2) : 0;

                if (currentPage2 > totalPages2 && totalPages2 > 0)
                    currentPage2 = totalPages2;
                else if (totalPages2 == 0)
                    currentPage2 = 1;

                await LoadPageData2();
                await LoadSparePartsForCurrentPageAsync();

                isSaving = false;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                item.Status = "Inspection";
                isSaving = false;
                StateHasChanged();
                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Error",
                    Title = "Error",
                    Text = $"Failed: {ex.Message}",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Danger
                });
            }
        }
    }
    // ─────────────────────────────────────────────────────
    // VIEW DETAILS DIALOG
    // ─────────────────────────────────────────────────────
    private async Task ShowRepairServiceDetails(RepairServices repairService)
    {
        _selectedRepairService = repairService;

        // ✅ CHANGED — was a sequential foreach + await (one HTTP round-trip
        // per missing spare part, in series). A report with several spare
        // parts could take noticeably longer to open than the grid load
        // itself. Now all missing spare parts are fetched concurrently with
        // Task.WhenAll, matching the fix already applied to
        // LoadSparePartsForCurrentPageAsync on this same page.
        if (_selectedRepairService?.SparePartItems != null && _selectedRepairService.SparePartItems.Any())
        {
            var missingIds = _selectedRepairService.SparePartItems
                .Where(item => item.SparePartId.HasValue && item.SparePartId.Value != Guid.Empty)
                .Select(item => item.SparePartId.Value)
                .Where(id => !_spareParts.Any(x => x.Id == id))
                .Distinct()
                .ToList();

            if (missingIds.Count > 0)
            {
                var fetchTasks = missingIds.Select(async id =>
                {
                    try
                    {
                        return await SparePartService.GetSparePartByIdAsync(id);
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"❌ Error fetching spare part {id}: {ex.Message}");
                        return null;
                    }
                });

                var fetchedResults = await Task.WhenAll(fetchTasks);

                _spareParts.AddRange(fetchedResults.Where(x => x != null));
            }
        }

        isViewDialogVisible = true;
        StateHasChanged();
    }



    // ─────────────────────────────────────────────────────
    // SEARCH
    // ─────────────────────────────────────────────────────
    private async Task PerformInspectionSearch()
    {
        if (string.IsNullOrWhiteSpace(InspectionSearchValue)) { await LoadPageData2(); await LoadSparePartsForCurrentPageAsync(); return; }
        await PerformInspectionSearchInternal(InspectionSearchValue);
    }

    private async Task PerformInspectionSearchInternal(string searchValue)
    {
        try
        {
            var result = await RepairItemService.SearchRepairServicesAsync(
                pageNumber: 1,
                pageSize: pageSize2,
                status: ActiveTabKey,                    // ✅ ប្តូរ
                searchTerm: searchValue.Trim(),
                sortBy: "InspectDate",
                sortDescending: true);

            filteredRepairServices2 = result.Items;
            totalPages2 = result.TotalPages;
            totalItems2 = result.TotalCount;
            currentPage2 = 1;
            await LoadSparePartsForCurrentPageAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Inspection search error: {ex.Message}");
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Search Error",
                Text = $"Failed to search: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }
    }

    private void OnInspectionSearchInput(InputEventArgs args)
    {
        _inspectionSearchDebounceTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(args.Value))
        {
            _ = Task.Run(async () =>
                await InvokeAsync(async () =>
                {
                    await Cache.InvalidateManyAsync(
                        GetCacheKeyForTab(ActiveTabKey, currentPage2, pageSize2));  // ✅ ប្តូរ
                    await LoadPageData2();
                    await LoadSparePartsForCurrentPageAsync();
                    StateHasChanged();
                }));
            return;
        }

        _inspectionSearchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                    await PerformInspectionSearchInternal(args.Value));
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Inspection search error: {ex.Message}");
            }
        }, null, 300, Timeout.Infinite);
    }

    private async Task ClearInspectionSearch()
    {
        InspectionSearchValue = string.Empty;
        currentPage2 = 1;
        await Cache.InvalidateManyAsync(
            GetCacheKeyForTab(ActiveTabKey, currentPage2, pageSize2),   // ✅ ប្តូរ
            GetCacheKeyForTab(ActiveTabKey, 1, pageSize2)                // ✅ ប្តូរ
        );
        await LoadPageData2();
        await LoadSparePartsForCurrentPageAsync();
        StateHasChanged();
    }

    // ─────────────────────────────────────────────────────
    // PRINT
    // ─────────────────────────────────────────────────────
    private async Task ShowReportPreview(RepairServices selectedRepairService)
    {
        if (selectedRepairService == null) return;
        try
        {
            var report = new Report2();

            // ✅ CHANGED — was:
            //   string repairByUser = GetUserNameById(selectedRepairService.repairBy);
            //   string verifiedByUser = GetUserNameById(selectedRepairService.verifiedBy);
            // Both fields are empty at "Inspection" stage, so this always printed
            // "Unknown". Now resolved per current status instead.
            string repairByUser = GetRepairByNameForReport(selectedRepairService);
            string verifiedByUser = GetVerifiedByNameForReport(selectedRepairService);

            // ✅ CHANGED — phone lookup follows the same status-based user,
            // not always repairBy/verifiedBy, so the phone number shown
            // matches whoever's name is printed.
            Guid? repairByPhoneUserId = selectedRepairService.Status switch
            {
                "Inspection" => selectedRepairService.inspectBy,
                "Awaiting Sparepart" => selectedRepairService.setAwaitingSparepartBy,
                "Awaiting Customer Confirm" => selectedRepairService.setAwaitingCustomerConfirmBy,
                "Sale Confirmed" => selectedRepairService.setSaleConfirmedBy,
                "Sent Spareparts" => selectedRepairService.setSentSparepartsBy,
                _ => selectedRepairService.repairBy
            };

            Guid? verifiedByPhoneUserId = DefaultVerifiedById;

            var phoneNumbers = await Task.WhenAll(
                GlobalUserCache.GetUserPhoneNumberByIdAsync(repairByPhoneUserId, autoLoad: true),
                GlobalUserCache.GetUserPhoneNumberByIdAsync(verifiedByPhoneUserId, autoLoad: true)
            );

            if (selectedRepairService.SparePartItems != null)
            {
                var validParts = selectedRepairService.SparePartItems
                    .Where(i => i.SparePartId.HasValue && i.SparePartId.Value != Guid.Empty)
                    .ToList();
                var fetchTasks = validParts.Select(async item =>
                {
                    try
                    {
                        var details = await SparePartService.GetSparePartByIdAsync(item.SparePartId.Value);
                        if (details != null)
                        {
                            item.ItemName = details.ItemName;
                            item.SerialNumber = details.SerialNumber;
                            item.UseFor = details.UseFor;
                        }
                    }
                    catch { }
                }).ToList();
                await Task.WhenAll(fetchTasks);
            }

            report.SetParameters(selectedRepairService, selectedRepairService.ServiceLocation,
                selectedRepairService.SparePartItems, selectedRepairService.hasContract,
                repairByUser, verifiedByUser, phoneNumbers[0], phoneNumbers[1]);

            foreach (var param in new[] { "Id", "ReportNumber", "CompanyName", "ContactName", "PhoneNumber", "Address", "ItemName", "SerialNumber", "CustomerRequest", "inspection", "Solution", "CompanyServiceChecked", "OnSiteChecked", "HasContract", "Datestart", "Datefinish", "RepairBy", "VerifiedBy", "RepairByPhone", "VerifiedByPhone" })
                report.Parameters[param].Visible = false;

            byte[] reportData;
            using (var ms = new MemoryStream()) { report.ExportToPdf(ms); reportData = ms.ToArray(); }

            string sanitized = selectedRepairService.reportNo?.Replace("/", "-").Replace("\\", "-") ?? "Report";
            string filename = $"ServiceReport_{sanitized}_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";
            await JSRuntime.InvokeVoidAsync("blazorReportsPrint.printReport", Convert.ToBase64String(reportData), filename);
        }
        catch (Exception ex)
        {
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Report Error",
                Text = $"Failed to generate report: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }
    }

