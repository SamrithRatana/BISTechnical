    // ─────────────────────────────────────────────────────
    // DISPOSE
    // ─────────────────────────────────────────────────────
    // ✅ FIXED — @implements IAsyncDisposable was missing at the top of this file.
    // Without that directive Blazor never calls DisposeAsync() when this component
    // is torn down, so hubConnection (SignalR), colorChangeTimer (ticks every 1s
    // forever), and the two debounce timers all kept running/leaking every time a
    // user navigated away from this page.
    public async ValueTask DisposeAsync()
    {
        _receivedSearchDebounceTimer?.Dispose();
        _sparePartSearchDebounceTimer?.Dispose();
        comboBoxRefsDesktop.Clear();
        comboBoxRefsMobile.Clear();
        _activeSparePartIndex = null;
        if (hubConnection != null) await hubConnection.DisposeAsync();
    }
