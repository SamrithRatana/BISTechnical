    private async Task EnsureSelectedSparePartsInFilteredList()
    {
        if (inspectItem?.SpareParts == null || !inspectItem.SpareParts.Any()) return;

        var selectedIds = inspectItem.SpareParts
            .Where(sp => sp.SparePartId != Guid.Empty)
            .Select(sp => sp.SparePartId)
            .ToList();

        // ✅ CHANGED — was a sequential foreach + await per missing spare part.
        // Now fetches all missing ones concurrently, same fix as
        // LoadSelectedSparePartsOnly above.
        var missingIds = selectedIds
            .Where(id => !filteredSpareParts.Any(sp => sp.Id == id))
            .Distinct()
            .ToList();

        if (missingIds.Count == 0) return;

        var fetchTasks = missingIds.Select(async id =>
        {
            try
            {
                return await SparePartService.GetSparePartByIdAsync(id);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error fetching {id}: {ex.Message}");
                return null;
            }
        });

        var results = await Task.WhenAll(fetchTasks);

        foreach (var sp in results)
        {
            if (sp != null && !filteredSpareParts.Any(x => x.Id == sp.Id))
                filteredSpareParts.Insert(0, sp);
        }
    }

    private async Task LoadSelectedSparePartsOnly(List<SparePart> spareParts)
    {
        try
        {
            filteredSpareParts.Clear();
            if (spareParts == null || !spareParts.Any()) return;

            var sparePartIds = spareParts
                .Where(sp => sp.SparePartId != Guid.Empty)
                .Select(sp => sp.SparePartId)
                .Distinct()
                .ToList();

            if (!sparePartIds.Any()) return;

            // ✅ CHANGED — was a sequential foreach + await, one HTTP round-trip
            // per spare part in series. A ticket with several pre-selected spare
            // parts made the "Accept" button noticeably slow to open the dialog.
            // Task.WhenAll fetches all of them concurrently instead.
            var fetchTasks = sparePartIds.Select(async id =>
            {
                try
                {
                    return await SparePartService.GetSparePartByIdAsync(id);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"❌ Error loading {id}: {ex.Message}");
                    return null;
                }
            });

            var results = await Task.WhenAll(fetchTasks);
            var loaded = results.Where(sp => sp != null).ToList();

            filteredSpareParts = loaded;
            _spareParts = loaded;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error in LoadSelectedSparePartsOnly: {ex.Message}");
            filteredSpareParts.Clear();
        }
    }
    private MarkupString HighlightMatch(string text, string term)
    {
        if (string.IsNullOrEmpty(text))
            return (MarkupString)string.Empty;

        if (string.IsNullOrWhiteSpace(term))
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);

        var sb = new System.Text.StringBuilder();
        int startIndex = 0;
        int idx;

        while ((idx = text.IndexOf(term, startIndex, StringComparison.OrdinalIgnoreCase)) >= 0)
        {
            sb.Append(System.Net.WebUtility.HtmlEncode(text.Substring(startIndex, idx - startIndex)));

            var matchedText = text.Substring(idx, term.Length);
            sb.Append("<span style=\"background-color:#ffeb3b;\">")
              .Append(System.Net.WebUtility.HtmlEncode(matchedText))
              .Append("</span>");

            startIndex = idx + term.Length;
        }

        sb.Append(System.Net.WebUtility.HtmlEncode(text.Substring(startIndex)));

        return (MarkupString)sb.ToString();
    }
    // ✅ FIXED — was: if (!filteredSpareParts.Any()) { load full catalog }
    // Problem: when editing an item that already has spare parts selected,
    // LoadSelectedSparePartsOnly() pre-populates filteredSpareParts with JUST
    // those selected items, so filteredSpareParts.Any() is already true. That
    // meant the full catalog never loaded, and users could only pick from the
    // items already on the ticket when adding a NEW spare part row.
    // Fix: use a dedicated isFullCatalogLoaded flag, and MERGE the fetched
    // catalog into filteredSpareParts (instead of overwriting) so previously
    // selected items already shown remain visible/selectable too.
    private async Task OnComboBoxClick(int index)
    {
        if (!isFullCatalogLoaded)
        {
            try
            {
                var result = await SparePartService.GetSparePartsPagedAsync(pageNumber: 1, pageSize: 10);
                var fullList = result.Items?.ToList() ?? new List<SparePartObject>();

                foreach (var sp in fullList)
                {
                    if (!filteredSpareParts.Any(x => x.Id == sp.Id))
                        filteredSpareParts.Add(sp);
                }

                isFullCatalogLoaded = true;
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error loading spare parts: {ex.Message}");
            }
        }
    }

    private async Task OnComboBoxFocus(int index)
    {
        _activeSparePartIndex = index;
        _popupShownForCurrentSearch = false; // ➕ NEW — reset per focus session
        await OnComboBoxClick(index);
    }
    public async Task OnFilteringSparePart(Syncfusion.Blazor.DropDowns.FilteringEventArgs args)
    {
        args.PreventDefaultAction = true;
        _sparePartSearchDebounceTimer?.Dispose();
        isSparePartLoading = true;
        StateHasChanged();

        if (string.IsNullOrWhiteSpace(args.Text))
        {
            sparePartSearchTerm = string.Empty;
            isSparePartLoading = false;
            _popupShownForCurrentSearch = false;
            await EnsureSelectedSparePartsInFilteredList();
            StateHasChanged();
            await ShowActiveComboPopup();
            return;
        }

        _sparePartSearchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    sparePartSearchTerm = args.Text.Trim();

                    var result = await SparePartService.SearchSparePartsAsync(
                        pageNumber: 1, pageSize: 50, searchTerm: args.Text.Trim());
                    filteredSpareParts = result.Items.ToList();
                    isFullCatalogLoaded = true;
                    await EnsureSelectedSparePartsInFilteredList();
                    isSparePartLoading = false;
                    StateHasChanged();

                    if (!_popupShownForCurrentSearch)
                    {
                        await ShowActiveComboPopup();
                        _popupShownForCurrentSearch = true;
                    }
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Search error: {ex.Message}");
                isSparePartLoading = false;
                StateHasChanged();
            }
        }, null, 300, Timeout.Infinite);
    }
    private async Task ShowActiveComboPopup()
