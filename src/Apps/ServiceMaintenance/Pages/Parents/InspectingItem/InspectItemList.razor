            await combo.ShowPopupAsync();
        }
    }
    // ─────────────────────────────────────────────────────
    // EDIT DIALOG — SAVE
    private async Task Save()
    {
        try
        {
            saveErrorMessage = string.Empty;
            isSaving = true;
            StateHasChanged();

            if (inspectItem == null || inspectItem.Id == Guid.Empty)
                throw new InvalidOperationException("Invalid inspection data.");

            inspectItem.SpareParts ??= new List<SparePart>();

            var currentUserId = JwtSessionService.GetCurrentUserId();
            if (!currentUserId.HasValue)
            {
                saveErrorMessage = "Your session has expired. Please login again.";
                isSaving = false;
                StateHasChanged();
                return;
            }

            inspectItem.InspectBy = currentUserId.Value;
            Guid repairServiceId = inspectItem.Id;

            var validSpareParts = inspectItem.SpareParts
                .Where(sp => sp.SparePartId != Guid.Empty && sp.Quantity > 0)
                .ToList();

            foreach (var sp in validSpareParts)
            {
                sp.ServiceId = repairServiceId;
                sp.IsHoldStatus = true;
            }

            inspectItem.SpareParts = validSpareParts;

            if (isEditMode)
                await InspectItemService.UpdateInspectItemAsync(repairServiceId, inspectItem);
            else
                await InspectItemService.CreateInspectItemAsync(repairServiceId, inspectItem);

            await Cache.InvalidateManyAsync(
                CacheKeys.InspectItem(currentPage, pageSize),
                CacheKeys.InspectItem(1, pageSize),
                CacheKeys.DashboardStats
            );
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixInspectionItem);

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Customization",
                Title = "Success",
                Text = isEditMode ? "Inspection updated successfully" : "Inspection created successfully",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Success
            });

            var capturedReportNo = _selectedRepairService?.reportNo;
            var capturedCompanyName = _selectedRepairService?.CompanyName;
            var capturedServiceLocation = _selectedRepairService?.ServiceLocation;
            var capturedItemName = _selectedRepairService?.itemName;
            var capturedSerialNumber = _selectedRepairService?.serialNumber;
            var capturedItemId = _selectedRepairService?.Id;
            var capturedServiceTypeId = inspectItem.ServiceTypeId;
            var capturedServiceTypeName = _serviceTypes?
                .FirstOrDefault(st => st.Id == capturedServiceTypeId)?.Name;
            var capturedServiceTypeDisplay = string.IsNullOrEmpty(capturedServiceTypeName)
                ? "N/A"
                : GetLocalizedServiceTypeName(capturedServiceTypeName);
            var capturedInspectByUserId = currentUserId.Value;

            var capturedSpareParts = validSpareParts
                .Select(sp =>
                {
                    var catalogItem = filteredSpareParts.FirstOrDefault(fp => fp.Id == sp.SparePartId);
                    return new
                    {
                        ItemName = catalogItem?.ItemName ?? "Unknown Item",
                        sp.Quantity,
                        sp.Condition,
                        sp.Remarks
                    };
                })
                .ToList();

            bool wasEditMode = isEditMode;

            isEditDialogVisible = false;
            isEditMode = false;
            _selectedRepairService = null;
            isRowSelected = false;
            filteredSpareParts.Clear();
            isFullCatalogLoaded = false;
            sparePartSearchTerm = string.Empty;
            _spareParts = Enumerable.Empty<SparePartObject>();
            comboBoxRefsDesktop.Clear();
            comboBoxRefsMobile.Clear();
            _activeSparePartIndex = null;
            _popupShownForCurrentSearch = false;
            isSaving = false;
            StateHasChanged();

            _ = Task.Run(async () =>
            {
                try
                {
                    if (hubConnection?.State == HubConnectionState.Connected)
                        await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                        {
                            AffectedStatuses = new[] { "Inspecting", "Inspection" }
                        });

                    currentPage = 1;
                    await Cache.InvalidateManyAsync(CacheKeys.InspectItem(1, pageSize));
                    await LoadPageData();
                    await InvokeAsync(StateHasChanged);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Background error: {ex.Message}");
                }

                try
                {
                    await TelegramQueue.EnqueueAsync(new TelegramMessage
                    {
                        Action = TelegramAction.Delete,
                        ItemId = repairServiceId,
                        TopicKey = "Inspecting",
                        ResolveMessageIdFromTopic = true
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Telegram delete enqueue failed: {ex.Message}");
                }

                try
                {
                    string sparePartsSection = string.Empty;
                    if (capturedSpareParts != null && capturedSpareParts.Any())
                    {
                        var sparePartLines = capturedSpareParts.Select(sp =>
                           $"- {sp.ItemName} x{sp.Quantity}" +
                           (!string.IsNullOrWhiteSpace(sp.Condition) ? $" ({sp.Condition})" : "") +
                           (!string.IsNullOrWhiteSpace(sp.Remarks) ? $"\n  💬 {sp.Remarks}" : ""));

                        sparePartsSection = "\n\n<b>គ្រឿងបន្លាស់ត្រូវការ:</b>\n" + string.Join("\n", sparePartLines);
                    }

                    string inspectorName = GetUserNameById(capturedInspectByUserId);

                    await TelegramQueue.EnqueueAsync(new TelegramMessage
                    {
                        Action = TelegramAction.Send,
                        ItemId = capturedItemId ?? repairServiceId,
                        TopicKey = "Inspection",
                        Text = $"✅ <b>វិនិច្ឆ័យរួចរាល់</b>\n\n" +
                               $"លេខ Report: <b>{capturedReportNo}</b>\n\n" +
                               $"ស្ថាប័ន: {capturedCompanyName}\n\n" +
                               $"ទីតាំងជួសជុល: {capturedServiceLocation}\n\n" +
                               $"ម៉ាស៊ីន: {capturedItemName}\n\n" +
                               $"SerialNumber: {capturedSerialNumber}\n\n" +
                               $"ប្រភេទសេវាកម្ម: {capturedServiceTypeDisplay}\n\n" +
                               $"ឈ្មោះអ្នកវិនិច្ឆ័យ: {inspectorName}" +
                               $"{sparePartsSection}"
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Telegram send enqueue failed: {ex.Message}");
                }
            });
        }
        catch (HttpRequestException httpEx)
        {
            var fullError = httpEx.Message;
            string display = "An error occurred while saving.";
            try
            {
                if (fullError.Contains("Insufficient stock"))
                {
                    var match = System.Text.RegularExpressions.Regex.Match(
                        fullError,
                        @"Insufficient stock for[^:]*: ([^.]+)\.\s*Available: (\d+),?\s*Required: (\d+)");
                    display = match.Success
                        ? $"Insufficient stock for: {match.Groups[1].Value}. Available: {match.Groups[2].Value}, Required: {match.Groups[3].Value}"
                        : "Insufficient stock. Please check inventory.";
                }
            }
            catch { }

            saveErrorMessage = display;
            isSaving = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            saveErrorMessage = ex.Message;
            isSaving = false;
            StateHasChanged();
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Error",
                Text = $"Failed to save: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }
    }

    private void CancelEditDialog()
    {
        isEditDialogVisible = false;
        _selectedRepairService = null;
        isRowSelected = false;
        isEditMode = false;
        filteredSpareParts.Clear();
        isFullCatalogLoaded = false;
        sparePartSearchTerm = string.Empty;
        _spareParts = Enumerable.Empty<SparePartObject>();
        comboBoxRefsDesktop.Clear();
        comboBoxRefsMobile.Clear();
        _activeSparePartIndex = null;
        _popupShownForCurrentSearch = false;
        saveErrorMessage = string.Empty;
    }

