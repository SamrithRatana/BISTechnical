    private async Task HandleSetInspecting(RepairServices item)
    {
        try
        {
            var currentUserId = JwtSessionService.GetCurrentUserId();
            if (!currentUserId.HasValue) return;

            item.Status = "Inspecting";
            StateHasChanged();

            var request = new SetInspectingRequest
            {
                Id = item.Id,
                InspectingBy = currentUserId.Value
            };

            await InspectingService.SetInspectingAsync(request);

            await Cache.InvalidateManyAsync(
                CacheKeys.ReceiveItem(currentPage, pageSize),
                CacheKeys.DashboardStats
            );
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixInspectItem);

            if (hubConnection?.State == HubConnectionState.Connected)
            {
                try
                {
                    await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                    {
                        AffectedStatuses = new[] { "Inspecting" }
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ SignalR broadcast failed: {ex.Message}");
                }
            }

            // ✅ Delete the "ItemReceived" topic message for this service.
            // No longer needs to fetch MessageId here — just tells the worker
            // WHICH (ServiceId, TopicKey) to resolve and delete. The worker
            // reads it from the ServiceTelegramMessages child table, so it can
            // never overwrite/lose a different topic's message id.
            // Fire-and-forget: does not block the UI thread while Telegram API
            // calls happen in the background worker.
            _ = Task.Run(async () =>
            {
                try
                {
                    await TelegramQueue.EnqueueAsync(new ServiceMaintenance.Services.Notifications.TelegramMessage
                    {
                        Action = ServiceMaintenance.Services.Notifications.TelegramAction.Delete,
                        ItemId = item.Id,
                        TopicKey = "ItemReceived",
                        ResolveMessageIdFromTopic = true
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Telegram delete enqueue failed: {ex.Message}");
                }

                try
                {
                    await TelegramQueue.EnqueueAsync(new ServiceMaintenance.Services.Notifications.TelegramMessage
                    {
                        Action = ServiceMaintenance.Services.Notifications.TelegramAction.Send,
                        ItemId = item.Id,
                        TopicKey = "Inspecting",
                        Text = $"🔍 <b>កំពុងវិនិច្ឆ័យ</b>\n\n" +
                               $"លេខ Report: <b>{item.reportNo}</b>\n\n" +
                               $"ស្ថាប័ន: {item.CompanyName}\n\n" +
                               $"ម៉ាស៊ីន: {item.itemName}\n\n" +
                               $"SerialNumber: {item.serialNumber}\n\n" +
                               $"លេខស៊េរី: {item.CustomerRequest}\n\n" +
                               $"ឈ្មោះអ្នកវិនិច្ឆ័យ: {GetUserNameDisplay(currentUserId)}"
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Telegram send enqueue failed: {ex.Message}");
                }
            });

            totalItems = Math.Max(0, totalItems - 1);
            totalPages = totalItems > 0
                ? (int)Math.Ceiling(totalItems / (double)pageSize)
                : 0;

            if (currentPage > totalPages && totalPages > 0)
                currentPage = totalPages;
            else if (totalPages == 0)
                currentPage = 1;

            await LoadPageData();

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Customization",
                Title = "Success",
                Text = $"{item.reportNo} set to Inspecting",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Success
            });
        }
        catch (Exception ex)
        {
            item.Status = "Item Recieved";
            StateHasChanged();
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Error",
                Text = $"Failed: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }
    }


