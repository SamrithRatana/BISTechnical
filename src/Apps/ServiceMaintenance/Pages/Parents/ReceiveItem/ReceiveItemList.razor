    private async Task UseScannedBarcode()
    {
        if (!string.IsNullOrEmpty(scannedBarcode))
        {
            barcodeScan = scannedBarcode;

            await Task.Delay(500);

            if (FilteredItems.Any())
            {
                var exactMatch = FilteredItems.FirstOrDefault(item =>
                    item.SerialNumber.Equals(scannedBarcode, StringComparison.OrdinalIgnoreCase)
                );

                if (exactMatch != null)
