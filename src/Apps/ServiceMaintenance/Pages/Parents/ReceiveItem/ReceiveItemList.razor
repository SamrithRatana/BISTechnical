                                $"ស្ថាប័ន: {receiveItem.CompanyName}\n\n" +
                                $"អាសយដ្ឋាន: {receiveItem.Address}\n\n" +
                                $"ឈ្មោះទំនាក់ទំនង: {receiveItem.ContactName}\n\n" +
                                $"លេខទូរស័ព្ទ: {receiveItem.PhoneNumber}\n\n" +
                                $"កាលបរិច្ឆេទទទួល: {receiveItem.ServiceDate:dd/MM/yyyy HH:mm}\n\n" +
