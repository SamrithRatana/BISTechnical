                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"⚠️ Telegram enqueue failed: {ex.Message}");
                    }
                }
                else
                {
                    try
                    {
                        await TelegramQueue.EnqueueAsync(new ServiceMaintenance.Services.Notifications.TelegramMessage
                        {
                            Action = ServiceMaintenance.Services.Notifications.TelegramAction.Edit,
                            ItemId = capturedItemId,
