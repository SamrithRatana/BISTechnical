    private async void OnSearchTermInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;

        _customerSearchDebounceTimer?.Dispose();

        if (string.IsNullOrWhiteSpace(searchTerm) || searchTerm.Length < 2)
        {
            try
            {
                var initialResult = await CustomerService.GetCustomersPaginatedAsync(pageNumber: 1, pageSize: 10);
                _customers = initialResult.Data ?? new List<Customer>();
                IsDropdownVisible = false;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Error loading customers: {ex.Message}");
                _customers = new List<Customer>();
            }

            StateHasChanged();
            return;
        }

        IsDropdownVisible = true;
        StateHasChanged();

        _customerSearchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    try
                    {
                        Console.WriteLine($"🔍 Searching: '{searchTerm}'");

                        // ✅ FIX: previously hardcoded pageSize: 20 silently truncated
                        // results (e.g. "STR" matched 24 customers but only 20 showed).
                        // Now loops through ALL pages until every match is fetched —
                        // no upper limit on total results returned.
                        const int fetchPageSize = 50;
                        var allResults = new List<Customer>();
                        int page = 1;
                        int totalRecords = 0;

                        do
                        {
                            var searchResult = await CustomerService.GetCustomersPaginatedAsync(
                                pageNumber: page,
                                pageSize: fetchPageSize,
                                searchTerm: searchTerm
                            );

                            var pageData = searchResult.Data?.ToList() ?? new List<Customer>();
                            allResults.AddRange(pageData);
                            totalRecords = searchResult.TotalRecords;

                            // ឈប់ loop ពេលទំព័រចុងក្រោយត្រឡប់មកតិចជាង fetchPageSize
                            if (pageData.Count < fetchPageSize)
                                break;

                            page++;
                        }
                        while (allResults.Count < totalRecords);

                        _customers = allResults;
                        _totalCustomersFound = totalRecords;

                        Console.WriteLine($"✅ Found {_customers.Count()} of {totalRecords} total customers");

                        IsDropdownVisible = _customers.Any();

                        StateHasChanged();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"❌ Search error: {ex.Message}");
                        IsDropdownVisible = false;
                        StateHasChanged();
                    }
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"❌ Timer error: {ex.Message}");
            }
        }, null, 300, Timeout.Infinite);
    }
