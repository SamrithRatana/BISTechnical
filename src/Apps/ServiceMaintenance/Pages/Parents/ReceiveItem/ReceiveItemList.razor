    private bool _disposed = false;

    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        if (isCameraScannerVisible)
        {
            try { await JSRuntime.InvokeVoidAsync("barcodeScanner.stopScanner"); }
            catch { /* JS interop unavailable during teardown — ignore */ }
        }

        objRef?.Dispose();
        _itemSearchDebounceTimer?.Dispose();
        _customerSearchDebounceTimer?.Dispose();
        _itemReceivedSearchDebounceTimer?.Dispose();

        // ✅ ថ្មី — រង់ចាំ Task ដែលកំពុង Connect ជាមុនសិន
        if (_signalRInitTask != null)
        {
            try { await _signalRInitTask; }
            catch (Exception ex)
            {
                Console.WriteLine($"⚠️ SignalR init task ended with error during dispose: {ex.Message}");
            }
        }

        if (hubConnection != null)
        {
            try { await hubConnection.DisposeAsync(); }
            catch (Exception ex)
            {
                Console.WriteLine($"⚠️ Error disposing hubConnection: {ex.Message}");
            }
        }

        // ✅ NEW — drop references to large in-memory collections immediately
        // on dispose instead of waiting for GC, matching daily-report.razor's
        // Dispose() pattern.
        filteredRepairServices = new List<RepairServices>();
        _repairItems = new List<Repairs>();
        allExistingItems = new List<Repairs>();
        uniqueItems = new List<Repairs>();
        _customers = new List<Customer>();
        _allUsers = new Dictionary<string, string>();
        _servicePriorities = new List<ServicePriority>();
    }
