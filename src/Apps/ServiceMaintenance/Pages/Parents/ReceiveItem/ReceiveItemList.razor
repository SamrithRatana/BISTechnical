    private async Task InitializeSignalRAsync()
    {
        try
        {
            hubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/itemHub"))
                .Build();

            // ✅ FIX: Server sends ItemUpdateMessage, not string — must subscribe with the matching type
            hubConnection.On<ItemUpdateMessage>("ReceiveItemUpdate", async (msg) =>
            {
                if (_disposed) return; // ✅ NEW
                await InvokeAsync(async () =>
                {
                    var affected = msg?.AffectedStatuses ?? Array.Empty<string>();
                    // This page only shows Status "Item Recieved" — only reload
                    // when the broadcast actually affects that status (or carries
                    // no status info at all, for backward compatibility)
                    if (affected.Length == 0 || affected.Contains("Item Recieved"))
                    {
                        await Cache.InvalidateManyAsync(
                            CacheKeys.ReceiveItem(currentPage, pageSize),
                            CacheKeys.DashboardStats
                        );
                        await LoadPageData();
                        StateHasChanged();
                    }
                });
            });

            hubConnection.On<Guid>("BroadcastItemDelete", async (deletedItemId) =>
            {
                if (_disposed) return; // ✅ NEW
                await InvokeAsync(async () =>
                {
                    await Cache.InvalidateManyAsync(
                        CacheKeys.ReceiveItem(currentPage, pageSize)
                    );
                    filteredRepairServices = filteredRepairServices
                        .Where(item => item.Id != deletedItemId)
                        .ToList();
                    StateHasChanged();
                });
            });

            await hubConnection.StartAsync();
            Console.WriteLine("✅ SignalR connected");

            // ✅ ADDED — this page previously had NO reconnect logic at all,
            // unlike inspect-item.razor / reapairItem.razor / finishItem.razor
            // which all reconnect after a dropped connection. Since
            // receive-item.razor is the first page most users land on, a silent
            // disconnect here meant the grid stopped receiving live updates
            // (new items, status changes from other users) until the person
            // manually refreshed the browser — a likely major source of the
                        // "feels slow / need to refresh" reports.
                        hubConnection.Closed += async (error) =>
             {
                 // ✅ NEW — stop immediately if the component was disposed while this
                 // callback was pending; prevents a "zombie" reconnect loop from
                 // touching state / calling StateHasChanged() on a torn-down component.
                 if (_disposed) return;

                 Console.WriteLine($"⚠️ SignalR closed: {error?.Message}. Reconnecting...");
                 await Task.Delay(new Random().Next(0, 5) * 1000);

                 if (_disposed) return;

                 try
                 {
                     await hubConnection.StartAsync();
                     Console.WriteLine("✅ SignalR reconnected");

                     if (_disposed) return;

                     await InvokeAsync(async () =>
                     {
                         await Cache.InvalidateManyAsync(
                             CacheKeys.ReceiveItem(currentPage, pageSize),
                             CacheKeys.DashboardStats
                         );
                         await LoadPageData();
                         StateHasChanged();
                     });
                 }
                 catch (Exception ex)
                 {
                     Console.WriteLine($"❌ SignalR reconnection failed: {ex.Message}");
                 }
             };
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠️ SignalR failed: {ex.Message}");
        }
    }
    private async void OnBarcodeScanChanged(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            IsDropdownItemVisible = false;
            IsValidationErrorVisible = false;
            StateHasChanged();
            return;
        }

        try
        {
            var searchResult = await ItemService.SearchItemsAsync(
                pageNumber: 1,
                pageSize: 20,
                searchTerm: value
            );

            _repairItems = searchResult.Items;

            var matchingItems = _repairItems.Where(item =>
                item.SerialNumber.Contains(value, StringComparison.OrdinalIgnoreCase) ||
                item.ItemName.Contains(value, StringComparison.OrdinalIgnoreCase)
            ).ToList();

            if (matchingItems.Any())
            {
                IsDropdownItemVisible = true;
                IsValidationErrorVisible = false;

                var exactMatch = matchingItems.FirstOrDefault(item =>
                    item.SerialNumber.Equals(value, StringComparison.OrdinalIgnoreCase)
                );

                if (exactMatch != null)
                {
                    searchItem = $"{exactMatch.ItemName}";
                    _selectedItem = exactMatch;
                    receiveItem.ItemId = exactMatch.Id;
                }
            }
            else
            {
                IsDropdownItemVisible = false;
                IsValidationErrorVisible = true;
                ValidationMessage = "លេខម៉ាស៊ីននេះមិនទាន់មានទេ សូមបញ្ចូលម៉ាស៊ីនថ្មីជាមុនសិន!";
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error searching items: {ex.Message}");
        }
    }

    private IEnumerable<Customer> FilteredCustomers => _customers;

    private IEnumerable<Repairs> FilteredItems =>
     _repairItems.Where(c => string.IsNullOrEmpty(searchItem) ||
                             c.SerialNumber.Contains(searchItem, StringComparison.OrdinalIgnoreCase) ||
                             c.ItemName.Contains(searchItem, StringComparison.OrdinalIgnoreCase));



    private async Task LoadPageData()
    {
        // ✅ FIX: only show the skeleton on first load — page navigation clicks
        // (Next/Previous/First/Last) no longer tear down and rebuild the whole
        // grid, they just swap the underlying data once the fetch resolves.
        if (isInitialLoad)
        {
            isPageLoading = true;
            StateHasChanged();
        }

        try
        {


            var result = await Cache.GetOrSetAsync(
                CacheKeys.ReceiveItem(currentPage, pageSize),
                () => RepairItemService.SearchRepairServicesAsync(
                    pageNumber: currentPage,
                    pageSize: pageSize,
                    status: "Item Recieved",
                    sortBy: "reportNo",
                    sortDescending: true),
                TimeSpan.FromMinutes(3)
            );

            filteredRepairServices = result?.Items ?? new List<RepairServices>();
            totalPages = result?.TotalPages ?? 0;
            totalItems = result?.TotalCount ?? 0;

        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading page: {ex.Message}");
        }
        finally
        {
            isPageLoading = false;
            isInitialLoad = false;
            StateHasChanged();
        }
    }

