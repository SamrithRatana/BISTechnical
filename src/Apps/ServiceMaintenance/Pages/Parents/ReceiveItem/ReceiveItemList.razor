    private MarkupString HighlightMatch(string text, string term)
    {
        if (string.IsNullOrEmpty(text))
            return (MarkupString)string.Empty;

        if (string.IsNullOrWhiteSpace(term))
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);

        var sb = new System.Text.StringBuilder();
        int startIndex = 0;
        int idx;

        while ((idx = text.IndexOf(term, startIndex, StringComparison.OrdinalIgnoreCase)) >= 0)
        {
            sb.Append(System.Net.WebUtility.HtmlEncode(text.Substring(startIndex, idx - startIndex)));

            var matchedText = text.Substring(idx, term.Length);
            sb.Append("<span style=\"background-color:#ffeb3b;\">")
              .Append(System.Net.WebUtility.HtmlEncode(matchedText))
              .Append("</span>");

            startIndex = idx + term.Length;
        }

        sb.Append(System.Net.WebUtility.HtmlEncode(text.Substring(startIndex)));

        return (MarkupString)sb.ToString();
    }

