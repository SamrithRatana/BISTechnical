    private string GetStatusClass(string status)
    {
        if (status == "Awaiting Sparepart")
        {
            return "status-active"; // Custom CSS class for yellow color
        }
        return string.Empty; // Default, no specific class
    }
    public async ValueTask DisposeAsync()
    {
        _gridSearchDebounceTimer?.Dispose();
        if (hubConnection != null)
        {
            try { await hubConnection.DisposeAsync(); }
            catch (Exception ex)
            {
                Console.WriteLine($"⚠️ Error disposing hubConnection: {ex.Message}");
            }
        }
    }

