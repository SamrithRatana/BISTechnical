    private async Task Save()
    {
        try
        {
            // ✅ Get current user ID from authentication state
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (!user.Identity.IsAuthenticated)
            {
                Console.WriteLine("❌ User is not authenticated");
                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Error",
                    Title = "Authentication Error",
                    Text = "User is not authenticated",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Danger
                });
                return;
            }

            // ✅ Get user ID from claims
            var userIdClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(userIdClaim))
            {
                Console.WriteLine("❌ No user ID found in claims");
                customerRejected.SetCustomerRejectedBy = Guid.Empty;
            }
            else if (Guid.TryParse(userIdClaim, out Guid userGuid))
            {
                customerRejected.SetCustomerRejectedBy = userGuid;
            }
            else
            {
                Console.WriteLine("❌ Invalid user ID format");
                customerRejected.SetCustomerRejectedBy = Guid.Empty;
            }

            await CustomerRejectedService.SetCustomerRejectedAsync(customerRejected);

            // ✅ SignalR notification
            if (hubConnection != null)
            {
                if (hubConnection.State == HubConnectionState.Disconnected)
                {
                    await hubConnection.StartAsync();
                }

                if (hubConnection.State == HubConnectionState.Connected)
                {
                    // ✅ FIX: ItemHub.BroadcastItemUpdate expects ItemUpdateMessage, not string
                    await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                    {
                        AffectedStatuses = Array.Empty<string>()
                    });
                }
            }

            string reportNo = !string.IsNullOrEmpty(ReportNo)
                ? ReportNo
                : _selectedRepairService?.reportNo;


            currentPage = 1;
            await LoadPageData();

            isConfirmationDialogVisible = false;

            // ✅ Success notification
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Customization",
                Title = "Success",
                Text = "Customer rejection set successfully",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Success
            });
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"❌ Error during save: {ex.Message}");

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Save Error",
                Text = $"Failed to save: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }
    }




    public async void OnSearch(Syncfusion.Blazor.Inputs.ChangedEventArgs args)
    {
        if (args.Value != null && args.Value.ToString().Trim().Length > 0)
        {
            string searchValue = args.Value.ToString().Trim();

            try
            {
                if (isGridView)
                {
                    var result = await RepairItemService.SearchRepairServicesAsync(
                        pageNumber: 1,
                        pageSize: gridPageSize,
                        status: "Customer Rejected",
                        searchTerm: searchValue,
                        sortBy: "reportNo",
                        sortDescending: true
                    );

                    filteredRepairServices2 = result.Items;
                    totalGridPages = result.TotalPages;
                    totalGridItems = result.TotalCount;
                    currentGridPage = 1;
                }
                else
                {
                    var result = await RepairItemService.SearchRepairServicesAsync(
                        pageNumber: 1,
                        pageSize: pageSize,
                        searchTerm: searchValue,
                        sortBy: "reportNo",
                        sortDescending: true,
                        excludedStatuses: new[]
                        {
                        "Customer Rejected",
                        "Finished",
                        "Repairing"
                        }
                    );

                    filteredRepairServices = result.Items;
                    totalPages = result.TotalPages;
                    totalItems = result.TotalCount;
                    currentPage = 1;
                }

                UpdatePagination();
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Search error: {ex.Message}");
            }
        }
        else
        {
            await LoadPageData();
        }
    }
