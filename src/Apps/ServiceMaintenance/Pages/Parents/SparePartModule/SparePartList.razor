    private void OnPdfQueryCellInfo(PdfQueryCellInfoEventArgs<SparePartObject> args)
    {
        // ✅ Much smaller row height so multiple rows fit per page
        int fixedRowHeight = 50;
        if (args.Row != null)
            args.Row.Height = fixedRowHeight;

        if (args.Column.HeaderText == "Image")
        {
            args.Cell.Value = "";

            if (!string.IsNullOrEmpty(args.Data.PictureUrl))
            {
                try
                {
                    byte[] imageBytes = null;
                    string fullImageUrl = null;

                    // ── Determine if cloud URL or local path ──────────────────
                    if (args.Data.PictureUrl.StartsWith("http://") ||
                        args.Data.PictureUrl.StartsWith("https://"))
                    {
                        fullImageUrl = args.Data.PictureUrl; // ✅ keep for hyperlink
                        using var httpClient = new HttpClient();
                        httpClient.Timeout = TimeSpan.FromSeconds(10);
                        imageBytes = httpClient.GetByteArrayAsync(args.Data.PictureUrl)
                                               .GetAwaiter().GetResult();
                    }
                    else
                    {
                        // local file path
                        string imagePath = Path.Combine(
                            Directory.GetCurrentDirectory(), "wwwroot",
                            args.Data.PictureUrl.TrimStart('/')
                                .Replace("/", Path.DirectorySeparatorChar.ToString()));
                        if (File.Exists(imagePath))
                            imageBytes = File.ReadAllBytes(imagePath);
                    }

                    // ── Render thumbnail as background ────────────────────────
                    if (imageBytes != null)
                    {
                        using var ms = new MemoryStream(imageBytes);
                        using var img = Image.FromStream(ms);
                        using var resized = new Bitmap(img, new System.Drawing.Size(45, 40));
                        using var output = new MemoryStream();
                        resized.Save(output, ImageFormat.Jpeg);
                        output.Position = 0;
                        args.Cell.Style.BackgroundImage =
                            Syncfusion.PdfExport.PdfImage.FromStream(output);
                        args.Cell.ImagePosition =
                            Syncfusion.PdfExport.PdfGridImagePosition.Center;
                    }

                    // ── Assign PdfUriAnnotation as cell value = clickable ─────
                    // This makes the entire cell clickable — click opens URL in browser
                    if (!string.IsNullOrEmpty(fullImageUrl))
                    {
                        var rect = new System.Drawing.RectangleF(0, 0, 60, 50);
                        var uriAnnotation = new Syncfusion.PdfExport.PdfUriAnnotation(
     rect, fullImageUrl);
                        uriAnnotation.Text = ""; // no visible text in PDF
                        args.Cell.Value = uriAnnotation;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"PDF image error: {ex.Message}");
                }
            }
            return;
        }

        // ── STOCK STATUS column ───────────────────────────────────────────
        if (args.Column.HeaderText == "Stock Status")
        {
            var qty = args.Data.Quantity;

            if (qty <= 0)
            {
                args.Cell.Value = "OUT OF STOCK";
                args.Cell.Style.BackgroundBrush =
                    new Syncfusion.PdfExport.PdfSolidBrush(
                        new Syncfusion.PdfExport.PdfColor(220, 53, 69));
                args.Cell.Style.TextBrush =
                    new Syncfusion.PdfExport.PdfSolidBrush(
                        new Syncfusion.PdfExport.PdfColor(255, 255, 255));
            }
            else if (qty <= CRITICAL_STOCK)
            {
                args.Cell.Value = "CRITICAL";
                args.Cell.Style.BackgroundBrush =
                    new Syncfusion.PdfExport.PdfSolidBrush(
                        new Syncfusion.PdfExport.PdfColor(255, 107, 107));
                args.Cell.Style.TextBrush =
                    new Syncfusion.PdfExport.PdfSolidBrush(
                        new Syncfusion.PdfExport.PdfColor(255, 255, 255));
            }
            else if (qty <= LOW_STOCK)
            {
                args.Cell.Value = "LOW STOCK";
                args.Cell.Style.BackgroundBrush =
                    new Syncfusion.PdfExport.PdfSolidBrush(
                        new Syncfusion.PdfExport.PdfColor(255, 193, 7));
                args.Cell.Style.TextBrush =
                    new Syncfusion.PdfExport.PdfSolidBrush(
                        new Syncfusion.PdfExport.PdfColor(0, 0, 0));
            }
            else
            {
                args.Cell.Value = "IN STOCK";
                args.Cell.Style.BackgroundBrush =
                    new Syncfusion.PdfExport.PdfSolidBrush(
                        new Syncfusion.PdfExport.PdfColor(40, 167, 69));
                args.Cell.Style.TextBrush =
                    new Syncfusion.PdfExport.PdfSolidBrush(
                        new Syncfusion.PdfExport.PdfColor(255, 255, 255));
            }
            return;
        }

        // ── STOCK QTY column ─────────────────────────────────────────────
        if (args.Column.HeaderText == "Stock Qty")
        {
            var qty = args.Data.Quantity;
            var bgColor = qty <= 0 ? new Syncfusion.PdfExport.PdfColor(255, 224, 224) :
                          qty <= CRITICAL_STOCK ? new Syncfusion.PdfExport.PdfColor(255, 208, 208) :
                          qty <= LOW_STOCK ? new Syncfusion.PdfExport.PdfColor(255, 243, 205) :
                                                  new Syncfusion.PdfExport.PdfColor(212, 237, 218);
            args.Cell.Style.BackgroundBrush =
                new Syncfusion.PdfExport.PdfSolidBrush(bgColor);
            return;
        }

        // ── TIMES USED column ────────────────────────────────────────────
        if (args.Column.HeaderText == "Times Used")
        {
            var count = args.Data.UsageCount;
            Syncfusion.PdfExport.PdfColor bg, fg;

            if (count >= 20) { bg = new Syncfusion.PdfExport.PdfColor(255, 68, 68); fg = new Syncfusion.PdfExport.PdfColor(255, 255, 255); }
            else if (count >= 10) { bg = new Syncfusion.PdfExport.PdfColor(255, 140, 0); fg = new Syncfusion.PdfExport.PdfColor(255, 255, 255); }
            else if (count >= 5) { bg = new Syncfusion.PdfExport.PdfColor(255, 193, 7); fg = new Syncfusion.PdfExport.PdfColor(0, 0, 0); }
            else { bg = new Syncfusion.PdfExport.PdfColor(232, 245, 233); fg = new Syncfusion.PdfExport.PdfColor(46, 125, 50); }

            args.Cell.Style.BackgroundBrush =
                new Syncfusion.PdfExport.PdfSolidBrush(bg);
            args.Cell.Style.TextBrush =
                new Syncfusion.PdfExport.PdfSolidBrush(fg);
            return;
        }
    }
