


@page "/SparePart Inventory Page";
@using BarcodeStandard
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.SignalR.Client
@using ServiceMaintenance.Models
@using ServiceMaintenance.Services
@using ServiceMaintenance.Services.R2CloudStorage
@using ServiceMaintenance.Services.KoompiCloudStorage.Helpers
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.BarcodeGenerator
@using System.Drawing.Imaging;
@using System.Drawing
@using OfficeOpenXml
@using OfficeOpenXml.Drawing
@using OfficeOpenXml.Style
@using Syncfusion.PdfExport
@inject ServiceSparePart sparePartService
@inject R2StorageService KoompiStorage
@inject StateManagementAction StateManagementAction
@inject Microsoft.AspNetCore.Components.NavigationManager UriHelper
@inherits PermissionBase
@inject CacheHelper Cache
@using ServiceMaintenance.Infrastructure.Shared.Caching
@implements IAsyncDisposable

<DxToastProvider Name="Customization"
                 MaxToastCount="5"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 VerticalAlignment="VerticalEdge.Top"
                 AnimationType="@Animation" />
<DxToastProvider Name="Error"
                 MaxToastCount="5"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 VerticalAlignment="VerticalEdge.Top"
                 AnimationType="@Animation" />

<ActionToolbox CanCreate="CanCreate"
               CanEdit="CanEdit"
               CanDelete="CanDelete"
               CanExport="CanExport"
               CanCheckList="CanView"
               IsCreateEnabled="true"
               IsEditEnabled="@(sparePartID.HasValue && sparePartID.Value != Guid.Empty)"
               IsDeleteEnabled="@(sparePartID.HasValue && sparePartID.Value != Guid.Empty)"
               OnCreate="NewItem_Click"
               OnEdit="EditItem_Click"
               OnDelete="DeleteItem_Click"
               OnExportExcel="ExportToExcel"
               OnExportPdf="ExportToPdf">
</ActionToolbox>

<DxLayoutBreakpoint DeviceSize="DeviceSize.XSmall" @bind-IsActive="@isXSmallScreen" />
<hr>

@if (CanAccess)
{
    @if (CanView)
    {
        <!-- Custom Search Box -->
        <div class="card shadow-sm rounded-lg mb-3">
            <div class="card-body">
                @* <div class="btn-group mb-3" role="group">
                    <button type="button"
                            class="btn @(stockFilter == "all" ? "btn-primary" : "btn-outline-primary")"
                            @onclick='() => FilterByStock("all")'>
                        <i class="fas fa-list"></i> All Items
                    </button>
                    <button type="button"
                            class="btn @(stockFilter == "out" ? "btn-danger" : "btn-outline-danger")"
                            @onclick='() => FilterByStock("out")'>
                        <i class="fas fa-exclamation-triangle"></i> Out of Stock
                    </button>
                    <button type="button"
                            class="btn @(stockFilter == "low" ? "btn-warning" : "btn-outline-warning")"
                            @onclick='() => FilterByStock("low")'>
                        <i class="fas fa-exclamation-circle"></i> Low Stock
                    </button>
                    <button type="button"
                            class="btn @(stockFilter == "good" ? "btn-success" : "btn-outline-success")"
                            @onclick='() => FilterByStock("good")'>
                        <i class="fas fa-check-circle"></i> Good Stock
                    </button>
                </div> *@
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="fas fa-search"></i>
                            </span>
                            <input type="text"
                                   class="form-control"
                                   placeholder="Search by Item Name, Part Number, Use For, or paste Id (GUID)..."
                                   @bind="searchQuery"
                                   @bind:event="oninput"
                                   @onkeyup="OnSearchKeyUp" />
                            @if (!string.IsNullOrEmpty(searchQuery))
                            {
                                <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
                                    <i class="fas fa-times"></i>
                                </button>
                            }
                        </div>
                    </div>
                    <div class="col-md-4 text-end">
                        @if (isSearching)
                        {
                            <span class="text-muted">
                                <i class="fas fa-spinner fa-spin"></i> Searching...
                            </span>
                        }
                        else if (!string.IsNullOrEmpty(searchQuery))
                        {
                            <span class="text-success">
                                <i class="fas fa-check-circle"></i> Found @totalCount results
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="h-100 grid-wrapper">
            @if (spareParts == null)
            {
                <div class="card-body w-100">
                    <div class="card-header border-0 p-2 rounded">
                        <DxLoadingPanel IndicatorAnimationType="WaitIndicatorAnimationType.Pulse"
                                        CssClass="w-100"
                                        IndicatorVisible="@indicatorVisible"
                                        IndicatorAreaVisible="@indicatorAreaVisible"
                                        Visible="true"
                                        Text="Processing..."
                                        TextAlignment="LoadingPanelTextAlignment.Right">
                            <div style="min-height: 250px;"></div>
                        </DxLoadingPanel>
                    </div>
                </div>
            }
            else
            {
                @* <div class="card shadow-sm rounded-lg mb-3">
                    <div class="card-body">
                        <h5 class="mb-3">
                            <i class="fas fa-chart-bar"></i> Stock Overview
                        </h5>
                        <div class="row">
                            <div class="col-md-3 col-6 mb-3">
                                <div class="stock-summary-card out-of-stock">
                                    <div class="stock-summary-icon">
                                        <i class="fas fa-exclamation-triangle"></i>
                                    </div>
                                    <div class="stock-summary-details">
                                        <h3>@GetStockCount(0, 0)</h3>
                                        <p>Out of Stock</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 col-6 mb-3">
                                <div class="stock-summary-card critical-stock">
                                    <div class="stock-summary-icon">
                                        <i class="fas fa-exclamation-circle"></i>
                                    </div>
                                    <div class="stock-summary-details">
                                        <h3>@GetStockCount(1, CRITICAL_STOCK)</h3>
                                        <p>Critical (≤@CRITICAL_STOCK)</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 col-6 mb-3">
                                <div class="stock-summary-card low-stock">
                                    <div class="stock-summary-icon">
                                        <i class="fas fa-info-circle"></i>
                                    </div>
                                    <div class="stock-summary-details">
                                        <h3>@GetStockCount(CRITICAL_STOCK + 1, LOW_STOCK)</h3>
                                        <p>Low (@(CRITICAL_STOCK + 1)-@LOW_STOCK)</p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-3 col-6 mb-3">
                                <div class="stock-summary-card good-stock">
                                    <div class="stock-summary-icon">
                                        <i class="fas fa-check-circle"></i>
                                    </div>
                                    <div class="stock-summary-details">
                                        <h3>@GetStockCount(LOW_STOCK + 1, int.MaxValue)</h3>
                                        <p>Good Stock (>@LOW_STOCK)</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> *@

                <SfGrid @ref="MyGrid"
                        DataSource="@spareParts"
                        AllowPaging="false"
                        AllowSorting="true"
                        AllowExcelExport="true"
                        AllowPdfExport="true"
                        AllowResizing="true"
                        AllowFiltering="true"
                        Height="450"
                        OnRowSelected="RowSelectHandler"
                        OnActionBegin="ActionBeginHandler">
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>

                    <GridEditSettings AllowEditing="true"
                                      Mode="EditMode.Normal"
                                      ShowDeleteConfirmDialog="true">
                    </GridEditSettings>

                    <GridEvents RowSelected="RowSelectHandler"
                                OnToolbarClick="ToolbarClickHandler"
                                PdfQueryCellInfoEvent="OnPdfQueryCellInfo"
                                ExcelQueryCellInfoEvent="OnExcelQueryCellInfo"
                                TValue="SparePartObject">
                    </GridEvents>

                    <GridColumns>
                        <GridColumn Field="Id" HeaderText="ID" Width="50" IsPrimaryKey="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center" Visible="false"></GridColumn>
                        <GridColumn HeaderText="@Loc[nameof(ResourceStrings.TextImage)]" Width="100" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                            <Template>
                                @{
                                    var partInfo = (context as SparePartObject);
                                    <div class="image-head">
                                        <img src="@UriHelper.ToAbsoluteUri($"{partInfo.PictureUrl}")" alt="Spare Part Image" />
                                    </div>
                                }
                            </Template>
                        </GridColumn>

                        <GridColumn Field="ItemName" HeaderText="@Loc[nameof(ResourceStrings.TextItemName)]" Width="150">
                            <Template>
                                @{
                                    var p = context as SparePartObject;
                                }
                                @HighlightMatch(p.ItemName, searchQuery)
                            </Template>
                        </GridColumn>
                        <GridColumn Field="SerialNumber" HeaderText="@Loc[nameof(ResourceStrings.TextPartNo)]" Width="150">
                            <Template>
                                @{
                                    var p = context as SparePartObject;
                                }
                                @HighlightMatch(p.SerialNumber, searchQuery)
                            </Template>
                        </GridColumn>
                        <GridColumn Field="Description" HeaderText="@Loc[nameof(ResourceStrings.textDescription)]" Width="200" Visible="false">
                            <Template>
                                @{
                                    var p = context as SparePartObject;
                                }
                                @HighlightMatch(p.Description, searchQuery)
                            </Template>
                        </GridColumn>
                        <GridColumn Field="UseFor" HeaderText="@Loc[nameof(ResourceStrings.TextUsefor)]" Width="150">
                            <Template>
                                @{
                                    var p = context as SparePartObject;
                                }
                                @HighlightMatch(p.UseFor, searchQuery)
                            </Template>
                        </GridColumn>
                        <GridColumn Field="DefaultPrice"
                                    HeaderText="Default Price"
                                    Width="130"
                                    Format="C2"
                                    TextAlign="Syncfusion.Blazor.Grids.TextAlign.Right">
                            <Template>
                                @{
                                    var sp = context as SparePartObject;
                                }
                                <span style="font-weight:600; color:#28a745;">
                                    $@sp.DefaultPrice.ToString("N2")
                                </span>
                            </Template>
                        </GridColumn>
                        <GridColumn Field="Quantity" HeaderText="Quantity" Width="180" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                            <Template>
                                @{
                                    var sparePart = context as SparePartObject;
                                    var stockLevel = sparePart.Quantity;
                                    var stockColor = GetStockLevelColor(stockLevel);
                                    var stockStatus = GetStockStatus(stockLevel);
                                }
                                <div class="stock-level-container">
                                    <div class="stock-text-display" @onclick="@(() => StartEditQuantity(sparePart))">
                                        <span class="stock-quantity-text">@stockLevel</span>
                                        <span class="stock-status-text">@stockStatus</span>
                                    </div>

                                    @* Progress bar *@
                                    <div class="stock-progress-bar">
                                        <div class="stock-progress-fill"
                                             style="width: @GetStockProgressWidth(stockLevel)%; background-color: @stockColor">
                                        </div>
                                    </div>
                                </div>
                            </Template>
                            <EditTemplate>
                                @{
                                    var sparePart = context as SparePartObject;
                                }
                                <SfNumericTextBox @bind-Value="@sparePart.Quantity"
                                                  TValue="int"
                                                  Min="0"
                                                  Step="1"
                                                  Format="n0"
                                                  ShowSpinButton="true"
                                                  Width="100%">
                                </SfNumericTextBox>
                            </EditTemplate>
                        </GridColumn>
                        <GridColumn HeaderText="@Loc[nameof(ResourceStrings.TextBarcode)]" Width="200">
                            <Template>
                                @{
                                    var sparePart = context as SparePartObject;
                                    var serialNumber = string.IsNullOrEmpty(sparePart.SerialNumber) ? "0" : sparePart.SerialNumber;
                                }
                                <SfBarcodeGenerator Width="200px" Height="100px"
                                                    Type="@BarcodeType.Code128"
                                                    ForeColor="black"
                                                    Value="@serialNumber">
                                </SfBarcodeGenerator>
                            </Template>
                        </GridColumn>
                        @* Set Stock Action Column *@
                        <GridColumn HeaderText="SET STOCK" Width="120" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                            <Template>
                                @{
                                    var sparePart = context as SparePartObject;
                                }
                                <button type="button"
                                        class="btn-set-stock-minimal"
                                        @onclick="@(() => StartEditQuantity(sparePart))"
                                        title="Set Stock">
                                    <i class="fas fa-boxes"></i>
                                    <span>Stock In</span>
                                </button>
                            </Template>
                        </GridColumn>
                        @* បន្ថែមក្រោម SET STOCK column *@
                        <GridColumn HeaderText="STOCK OUT" Width="130" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center">
                            <Template>
                                @{
                                    var sparePart = context as SparePartObject;
                                }
                                <button type="button"
                                        class="btn-stock-out-minimal"
                                        @onclick="@(() => StartManualStockOut(sparePart))"
                                        title="Manual Stock Out"
                                        disabled="@(sparePart.Quantity <= 0)">
                                    <i class="fas fa-minus-circle"></i>
                                    <span>Stock Out</span>
                                </button>
                            </Template>
                        </GridColumn>

                    </GridColumns>
                </SfGrid>

                <FooterPagination CurrentPage="currentPage"
                                  TotalPages="totalPages"
                                  TotalItems="totalCount"
                                  PageSize="pageSize"
                                  OnFirstPage="FirstPage"
                                  OnPreviousPage="PreviousPage"
                                  OnNextPage="NextPage"
                                  OnLastPage="LastPage"
                                  PageSizeOptions="new[] { 5, 10, 20, 50 }"
                                  OnPageSizeChanged="OnPageSizeChanged" />

                <SfDialog @ref="DialogDelete" IsModal="true" Width="250px" ShowCloseIcon="true" Visible="false">
                    <DialogTemplates>
                        <Header> Confirm Delete </Header>
                        <Content> @Loc[nameof(ResourceStrings.Textconfirmdelete)] </Content>
                    </DialogTemplates>
                    <DialogButtons>
                        <DialogButton Content="Delete" IsPrimary="true" OnClick="ConfirmDeleteYes" />
                        <DialogButton Content="Cancel" IsPrimary="false" OnClick="ConfirmDeleteNo" />
                    </DialogButtons>
                </SfDialog>

                <SfDialog @ref="DialogNoRecordSelected" IsModal="true" Width="250px" ShowCloseIcon="true" Visible="false">
                    <DialogTemplates>
                        <Header> Warning! </Header>
                        <Content> @Loc[nameof(ResourceStrings.TextSelectRecord)] </Content>
                    </DialogTemplates>
                    <DialogButtons>
                        <DialogButton Content="OK" IsPrimary="true" OnClick="CloseDialogNoRecordSelected" />
                    </DialogButtons>
                </SfDialog>
                @* Add this dialog after your other dialogs *@
                <SfDialog @ref="DialogQuantityEdit" IsModal="true" Width="350px" ShowCloseIcon="true" Visible="@isQuantityEditVisible">
                    <DialogTemplates>
                        <Header>Stock In</Header>
                        <Content>
                            <div class="p-3">
                                <label class="form-label">Current Quantity: @editingItem?.Quantity</label>
                                <SfNumericTextBox @bind-Value="@newQuantity"
                                                  TValue="int"
                                                  Placeholder="Enter new quantity"
                                                  Min="0"
                                                  Step="1"
                                                  Format="n0"
                                                  ShowSpinButton="true"
                                                  Width="100%">
                                </SfNumericTextBox>
                            </div>
                        </Content>
                    </DialogTemplates>
                    <DialogButtons>
                        <DialogButton Content="Update" IsPrimary="true" OnClick="UpdateQuantity" />
                        <DialogButton Content="Cancel" OnClick="CancelQuantityEdit" />
                    </DialogButtons>
                </SfDialog>
                @* Manual Stock Out Dialog *@
                <SfDialog @ref="DialogManualStockOut"
                          IsModal="true"
                          Width="420px"
                          ShowCloseIcon="true"
                          Visible="@isManualStockOutVisible">
                    <DialogTemplates>
                        <Header>
                            <div style="display:flex; align-items:center; gap:10px;">
                                <i class="fas fa-minus-circle text-danger"></i>
                                <span>Manual Stock Out</span>
                            </div>
                        </Header>
                        <Content>
                            <div class="p-3">
                                @if (stockOutItem != null)
                                {
                                    <div class="alert alert-warning py-2 mb-3">
                                        <i class="fas fa-box"></i>
                                        <strong> @stockOutItem.ItemName</strong>
                                        &nbsp;|&nbsp; Current Stock:
                                        <strong class="@(stockOutItem.Quantity <= CRITICAL_STOCK ? "text-danger" : "text-success")">
                                            @stockOutItem.Quantity
                                        </strong>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">
                                            Quantity to Remove <span class="text-danger">*</span>
                                        </label>
                                        <SfNumericTextBox @bind-Value="@stockOutQuantity"
                                                          TValue="int"
                                                          Placeholder="Enter quantity to deduct"
                                                          Min="1"
                                                          Max="@stockOutItem.Quantity"
                                                          Step="1"
                                                          Format="n0"
                                                          ShowSpinButton="true"
                                                          Width="100%">
                                        </SfNumericTextBox>
                                        @if (stockOutQuantity > stockOutItem.Quantity)
                                        {
                                            <small class="text-danger">
                                                <i class="fas fa-exclamation-triangle"></i>
                                                Cannot exceed available stock (@stockOutItem.Quantity)
                                            </small>
                                        }
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-semibold">Reason / Note</label>
                                        <SfTextArea @bind-Value="@stockOutReason"
                                                    Placeholder="e.g. Used for internal repair, damaged, lost..."
                                                    RowCount="3"
                                                    FloatLabelType="FloatLabelType.Never"
                                                    Width="100%">
                                        </SfTextArea>
                                    </div>

                                    <div class="alert alert-info py-2 mb-0" style="font-size:0.85rem;">
                                        <i class="fas fa-info-circle"></i>
                                        After deduction: <strong>@Math.Max(0, stockOutItem.Quantity - stockOutQuantity)</strong> remaining
                                    </div>
                                }
                            </div>
                        </Content>
                    </DialogTemplates>
                    <DialogButtons>
                        <DialogButton Content="Confirm Stock Out"
                                      IsPrimary="true"
                                      OnClick="ConfirmManualStockOut"
                                      Disabled="@(stockOutQuantity <= 0 || stockOutQuantity > (stockOutItem?.Quantity ?? 0))" />
                        <DialogButton Content="Cancel"
                                      OnClick="CancelManualStockOut" />
                    </DialogButtons>
                </SfDialog>
                <SfDialog IsModal="true" Width="600px" ShowCloseIcon="true" Visible="@isAddDialogVisible">
                    <DialogTemplates>
                        <Header>
                            <div class="dialog-header d-flex justify-content-between align-items-center w-100 pe-3">
                                <h3 class="dialog-title m-0">@pageTitle</h3>
                                @if (isEditing)
                                {
                                    <button type="button" class="btn btn-sm text-primary bg-light border-0 rounded-pill px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm" @onclick="() => PopupVisible = true" style="background-color: #e0f2fe !important; color: #0284c7 !important; font-size: 0.8rem !important; border-radius: 20px !important;">
                                        <i class="fas fa-barcode"></i> Barcode
                                    </button>
                                }
                            </div>
                            <DxPopup HeaderText="Barcode Generator"
                                     Width="320px"
                                     @bind-Visible="@PopupVisible">
                                <BodyContentTemplate>
                                    <div class="popup-body-content text-center p-2">
                                        <SfBarcodeGenerator Width="200px" Height="100px"
                                                            Type="@BarcodeType.Code128"
                                                            ForeColor="black"
                                                            Value="@sparePart.SerialNumber"
                                                            @ref="barcodeGenerator">
                                        </SfBarcodeGenerator>
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-sm btn-primary" @onclick="OnExport">Export</button>
                                        </div>
                                    </div>
                                </BodyContentTemplate>
                            </DxPopup>
                        </Header>
                    </DialogTemplates>

                    <EditForm Model="@sparePart" OnValidSubmit="@SaveModel">
                        <div class="row g-3">
                            <!-- Left Column: Image Upload & Description -->
                            <div class="col-md-5">
                                <div class="sp-edit-image-box" style="width:100%; height:160px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; border:2px dashed #e2e8f0; border-radius:12px; background:#f8fafc; position:relative; overflow:hidden; margin-bottom:0.75rem;">
                                    @if (!string.IsNullOrEmpty(pendingImagePreviewUrl))
                                    {
                                        <img src="@pendingImagePreviewUrl" alt="Preview" class="sp-edit-img-preview" style="max-height:110px; max-width:90%; object-fit:contain; border-radius:6px;" />
                                        <button type="button" class="sp-edit-crop-btn" style="position:absolute; top:6px; right:6px; background:rgba(0,0,0,0.5); color:#fff; border:none; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:12px;" title="Crop Image" @onclick="OpenCropperModal">
                                            <i class="fas fa-crop"></i>
                                        </button>
                                    }
                                    else if (!string.IsNullOrEmpty(sparePart.PictureUrl))
                                    {
                                        <img src="@sparePart.PictureUrl" alt="Spare Part Image" class="sp-edit-img-preview" style="max-height:110px; max-width:90%; object-fit:contain; border-radius:6px;" />
                                    }
                                    else
                                    {
                                        <i class="fas fa-camera" style="font-size:2.5rem; color:#94a3b8; margin-bottom:4px;"></i>
                                    }
                                    <label for="fileUpload" class="sp-edit-browse-btn" style="display:inline-flex; align-items:center; gap:6px; padding:6px 18px; background:#3b82f6; color:#fff; border-radius:20px; font-size:13px; font-weight:500; cursor:pointer; border:none; box-shadow:0 2px 8px rgba(59,130,246,0.3);">
                                        <i class="fas fa-camera me-1"></i> Browse Image
                                    </label>
                                    <InputFile id="fileUpload" OnChange="HandleFileSelected" accept="image/*" style="display:none;" />
                                </div>

                                <div class="mb-2">
                                    <SfTextBox Enabled="false" Placeholder="@Loc[nameof(ResourceStrings.Textimagefile)]" FloatLabelType="@FloatLabelType.Always" Value="@GetImageFileName()"></SfTextBox>
                                </div>

                                <div>
                                    <SfTextArea Enabled="true" Placeholder="@Loc[nameof(ResourceStrings.textDescription)]" RowCount="3" FloatLabelType="@FloatLabelType.Always" @bind-Value="sparePart.Description"></SfTextArea>
                                </div>
                            </div>

                            <!-- Right Column: Item Details -->
                            <div class="col-md-7">
                                <div class="mb-2">
                                    <SfComboBox @ref="comboObj"
                                                @onclick="OnComboBoxClick"
                                                @onfocusout="@(async () => await OnComboBoxBlur())"
                                                TValue="string"
                                                Placeholder="Select or type to search items"
                                                FloatLabelType="FloatLabelType.Always"
                                                FilterType="Syncfusion.Blazor.DropDowns.FilterType.Contains"
                                                AllowFiltering="true"
                                                AllowCustom="true"
                                                TItem="string"
                                                @bind-Value="sparePart.ItemName"
                                                DataSource="@uniqueItemNames"
                                                Width="100%"
                                                PopupWidth="100%">
                                        <ComboBoxFieldSettings Value="" Text=""></ComboBoxFieldSettings>
                                        <ComboBoxTemplates TItem="string">
                                            <ItemTemplate Context="itemName">
                                                <div class="item-name" title="@itemName">@itemName</div>
                                            </ItemTemplate>
                                        </ComboBoxTemplates>
                                        <ComboBoxEvents TValue="string" TItem="string" Filtering="OnComboBoxFiltering"></ComboBoxEvents>
                                    </SfComboBox>
                                </div>

                                <div class="mb-2">
                                    <SfTextBox Enabled="true" Placeholder="Part Number" FloatLabelType="@FloatLabelType.Always" @bind-Value="@sparePart.SerialNumber"></SfTextBox>
                                </div>

                                <div class="mb-2">
                                    <SfTextBox Enabled="true" Placeholder="@Loc[nameof(ResourceStrings.TextUsefor)]" FloatLabelType="@FloatLabelType.Always" @bind-Value="sparePart.UseFor"></SfTextBox>
                                </div>

                                <div class="row g-2 mt-1">
                                    <div class="col-6">
                                        <SfNumericTextBox TValue="int" Placeholder="Quantity" FloatLabelType="@FloatLabelType.Always" @bind-Value="sparePart.Quantity" Min="0" Step="1" Format="n0" ShowSpinButton="true" Enabled="true"></SfNumericTextBox>
                                    </div>
                                    <div class="col-6">
                                        <SfNumericTextBox TValue="decimal" Placeholder="Default Price ($)" FloatLabelType="@FloatLabelType.Always" @bind-Value="sparePart.DefaultPrice" Min="0" Format="n2" ShowSpinButton="false" Enabled="true"></SfNumericTextBox>
                                    </div>
                                </div>
                            </div>
                        </div>
                        @if (uploadStatus.IsVisible)
                        {
                            <div class="upload-status-bar @GetStatusBarClass()">
                                @if (uploadStatus.IsBusy)
                                {
                                    <div class="upload-status-spinner"></div>
                                }
                                <div>
