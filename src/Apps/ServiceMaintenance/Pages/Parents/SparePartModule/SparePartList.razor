    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        // Load first page with pagination
        await LoadSparePartsPagedAsync(currentPage, pageSize);

        // Don't load all item names anymore - they will load on-demand in ComboBox

        // Establish SignalR connection
        hubConnection = new HubConnectionBuilder()
            .WithUrl(NavigationManager.ToAbsoluteUri("/itemHub"))
            .Build();

        // ✅ FIX: was On<string> — server always broadcasts ItemUpdateMessage,
        // so this handler never fired at all. This page never received any
        // real-time update from other pages.
        hubConnection.On<ItemUpdateMessage>("ReceiveItemUpdate", async (msg) =>
        {
            await LoadSparePartsPagedAsync(currentPage, pageSize);
            // Optionally refresh ComboBox data if dialog is open
            if (isAddDialogVisible && !string.IsNullOrEmpty(currentComboBoxSearch))
            {
                uniqueItemNames = await sparePartService.SearchItemNamesAsync(currentComboBoxSearch, 20);
            }
            await InvokeAsync(StateHasChanged);
        });

        // Handle item deletion event
        hubConnection.On<Guid>("BroadcastItemDelete", (deletedItemId) =>
        {
            spareParts = spareParts.Where(item => item.Id != deletedItemId).ToList();
            // Clear ComboBox cache when items are deleted
            uniqueItemNames = new List<string>();
            InvokeAsync(StateHasChanged);
        });

        // Start the SignalR connection
        await hubConnection.StartAsync();

        // ✅ ADDED — this page previously had no reconnect logic at all, so a
        // dropped connection left it silently stuck with no live updates.
        hubConnection.Closed += async (error) =>
        {
            if (_isDisposed) return;
            Console.WriteLine($"⚠️ SignalR closed: {error?.Message}. Reconnecting...");
            await Task.Delay(new Random().Next(0, 5) * 1000);
            try
            {
                if (_isDisposed) return;
                await hubConnection.StartAsync();
                Console.WriteLine("✅ SignalR reconnected");
                await InvokeAsync(async () =>
                {
                    if (_isDisposed) return;
                    await LoadSparePartsPagedAsync(currentPage, pageSize);
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                if (!_isDisposed)
                    Console.WriteLine($"❌ SignalR reconnection failed: {ex.Message}");
            }
        };
    }
