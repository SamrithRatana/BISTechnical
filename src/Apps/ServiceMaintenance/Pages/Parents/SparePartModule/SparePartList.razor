    public async Task ExportUsedSparePartsToExcel()
    {
        try
        {
            var originalPageSize = pageSize;
            var originalCurrentPage = currentPage;

            ShowSuccessToast("កំពុងរៀបចំ Export...");

            var usedSpareparts = await sparePartService.GetSparePartsUsedInServicesAsync();

            if (!usedSpareparts.Any())
            {
                ShowErrorToast("មិនមានគ្រឿងបន្លាស់ដែលធ្លាប់ប្ដូរទេ");
                return;
            }

            // ── Build Excel with EPPlus directly (to embed real images) ──────
            using var package = new ExcelPackage();
            var ws = package.Workbook.Worksheets.Add("Used Spare Parts");

            // ── Header row ───────────────────────────────────────────────────
            string[] headers = { "Image", "Item Name", "Part Number", "Use For",
                              "ចំនួនក្នុងស្តុក", "ចំនួនប្រើញឹកញាប់", "Stock Status", "Description" };

            for (int c = 0; c < headers.Length; c++)
            {
                var cell = ws.Cells[1, c + 1];
                cell.Value = headers[c];
                cell.Style.Font.Bold = true;
                cell.Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                cell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(33, 115, 186));
                cell.Style.Font.Color.SetColor(System.Drawing.Color.White);
                cell.Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Center;
                cell.Style.VerticalAlignment = OfficeOpenXml.Style.ExcelVerticalAlignment.Center;
            }

            // ── Set image column width & row heights ─────────────────────────
            ws.Column(1).Width = 15; // Image column
            ws.Column(2).Width = 25;
            ws.Column(3).Width = 18;
            ws.Column(4).Width = 30;
            ws.Column(5).Width = 15;
            ws.Column(6).Width = 18;
            ws.Column(7).Width = 15;
            ws.Column(8).Width = 35;

            // ── Data rows ────────────────────────────────────────────────────
            using var httpClient = new HttpClient();
            httpClient.Timeout = TimeSpan.FromSeconds(10);

            for (int i = 0; i < usedSpareparts.Count; i++)
            {
                int row = i + 2; // row 1 = header
                var part = usedSpareparts[i];

                ws.Row(row).Height = 60; // pixels ≈ 60pt row height for image

                // ── Col 1: Image ─────────────────────────────────────────────
                if (!string.IsNullOrEmpty(part.PictureUrl))
                {
                    try
                    {
                        byte[] imageBytes = null;

                        if (part.PictureUrl.StartsWith("http://") || part.PictureUrl.StartsWith("https://"))
                        {
                            imageBytes = await httpClient.GetByteArrayAsync(part.PictureUrl);
                        }
                        else
                        {
                            var localPath = Path.Combine(
                                Directory.GetCurrentDirectory(), "wwwroot",
                                part.PictureUrl.TrimStart('/').Replace("/", Path.DirectorySeparatorChar.ToString()));
                            if (File.Exists(localPath))
                                imageBytes = await File.ReadAllBytesAsync(localPath);
                        }

                        if (imageBytes != null)
                        {
                            using var ms = new MemoryStream(imageBytes);
                            using var img = System.Drawing.Image.FromStream(ms);

                            // Resize to thumbnail
                            using var thumb = new System.Drawing.Bitmap(img, new System.Drawing.Size(80, 55));
                            using var thumbStream = new MemoryStream();
                            thumb.Save(thumbStream, System.Drawing.Imaging.ImageFormat.Jpeg);
                            thumbStream.Position = 0;

                            // Add picture to worksheet cell
                            var picture = ws.Drawings.AddPicture($"img_{row}", thumbStream);
                            // Position: row-1 (0-based), col-1 (0-based), offsetX px, offsetY px
                            picture.SetPosition(row - 1, 2, 0, 2);
                            picture.SetSize(80, 55);
                        }
                        else
                        {
                            ws.Cells[row, 1].Value = "No Image";
                        }
                    }
                    catch (Exception imgEx)
                    {
                        Console.WriteLine($"Image embed error row {row}: {imgEx.Message}");
                        ws.Cells[row, 1].Value = "Error";
                    }
                }
                else
                {
                    ws.Cells[row, 1].Value = "No Image";
                    ws.Cells[row, 1].Style.Font.Color.SetColor(System.Drawing.Color.Gray);
                }

                // ── Col 2-8: Data ─────────────────────────────────────────────
                ws.Cells[row, 2].Value = part.ItemName;
                ws.Cells[row, 3].Value = part.SerialNumber;
                ws.Cells[row, 4].Value = part.UseFor;
                ws.Cells[row, 5].Value = part.Quantity;
                ws.Cells[row, 6].Value = part.UsageCount;
                ws.Cells[row, 8].Value = part.Description;

                // ── Col 7: Stock Status with color ───────────────────────────
                var statusCell = ws.Cells[row, 7];
                if (part.Quantity <= 0)
                {
                    statusCell.Value = "OUT OF STOCK";
                    statusCell.Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                    statusCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(220, 53, 69));
                    statusCell.Style.Font.Color.SetColor(System.Drawing.Color.White);
                }
                else if (part.Quantity <= CRITICAL_STOCK)
                {
                    statusCell.Value = "CRITICAL";
                    statusCell.Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                    statusCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(255, 107, 107));
                    statusCell.Style.Font.Color.SetColor(System.Drawing.Color.White);
                }
                else if (part.Quantity <= LOW_STOCK)
                {
                    statusCell.Value = "LOW STOCK";
                    statusCell.Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                    statusCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(255, 193, 7));
                    statusCell.Style.Font.Color.SetColor(System.Drawing.Color.Black);
                }
                else
                {
                    statusCell.Value = "IN STOCK";
                    statusCell.Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                    statusCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(40, 167, 69));
                    statusCell.Style.Font.Color.SetColor(System.Drawing.Color.White);
                }
                statusCell.Style.Font.Bold = true;
                statusCell.Style.HorizontalAlignment = OfficeOpenXml.Style.ExcelHorizontalAlignment.Center;

                // ── Quantity color ────────────────────────────────────────────
                var qtyCell = ws.Cells[row, 5];
                qtyCell.Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                if (part.Quantity <= 0)
                    qtyCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(255, 224, 224));
                else if (part.Quantity <= CRITICAL_STOCK)
                    qtyCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(255, 208, 208));
                else if (part.Quantity <= LOW_STOCK)
                    qtyCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(255, 243, 205));
                else
                    qtyCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(212, 237, 218));

                // ── UsageCount color ──────────────────────────────────────────
                var usageCell = ws.Cells[row, 6];
                usageCell.Style.Fill.PatternType = OfficeOpenXml.Style.ExcelFillStyle.Solid;
                if (part.UsageCount >= 20)
                {
                    usageCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(255, 68, 68));
                    usageCell.Style.Font.Color.SetColor(System.Drawing.Color.White);
                    usageCell.Style.Font.Bold = true;
                }
                else if (part.UsageCount >= 10)
                {
                    usageCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(255, 140, 0));
                    usageCell.Style.Font.Color.SetColor(System.Drawing.Color.White);
                }
                else if (part.UsageCount >= 5)
                {
                    usageCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(255, 193, 7));
                }
                else
                {
                    usageCell.Style.Fill.BackgroundColor.SetColor(System.Drawing.Color.FromArgb(232, 245, 233));
                    usageCell.Style.Font.Color.SetColor(System.Drawing.Color.FromArgb(46, 125, 50));
                }

                // ── Row border ────────────────────────────────────────────────
                using var rowRange = ws.Cells[row, 1, row, 8];
                rowRange.Style.Border.Bottom.Style = OfficeOpenXml.Style.ExcelBorderStyle.Thin;
                rowRange.Style.Border.Bottom.Color.SetColor(System.Drawing.Color.LightGray);
                rowRange.Style.VerticalAlignment = OfficeOpenXml.Style.ExcelVerticalAlignment.Center;
            }

            // ── Header border & auto-filter ───────────────────────────────────
            ws.Cells[1, 1, 1, 8].AutoFilter = true;
            ws.View.FreezePanes(2, 1);

            using (var headerRange = ws.Cells[1, 1, 1, 8])
            {
                headerRange.Style.Border.Bottom.Style = OfficeOpenXml.Style.ExcelBorderStyle.Medium;
                headerRange.Style.Border.Bottom.Color.SetColor(System.Drawing.Color.FromArgb(33, 115, 186));
            }

            // ── Stream to browser download ────────────────────────────────────
            var excelBytes = package.GetAsByteArray();
            var base64 = Convert.ToBase64String(excelBytes);
            var fileName = $"UsedSpareParts_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

            await JS.InvokeVoidAsync("downloadFileFromBase64", base64, fileName,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");

            ShowSuccessToast("Export សម្រេច!");

            await LoadSparePartsPagedAsync(originalCurrentPage, originalPageSize);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in ExportUsedSparePartsToExcel: {ex.Message}");
            ShowErrorToast("Export បរាជ័យ: " + ex.Message);
            await LoadSparePartsPagedAsync(currentPage, pageSize);
            StateHasChanged();
        }
    }
