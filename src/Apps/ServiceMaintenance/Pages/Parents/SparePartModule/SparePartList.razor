            var result = await Cache.GetOrSetAsync(
                CacheKeys.SparePart(page, size),
                () => sparePartService.GetSparePartsPagedAsync(page, size),
                TimeSpan.FromMinutes(3));
            spareParts = result.Items ?? new List<SparePartObject>();
            totalCount = result.TotalCount;
            currentPage = page;
            pageSize = size;
            indicatorVisible = false;
        }
        catch (Exception ex)
        {
