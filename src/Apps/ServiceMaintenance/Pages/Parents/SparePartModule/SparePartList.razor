    private void OnSearchKeyUp(KeyboardEventArgs e)
    {
        _searchDebounceTimer?.Dispose();

        _searchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await InvokeAsync(async () =>
                {
                    await PerformSearch();
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error in debounced search: {ex.Message}");
            }
        }, null, 500, Timeout.Infinite);
    }

    private async Task PerformSearch()
    {
        try
        {
            isSearching = true;
            StateHasChanged();

            currentPage = 1;

            if (string.IsNullOrWhiteSpace(searchQuery))
            {
                await LoadSparePartsPagedAsync(currentPage, pageSize);
            }
            else
            {
                // ✅ Check if the search term looks like a GUID (Id search)
                if (Guid.TryParse(searchQuery.Trim(), out Guid searchId))
                {
                    try
                    {
                        var item = await sparePartService.GetSparePartByIdAsync(searchId);
                        if (item != null)
                        {
                            spareParts = new List<SparePartObject> { item };
                            totalCount = 1;
                        }
                        else
                        {
                            spareParts = new List<SparePartObject>();
                            totalCount = 0;
                        }
                    }
                    catch
                    {
                        spareParts = new List<SparePartObject>();
                        totalCount = 0;
                    }
                }
                else
                {
                    // ✅ Normal text search
                    var result = await sparePartService.SearchSparePartsAsync(
                        pageNumber: currentPage,
                        pageSize: pageSize,
                        searchTerm: searchQuery
                    );

                    spareParts = result.Items ?? new List<SparePartObject>();
                    totalCount = result.TotalCount;
                    currentPage = result.PageNumber;
                }
            }

            isSearching = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in PerformSearch: {ex.Message}");
            isSearching = false;
            ShowErrorToast("Failed to search spare parts");
        }
