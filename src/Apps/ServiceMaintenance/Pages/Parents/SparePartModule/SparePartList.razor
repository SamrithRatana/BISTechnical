    private async Task<string> GenerateSerialNumber(string itemName)
    {
        if (string.IsNullOrEmpty(itemName)) return string.Empty;

        // Split itemName into words
        var words = itemName.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);

        // Determine how many characters to take for initials
        int initialLength = words.Length switch
        {
            >= 4 => 4,
            3 => 3,
            2 => 2,
            _ => 1
        };

        var initials = string.Concat(words.Take(initialLength).Select(word => word[0])).ToUpper();

        // Extract context (numeric suffix) from the last word if present
        string context = string.Empty;
        var lastWord = words.Last();
        var digitMatch = System.Text.RegularExpressions.Regex.Match(lastWord, @"\d+$");
        if (digitMatch.Success)
        {
            context = digitMatch.Value;
        }

        string prefix = initials + context;

        // USE API TO GET EXISTING SERIAL NUMBERS
        try
        {
            var existingSerials = await sparePartService.GetSerialNumbersByPrefixAsync(prefix, 100);

            if (!existingSerials.Any())
            {
                return $"{prefix}-01";
            }

            // Find the maximum serial number
            var maxSerial = existingSerials
                .Where(sn => sn.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
                .OrderByDescending(sn => sn)
                .FirstOrDefault();

            int nextSerialNumber = 1;
            if (!string.IsNullOrEmpty(maxSerial))
            {
                var parts = maxSerial.Split('-');
                if (parts.Length == 2 && int.TryParse(parts[1], out int lastNumber))
                {
                    nextSerialNumber = lastNumber + 1;
                }
            }

            return $"{prefix}-{nextSerialNumber:D2}";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error generating serial number: {ex.Message}");
            return $"{prefix}-01"; // Fallback
        }
    }
    // ✅ NEW — highlights the current search term inside grid cell text,
    // same pattern used in receive-item.razor's dropdown highlighting.
    private MarkupString HighlightMatch(string text, string term)
    {
        if (string.IsNullOrEmpty(text))
            return (MarkupString)string.Empty;

        if (string.IsNullOrWhiteSpace(term))
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);

        var sb = new System.Text.StringBuilder();
        int startIndex = 0;
        int idx;

        while ((idx = text.IndexOf(term, startIndex, StringComparison.OrdinalIgnoreCase)) >= 0)
        {
            sb.Append(System.Net.WebUtility.HtmlEncode(text.Substring(startIndex, idx - startIndex)));

            var matchedText = text.Substring(idx, term.Length);
            sb.Append("<span style=\"background-color:#ffeb3b;\">")
              .Append(System.Net.WebUtility.HtmlEncode(matchedText))
              .Append("</span>");

            startIndex = idx + term.Length;
        }

        sb.Append(System.Net.WebUtility.HtmlEncode(text.Substring(startIndex)));

        return (MarkupString)sb.ToString();
    }

    private async Task OnComboBoxBlur()
    {
        await OnItemNameChanged();
    }

    private void OnExport()
    {
        barcodeGenerator.Export("barcodeFile", BarcodeExportType.JPG);
    }
    private async Task ScrollFilterSliderLeft()
    {
        if (JS != null)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", @"
                const slider = document.getElementById('filterCardSlider');
                if (slider) {
                    slider.scrollLeft -= 100;
                }
            ");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error scrolling filter slider: {ex.Message}");
            }
        }
    }

    private async Task ScrollFilterSliderRight()
    {
        if (JS != null)
        {
            try
            {
                await JS.InvokeVoidAsync("eval", @"
                const slider = document.getElementById('filterCardSlider');
                if (slider) {
                    slider.scrollLeft += 100;
                }
            ");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error scrolling filter slider: {ex.Message}");
            }
        }
    }
