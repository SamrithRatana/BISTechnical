    private async Task SaveModel()
    {
        uploadStatus = UploadStatusInfo.Idle(); // ← ADD HERE (top of method, resets status before each save)

        try
        {
            // Process and save the image if there's a pending file
            if (pendingImageFile != null)
            {
                try
                {
                    await ProcessAndSaveImage();
                }
                catch (Exception imageEx)
                {
                    uploadStatus = UploadStatusInfo.Error(imageEx.Message); // ← ADD HERE (shows red error in status bar)
                    ShowErrorToast($"Image processing failed: {imageEx.Message}");
                    return;
                }
            }

            // Validate required fields
            if (string.IsNullOrWhiteSpace(sparePart.ItemName))
            {
                ShowErrorToast("Item Name is required");
                return;
            }

            // ✅ FIX: ItemHub.BroadcastItemUpdate expects ItemUpdateMessage, not string
            if (sparePartID == null || sparePartID == Guid.Empty)
            {
                sparePart.LinkItemId = Guid.NewGuid();
                await sparePartService.CreateSparePartAsync(sparePart);
                await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                {
                    AffectedStatuses = Array.Empty<string>()
                });
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixSparePart);
            }
            else
            {
                sparePart.Id = sparePartID.Value;
                await sparePartService.UpdateSparePartAsync(sparePart);
                await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                {
                    AffectedStatuses = Array.Empty<string>()
                });
                await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixSparePart);
            }

            // Clear pending data after successful save
            pendingImageFile = null;
            pendingImagePreviewUrl = null;

            isAddDialogVisible = false;
            await LoadSparePartsPagedAsync(currentPage, pageSize);
            StateHasChanged();
            ShowSuccessToast("Spare part saved successfully");
        }
        catch (Exception ex)
        {
            uploadStatus = UploadStatusInfo.Error(ex.Message); // ← ADD HERE (catches any unexpected outer error)
            ShowErrorToast($"Unexpected error: {ex.Message}");
        }
    }
