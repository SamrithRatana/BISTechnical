    public void OnExcelQueryCellInfo(ExcelQueryCellInfoEventArgs<SparePartObject> args)
    {

        if (args.Column.HeaderText == "Image")
        {
            if (!string.IsNullOrEmpty(args.Data.PictureUrl))
            {
                args.Cell.Value = Path.GetFileName(args.Data.PictureUrl);
                args.Cell.CellStyle.BackColor = "#E3F2FD";
            }
            else
            {
                args.Cell.Value = "No Image";
                args.Cell.CellStyle.BackColor = "#F5F5F5";
                args.Cell.CellStyle.FontColor = "#999999";
            }
        }
        // ── Stock Status column ──────────────────────────────────────────
        if (args.Column.HeaderText == "Stock Status")
        {
            var qty = args.Data.Quantity;

            if (qty <= 0)
            {
                args.Cell.Value = "OUT OF STOCK";
                args.Cell.CellStyle.BackColor = "#FF0000";
                args.Cell.CellStyle.FontColor = "#FFFFFF";
                args.Cell.CellStyle.Bold = true;
            }
            else if (qty <= CRITICAL_STOCK)
            {
                args.Cell.Value = "CRITICAL";
                args.Cell.CellStyle.BackColor = "#FF6B6B";
                args.Cell.CellStyle.FontColor = "#FFFFFF";
                args.Cell.CellStyle.Bold = true;
            }
            else if (qty <= LOW_STOCK)
            {
                args.Cell.Value = "LOW STOCK";
                args.Cell.CellStyle.BackColor = "#FFC107";
                args.Cell.CellStyle.FontColor = "#000000";
                args.Cell.CellStyle.Bold = true;
            }
            else
            {
                args.Cell.Value = "IN STOCK";
                args.Cell.CellStyle.BackColor = "#28A745";
                args.Cell.CellStyle.FontColor = "#FFFFFF";
                args.Cell.CellStyle.Bold = true;
            }
        }

        // ── Stock Qty color ──────────────────────────────────────────────
        if (args.Column.HeaderText == "Stock Qty" || args.Column.HeaderText == "Quantity")
        {
            var qty = args.Data.Quantity;

            if (qty <= 0)
                args.Cell.CellStyle.BackColor = "#FFE0E0";
            else if (qty <= CRITICAL_STOCK)
                args.Cell.CellStyle.BackColor = "#FFD0D0";
            else if (qty <= LOW_STOCK)
                args.Cell.CellStyle.BackColor = "#FFF3CD";
            else
                args.Cell.CellStyle.BackColor = "#D4EDDA";
        }

        // ── Times Used color (ញឹកញាប់ = កាន់តែខ្ចីពណ៌) ─────────────────
        if (args.Column.HeaderText == "Times Used")
        {
            var count = args.Data.UsageCount;
            args.Cell.Value = count;

            if (count >= 20)
            {
                args.Cell.CellStyle.BackColor = "#FF4444"; // red = used most
                args.Cell.CellStyle.FontColor = "#FFFFFF";
                args.Cell.CellStyle.Bold = true;
            }
            else if (count >= 10)
            {
                args.Cell.CellStyle.BackColor = "#FF8C00";
                args.Cell.CellStyle.FontColor = "#FFFFFF";
                args.Cell.CellStyle.Bold = true;
            }
            else if (count >= 5)
            {
                args.Cell.CellStyle.BackColor = "#FFC107";
                args.Cell.CellStyle.FontColor = "#000000";
            }
            else
            {
                args.Cell.CellStyle.BackColor = "#E8F5E9";
                args.Cell.CellStyle.FontColor = "#2E7D32";
            }
        }

        // ── Total Qty Used color ─────────────────────────────────────────
        if (args.Column.HeaderText == "Total Qty Used")
        {
            var totalQty = args.Data.TotalQtyUsed;
            args.Cell.Value = totalQty;

            if (totalQty >= 50)
            {
                args.Cell.CellStyle.BackColor = "#FF4444";
                args.Cell.CellStyle.FontColor = "#FFFFFF";
                args.Cell.CellStyle.Bold = true;
            }
            else if (totalQty >= 20)
            {
                args.Cell.CellStyle.BackColor = "#FF8C00";
                args.Cell.CellStyle.FontColor = "#FFFFFF";
            }
            else if (totalQty >= 10)
            {
                args.Cell.CellStyle.BackColor = "#FFC107";
                args.Cell.CellStyle.FontColor = "#000000";
            }
            else
            {
                args.Cell.CellStyle.BackColor = "#E8F5E9";
                args.Cell.CellStyle.FontColor = "#2E7D32";
            }
        }
    }
