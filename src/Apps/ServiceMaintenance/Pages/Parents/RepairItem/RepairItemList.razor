    // ✅ CHANGED — now async, fetches the LATEST Inspection/Solution
    // directly from the server (not from the grid's cached copy) so the
    // dialog always shows the true current values before the user appends.
    private async Task OnApplyButtonClick(RepairServices selectedRepairService)
    {
        _selectedRepairService = selectedRepairService;

        if (_selectedRepairService != null)
        {
            if (_selectedRepairService.Status == "Sale Confirmed" &&
                _selectedRepairService.SparePartItems != null &&
                _selectedRepairService.SparePartItems.Any())
            {
                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Error",
                    Title = "ត្រូវរង់ចាំផ្នែកស្តុកត្រួតពិនិត្យនិងបញ្ជូនគ្រឿងបន្លាស់ជាមុនសិន",
                    Text = $"{_selectedRepairService.reportNo}: មិនអាចអនុម័តជា 'ជួសជុលបាន' បានទេ ព្រោះ Service នេះមានគ្រឿងបន្លាស់ភ្ជាប់មកជាមួយ។",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Danger
                });
                return;
            }

            // ✅ NEW — items still in "Inspection" can only be approved
            // (moved to Repairing) if the ServiceType is Free (1). Charge
            // (2) items must go through the sales/marketing department
            // first, so block and inform the user instead.
            if (_selectedRepairService.Status == "Inspection" &&
                _selectedRepairService.ServiceTypeId == 2)
            {
                ToastNotificationService.ShowToast(new ToastOptions
                {
                    ProviderName = "Error",
                    Title = "មិនអាចអនុម័តបាន",
                    Text = "អ្នកមិនអាច អនុម័តបានទេ ព្រោះជា Service Charge ត្រូវបញ្ជូនទៅផ្នែកទីផ្សារ Confirm ជាមុនសិនទើបអាចអនុម័តបាន",
                    ThemeMode = ToastThemeMode.Pastel,
                    RenderStyle = ToastRenderStyle.Danger
                });
                return;
            }

            // ✅ existing — pull fresh Inspection/Solution straight from the API
            // (GetRepairServiceByIdAsync), so we don't rely on whatever the
            // grid happened to have cached.
            try
            {
                var freshService = await RepairItemService.GetRepairServiceByIdAsync(_selectedRepairService.Id);
                editInspection = freshService?.Inspection ?? string.Empty;
                editSolution = freshService?.Solution ?? string.Empty;
            }
            catch
            {
                editInspection = _selectedRepairService.Inspection ?? string.Empty;
                editSolution = _selectedRepairService.Solution ?? string.Empty;
            }

            RepairItemBy.Id = _selectedRepairService.Id;
            pageTitle = "អនុម័តជួសជុល";
            isConfirmationDialogVisible = true;
        }
    }

    private async Task ConfirmCustomerConfirm()
    {
        if (isProcessing)
        {
            return;
        }

        // Block approving to "Sale Confirmed" if the service still has
        // SparepartItems attached.
        if (_selectedRepairService?.Status == "Sale Confirmed" &&
            _selectedRepairService.SparePartItems != null &&
            _selectedRepairService.SparePartItems.Any())
        {
            isConfirmationDialogVisible = false;

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "មិនអាចអនុម័តបាន",
                Text = $"{_selectedRepairService.reportNo}: មិនអាចអនុម័តជា 'ជួសជុលបាន' បានទេ ព្រោះ Service នេះមានគ្រឿងបន្លាស់ភ្ជាប់ស្រាប់។",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
            return;
        }

        try
        {
            isProcessing = true;
            StateHasChanged();

            // ✅ Persist any edits made to Inspection/Solution in the
            // dialog BEFORE the repair action runs, using the dedicated
            // narrow-scope endpoint (touches only these two fields).
            if (_selectedRepairService != null)
            {
                bool inspectionSolutionChanged =
                    editInspection != (_selectedRepairService.Inspection ?? string.Empty) ||
                    editSolution != (_selectedRepairService.Solution ?? string.Empty);

                if (inspectionSolutionChanged)
                {
                    await RepairItemService.UpdateInspectionSolutionAsync(
                        _selectedRepairService.Id, editInspection, editSolution);

                    _selectedRepairService.Inspection = editInspection;
                    _selectedRepairService.Solution = editSolution;
                }
            }

            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity.IsAuthenticated)
            {
                var currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

                if (!string.IsNullOrEmpty(currentUserId))
                {
                    if (Guid.TryParse(currentUserId, out Guid userGuid))
                    {
                        RepairItemBy.repairBy = userGuid;
                    }
                    else
                    {
                        RepairItemBy.repairBy = Guid.Empty;
                    }
                }
                else
                {
                    RepairItemBy.repairBy = Guid.Empty;
                }
            }

            // Capture the status BEFORE it gets mutated locally below, so the
            // broadcast and Telegram delete both know exactly which topic
            // this item is leaving.
            string originalStatus = _selectedRepairService?.Status ?? "Sent Spareparts";

            await RepairService.RepairAsync(RepairItemBy);

            // Only invalidate the prefix the item is actually leaving,
            // plus PrefixRepairItem/PrefixSparePart which this action always
            // touches (spare part stock gets deducted here).
            await Cache.InvalidateByPrefixAsync(GetPrefixForStatus(originalStatus));
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixRepairItem);
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixSparePart);
            await Cache.InvalidateAsync(CacheKeys.DashboardStats);

            Guid processedItemId = Guid.Empty;
            string reportNo = string.Empty;

            if (_selectedRepairService != null)
            {
                processedItemId = _selectedRepairService.Id;
                reportNo = _selectedRepairService.reportNo;

                filteredRepairServices = filteredRepairServices
                    .Where(x => x.Id != processedItemId)
                    .ToList();

                totalItems--;
                totalPages = totalItems > 0
                    ? (int)Math.Ceiling(totalItems / (double)pageSize)
                    : 0;

                if (currentPage > totalPages && totalPages > 0)
                {
                    currentPage = totalPages;
                }

                _selectedRepairService.repairDate = DateTime.UtcNow.AddHours(7);
                _selectedRepairService.Status = "Repairing";
                _selectedRepairService.repairBy = RepairItemBy.repairBy;
            }

            isConfirmationDialogVisible = false;
            isProcessing = false;
            StateHasChanged();

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Customization",
                Title = "Success",
                Text = $"Repair item {reportNo} processed successfully",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Success
            });

            _ = Task.Run(async () =>
            {
                var backgroundTasks = new List<Task>();

                if (hubConnection?.State == HubConnectionState.Connected)
                {
                    backgroundTasks.Add(
                        hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                        {
                            AffectedStatuses = new[] { originalStatus }
                        })
                            .ContinueWith(t =>
                            {
                                if (!t.IsCompletedSuccessfully)
                                    Console.WriteLine($"⚠️ SignalR failed: {t.Exception?.Message}");
                            })
                    );
                }

                // ✅ NEW — delete the Telegram message that was posted for this
                // item under its PREVIOUS status (e.g. "SentSpareparts" or
                // "Inspection" topic), now that it has been approved and moved
                // to "Repairing". ResolveMessageIdFromTopic=true because this
                // page never captured the MessageId itself (it was saved by
                // whichever page originally sent it) — the worker looks it up
                // from ServiceTelegramMessages at execution time, keyed by
                // (ItemId, TopicKey).
                if (processedItemId != Guid.Empty)
                {
                    backgroundTasks.Add(Task.Run(async () =>
                    {
                        try
                        {
                            string topicKey = GetTelegramTopicKeyForStatus(originalStatus);

                            await TelegramQueue.EnqueueAsync(new TelegramMessage
                            {
                                Action = TelegramAction.Delete,
                                ItemId = processedItemId,
                                TopicKey = topicKey,
                                ResolveMessageIdFromTopic = true
                            });
                            Console.WriteLine($"🗑️ Telegram delete enqueued for {reportNo} (topic: {topicKey})");
                        }
                        catch (Exception ex)
                        {
                            Console.WriteLine($"⚠️ Telegram delete enqueue failed: {ex.Message}");
                        }
                    }));
                }

                try
                {
                    await Task.WhenAll(backgroundTasks);
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Some notifications failed: {ex.Message}");
                }

                await Task.Delay(2000);

                try
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadPageData();
                        StateHasChanged();
                    });
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"⚠️ Background refresh failed: {ex.Message}");
                }
            });
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("timed out"))
        {
            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Timeout",
                Text = "Operation is taking longer than expected. Refreshing data...",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Warning
            });

            await LoadPageData();
            isConfirmationDialogVisible = false;
            isProcessing = false;
        }
        catch (Exception ex)
        {
            string userMessage = ParseFriendlyErrorMessage(ex.Message);

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "ត្រូវរង់ចាំផ្នែកស្តុកត្រួតពិនិត្យនិងបញ្ជូនគ្រឿងបន្លាស់ជាមុនសិន",
                Text = userMessage,
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });

            await LoadPageData();
            isConfirmationDialogVisible = false;
            isProcessing = false;
        }
        finally
        {
            if (isProcessing)
            {
                isProcessing = false;
                StateHasChanged();
            }
        }
    }
    private string ParseFriendlyErrorMessage(string rawError)
    {
        try
        {
            if (rawError.Contains("Insufficient stock") || rawError.Contains("Insufficient stock when releasing hold"))
            {
                var itemMatch = System.Text.RegularExpressions.Regex.Match(
                    rawError, @"Item:\s*(.+?)\s*\|");
                var availableMatch = System.Text.RegularExpressions.Regex.Match(
                    rawError, @"Available:\s*(\d+)");
                var requiredMatch = System.Text.RegularExpressions.Regex.Match(
                    rawError, @"Required:\s*(\d+)");
                var barcodeMatch = System.Text.RegularExpressions.Regex.Match(
                    rawError, @"(?:Barcode|Serial|SKU|Code):\s*([A-Za-z0-9\-]+)",
                    System.Text.RegularExpressions.RegexOptions.IgnoreCase);

                string itemName = itemMatch.Success ? itemMatch.Groups[1].Value.Trim() : "គ្រឿងបន្លាស់";
                string available = availableMatch.Success ? availableMatch.Groups[1].Value : "0";
                string required = requiredMatch.Success ? requiredMatch.Groups[1].Value : "?";

                string barcode = barcodeMatch.Success
                    ? barcodeMatch.Groups[1].Value.Trim()
                    : GetBarcodeFromCurrentService(itemName);

                string barcodeInfo = !string.IsNullOrEmpty(barcode)
                    ? $"Id: {barcode} | "
                    : "";

                return $"ស្តុកគ្រឿងបន្លាស់មិនគ្រប់គ្រាន់ សូមពិនិត្យឡើងវិញ! " +
                       $"ឈ្មោះ: {itemName} | " +
                       $"{barcodeInfo}" +
                       $"មានក្នុងស្តុក: {available} | " +
                       $"ត្រូវការ: {required}. " +
                       $"សូមបញ្ចូលស្តុកជាមុនសិន។";
            }

            if (rawError.Contains("DbUpdateException") || rawError.Contains("SqlException"))
            {
                return "មានបញ្ហាក្នុងការរក្សាទុកទិន្នន័យ។ សូមព្យាយាមម្តងទៀត។";
            }

            if (rawError.Contains("timed out") || rawError.Contains("timeout"))
            {
                return "ការតភ្ជាប់យឺតពេក។ សូមព្យាយាមម្តងទៀត។";
            }

            if (rawError.Contains("InternalServerError") || rawError.Contains("500"))
            {
                return "មានបញ្ហានៅម៉ាស៊ីនមេ។ សូមទាក់ទងអ្នកគ្រប់គ្រង។";
            }

            return "មិនអាចអនុម័តការជួសជុលបាន។ សូមពិនិត្យម្តងទៀត ឬទាក់ទងអ្នកគ្រប់គ្រង។";
        }
        catch
        {
            return "មិនអាចអនុម័តការជួសជុលបាន។ សូមទាក់ទងអ្នកគ្រប់គ្រង។";
        }
    }

    private string GetBarcodeFromCurrentService(string itemName)
    {
        try
        {
            if (_selectedRepairService?.SparePartItems == null)
                return string.Empty;

            foreach (var sp in _selectedRepairService.SparePartItems)
            {
                var sparePartObj = _spareParts.FirstOrDefault(x =>
                    x.Id == sp.SparePartId &&
                    (x.ItemName?.Equals(itemName, StringComparison.OrdinalIgnoreCase) == true ||
                     itemName.Contains(x.ItemName ?? "", StringComparison.OrdinalIgnoreCase)));

                if (sparePartObj != null)
                    return sparePartObj.Id.ToString();
            }

            var firstSparePart = _selectedRepairService?.SparePartItems?.FirstOrDefault();
            if (firstSparePart?.SparePartId != null)
                return firstSparePart.SparePartId.ToString();

            return string.Empty;
        }
        catch
        {
            return string.Empty;
        }
    }
