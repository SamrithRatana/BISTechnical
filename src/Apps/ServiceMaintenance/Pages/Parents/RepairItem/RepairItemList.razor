                                                    </td>
                                                    <td style="padding:5px 6px; vertical-align:middle; color:#555;
                                                                               overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"
                                                        title="@(sparePartObject?.UseFor ?? sparePart.UseFor)">
                                                        @(sparePartObject?.UseFor ?? sparePart.UseFor ?? "—")
                                                    </td>
                                                    <td style="padding:5px 4px; text-align:center; vertical-align:middle; font-weight:700;">
                                                        @sparePart.Quantity
                                                    </td>
                                                    <td style="padding:5px 4px; text-align:center; vertical-align:middle;">
                                                        @if (!string.IsNullOrEmpty(sparePart.Condition))
