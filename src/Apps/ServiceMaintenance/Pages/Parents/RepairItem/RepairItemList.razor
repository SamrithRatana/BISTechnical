                                                </td>
                                                <td></td>
                                                <td style="padding:6px 4px; text-align:right; color:#28a745; white-space:nowrap;">
                                                    @{
                                                        var grandTotal = _selectedRepairService.SparePartItems.Sum(sp =>
                                                        {
                                                            var obj = _spareParts.FirstOrDefault(x => x.Id == sp.SparePartId);
                                                            return (obj?.DefaultPrice ?? 0) * sp.Quantity;
                                                        });
                                                    }
                                                    $@grandTotal.ToString("N2")
                                                </td>
                                                <td></td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </Content>
            </DialogTemplates>
            <DialogButtons>
                <DialogButton Content="Close" IsPrimary="true" OnClick="@CloseDialog" />
            </DialogButtons>
        </SfDialog>
    }
}
@code {
    [Parameter] public string ReportNo { get; set; }
