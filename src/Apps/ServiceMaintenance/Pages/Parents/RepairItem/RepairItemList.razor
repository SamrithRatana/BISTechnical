@page "/reapairItem"
@page "/reapairItem/{ReportNo}"
@implements IAsyncDisposable

@using ServiceMaintenance.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.AspNetCore.Components.Authorization
@using System.Timers
@using ServiceMaintenance.Pages.Reports
@using ServiceMaintenance.Services
@using Syncfusion.Blazor.Cards
@inject RepairItemService RepairItemService
@inject CustomerService CustomerService
@inject NavigationManager NavigationManager
@inject StateManagementAction StateManagementAction
@inject RepairService RepairService
@inject ServiceSparePart SparePartService
@inject JwtSessionService JwtSessionService
@inject GlobalUserService GlobalUserCache
@inject SentSparepartsService SentSparepartsService
@inject IJSRuntime JSRuntime
@inject CacheHelper Cache
@inject InspectItemService InspectItemService
@using ServiceMaintenance.Infrastructure.Shared.Caching
@using ServiceMaintenance.Services.Notifications
@inject TelegramNotificationQueue TelegramQueue
<DxToastProvider Name="Customization"
                 MaxToastCount="10"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 VerticalAlignment="VerticalEdge.Top"
                 AnimationType="@Animation" />
                 
<DxToastProvider Name="Error"
                 MaxToastCount="5"
                 HorizontalAlignment="HorizontalAlignment.Right"
                 VerticalAlignment="VerticalEdge.Top"
                 AnimationType="@Animation"
                 ShowCloseButton="true"
                 DisplayTime="TimeSpan.Zero" />
              
<ActionToolbox CanCreate="CanCreate"
               CanEdit="CanEdit"
               CanDelete="CanDelete"
               CanExport="CanExport"
               IsCreateEnabled="false"
               IsEditEnabled="false"
               IsDeleteEnabled="false"
               OnCreate="NewRepairService_Click"
               OnEdit="EditRepairService_Click"
               OnExportExcel="ExportToExcel"
               OnExportPdf="ExportToPdf">
    <CustomActions>
        @if (CanPrint)
        {
            <button class="btn btn-sm btn-outline-secondary compact-btn" @onclick="() => ShowReportPreview(_selectedRepairService)" disabled="@(!isRow)">
                <i class="fas fa-print me-1"></i> Print Report
            </button>
        }
    </CustomActions>
</ActionToolbox>
<br />
<SfMediaQuery @bind-ActiveBreakPoint="activeBreakpoint"></SfMediaQuery>
@{
    bool enableAdaptiveUIMode = false;
    RowDirection renderingMode = RowDirection.Vertical;

    if (activeBreakpoint == "Small")
    {
        enableAdaptiveUIMode = true;
        renderingMode = RowDirection.Vertical;
    }
    else if (activeBreakpoint == "Medium")
    {
        enableAdaptiveUIMode = true;
        renderingMode = RowDirection.Horizontal;
    }
    else
    {
        enableAdaptiveUIMode = false;
    }
}
@if (CanAccess)
{
    @if (CanView)
    {
        <div class="search-bar-container">
            <div class="search-bar-row">

                <SfTextBox @ref="RepairSearchBox"
                           Placeholder="Search by Report No, Company, Serial Number..."
                           ShowClearButton="true"
                           Width="400px"
                           @bind-Value="RepairSearchValue"
                           Input="OnRepairSearchInput">
                </SfTextBox>

                <SfButton Content="Search"
                          CssClass="e-btn e-primary"
                          IconCss="fas fa-search"
                          OnClick="PerformRepairSearch" />

                <SfButton Content="Clear"
                          CssClass="e-btn e-outline"
                          IconCss="fas fa-times"
                          OnClick="ClearRepairSearch" />
            </div>

            @if (!string.IsNullOrEmpty(RepairSearchValue))
            {
                <div class="search-hint">
                    <i class="fas fa-info-circle"></i>
                    Searching for: <strong>@RepairSearchValue</strong>
                </div>
            }
        </div>

        <SfGrid @ref="MyGrid"
                DataSource="@filteredRepairServices"
                AllowSorting="true"
                ShowColumnChooser="true"
                AllowExcelExport="true"
                AllowPdfExport="true"
                AllowResizing="true"
                AllowFiltering="true"
                Height="450"
                SelectionMode="GridSelectionMode.Single"
                Toolbar="@ToolbarItems"
                EnableAdaptiveUI="@enableAdaptiveUIMode"
                RowRenderingMode="@renderingMode"
                AllowSelection="true">
            <GridEvents TValue="RepairServices" RowSelected="RowSelectHandler" OnRecordDoubleClick="RowDoubleClickHandler"></GridEvents>
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
            <GridColumns>
                <GridColumn Field="Id" HeaderText="Id" Width="150" Format="d" Visible="false" />
                <GridColumn Field="reportNo" HeaderText="@Loc[nameof(ResourceStrings.Textref)]" Width="150" />
                <GridColumn Field="CompanyName" HeaderText="@Loc[nameof(ResourceStrings.TextCompanyName)]" CustomAttributes="@(new Dictionary<string, object>() { { "class", "e-attr" } })" Width="200" />
                <GridColumn Field="itemName" HeaderText="@Loc[nameof(ResourceStrings.TextItemName)]" Width="200" />
                <GridColumn Field="serialNumber" HeaderText="@Loc[nameof(ResourceStrings.TextSerialNumber)]" Width="200" />
                <GridColumn Field="CustomerRequest" HeaderText="@Loc[nameof(ResourceStrings.TextCustomerReq)]" Width="250" Visible="false" />
                <GridColumn Field="ServiceLocation" HeaderText="@Loc[nameof(ResourceStrings.TextServiceLocation)]" Width="200" />
                <GridColumn Field="Status" HeaderText="@Loc[nameof(ResourceStrings.TextStatus)]" Width="220">
                    <Template>
                                    @{
                var item = context as RepairServices;
                var currentStatus = item?.Status ?? "Sent Spareparts";

                string bgColor, textColor, borderColor;
                switch (currentStatus)
                {
                    case "Inspection":
                        bgColor = "#cce5ff"; textColor = "#004085"; borderColor = "#b8daff";
                        break;
                    case "Inspecting":
                        bgColor = "#d4edda"; textColor = "#155724"; borderColor = "#c3e6cb";
                        break;
                    case "Awaiting Sparepart":
                        bgColor = "#e2e3e5"; textColor = "#383d41"; borderColor = "#d6d8db";
                        break;
                    case "Awaiting Customer Confirm":
                        bgColor = "#d1ecf1"; textColor = "#0c5460"; borderColor = "#bee5eb";
                        break;
                    case "Sale Confirmed":
                        bgColor = "#d1ecf1"; textColor = "#0c5460"; borderColor = "#bee5eb";
                        break;
                    default: // Sent Spareparts
                        bgColor = "#fff3cd"; textColor = "#856404"; borderColor = "#ffeeba";
                        break;
                }
            }
                      <select class="status-select" style="background-color: @bgColor; color: @textColor; border: 1px solid @borderColor;"
        @key="@($"{item?.Id}_{currentStatus}")"
        @onchange="async (e) => await OnRepairStatusChanged(item, e.Value?.ToString())">
    <option value="Sent Spareparts" hidden
            selected="@(currentStatus == "Sent Spareparts")"
            style="background-color:#ffffff; color:#212529; font-size:12px;">
        បានបញ្ជូនគ្រឿងបន្លាស់
    </option>
    <option value="Inspection" hidden
            selected="@(currentStatus == "Inspection")"
            style="background-color:#ffffff; color:#212529; font-size:12px;">
        វិនិច្ឆ័យរួចរាល់
    </option>
    <option value="Sale Confirmed" hidden
            selected="@(currentStatus == "Sale Confirmed")"
            style="background-color:#ffffff; color:#212529; font-size:12px;">
        ជួសជុលបាន
    </option>
    <option value="Inspecting"
            selected="@(currentStatus == "Inspecting")"
            style="background-color:#ffffff; color:#212529; font-size:12px;">
        កែតម្រូវគ្រឿងបន្លាស់ម្ដងទៀត
    </option>
</select>
                    </Template>
                </GridColumn>
                <GridColumn Field="repairDate" HeaderText="@Loc[nameof(ResourceStrings.TextRepairDate)]" Width="150" Format="dd/MM/yyyy HH:mm tt" Visible="@HasRepairDate()" />
                <GridColumn Field="setSaleConfirmedBy" HeaderText="Confirmed By" Width="150">
                    <Template>
                        @{
                            var item = context as RepairServices;
                            var username = GetUserNameById(item.setSaleConfirmedBy);
                        }
                        @username
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@Loc[nameof(ResourceStrings.TextAction)]" IsFrozen="true" Freeze="FreezeDirection.Right" Width="200">
                    <Template>
                        @if ((context as RepairServices)?.repairDate == null)
                        {
                            <DxButton IconCssClass="fas fa-check"
                                      CssClass="icon-button danger"
                                      RenderStyle="ButtonRenderStyle.Primary"
                                      RenderStyleMode="ButtonRenderStyleMode.Text"
                                      Text="@Loc[nameof(ResourceStrings.TextApproved)]"
                                      @onclick="() => OnApplyButtonClick(context as RepairServices)" />
                            <DxButton IconCssClass="fas fa-eye"
                                      CssClass="icon-button info"
                                      RenderStyle="ButtonRenderStyle.Info"
                                      RenderStyleMode="ButtonRenderStyleMode.Text"
                                      Text="@Loc[nameof(ResourceStrings.TextView)]"
                                      @onclick="() => ShowRepairServiceDetails(context as RepairServices)" />
                        }
                        else
                        {
                            <DxButton IconCssClass="fas fa-eye"
                                      CssClass="icon-button info"
                                      RenderStyle="ButtonRenderStyle.Info"
                                      RenderStyleMode="ButtonRenderStyleMode.Text"
                                      Text="@Loc[nameof(ResourceStrings.TextView)]"
                                      @onclick="() => ShowRepairServiceDetails(context as RepairServices)" />
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
        <FooterPagination CurrentPage="currentPage"
                          TotalPages="totalPages"
                          TotalItems="totalItems"
                          PageSize="pageSize"
                          OnFirstPage="FirstPage"
                          OnPreviousPage="PreviousPage"
                          OnNextPage="NextPage"
                          OnLastPage="LastPage" />
        <SfDialog @ref="ConfirmationDialog"
                  IsModal="true"
                  Width="450px"
                  ShowCloseIcon="true"
                  Visible="@isConfirmationDialogVisible">
            <DialogTemplates>
                <Header>
                    <h2>@pageTitle</h2>
                    <p class="dialog-subtitle">
                        អាចសរសេរបន្ថែមបាន
                    </p>
                </Header>
                <Content>
                    @if (isProcessing)
                    {
                        <div class="loading-container">
                            <div class="spinner-border text-primary" role="status">
                                <span class="sr-only">Loading...</span>
                            </div>
                            <p class="mt-3">Processing repair item... Please wait.</p>
                        </div>
                    }
                    else
                    {
                        <p>@Loc[nameof(ResourceStrings.Textconfirmrepairdia)]</p>

                        <div style="margin-top: 12px;">
                            <label style="font-weight: 600; font-size: 13px; display:block; margin-bottom:4px;">
                                @Loc[nameof(ResourceStrings.TextInspection)]
                            </label>
                            <SfTextBox @bind-Value="editInspection"
                                       Multiline="true"
                                       CssClass="e-outline"
                                       Placeholder="Inspection"
                                       Rows="3">
                            </SfTextBox>
                        </div>

                        <div style="margin-top: 12px;">
                            <label style="font-weight: 600; font-size: 13px; display:block; margin-bottom:4px;">
                                @Loc[nameof(ResourceStrings.Textsolution)]
                            </label>
                            <SfTextBox @bind-Value="editSolution"
                                       Multiline="true"
                                       CssClass="e-outline"
                                       Placeholder="Solution"
                                       Rows="3">
                            </SfTextBox>
                        </div>
                    }
                </Content>
                <FooterTemplate>
                    <SfButton CssClass="e-btn custom-button"
                              @onclick="ConfirmCustomerConfirm"
                              Disabled="@isProcessing">
                        @(isProcessing ? "Processing..." : "Yes")
                    </SfButton>
                    <SfButton CssClass="e-btn e-danger"
                              @onclick="CancelConfirmationDialog"
                              Disabled="@isProcessing">
                        No
                    </SfButton>
                </FooterTemplate>
            </DialogTemplates>
        </SfDialog>

        <SfDialog @ref="DialogEdit" Target="#target" Width="600px" IsModal="true" ShowCloseIcon="true" @bind-Visible="@isViewDialogVisible">
            <DialogEvents OnOverlayModalClick="@OverlayClick"></DialogEvents>
            <DialogTemplates>
                <Header>@Loc[nameof(ResourceStrings.TextViewInfo)]</Header>
                <Content>
                    <div class="report-container">
                        <div class="report-body">
                            <table class="report-table">

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.reportNo))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.Textref)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.reportNo</td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.ServiceDate != default(DateTime))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextReceiveDate)]:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.ServiceDate.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var createdByUser = GetUserNameById(
                                                _selectedRepairService?.createby == Guid.Empty
                                                ? (Guid?)null
                                                : _selectedRepairService.createby);
                                            }
                                            @if (!string.IsNullOrEmpty(createdByUser) && createdByUser != "Unknown" && createdByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @createdByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.inspectDate.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextInspection)]:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.inspectDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var inspectByUser = GetUserNameById(_selectedRepairService?.inspectBy);
                                            }
                                            @if (!string.IsNullOrEmpty(inspectByUser) && inspectByUser != "Unknown" && inspectByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @inspectByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.awaitingSparepartDate.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.Textwaitsparepart)]:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.awaitingSparepartDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var setByUser = GetUserNameById(_selectedRepairService?.setAwaitingSparepartBy);
                                            }
                                            @if (!string.IsNullOrEmpty(setByUser) && setByUser != "Unknown" && setByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @setByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.awaitingCustomerConfirmDate.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextawaitingCustomerConfirmDate)]:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.awaitingCustomerConfirmDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var confirmByUser = GetUserNameById(_selectedRepairService?.setAwaitingCustomerConfirmBy);
                                            }
                                            @if (!string.IsNullOrEmpty(confirmByUser) && confirmByUser != "Unknown" && confirmByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @confirmByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.repairDate.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextRepairDate)]:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.repairDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var repairByUser = GetUserNameById(_selectedRepairService?.repairBy);
                                            }
                                            @if (!string.IsNullOrEmpty(repairByUser) && repairByUser != "Unknown" && repairByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @repairByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.thirdPartyRepairDate.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>Third-party date:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.thirdPartyRepairDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var thirdPartyByUser = GetUserNameById(_selectedRepairService?.thirdPartyRepairBy);
                                            }
                                            @if (!string.IsNullOrEmpty(thirdPartyByUser) && thirdPartyByUser != "Unknown" && thirdPartyByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @thirdPartyByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.finishedDate.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextFinishDate)]:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.finishedDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var verifiedByUser = GetUserNameById(_selectedRepairService?.verifiedBy);
                                            }
                                            @if (!string.IsNullOrEmpty(verifiedByUser) && verifiedByUser != "Unknown" && verifiedByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @verifiedByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.saleConfirmedDate.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>Sale confirmed date:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.saleConfirmedDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var saleConfirmedByUser = GetUserNameById(_selectedRepairService?.setSaleConfirmedBy);
                                            }
                                            @if (!string.IsNullOrEmpty(saleConfirmedByUser) && saleConfirmedByUser != "Unknown" && saleConfirmedByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @saleConfirmedByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.customerRejectedDate.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextCustomerReject)]:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.customerRejectedDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var rejectedByUser = GetUserNameById(_selectedRepairService?.setCustomerRejectedBy);
                                            }
                                            @if (!string.IsNullOrEmpty(rejectedByUser) && rejectedByUser != "Unknown" && rejectedByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @rejectedByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.unrepairableDate.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextUnrepairable)]:</strong></td>
                                        <td class="report-value">
                                            @_selectedRepairService.unrepairableDate.Value.ToString("yyyy-MM-dd HH:mm tt")
                                            @{
                                                var unrepairableByUser = GetUserNameById(_selectedRepairService?.setUnrepairableBy);
                                            }
                                            @if (!string.IsNullOrEmpty(unrepairableByUser) && unrepairableByUser != "Unknown" && unrepairableByUser != "Unknown User")
                                            {
                                                <span style="color: var(--text-secondary); margin-left: 8px;">| @unrepairableByUser</span>
                                            }
                                        </td>
                                    </tr>
                                }

                                @if (_selectedRepairService?.DaysTaken.HasValue == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>Days taken:</strong></td>
                                        <td class="report-value">@_selectedRepairService.DaysTaken.Value days</td>
                                    </tr>
                                }

                                <tr><td colspan="2"><hr style="margin: 6px 0;" /></td></tr>

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.CompanyName))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextCompanyName)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.CompanyName</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.Address))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextAddress)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.Address</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.ContactName))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextContactName)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.ContactName</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.PhoneNumber))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextPhoneNumber)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.PhoneNumber</td>
                                    </tr>
                                }

                                <tr><td colspan="2"><hr style="margin: 6px 0;" /></td></tr>

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.itemName))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextItemName)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.itemName</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.serialNumber))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextSerialNumber)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.serialNumber</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.CustomerRequest))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextCustomerReq)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.CustomerRequest</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.Inspection))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextInspection)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.Inspection</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.Solution))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.Textsolution)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.Solution</td>
                                    </tr>
                                }

                                <tr><td colspan="2"><hr style="margin: 6px 0;" /></td></tr>

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.ServiceLocation))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextServiceLocation)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.ServiceLocation</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.ServiceType))
                                {
                                    <tr>
                                        <td class="report-label"><strong>Service type:</strong></td>
                                        <td class="report-value">@_selectedRepairService.ServiceType</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.ServicePriority))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextPriority)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.ServicePriority</td>
                                    </tr>
                                }

                                @if (!string.IsNullOrEmpty(_selectedRepairService?.Status))
                                {
                                    <tr>
                                        <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextStatus)]:</strong></td>
                                        <td class="report-value">@_selectedRepairService.Status</td>
                                    </tr>
                                }

                                <tr>
                                    <td class="report-label"><strong>@Loc[nameof(ResourceStrings.TextContract)]:</strong></td>
                                    <td class="report-value">@(_selectedRepairService?.hasContract == true ? "Yes" : "No")</td>
                                </tr>

                                @if (_selectedRepairService?.isThirdPartyRepair == true)
                                {
                                    <tr>
                                        <td class="report-label"><strong>Third-party repair:</strong></td>
                                        <td class="report-value">Yes</td>
                                    </tr>
                                }

                            </table>

