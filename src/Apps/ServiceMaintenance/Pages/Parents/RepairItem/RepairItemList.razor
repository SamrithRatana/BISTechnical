    private int totalItems = 0;
    private Dictionary<string, string> _allUsers = new Dictionary<string, string>();
    private bool _usersLoaded = false;

    private SfTextBox RepairSearchBox;
    private string RepairSearchValue { get; set; }
    private System.Threading.Timer _repairSearchDebounceTimer;

    // ✅ NEW — the two statuses this page now combines into one grid.
   // ✅ NEW — the three statuses this page now combines into one grid.
private static readonly string[] StatusesShownOnThisPage = new[]
{
    "Sent Spareparts",
    "Inspection",
    "Sale Confirmed",
};
    private static string GetTelegramTopicKeyForStatus(string status) => status switch
    {
        "Sent Spareparts" => "SentSpareparts",
        "Inspection" => "Inspection",
        "Sale Confirmed" => "SaleConfirmed",
        "Awaiting Sparepart" => "AwaitingSparepart",
        "Awaiting Customer Confirm" => "AwaitingCustomerConfirm",
        "Inspecting" => "Inspecting",
        "Customer Rejected" => "CustomerRejected",
        "Unrepairable" => "Unrepairable",
        "Item Recieved" => "ItemReceived",
        _ => status?.Replace(" ", "") ?? string.Empty,
    };
    protected override async Task OnInitializedAsync()
{
    await base.OnInitializedAsync();
    try
    {
        await LoadAllUsersAsync();

        // Load initial page data
        await LoadPageData();
        var sparePartsResult = await SparePartService.GetSparePartsPagedAsync(pageNumber: 1, pageSize: 100);
        _spareParts = sparePartsResult.Items;
        // Load other necessary data
        _serviceStatuses = await RepairItemService.GetServiceStatusesAsync();
    }
    catch (Exception ex)
    {
        Console.Error.WriteLine($"Error loading data: {ex.Message}");
    }

    // Extract ReportNo from the route
    var routeData = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Split('/');
    string ReportNoFromRoute = routeData.Length > 1 ? routeData[1] : null;

    if (!string.IsNullOrEmpty(ReportNoFromRoute))
    {
        var result = await RepairItemService.SearchRepairServicesAsync(
            pageNumber: 1,
            pageSize: 10,
            searchTerm: ReportNoFromRoute
        );
        filteredRepairServices = result.Items;

        var selectedService = filteredRepairServices.FirstOrDefault();
        if (selectedService != null)
        {
                await OnApplyButtonClick(selectedService);   // ✅ បន្ថែម await
            }
    }

    // SignalR setup
    hubConnection = new HubConnectionBuilder()
        .WithUrl(NavigationManager.ToAbsoluteUri("/itemHub"))
        .Build();

 hubConnection.On<ItemUpdateMessage>("ReceiveItemUpdate", async (msg) =>
{
    var affected = msg?.AffectedStatuses ?? Array.Empty<string>();

    foreach (var status in affected)
        await Cache.InvalidateByPrefixAsync(GetPrefixForStatus(status));

    await Cache.InvalidateAsync(CacheKeys.DashboardStats);

    bool relevantToThisPage = affected.Any(s => StatusesShownOnThisPage.Contains(s));
    if (relevantToThisPage)
        await LoadPageData();

    await InvokeAsync(StateHasChanged);
});

    hubConnection.On<Guid>("BroadcastItemDelete", (deletedItemId) =>
    {
        filteredRepairServices = filteredRepairServices.Where(item => item.Id != deletedItemId).ToList();
        totalItems--;
        InvokeAsync(StateHasChanged);
    });

    await hubConnection.StartAsync();

    hubConnection.Closed += async (error) =>
    {
        await Task.Delay(new Random().Next(0, 5) * 1000);
        try
        {
            await hubConnection.StartAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Reconnection failed: {ex.Message}");
        }
    };
}
    private async Task LoadAllUsersAsync()
    {
        if (_usersLoaded)
            return;

        try
        {
            _allUsers = await GlobalUserCache.GetUsersAsync();
            _usersLoaded = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading users: {ex.Message}");
            _allUsers = new Dictionary<string, string>();
        }
    }
    // ✅ NEW — local mapping since this page never had a GetPrefixForTab helper
private static string GetPrefixForStatus(string status) => status switch
{
    "Inspection" => CacheKeys.PrefixInspectionItem,
    "Sent Spareparts" => CacheKeys.PrefixSentSpareparts,
    "Sale Confirmed" => CacheKeys.PrefixSaleConfirmed,
    "Awaiting Sparepart" => CacheKeys.PrefixAwaitSparePart,
    "Awaiting Customer Confirm" => CacheKeys.PrefixAwaitCustomer,
    "Inspecting" => CacheKeys.PrefixInspectItem,
    "Customer Rejected" => CacheKeys.PrefixCustomerReject,
    "Unrepairable" => CacheKeys.PrefixUnRepairable,
    _ => CacheKeys.PrefixSentSpareparts,
};
    // ✅ NEW — each status this page combines has its own dedicated cache key
    // builder (CacheKeys already ships InspectionItem and SentSpareparts). Using
    // one shared key for both statuses would make the second fetch overwrite
    // the first's cached entry.
   private static string GetCacheKeyForStatus(string status, int page, int size) => status switch
{
    "Inspection" => CacheKeys.InspectionItem(page, size),
    "Sale Confirmed" => CacheKeys.SaleConfirmed(page, size),
    _ => CacheKeys.SentSpareparts(page, size),
};

   private async Task OnRepairStatusChanged(RepairServices item, string newStatus)
{
    if (item == null || string.IsNullOrEmpty(newStatus) || newStatus == item.Status)
        return;

    string previousStatus = item.Status;

    if (newStatus == "Inspecting")
    {
        try
        {
            await RepairItemService.MoveBackToInspectingAsync(item.Id);

            // ✅ CHANGED — only the prefix the item is leaving (its previous
            // status, either "Sent Spareparts" or "Inspection") + "Inspecting"
            // (where it's going, served by inspect-item.razor) need clearing.
            await Cache.InvalidateByPrefixAsync(GetPrefixForStatus(previousStatus));
            await Cache.InvalidateByPrefixAsync(CacheKeys.PrefixInspectItem);
            await Cache.InvalidateAsync(CacheKeys.DashboardStats);

            // ✅ NEW — this broadcast was missing entirely before. Without it,
            // other open tabs never learned this item moved to "Inspecting".
            if (hubConnection?.State == HubConnectionState.Connected)
                await hubConnection.SendAsync("BroadcastItemUpdate", new ItemUpdateMessage
                {
                    AffectedStatuses = new[] { previousStatus, "Inspecting" }
                });

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Customization",
                Title = "សម្រេច",
                Text = $"{item.reportNo} → កែតម្រូវគ្រឿងបន្លាស់ម្ដងទៀត",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Success
            });

            await LoadPageData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            item.Status = previousStatus;
            StateHasChanged();

            ToastNotificationService.ShowToast(new ToastOptions
            {
                ProviderName = "Error",
                Title = "Error",
                Text = $"Failed: {ex.Message}",
                ThemeMode = ToastThemeMode.Pastel,
                RenderStyle = ToastRenderStyle.Danger
            });
        }
    }
}

    private async Task LoadPageData()
    {
        try
        {
            // ✅ CHANGED — now fetches BOTH "Sent Spareparts" and "Inspection"
            // and merges them into one grid, each under its own cache key.
            var tasks = StatusesShownOnThisPage.Select(status =>
                Cache.GetOrSetAsync(
                    GetCacheKeyForStatus(status, currentPage, pageSize),
                    () => RepairItemService.SearchRepairServicesAsync(
                        pageNumber: currentPage,
                        pageSize: pageSize,
                        status: status,
                        sortBy: "reportNo",
                        sortDescending: true),
                    TimeSpan.FromMinutes(3)
                )
            ).ToList();

            var results = await Task.WhenAll(tasks);

            var allResults = new List<RepairServices>();
            int combinedTotalCount = 0;

            foreach (var result in results)
            {
                if (result?.Items != null && result.Items.Any())
                {
                    allResults.AddRange(result.Items);
                    combinedTotalCount += result.TotalCount;
                }
            }

            filteredRepairServices = allResults
                .GroupBy(x => x.Id)
                .Select(g => g.First())
                .OrderByDescending(x => x.reportNo)
                .ToList();

            totalItems = combinedTotalCount;
            totalPages = totalItems > 0 ? (int)Math.Ceiling(totalItems / (double)pageSize) : 0;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading page data: {ex.Message}");
        }
    }
    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadPageData();
        StateHasChanged();
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadPageData();
            StateHasChanged();
        }
    }

    private async Task PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadPageData();
            StateHasChanged();
        }
    }

    private async Task FirstPage()
    {
        currentPage = 1;
        await LoadPageData();
        StateHasChanged();
    }

    private async Task LastPage()
    {
        currentPage = totalPages;
        await LoadPageData();
        StateHasChanged();
    }


    private string GetUserNameById(Guid? userId)
    {
        if (!userId.HasValue || userId.Value == Guid.Empty)
            return "Unknown";

        string userIdString = userId.Value.ToString();

        if (!_usersLoaded)
            return "Loading...";

        if (_allUsers.TryGetValue(userIdString, out string username))
            return username;

        return "Unknown User";
