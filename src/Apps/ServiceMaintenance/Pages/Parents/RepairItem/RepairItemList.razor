                                                        }
                                                        else
                                                        {
                                                            <span style="color:#aaa;">—</span>
                                                        }
                                                    </td>
                                                    <td style="padding:5px 4px; text-align:center; vertical-align:middle;">
                                                        <span class="stock-status-badge"
                                                              style="background:@stockBg; color:@stockFg;
                                                                                    padding:2px 8px; border-radius:8px; font-size:0.7rem;
                                                                                    font-weight:700; white-space:nowrap; display:inline-block;
                                                                                    position:relative; cursor:default;">
                                                            @stockLabel
                                                            <span class="stock-qty-tooltip">@stockQty in stock</span>
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        <tfoot>
                                            <tr style="background:#f8f9fa; font-weight:700; border-top:2px solid #dee2e6;">
                                                <td colspan="3" style="padding:6px 8px; text-align:right; color:#555; font-size:0.8rem;">Total:</td>
                                                <td style="padding:6px 4px; text-align:center;">
