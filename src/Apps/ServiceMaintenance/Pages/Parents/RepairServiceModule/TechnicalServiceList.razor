    private async Task SaveRemarks(SparePartItem sparePart, string newValue)
    {
        try
        {
            var success = await SparePartService.UpdateSparepartItemRemarksAsync(sparePart.Id, newValue);

            if (success)
            {
                sparePart.Remarks = newValue;
                sparePart.RemarksUpdatedAt = DateTime.Now;

                pageCache.Clear();

                if (hubConnection?.State == HubConnectionState.Connected)
                    await hubConnection.SendAsync("BroadcastItemUpdate", "ItemUpdated");

                ShowSuccessToast("Remark updated");
            }
            else
            {
                ShowErrorToast("Failed to save remark");
            }
        }
        catch (Exception ex)
        {
            ShowErrorToast($"Failed: {ex.Message}");
        }

        StateHasChanged();
    }
