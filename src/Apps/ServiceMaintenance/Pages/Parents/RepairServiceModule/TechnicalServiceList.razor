    private async Task OnPageSizeChange(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newPageSize))
        {
            pageSize = newPageSize;
            currentPage = 1;
            pageCache.Clear();
            await LoadPageAsync(1, useCache: false);
        }
    }

    private void OnSearchInput(InputEventArgs args)
    {
        searchDebounceTimer?.Dispose();

        // ✅ ADDED — when the user clears the search box entirely, reload the
        // unfiltered list immediately instead of waiting on debounce+PerformSearch,
        // matching the pattern used on the other list pages (await-sparepart,
        // inspection-list, etc.).
        if (string.IsNullOrWhiteSpace(args.Value))
        {
            searchText = string.Empty;
            _ = InvokeAsync(async () =>
            {
                currentPage = 1;
                await LoadPageAsync(1, useCache: false);
                StateHasChanged();
            });
            return;
        }

        searchText = args.Value;

        searchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () => await PerformSearch());
        }, null, 500, System.Threading.Timeout.Infinite);
    }

    private async Task PerformSearch()
    {
        try
        {
            currentPage = 1;
            pageCache.Clear();
            await LoadPageAsync(1, useCache: false);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"⚠ {ex.Message} not found");
        }
    }

