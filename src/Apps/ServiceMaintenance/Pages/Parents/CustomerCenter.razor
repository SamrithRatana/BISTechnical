@page "/customer-center"
@using System.Linq
@using System.Threading
@using ServiceMaintenance.Models
@using ServiceMaintenance.Services.BISServices
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Navigations
@inject CustomerService CustomerService
@inherits PermissionBase
@implements IAsyncDisposable

@* ══════════════════════════════════════════════════════════════════
   Customer Center — manage Customers and Customer Types in one place.

   PAGINATION (replaces the earlier infinite-scroll approach):
   - Fixed page size (CustomerPageSize constant), shared by BOTH the
     Customers tab's manual Prev/Next pager AND the Customer Types
     tab's pager — one constant, one page size everywhere.
   - Both tabs now drive the SAME shared <FooterPagination> component
     (portaled into the app footer via <FooterPortal>). Only one tab
     is active at a time, so only one instance renders, wired to that
     tab's own page-number/total-pages state.
   - Customers: pagination is SERVER-SIDE — each page load re-fetches
     from the API and REPLACES Customers (see LoadCustomersAsync).
   - Customer Types: pagination is CLIENT-SIDE — all types are loaded
     up front once (GetAllCustomerTypesAsync loops every API page),
     then search-filtered and page-sliced in memory (see
     RefreshDisplayedCustomerTypes / UpdateCustomerTypesPageSlice).
     No extra API calls happen when paging through Customer Types.

   MULTI-SELECT BULK CUSTOMER TYPE ASSIGNMENT (Customers tab):
   - Checkbox column + GridSelectionSettings enables multi-row select.
   - Selected row IDs tracked in SelectedCustomerIds (HashSet<Guid>).
   - A bulk-action bar appears above the grid once >=1 row is selected,
     letting the user pick a Customer Type and apply it to every
     selected row in ONE API call (CustomerService.BulkAssignCustomerTypeAsync
     -> PUT /api/Customer/bulk-assign-type), rather than looping
     UpdateCustomerAsync per row.
   - Because Customers is SERVER-paginated, selection is cleared on
     every page/search/filter reload — it does not persist "across
     pages" (there is no cross-page selection tracking here by design).

   LIFECYCLE:
   - _cts.Token is passed into CustomerService so navigating away
     cancels the in-flight HTTP request, not just the component's
     reaction to it.
   - A per-load generation counter (_loadGeneration) discards a stale
     request's result if a newer one (e.g. user clicked Next twice
     fast, or changed the search mid-request) has since started.
   ══════════════════════════════════════════════════════════════════ *@

@if (CanAccess)
{
    <div class="customer-center-page" style="display:flex; flex-direction:column; height:100%; padding:16px; gap:12px;">

        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <h4 style="margin:0; font-weight:700;">
                    <i class="fas fa-address-book" style="margin-right:8px; color:#007bff;"></i>
                    Customer Center
                </h4>
                <div style="font-size:0.85rem; color:#777;">Manage customers and customer types.</div>
            </div>
        </div>

        @* ── Tab switcher ─────────────────────────────────────── *@
        <StatusTabMenu Tabs="@TabItems"
                       ActiveTabKey="@ActiveTab"
                       ActiveTabKeyChanged="@((string key) => ActiveTab = key)"
                       OnTabChanged="@((string key) => SwitchTab(key))" />

        @* ── Status banner ────────────────────────────────────────── *@
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <div class="alert @(IsStatusError ? "alert-danger" : "alert-success") py-2 mb-0"
                 style="display:flex; justify-content:space-between; align-items:center;">
                <span>@StatusMessage</span>
                <button class="btn-close" style="background:none;border:none;cursor:pointer;" @onclick="() => StatusMessage = null">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        }

        @if (ActiveTab == "customers")
        {
            @* ══════════════════════════════════════════════════════
               CUSTOMERS TAB
               ══════════════════════════════════════════════════════ *@
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <div style="position:relative; min-width:260px;">
                    <input type="text"
                           class="form-control"
                           placeholder="Search company, contact, phone..."
                           @bind="CustomerSearchTerm"
                           @bind:event="oninput"
                           @bind:after="OnCustomerSearchChanged" />
                </div>
                <button class="btn btn-outline-secondary" @onclick="() => LoadCustomersAsync(resetPaging: true)">
                    <i class="fas fa-search"></i> Search
                </button>

                <select class="form-control" style="width:150px;" @bind="ActiveFilterText" @bind:after="() => LoadCustomersAsync(resetPaging: true)">
                    <option value="all">All Statuses</option>
                    <option value="active">Active Only</option>
                    <option value="inactive">Inactive Only</option>
                </select>

                @* ── Find customers with no Customer Type set ──────────
                   Filters only within the currently loaded page, since
                   there's no "Load All" anymore under standard paging. *@
                <div class="form-check" style="display:flex; align-items:center; gap:6px; white-space:nowrap;">
                    <input class="form-check-input" type="checkbox" id="missingTypeOnly"
                           @bind="ShowMissingTypeOnly" @bind:after="() => LoadCustomersAsync(resetPaging: true)" style="margin:0;" />
                    <label class="form-check-label" for="missingTypeOnly" style="margin:0; cursor:pointer;">
                        Missing Type Only
                        @if (ShowMissingTypeOnly)
                        {
                            <span class="text-muted">(@TotalCustomerRecords found)</span>
                        }
                    </label>
                </div>

                <div style="flex:1"></div>
            </div>

            @* ── Bulk Customer Type assignment bar — shown once >=1 row selected ── *@
            @if (SelectedCustomerIds.Count > 0)
            {
                <div class="alert alert-secondary py-2 mb-0" style="display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
                    <span><strong>@SelectedCustomerIds.Count</strong> selected</span>

                    <label class="mb-0" style="white-space:nowrap;">Set Customer Type:</label>
                    <select class="form-control" style="width:220px;" @bind="BulkCustomerTypeListId" disabled="@IsBulkUpdating">
                        <option value="">-- Select --</option>
                        @foreach (var type in CustomerTypes)
                        {
                            <option value="@type.ListId">@type.Type</option>
                        }
                    </select>

                    <button class="btn btn-sm btn-primary" disabled="@(IsBulkUpdating || string.IsNullOrEmpty(BulkCustomerTypeListId))"
                            @onclick="BulkAssignCustomerTypeAsync">
                        <i class="fas fa-check"></i> Apply to Selected
                    </button>

                    @if (IsBulkUpdating)
                    {
                        <span class="text-muted"><i class="fas fa-spinner fa-spin"></i> Working...</span>
                    }

                    <div style="flex:1"></div>
                    <button class="btn btn-sm btn-link" @onclick="ClearCustomerSelectionAsync" disabled="@IsBulkUpdating">
                        Clear selection
                    </button>
                </div>
            }

            @if (IsLoadingCustomers)
            {
                <div class="alert alert-info">Loading customers...</div>
            }
            else
            {
                <div style="flex:1; overflow:auto;">
                    <SfGrid @ref="CustomerGridRef"
                            TValue="Customer"
                            DataSource="@DisplayedCustomers"
                            AllowPaging="false"
                            AllowSorting="true"
                            AllowFiltering="false"
                            Toolbar="@CustomerToolbarItems">
                        <GridEvents TValue="Customer"
                                    OnActionBegin="OnCustomerActionBegin"
                                    RowDataBound="OnCustomerRowDataBound"
                                    RowSelected="OnCustomerRowSelected"
                                    RowDeselected="OnCustomerRowDeselected"
                                    RowDeselecting="OnCustomerRowDeselecting"></GridEvents>
                        <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple"
                                               Mode="Syncfusion.Blazor.Grids.SelectionMode.Row"
                                               CheckboxOnly="true"
                                               PersistSelection="true">
                        </GridSelectionSettings>
                        <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true"
                                          Mode="EditMode.Dialog" ShowDeleteConfirmDialog="true"></GridEditSettings>
                        <GridColumns>
                            <GridColumn Type="Syncfusion.Blazor.Grids.ColumnType.CheckBox" Width="45"></GridColumn>
                            <GridColumn Field=@nameof(Customer.Id) IsPrimaryKey="true" Visible="false"></GridColumn>
                            <GridColumn Field=@nameof(Customer.CompanyName) HeaderText="Company Name" Width="200"
                                        ValidationRules="@(new ValidationRules { Required = true })"></GridColumn>
                            <GridColumn Field=@nameof(Customer.ContactName) HeaderText="Contact" Width="150"></GridColumn>
                            <GridColumn Field=@nameof(Customer.PhoneNumber) HeaderText="Phone" Width="130"></GridColumn>
                            <GridColumn Field=@nameof(Customer.Email) HeaderText="Email" Width="180"></GridColumn>
                            <GridColumn Field=@nameof(Customer.Address) HeaderText="Address" Width="200"></GridColumn>

                            <GridForeignColumn TValue="CustomerService.CustomerTypeDto"
                                               Field=@nameof(Customer.CustomerTypeListId)
                                               HeaderText="Customer Type"
                                               Width="150"
                                               ForeignKeyField="ListId"
                                               ForeignKeyValue="Type"
                                               ForeignDataSource="@CustomerTypes"
                                               EditType="EditType.DropDownEdit">
                            </GridForeignColumn>

                            <GridColumn Field=@nameof(Customer.IsActive) HeaderText="Active" Width="90"
                                        EditType="EditType.BooleanEdit" DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center"></GridColumn>

                            <GridColumn Field=@nameof(Customer.CreatedAt) HeaderText="Created" Width="120"
                                        AllowEditing="false" Format="dd/MM/yyyy" Type="ColumnType.Date"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>

                @* ── Pagination renders in the shared app footer via
                     FooterPortal — see FooterPagination.razor. Only mounted
                     while THIS tab is active. ── *@
                <FooterPagination CurrentPage="CustomerPageNumber"
                                  TotalPages="TotalCustomerPages"
                                  TotalItems="TotalCustomerRecords"
                                  PageSize="CustomerPageSize"
                                  OnFirstPage="GoToFirstPageAsync"
                                  OnPreviousPage="GoToPreviousPageAsync"
                                  OnNextPage="GoToNextPageAsync"
                                  OnLastPage="GoToLastPageAsync" />
            }
        }
        else
        {
            @* ══════════════════════════════════════════════════════
               CUSTOMER TYPES TAB
               ══════════════════════════════════════════════════════ *@
            <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap;">
                <div style="position:relative; min-width:260px;">
                    <input type="text"
                           class="form-control"
                           placeholder="Search type, description..."
                           @bind="CustomerTypeSearchTerm"
                           @bind:event="oninput"
                           @bind:after="() => RefreshDisplayedCustomerTypes(resetPaging: true)" />
                </div>
                <button class="btn btn-outline-secondary" @onclick="() => RefreshDisplayedCustomerTypes(resetPaging: true)">
                    <i class="fas fa-search"></i> Search
                </button>
                @if (!string.IsNullOrWhiteSpace(CustomerTypeSearchTerm))
                {
                    <span class="text-muted">(@FilteredCustomerTypes.Count found)</span>
                    <button class="btn btn-link btn-sm" @onclick="ClearCustomerTypeSearch">
                        <i class="fas fa-times"></i> Clear
                    </button>
                }

                <div style="flex:1"></div>

                <button class="btn btn-outline-secondary btn-sm" @onclick="() => LoadCustomerTypesAsync(forceRefresh: true)">
                    <i class="fas fa-sync-alt"></i> Refresh
                </button>
            </div>

            @if (IsLoadingTypes && CustomerTypes.Count == 0)
            {
                <div class="alert alert-info">Loading customer types...</div>
            }
            else
            {
                <div style="flex:1; overflow:auto;">
                    <SfGrid @ref="CustomerTypeGridRef"
                            TValue="CustomerService.CustomerTypeDto"
                            DataSource="@DisplayedCustomerTypes"
                            AllowPaging="false"
                            AllowSorting="true"
                            Toolbar="@CustomerTypeToolbarItems">
                        <GridEvents TValue="CustomerService.CustomerTypeDto" OnActionBegin="OnCustomerTypeActionBegin"></GridEvents>
                        <GridEditSettings AllowAdding="true" AllowEditing="true" AllowDeleting="true"
                                          Mode="EditMode.Dialog" ShowDeleteConfirmDialog="true"></GridEditSettings>
                        <GridColumns>
                            <GridColumn Field=@nameof(CustomerService.CustomerTypeDto.ListId) IsPrimaryKey="true" Visible="false"></GridColumn>
                            <GridColumn Field=@nameof(CustomerService.CustomerTypeDto.Type) HeaderText="Type" Width="180"
                                        ValidationRules="@(new ValidationRules { Required = true })"></GridColumn>
                            <GridColumn Field=@nameof(CustomerService.CustomerTypeDto.Description) HeaderText="Description" Width="260"></GridColumn>
                            <GridColumn Field=@nameof(CustomerService.CustomerTypeDto.IsActive) HeaderText="Active" Width="90"
                                        EditType="EditType.BooleanEdit" DisplayAsCheckBox="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center"></GridColumn>
                            <GridColumn Field=@nameof(CustomerService.CustomerTypeDto.CreatedAt) HeaderText="Created" Width="120"
                                        AllowEditing="false" Format="dd/MM/yyyy" Type="ColumnType.Date"></GridColumn>
                        </GridColumns>
                    </SfGrid>
                </div>

                @* ── Same shared footer pager as Customers, but paginating
                     the in-memory filtered list — no API calls on page
                     change. ── *@
                <FooterPagination CurrentPage="CustomerTypePageNumber"
                                  TotalPages="TotalCustomerTypePages"
                                  TotalItems="FilteredCustomerTypes.Count"
                                  PageSize="CustomerPageSize"
                                  OnFirstPage="GoToFirstCustomerTypePageAsync"
                                  OnPreviousPage="GoToPreviousCustomerTypePageAsync"
                                  OnNextPage="GoToNextCustomerTypePageAsync"
                                  OnLastPage="GoToLastCustomerTypePageAsync" />
            }
        }
    </div>
}
else if (PermissionsLoaded)
{
    <div class="alert alert-danger m-3">You don't have permission to access Customer Center.</div>
}


@code {
    private List<object> CustomerToolbarItems = new List<object>
    {
        new ItemModel { Text = "Add", Id = "Add", Disabled = true },
        new ItemModel { Text = "Edit", Id = "Edit", Disabled = false },
        new ItemModel { Text = "Delete", Id = "Delete", Disabled = true },
        new ItemModel { Text = "Update", Id = "Update", Disabled = true },
        new ItemModel { Text = "Cancel", Id = "Cancel", Disabled = true }
    };

    private List<object> CustomerTypeToolbarItems = new List<object>
    {
        new ItemModel { Text = "Add", Id = "Add", Disabled = true },
        new ItemModel { Text = "Edit", Id = "Edit", Disabled = true },
        new ItemModel { Text = "Delete", Id = "Delete", Disabled = true },
        new ItemModel { Text = "Update", Id = "Update", Disabled = true },
        new ItemModel { Text = "Cancel", Id = "Cancel", Disabled = true }
    };
    // ── Lifecycle / cancellation ────────────────────────────────────
    private readonly CancellationTokenSource _cts = new();
    private bool _disposed;

    // ── Tab state ──────────────────────────────────────────────────
    private string ActiveTab = "customers";
    private List<StatusTabMenu.TabItem> TabItems = new();

    private void RefreshTabItems()
    {
        TabItems = new()
        {
            new StatusTabMenu.TabItem { Key = "customers", Label = "Customers", Count = TotalCustomerRecords },
            new StatusTabMenu.TabItem { Key = "types", Label = "Customer Types", Count = CustomerTypes.Count }
        };
    }

    private void SwitchTab(string tab)
    {
        ActiveTab = tab;
        StatusMessage = null;
    }

    // ── Status banner ─────────────────────────────────────────────
    private string StatusMessage;
    private bool IsStatusError;

    private void ShowStatus(string message, bool isError)
    {
        if (_disposed) return;
        StatusMessage = message;
        IsStatusError = isError;
        SafeStateHasChanged();
    }

    // ── Customers state ──────────────────────────────────────────
    private SfGrid<Customer> CustomerGridRef;
    private List<Customer> Customers = new();
    private string CustomerSearchTerm = string.Empty;
    private string ActiveFilterText = "active"; // "all" | "active" | "inactive"
    private bool? ActiveFilterValue =>
        ActiveFilterText == "active" ? true :
        ActiveFilterText == "inactive" ? false :
        (bool?)null;

    private int CustomerPageNumber = 1;
    private const int CustomerPageSize = 13; // rows per page — change this single constant to adjust page size everywhere (drives both tabs' footer pagers)
    private int TotalCustomerRecords = 0;
    private int TotalCustomerPages = 0;
    private bool IsLoadingCustomers = false;

    private bool CanGoPrevious => CustomerPageNumber > 1;
    private bool CanGoNext => CustomerPageNumber < TotalCustomerPages;

    // Guards against applying a stale response if the user clicks
    // Next/Prev/Search again before an earlier request finishes.
    private int _loadGeneration = 0;

    // Debounce for live-as-you-type search (Customers hits the server,
    // unlike Customer Types which filters an already-loaded list in
    // memory — so we wait for a short pause in typing before firing
    // the API call, instead of searching on every keystroke).
    private CancellationTokenSource _searchDebounceCts;
    private const int SearchDebounceMs = 400;

    private async Task OnCustomerSearchChanged()
    {
        _searchDebounceCts?.Cancel();
        _searchDebounceCts?.Dispose();
        _searchDebounceCts = new CancellationTokenSource();
        var token = _searchDebounceCts.Token;

        try
        {
            await Task.Delay(SearchDebounceMs, token);
            if (!token.IsCancellationRequested && !_disposed)
                await LoadCustomersAsync(resetPaging: true);
        }
        catch (TaskCanceledException)
        {
            // Superseded by a newer keystroke — expected, ignore.
        }
    }

    // ── Find customers missing a Customer Type ────────────────────
    private bool ShowMissingTypeOnly = false;
    private List<Customer> DisplayedCustomers = new();
    private int MissingTypeCount = 0;

    private void RefreshDisplayedCustomers()
    {
        DisplayedCustomers = Customers;
    }

    // ── Customers: multi-select / bulk Customer Type assignment ───
    // Tracked by Id (not object refs) since Customers/DisplayedCustomers
    // is replaced wholesale on every page load (server-side paging).
    private HashSet<Guid> SelectedCustomerIds = new();
    private string BulkCustomerTypeListId = string.Empty;
    private bool IsBulkUpdating = false;

    private void OnCustomerRowSelected(RowSelectEventArgs<Customer> args)
    {
        if (args.Data != null)
            SelectedCustomerIds.Add(args.Data.Id);
    }

    private void OnCustomerRowDeselected(RowDeselectEventArgs<Customer> args)
    {
        if (args.Data != null)
            SelectedCustomerIds.Remove(args.Data.Id);
    }

    // Prevents an in-flight bulk update from losing selection state
    // if a deselect event fires mid-operation (e.g. grid refresh).
    private void OnCustomerRowDeselecting(RowDeselectEventArgs<Customer> args)
    {
        if (IsBulkUpdating)
            args.Cancel = true;
    }

    private async Task ClearCustomerSelectionAsync()
    {
        SelectedCustomerIds.Clear();
        BulkCustomerTypeListId = string.Empty;
        if (CustomerGridRef != null)
            await CustomerGridRef.ClearSelectionAsync();
        SafeStateHasChanged();
    }

    // Calls the single bulk-assign API endpoint (PUT /api/Customer/bulk-assign-type)
    // instead of looping UpdateCustomerAsync per selected row.
    private async Task BulkAssignCustomerTypeAsync()
    {
        if (_disposed || SelectedCustomerIds.Count == 0) return;
        if (!int.TryParse(BulkCustomerTypeListId, out var newTypeId)) return;

        IsBulkUpdating = true;
        SafeStateHasChanged();

        var idsToUpdate = SelectedCustomerIds.ToList();

        try
        {
            var updatedCount = await CustomerService.BulkAssignCustomerTypeAsync(idsToUpdate, newTypeId);

            if (_disposed) return;

            var typeName = CustomerTypes.FirstOrDefault(t => t.ListId == newTypeId)?.Type ?? "selected type";

            if (updatedCount > 0)
            {
                // Re-fetch the current page so local rows reflect the new type
                // (server is the source of truth after a bulk update).
                await LoadCustomersAsync(resetPaging: false);

                ShowStatus(
                    updatedCount == idsToUpdate.Count
                        ? $"Set Customer Type to \"{typeName}\" for {updatedCount} customer(s)."
                        : $"Set Customer Type to \"{typeName}\" for {updatedCount} of {idsToUpdate.Count} selected customer(s).",
                    isError: updatedCount < idsToUpdate.Count);
            }
            else
            {
                ShowStatus("Failed to update Customer Type for the selected customer(s).", isError: true);
            }
        }
        catch (Exception ex)
        {
            if (!_disposed)
                ShowStatus($"Error applying Customer Type: {ex.Message}", isError: true);
        }
        finally
        {
            if (!_disposed)
            {
                SelectedCustomerIds.Clear();
                BulkCustomerTypeListId = string.Empty;
                if (CustomerGridRef != null)
                    await CustomerGridRef.ClearSelectionAsync();

                IsBulkUpdating = false;
                SafeStateHasChanged();
            }
        }
    }

    // ── Customer Types state ────────────────────────────────────
    private SfGrid<CustomerService.CustomerTypeDto> CustomerTypeGridRef;
    private List<CustomerService.CustomerTypeDto> CustomerTypes = new();
    private bool IsLoadingTypes = false;

    // ── Customer Types: search + client-side pagination ──────────
    // All types are already loaded up front (GetAllCustomerTypesAsync
    // loops every API page), so both search and paging happen in
    // memory — no extra HTTP calls when typing or changing pages.
    private string CustomerTypeSearchTerm = string.Empty;

    // Search-filtered, NOT yet sliced to a page.
    private List<CustomerService.CustomerTypeDto> FilteredCustomerTypes = new();

    // Current page slice of FilteredCustomerTypes — this is what the grid renders.
    private List<CustomerService.CustomerTypeDto> DisplayedCustomerTypes = new();

    private int CustomerTypePageNumber = 1;
    private int TotalCustomerTypePages = 0;

    private bool CanGoPreviousTypes => CustomerTypePageNumber > 1;
    private bool CanGoNextTypes => CustomerTypePageNumber < TotalCustomerTypePages;

    // resetPaging=true snaps back to page 1 (used by Search / Clear).
    // resetPaging=false keeps the current page, just re-filters and
    // re-slices around it (used after CRUD updates that don't change
    // the search term) — the page number is still clamped to a valid
    // range in UpdateCustomerTypesPageSlice in case the result set shrank.
    private void RefreshDisplayedCustomerTypes(bool resetPaging = false)
    {
        if (string.IsNullOrWhiteSpace(CustomerTypeSearchTerm))
        {
            FilteredCustomerTypes = CustomerTypes;
        }
        else
        {
            var term = CustomerTypeSearchTerm.Trim();
            FilteredCustomerTypes = CustomerTypes
                .Where(t =>
                    (!string.IsNullOrEmpty(t.Type) && t.Type.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrEmpty(t.Description) && t.Description.Contains(term, StringComparison.OrdinalIgnoreCase)))
                .ToList();
        }

        if (resetPaging)
            CustomerTypePageNumber = 1;

        UpdateCustomerTypesPageSlice();
    }

    private void UpdateCustomerTypesPageSlice()
    {
        TotalCustomerTypePages = FilteredCustomerTypes.Count > 0
            ? (int)Math.Ceiling(FilteredCustomerTypes.Count / (double)CustomerPageSize)
            : 0;

        // Clamp in case a delete/filter shrank the results out from under the current page.
        if (CustomerTypePageNumber < 1)
            CustomerTypePageNumber = 1;
        else if (TotalCustomerTypePages > 0 && CustomerTypePageNumber > TotalCustomerTypePages)
            CustomerTypePageNumber = TotalCustomerTypePages;

        DisplayedCustomerTypes = FilteredCustomerTypes
            .Skip((CustomerTypePageNumber - 1) * CustomerPageSize)
            .Take(CustomerPageSize)
            .ToList();

        SafeStateHasChanged();
    }

    private void ClearCustomerTypeSearch()
    {
        CustomerTypeSearchTerm = string.Empty;
        RefreshDisplayedCustomerTypes(resetPaging: true);
    }

    // FooterPagination expects async handlers (it's shared with the
    // server-paginated Customers tab) — these are synchronous under
    // the hood since no HTTP call is needed, just a re-slice.
    private Task GoToFirstCustomerTypePageAsync()
    {
        if (!CanGoPreviousTypes || _disposed) return Task.CompletedTask;
        CustomerTypePageNumber = 1;
        UpdateCustomerTypesPageSlice();
        return Task.CompletedTask;
    }

    private Task GoToLastCustomerTypePageAsync()
    {
        if (!CanGoNextTypes || _disposed) return Task.CompletedTask;
        CustomerTypePageNumber = TotalCustomerTypePages;
        UpdateCustomerTypesPageSlice();
        return Task.CompletedTask;
    }

    private Task GoToNextCustomerTypePageAsync()
    {
        if (!CanGoNextTypes || _disposed) return Task.CompletedTask;
        CustomerTypePageNumber++;
        UpdateCustomerTypesPageSlice();
        return Task.CompletedTask;
    }

    private Task GoToPreviousCustomerTypePageAsync()
    {
        if (!CanGoPreviousTypes || _disposed) return Task.CompletedTask;
        CustomerTypePageNumber--;
        UpdateCustomerTypesPageSlice();
        return Task.CompletedTask;
    }

    // ── Lifecycle ────────────────────────────────────────────────
    protected override async Task OnPermissionsLoadedAsync()
    {
        if (!CanAccess)
        {
            ShowError("You don't have permission to access Customer Center.");
            return;
        }

        // Customer Types are needed both for their own tab AND as the
        // foreign-key DataSource for the Customer grid's "Customer Type"
        // column, so load them first regardless of which tab is active.
        await LoadCustomerTypesAsync();
        await LoadCustomersAsync(resetPaging: true);
    }

    private void SafeStateHasChanged()
    {
        if (_disposed) return;
        try { StateHasChanged(); }
        catch (ObjectDisposedException) { /* component torn down mid-flight — ignore */ }
    }

    // ── Customers: load / search / paginate ─────────────────────
    // resetPaging=true snaps back to page 1 (used by Search / status
    // filter change). resetPaging=false keeps whatever CustomerPageNumber
    // was already set by GoToNextPageAsync/GoToPreviousPageAsync.
    private async Task LoadCustomersAsync(bool resetPaging = false)
    {
        if (_disposed) return;

        var myGeneration = ++_loadGeneration;

        if (resetPaging)
            CustomerPageNumber = 1;

        IsLoadingCustomers = true;
        SafeStateHasChanged();

        try
        {
            var result = await CustomerService.GetCustomersPaginatedAsync(
                pageNumber: CustomerPageNumber,
                pageSize: CustomerPageSize,
                searchTerm: string.IsNullOrWhiteSpace(CustomerSearchTerm) ? null : CustomerSearchTerm.Trim(),
                isActive: ActiveFilterValue,
                missingTypeOnly: ShowMissingTypeOnly ? true : (bool?)null,
                callerToken: _cts.Token
            );

            if (_disposed || myGeneration != _loadGeneration) return;

            // Standard paging: each page load REPLACES the list — no
            // accumulation like the old "Load More"/infinite-scroll did.
            Customers = result.Data.ToList();
            TotalCustomerRecords = result.TotalRecords;
            TotalCustomerPages = Math.Max(result.TotalPages, result.Data.Any() ? 1 : 0);

            // Selection is tied to rows on THIS page — a reload (new
            // search/filter/page) invalidates it, since the underlying
            // rows may have changed or scrolled out of view.
            SelectedCustomerIds.Clear();

            RefreshDisplayedCustomers();
            RefreshTabItems();
        }
        catch (Exception ex)
        {
            if (!_disposed && myGeneration == _loadGeneration)
                ShowStatus($"Error loading customers: {ex.Message}", isError: true);
        }
        finally
        {
            if (!_disposed && myGeneration == _loadGeneration)
            {
                IsLoadingCustomers = false;
                SafeStateHasChanged();
            }
        }
    }

    private async Task GoToFirstPageAsync()
    {
        if (!CanGoPrevious || IsLoadingCustomers || _disposed) return;
        CustomerPageNumber = 1;
        await LoadCustomersAsync(resetPaging: false);
    }

    private async Task GoToLastPageAsync()
    {
        if (!CanGoNext || IsLoadingCustomers || _disposed) return;
        CustomerPageNumber = TotalCustomerPages;
        await LoadCustomersAsync(resetPaging: false);
    }

    private async Task GoToNextPageAsync()
    {
        if (!CanGoNext || IsLoadingCustomers || _disposed) return;
        CustomerPageNumber++;
        await LoadCustomersAsync(resetPaging: false);
    }

    private async Task GoToPreviousPageAsync()
    {
        if (!CanGoPrevious || IsLoadingCustomers || _disposed) return;
        CustomerPageNumber--;
        await LoadCustomersAsync(resetPaging: false);
    }

    // ── Customers: grid CRUD ─────────────────────────────────────
    private void OnCustomerRowDataBound(RowDataBoundEventArgs<Customer> args)
    {
        if (args.Data?.CustomerTypeListId == null)
        {
            args.Row.AddClass(new[] { "missing-type-row" });
        }
    }

    private async Task OnCustomerActionBegin(ActionEventArgs<Customer> args)
    {
        if (_disposed) return;

        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Save)
        {
            args.Cancel = true; // we save via the API ourselves, then patch the local list

            var isNew = args.Action == "Add";
            var customer = args.Data;

            try
            {
                if (isNew)
                {
                    // CustomerService.CreateCustomerAsync invalidates the Redis
                    // cache prefix internally — no manual cache handling needed
                    // here, just refresh the local list to match.
                    var created = await CustomerService.CreateCustomerAsync(customer);
                    if (_disposed) return;

                    // New row goes to the top of the CURRENT page's view.
                    // If you're not on page 1, it won't visually collide with
                    // stale paging math — just re-fetch this page to stay
                    // consistent with the server's sort order.
                    await LoadCustomersAsync(resetPaging: false);
                    ShowStatus($"Created customer \"{created.CompanyName}\".", isError: false);
                }
                else
                {
                    var ok = await CustomerService.UpdateCustomerAsync(customer);
                    if (_disposed) return;

                    if (ok)
                    {
                        var idx = Customers.FindIndex(c => c.Id == customer.Id);
                        if (idx >= 0) Customers[idx] = customer;
                        RefreshDisplayedCustomers();
                        ShowStatus($"Updated customer \"{customer.CompanyName}\".", isError: false);
                    }
                    else
                    {
                        ShowStatus($"Failed to update customer \"{customer.CompanyName}\".", isError: true);
                    }
                }
            }
            catch (Exception ex)
            {
                if (!_disposed)
                    ShowStatus($"Error saving customer: {ex.Message}", isError: true);
            }
            finally
            {
                if (!_disposed)
                {
                    if (CustomerGridRef != null)
                        await CustomerGridRef.CloseEditAsync();
                    SafeStateHasChanged();
                }
            }
        }
        else if (args.RequestType == Syncfusion.Blazor.Grids.Action.Delete)
        {
            args.Cancel = true;

            var customer = args.Data;
            if (customer == null) return;

            try
            {
                var ok = await CustomerService.DeleteCustomerAsync(customer.Id);
                if (_disposed) return;

                if (ok)
                {
                    // Re-fetch this page — deleting a row shifts everything
                    // after it, so patching the local list in place would
                    // drift from what page N actually contains server-side.
                    await LoadCustomersAsync(resetPaging: false);
                    ShowStatus($"Deleted customer \"{customer.CompanyName}\".", isError: false);
                }
                else
                {
                    ShowStatus($"Failed to delete customer \"{customer.CompanyName}\".", isError: true);
                }
            }
            catch (Exception ex)
            {
                if (!_disposed)
                    ShowStatus($"Error deleting customer: {ex.Message}", isError: true);
            }
            finally
            {
                if (!_disposed)
                {
                    if (CustomerGridRef != null)
                        await CustomerGridRef.Refresh();
                    SafeStateHasChanged();
                }
            }
        }
    }

    // ── Customer Types: load ─────────────────────────────────────
    private async Task LoadCustomerTypesAsync(bool forceRefresh = false)
    {
        if (_disposed) return;

        IsLoadingTypes = true;
        SafeStateHasChanged();

        try
        {
            // forceRefresh=true invalidates the Redis cache key inside
            // CustomerService before refetching — see GetAllCustomerTypesAsync.
            var types = await CustomerService.GetAllCustomerTypesAsync(forceRefresh);
            if (_disposed) return;

            CustomerTypes = types;
            RefreshDisplayedCustomerTypes(resetPaging: true);
            RefreshTabItems();
        }
        catch (Exception ex)
        {
            if (!_disposed)
                ShowStatus($"Error loading customer types: {ex.Message}", isError: true);
        }
        finally
        {
            if (!_disposed)
            {
                IsLoadingTypes = false;
                SafeStateHasChanged();
            }
        }
    }

    // ── Customer Types: grid CRUD ────────────────────────────────
    private async Task OnCustomerTypeActionBegin(ActionEventArgs<CustomerService.CustomerTypeDto> args)
    {
        if (_disposed) return;

        if (args.RequestType == Syncfusion.Blazor.Grids.Action.Save)
        {
            args.Cancel = true;

            var isNew = args.Action == "Add";
            var type = args.Data;

            try
            {
                if (isNew)
                {
                    var created = await CustomerService.CreateCustomerTypeAsync(type);
                    if (_disposed) return;

                    CustomerTypes.Insert(0, created);
                    // Jump back to page 1 so the newly-created row is visible.
                    RefreshDisplayedCustomerTypes(resetPaging: true);
                    RefreshTabItems();
                    ShowStatus($"Created customer type \"{created.Type}\".", isError: false);
                }
                else
                {
                    var ok = await CustomerService.UpdateCustomerTypeAsync(type);
                    if (_disposed) return;

                    if (ok)
                    {
                        var idx = CustomerTypes.FindIndex(t => t.ListId == type.ListId);
                        if (idx >= 0) CustomerTypes[idx] = type;
                        // Stay on the current page — updating in place shouldn't move you.
                        RefreshDisplayedCustomerTypes(resetPaging: false);
                        ShowStatus($"Updated customer type \"{type.Type}\".", isError: false);
                    }
                    else
                    {
                        ShowStatus($"Failed to update customer type \"{type.Type}\".", isError: true);
                    }
                }
            }
            catch (Exception ex)
            {
                if (!_disposed)
                    ShowStatus($"Error saving customer type: {ex.Message}", isError: true);
            }
            finally
            {
                if (!_disposed)
                {
                    if (CustomerTypeGridRef != null)
                        await CustomerTypeGridRef.CloseEditAsync();
                    SafeStateHasChanged();
                }
            }
        }
        else if (args.RequestType == Syncfusion.Blazor.Grids.Action.Delete)
        {
            args.Cancel = true;

            var type = args.Data;
            if (type == null) return;

            try
            {
                var ok = await CustomerService.DeleteCustomerTypeAsync(type.ListId);
                if (_disposed) return;

                if (ok)
                {
                    CustomerTypes.RemoveAll(t => t.ListId == type.ListId);
                    // Keep current page — UpdateCustomerTypesPageSlice will
                    // clamp back a page automatically if this emptied the page.
                    RefreshDisplayedCustomerTypes(resetPaging: false);
                    RefreshTabItems();
                    ShowStatus($"Deleted customer type \"{type.Type}\".", isError: false);
                }
                else
                {
                    ShowStatus($"Failed to delete customer type \"{type.Type}\". It may still be in use by existing customers.", isError: true);
                }
            }
            catch (Exception ex)
            {
                if (!_disposed)
                    ShowStatus($"Error deleting customer type: {ex.Message}", isError: true);
            }
            finally
            {
                if (!_disposed)
                {
                    if (CustomerTypeGridRef != null)
                        await CustomerTypeGridRef.Refresh();
                    SafeStateHasChanged();
                }
            }
        }
    }

    // ── Cleanup ───────────────────────────────────────────────────
    public async ValueTask DisposeAsync()
    {
        _disposed = true;

        try { _cts.Cancel(); }
        catch (ObjectDisposedException) { }

        _cts.Dispose();

        try { _searchDebounceCts?.Cancel(); }
        catch (ObjectDisposedException) { }

        _searchDebounceCts?.Dispose();

        Customers = new();
        DisplayedCustomers = new();
        CustomerTypes = new();
        FilteredCustomerTypes = new();
        DisplayedCustomerTypes = new();
        SelectedCustomerIds = new();

        await Task.CompletedTask;
    }
}