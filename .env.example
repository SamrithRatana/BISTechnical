# ════════════════════════════════════════════════════════
# RabbitMQ — CloudAMQP / Local Broker
# ════════════════════════════════════════════════════════
RABBITMQ_HOST=your-rabbitmq-host.com
RABBITMQ_PORT=5671
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=your_vhost

# ════════════════════════════════════════════════════════
# Security & JWT Token Key
# ════════════════════════════════════════════════════════
JWT_KEY=YourStrongAndSecureJwtSecretKeyGoesHereMinimum32Chars!2026

# ════════════════════════════════════════════════════════
# Database Configuration
# ════════════════════════════════════════════════════════
DB_SERVER=localhost,1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd

# ════════════════════════════════════════════════════════
# Redis Cache
# ════════════════════════════════════════════════════════
UPSTASH_REDIS_ENDPOINT=your-redis-host.upstash.io
UPSTASH_REDIS_PASSWORD=your_redis_password

# ════════════════════════════════════════════════════════
# SMTP Notification Settings
# ════════════════════════════════════════════════════════
SMTP_USERNAME=your_email@domain.com
SMTP_PASSWORD=your_app_password
